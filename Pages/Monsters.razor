@page "/monsters"
@using DndCompanion.Models
@using DndCompanion.Models.Packages
@implements IDisposable
@inject IMonsterRepository MonsterRepository
@inject IProfileRepository ProfileRepository
@inject ICatalogService Catalog
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ToastService Toasts
@inject ConfirmService Confirm

<PageTitle>Mostri - D&amp;D Companion</PageTitle>

<div class="monsters-container">
    <header class="page-header">
        <button type="button" class="back-btn" @onclick='() => Navigation.NavigateTo("")'>
            ← Home
        </button>
        <h1 class="page-title">Mostri</h1>
    </header>

    <DbErrorBanner Message="@errorMessage" OnDismiss="@(() => errorMessage = null)" />

    @if (mode == ViewMode.Form)
    {
        <div class="form-view">
            <div class="form-top">
                <button type="button" class="back-link" @onclick="CancelForm">← Annulla</button>
            </div>

            <h2 class="form-title">
                @(string.IsNullOrEmpty(editDraft.Id) ? "Nuovo Mostro" : "Modifica Mostro")
            </h2>

            <div class="form-grid">
                <div class="field field-full">
                    <label>Nome</label>
                    <input type="text" class="input" maxlength="120" @bind="editDraft.Name" />
                </div>

                <div class="field">
                    <label>Taglia</label>
                    <input type="text" class="input" maxlength="40" @bind="editDraft.Size" />
                </div>

                <div class="field">
                    <label>Tipo</label>
                    <input type="text" class="input" maxlength="40" @bind="editDraft.Type" />
                </div>

                <div class="field">
                    <label>Allineamento</label>
                    <input type="text" class="input" maxlength="60" @bind="editDraft.Alignment" />
                </div>

                <div class="field">
                    <label>Challenge Rating</label>
                    <input type="text" class="input" maxlength="10" @bind="editDraft.ChallengeRating" />
                </div>

                <div class="field">
                    <label>CA</label>
                    <input type="number" class="input" min="0" max="40" @bind="editDraft.ArmorClass" />
                </div>

                <div class="field">
                    <label>PF (es. "45 (6d10+12)")</label>
                    <input type="text" class="input" maxlength="60" @bind="editDraft.HitPoints" />
                </div>

                <div class="field field-full">
                    <label>Velocità</label>
                    <input type="text" class="input" maxlength="120" @bind="editDraft.Speed" />
                </div>

                <div class="field-group field-full">
                    <label class="group-label">Caratteristiche</label>
                    <div class="stats-inputs">
                        <div class="field stat-field">
                            <label title="Forza">FOR</label>
                            <input type="number" class="input" min="1" max="30" @bind="editDraft.Strength" />
                        </div>
                        <div class="field stat-field">
                            <label title="Destrezza">DES</label>
                            <input type="number" class="input" min="1" max="30" @bind="editDraft.Dexterity" />
                        </div>
                        <div class="field stat-field">
                            <label title="Costituzione">COS</label>
                            <input type="number" class="input" min="1" max="30" @bind="editDraft.Constitution" />
                        </div>
                        <div class="field stat-field">
                            <label title="Intelligenza">INT</label>
                            <input type="number" class="input" min="1" max="30" @bind="editDraft.Intelligence" />
                        </div>
                        <div class="field stat-field">
                            <label title="Saggezza">SAG</label>
                            <input type="number" class="input" min="1" max="30" @bind="editDraft.Wisdom" />
                        </div>
                        <div class="field stat-field">
                            <label title="Carisma">CAR</label>
                            <input type="number" class="input" min="1" max="30" @bind="editDraft.Charisma" />
                        </div>
                    </div>
                </div>

                <div class="field field-full">
                    <label>Abilità speciali</label>
                    <textarea class="input" rows="5" @bind="editDraft.Abilities"></textarea>
                </div>

                <div class="field field-full">
                    <label>Descrizione</label>
                    <textarea class="input" rows="6" @bind="editDraft.Description"></textarea>
                </div>
            </div>

            <div class="form-actions">
                <button type="button" class="primary-btn" @onclick="SaveFormAsync" disabled="@isBusy">
                    @(isBusy ? "Salvataggio..." : "Salva")
                </button>
                <button type="button" class="secondary-btn" @onclick="CancelForm" disabled="@isBusy">
                    Annulla
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="search-section">
            <input type="text" class="search-input" placeholder="Cerca mostri..."
                   @bind="searchInput" @bind:event="oninput" @bind:after="OnSearchInputChangedAsync" />

            <div class="filter-label">Challenge Rating</div>
            <div class="chips-row">
                @foreach (var cr in crFilters)
                {
                    <button type="button"
                            class="chip @(crFilterLabels.Contains(cr.Label) ? "chip-active" : "")"
                            @onclick="() => ToggleCr(cr.Label)">
                        @cr.Label
                    </button>
                }
            </div>

            <div class="filter-label">Tipo</div>
            <div class="chips-row">
                @foreach (var t in types)
                {
                    <button type="button"
                            class="chip @(typeFilter == t.Match ? "chip-active" : "")"
                            @onclick="() => ToggleType(t.Match)">
                        @t.Label
                    </button>
                }
            </div>

            <div class="results-info">
                @if (isLoading)
                {
                    <LoadingSpinner Text="Caricamento mostri..." />
                }
                else
                {
                    var count = FilteredEntries.Count();
                    <span>@count @(count == 1 ? "mostro trovato" : "mostri trovati")</span>
                }
            </div>
        </div>

        <div class="monsters-list">
            @if (!isLoading)
            {
                @foreach (var entry in FilteredEntries)
                {
                    var isExpanded = expandedKey == entry.Key;
                    <div class="monster-card @(isExpanded ? "expanded" : "") @(entry.FromAppPackage ? "package-card" : "")">
                        <button type="button" class="card-summary" @onclick="() => ToggleExpand(entry.Key)">
                            <div class="card-main">
                                <div class="card-name">@entry.Name</div>
                                <div class="card-meta">
                                    <span class="cr-badge">CR @(string.IsNullOrEmpty(entry.ChallengeRating) ? "—" : entry.ChallengeRating)</span>
                                    @if (entry.Db is not null)
                                    {
                                        <span class="type">@entry.Db.Type</span>
                                    }
                                    @{ var author = GetAuthorName(entry.AddedBy); }
                                    @if (!string.IsNullOrEmpty(author))
                                    {
                                        <span class="author-badge" title="Aggiunto da @author">✎ @author</span>
                                    }
                                    @if (entry.FromAppPackage)
                                    {
                                        <span class="package-badge">Dal manuale</span>
                                    }
                                </div>
                            </div>
                            <span class="expand-icon">@(isExpanded ? "▾" : "▸")</span>
                        </button>

                        <div class="card-details">
                            <div class="details-inner">
                                @if (entry.Db is not null)
                                {
                                    <div class="header-line">
                                        @entry.Db.Size @entry.Db.Type, @entry.Db.Alignment
                                    </div>
                                }

                                <div class="key-stats-row">
                                    <div class="key-stat">
                                        <div class="key-label">CA</div>
                                        <div class="key-value">@entry.ArmorClass</div>
                                    </div>
                                    <div class="key-stat">
                                        <div class="key-label">PF</div>
                                        <div class="key-value">@entry.HitPoints</div>
                                    </div>
                                    @* La velocità esiste solo sulla riga di database: PackageMonster non la porta (Task 2). *@
                                    @if (entry.Db is not null)
                                    {
                                        <div class="key-stat key-stat-wide">
                                            <div class="key-label">Velocità</div>
                                            <div class="key-value">@entry.Db.Speed</div>
                                        </div>
                                    }
                                </div>

                                @if (entry.Db is not null)
                                {
                                    <div class="stats-grid">
                                        @foreach (var s in GetStats(entry.Db))
                                        {
                                            <div class="stat-card">
                                                <div class="stat-label">@s.Label</div>
                                                <div class="stat-value">@s.Value</div>
                                                <div class="stat-mod">@FormatBonus(CharacterCalculations.GetModifier(s.Value))</div>
                                            </div>
                                        }
                                    </div>
                                }

                                @if (entry.Db is not null && !string.IsNullOrWhiteSpace(entry.Db.Abilities))
                                {
                                    <div class="section-block">
                                        <div class="section-title">Abilità speciali</div>
                                        <div class="section-body">@entry.Db.Abilities</div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(entry.Description))
                                {
                                    <div class="section-block">
                                        <div class="section-title">Descrizione</div>
                                        <div class="section-body">@entry.Description</div>
                                    </div>
                                }

                                @if (entry.IsPackage)
                                {
                                    <div class="master-actions">
                                        <button type="button" class="action-btn duplicate-action"
                                                @onclick="() => OpenDuplicateForm(entry.Package!)" @onclick:stopPropagation
                                                aria-label="Duplica e modifica @entry.Name">
                                            ⧉ Duplica e modifica
                                        </button>
                                    </div>
                                }
                                else if (CatalogKey.IsFromAppPackage(entry.Db!.SourceId))
                                {
                                    <div class="master-actions">
                                        <button type="button" class="action-btn duplicate-action"
                                                @onclick="() => OpenDuplicateForm(entry.Db!)" @onclick:stopPropagation
                                                aria-label="Duplica e modifica @entry.Name">
                                            ⧉ Duplica e modifica
                                        </button>
                                    </div>
                                }
                                else if (PuoModificare(entry.Db!))
                                {
                                    <div class="master-actions">
                                        <button type="button" class="action-btn edit-action" @onclick="() => OpenEditForm(entry.Db!)" @onclick:stopPropagation>
                                            ✎ Modifica
                                        </button>
                                        <button type="button" class="action-btn delete-action" @onclick="() => DeleteMonsterAsync(entry.Db!)" @onclick:stopPropagation>
                                            🗑 Elimina
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (!FilteredEntries.Any())
                {
                    <div class="empty-state">
                        @if (dbRows.Count == 0 && packageRows.Count == 0)
                        {
                            <div class="empty-icon">🐉</div>
                            <p class="empty-title">Nessun mostro nel database</p>
                            <p class="empty-text">
                                Il Master può aggiungere i mostri usando il bottone
                                <strong>+</strong> in basso a destra.
                            </p>
                        }
                        else
                        {
                            <p class="empty-text">Nessun mostro corrisponde ai filtri.</p>
                        }
                    </div>
                }
            }
        </div>

        @* Creazione mostro: ogni membro della campagna può aggiungere. *@
        <button type="button" class="fab" @onclick="OpenCreateForm" title="Nuovo mostro" aria-label="Nuovo mostro">
            +
        </button>
    }
</div>

@code {
    private enum ViewMode { List, Form }

    private ViewMode mode = ViewMode.List;

    private List<Monster> dbRows = new();
    private List<PackageMonster> packageRows = new();
    private Dictionary<string, string> playerNicknames = new();
    private bool isLoading = true;
    private bool isBusy;
    private string? errorMessage;

    private string searchInput = string.Empty;
    private string searchQuery = string.Empty;
    private CancellationTokenSource? debounceCts;

    private record CrFilter(string Label, Func<double, bool> Match);

    private readonly CrFilter[] crFilters =
    {
        new("0",     v => v == 0),
        new("1/8",   v => Math.Abs(v - 0.125) < 0.001),
        new("1/4",   v => Math.Abs(v - 0.25) < 0.001),
        new("1/2",   v => Math.Abs(v - 0.5) < 0.001),
        new("1",     v => v == 1),
        new("2",     v => v == 2),
        new("3",     v => v == 3),
        new("4",     v => v == 4),
        new("5",     v => v == 5),
        new("6",     v => v == 6),
        new("7",     v => v == 7),
        new("8",     v => v == 8),
        new("9",     v => v == 9),
        new("10",    v => v == 10),
        new("11-15", v => v >= 11 && v <= 15),
        new("16-20", v => v >= 16 && v <= 20),
        new("21+",   v => v >= 21)
    };
    private readonly HashSet<string> crFilterLabels = new();

    private record MonsterType(string Label, string Match);

    private readonly MonsterType[] types =
    {
        new("Aberrazione", "Aberration"),
        new("Bestia",      "Beast"),
        new("Celestiale",  "Celestial"),
        new("Costrutto",   "Construct"),
        new("Drago",       "Dragon"),
        new("Elementale",  "Elemental"),
        new("Folletto",    "Fey"),
        new("Immondo",     "Fiend"),
        new("Gigante",     "Giant"),
        new("Umanoide",    "Humanoid"),
        new("Mostruosità", "Monstrosity"),
        new("Melma",       "Ooze"),
        new("Vegetale",    "Plant"),
        new("Non Morto",   "Undead")
    };
    private string? typeFilter;

    private string? expandedKey;
    private Monster editDraft = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CurrentUser.EnsureLoadedAsync();

            if (string.IsNullOrEmpty(CurrentUser.CampaignId)) return;

            var profilesTask = ProfileRepository.GetProfilesAsync();
            var reloadTask = ReloadAsync();
            await Task.WhenAll(profilesTask, reloadTask);

            playerNicknames = profilesTask.Result.ToDictionary(p => p.Id, p => p.DisplayName ?? "Utente");
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore caricamento mostri: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Ricarica SEMPRE dal servizio invece di ritoccare dbRows/packageRows in memoria: la vista non
    // è solo righe di database, contiene anche le voci di pacchetto, e quali siano visibili dipende
    // da cosa c'è nel database (vedi "Duplica e modifica" più sotto).
    private async Task ReloadAsync()
    {
        if (string.IsNullOrEmpty(CurrentUser.CampaignId)) return;

        var vista = await Catalog.GetMonstersAsync(CurrentUser.CampaignId);
        dbRows = vista.DbRows.ToList();
        packageRows = vista.PackageEntries.ToList();
    }

    private string? GetAuthorName(string? authorId)
    {
        if (string.IsNullOrEmpty(authorId)) return null;
        return playerNicknames.TryGetValue(authorId, out var nick) ? nick : null;
    }

    // Una riga di database è modificabile se chi guarda ne ha il diritto E non viene dal
    // pacchetto dell'app: quelle restano voci di manuale anche se vivono nel database (§6).
    private bool PuoModificare(Monster m)
        => !CatalogKey.IsFromAppPackage(m.SourceId)
           && AccessControl.CanEdit(CurrentUser.IsMaster, m.AddedBy, CurrentUser.UserId);

    // Copia modificabile di una voce di pacchetto: nasce SENZA SourceId, così è una voce
    // propria dell'utente e ha la precedenza nel merge (§4.3). Le sei caratteristiche restano ai
    // default del Model (10): PackageMonster non le porta.
    private Monster DuplicaDaPacchetto(PackageMonster p) => new()
    {
        Name = p.Name,
        ChallengeRating = p.ChallengeRating,
        // `?? 10`: la proprietà del pacchetto è int? (Task 2), quella del Model è int, e 10 è il
        // default del Model per un mostro di cui non si conosce l'armatura.
        ArmorClass = p.ArmorClass ?? 10,
        HitPoints = p.HitPoints,
        Description = p.Description,
        SourceId = null,
        CampaignId = CurrentUser.CampaignId ?? string.Empty,
        AddedBy = CurrentUser.UserId,
    };

    // Stessa regola di DuplicaDaPacchetto, ma per una riga di DATABASE che porta comunque la
    // provenienza del pacchetto dell'app (import diretto, non ancora possibile in questa fase ma
    // già previsto dal modello dati): anche qui la copia nasce SENZA SourceId.
    // AddedBy è l'utente CORRENTE, non l'autore originale della riga (che potrebbe non essere lui):
    // la RLS "monsters_insert" richiede added_by = auth.uid(), quindi copiare m.AddedBy avrebbe
    // fatto fallire l'INSERT per chiunque diverso dall'autore originale, master incluso.
    private Monster DuplicaDaRigaImportata(Monster m) => new()
    {
        Name = m.Name,
        Size = m.Size,
        Type = m.Type,
        Alignment = m.Alignment,
        ArmorClass = m.ArmorClass,
        HitPoints = m.HitPoints,
        Speed = m.Speed,
        Strength = m.Strength,
        Dexterity = m.Dexterity,
        Constitution = m.Constitution,
        Intelligence = m.Intelligence,
        Wisdom = m.Wisdom,
        Charisma = m.Charisma,
        ChallengeRating = m.ChallengeRating,
        Abilities = m.Abilities,
        Description = m.Description,
        SourceId = null,
        CampaignId = m.CampaignId,
        AddedBy = CurrentUser.UserId,
    };

    // Vista unificata di riga-database e voce-pacchetto: la lista mostrata è un'unione delle due
    // sorgenti (ricerca/filtri/ordinamento/rendering condivisi), ma le operazioni CRUD restano
    // ancorate a dbRows/packageRows separati.
    // Solo i campi che ESISTONO su entrambe le fonti entrano nel record: taglia, tipo, allineamento,
    // velocità, caratteristiche e abilità speciali vivono solo sul Model (PackageMonster non li porta,
    // Task 2) e nel markup si leggono direttamente da entry.Db, sotto `@if (entry.Db is not null)`.
    private sealed record Entry(
        string Key,
        string Name,
        string ChallengeRating,
        int ArmorClass,
        string HitPoints,
        string Description,
        string? AddedBy,
        bool IsPackage,
        bool FromAppPackage,
        Monster? Db,
        PackageMonster? Package);

    private static Entry ToEntry(Monster m) => new(
        "db:" + m.Id, m.Name, m.ChallengeRating, m.ArmorClass, m.HitPoints, m.Description,
        m.AddedBy, false, CatalogKey.IsFromAppPackage(m.SourceId), m, null);

    // Nessun autore: una voce di pacchetto non l'ha aggiunta nessuno.
    // `?? 10` sulla CA: la proprietà del pacchetto è int? (Task 2), quella del record è int, e 10
    // è il default del Model per un mostro di cui non si conosce l'armatura.
    private static Entry ToEntry(PackageMonster p) => new(
        "pkg:" + p.Id, p.Name, p.ChallengeRating, p.ArmorClass ?? 10, p.HitPoints, p.Description,
        null, true, true, null, p);

    private IEnumerable<Entry> FilteredEntries
    {
        get
        {
            IEnumerable<Entry> result = dbRows.Select(ToEntry).Concat(packageRows.Select(ToEntry));

            if (!string.IsNullOrEmpty(searchQuery))
            {
                // Normalizzato su entrambi i lati: cercare "drago" deve trovare "Drago".
                var chiave = CatalogKey.NormalizeName(searchQuery);
                result = result.Where(e =>
                    CatalogKey.NormalizeName(e.Name).Contains(chiave, StringComparison.Ordinal));
            }

            if (crFilterLabels.Count > 0)
            {
                result = result.Where(e =>
                {
                    var v = MonsterCatalog.ParseChallengeRating(e.ChallengeRating);
                    if (v < 0) return false;
                    return crFilters.Any(f => crFilterLabels.Contains(f.Label) && f.Match(v));
                });
            }

            if (!string.IsNullOrEmpty(typeFilter))
            {
                // Il tipo (Aberrazione, Bestia, ...) esiste solo sulla riga di database: PackageMonster
                // non lo porta (Task 2). Una voce di pacchetto non può quindi corrispondere a un tipo
                // scelto e va esclusa, non mostrata "per difetto" come se combaciasse.
                result = result.Where(e =>
                    e.Db is not null && e.Db.Type.Contains(typeFilter, StringComparison.OrdinalIgnoreCase));
            }

            return result
                .OrderBy(e => MonsterCatalog.ParseChallengeRating(e.ChallengeRating))
                .ThenBy(e => e.Name, StringComparer.OrdinalIgnoreCase);
        }
    }

    private async Task OnSearchInputChangedAsync()
    {
        debounceCts?.Cancel();
        debounceCts?.Dispose();
        debounceCts = new CancellationTokenSource();
        var token = debounceCts.Token;
        try
        {
            await Task.Delay(300, token);
            if (token.IsCancellationRequested) return;
            searchQuery = searchInput.Trim();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private void ToggleCr(string label)
    {
        if (!crFilterLabels.Add(label))
            crFilterLabels.Remove(label);
        expandedKey = null;
    }

    private void ToggleType(string type)
    {
        typeFilter = typeFilter == type ? null : type;
        expandedKey = null;
    }

    private void ToggleExpand(string key) => expandedKey = expandedKey == key ? null : key;

    private void OpenCreateForm()
    {
        editDraft = new Monster
        {
            Size = "Medium",
            ArmorClass = 10,
            Strength = 10,
            Dexterity = 10,
            Constitution = 10,
            Intelligence = 10,
            Wisdom = 10,
            Charisma = 10,
            AddedBy = CurrentUser.UserId,
            CampaignId = CurrentUser.CampaignId ?? string.Empty
        };
        mode = ViewMode.Form;
    }

    private void OpenEditForm(Monster monster)
    {
        editDraft = CloneMonster(monster);
        mode = ViewMode.Form;
    }

    private void OpenDuplicateForm(PackageMonster package)
    {
        editDraft = DuplicaDaPacchetto(package);
        mode = ViewMode.Form;
    }

    private void OpenDuplicateForm(Monster monster)
    {
        editDraft = DuplicaDaRigaImportata(monster);
        mode = ViewMode.Form;
    }

    private void CancelForm() => mode = ViewMode.List;

    private async Task SaveFormAsync()
    {
        var validationError = FormValidation.ValidateMonster(editDraft);
        if (validationError is not null)
        {
            Toasts.ShowError(validationError);
            return;
        }

        isBusy = true;
        errorMessage = null;
        try
        {
            Monster? saved;
            if (string.IsNullOrEmpty(editDraft.Id))
            {
                saved = await MonsterRepository.CreateMonsterAsync(editDraft);
            }
            else
            {
                saved = await MonsterRepository.UpdateMonsterAsync(editDraft);
            }

            if (saved is null)
            {
                errorMessage = "Il server non ha restituito il mostro salvato.";
                return;
            }

            // Richiama il servizio invece di ritoccare dbRows: la copia di "Duplica e modifica"
            // deve far sparire la voce di pacchetto da cui deriva nella STESSA operazione, non al
            // prossimo cambio pagina.
            await ReloadAsync();
            expandedKey = "db:" + saved.Id;
            mode = ViewMode.List;
            Toasts.ShowSuccess("Salvato");
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore salvataggio: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteMonsterAsync(Monster monster)
    {
        var confirmed = await Confirm.ShowAsync($"Eliminare il mostro \"{monster.Name}\"?");
        if (!confirmed) return;

        isBusy = true;
        errorMessage = null;
        try
        {
            await MonsterRepository.DeleteMonsterAsync(monster.Id);
            if (expandedKey == "db:" + monster.Id) expandedKey = null;
            await ReloadAsync();
            Toasts.ShowSuccess("Eliminato");
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore eliminazione: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private static Monster CloneMonster(Monster m) => new()
    {
        Id = m.Id,
        Name = m.Name,
        Size = m.Size,
        Type = m.Type,
        Alignment = m.Alignment,
        ArmorClass = m.ArmorClass,
        HitPoints = m.HitPoints,
        Speed = m.Speed,
        Strength = m.Strength,
        Dexterity = m.Dexterity,
        Constitution = m.Constitution,
        Intelligence = m.Intelligence,
        Wisdom = m.Wisdom,
        Charisma = m.Charisma,
        ChallengeRating = m.ChallengeRating,
        Abilities = m.Abilities,
        Description = m.Description,
        SourceId = m.SourceId,
        AddedBy = m.AddedBy,
        CampaignId = m.CampaignId
    };

    private static IEnumerable<(string Label, int Value)> GetStats(Monster m) => new[]
    {
        ("FOR", m.Strength),
        ("DES", m.Dexterity),
        ("COS", m.Constitution),
        ("INT", m.Intelligence),
        ("SAG", m.Wisdom),
        ("CAR", m.Charisma)
    };

    public void Dispose()
    {
        debounceCts?.Cancel();
        debounceCts?.Dispose();
    }
}
