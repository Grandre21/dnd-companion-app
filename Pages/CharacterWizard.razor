@page "/characters/nuovo"
@using DndCompanion.Models
@using DndCompanion.Models.Packages
@inject ICatalogService Catalog
@inject ICharacterRepository CharacterRepository
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject ConfirmService Confirm

<PageTitle>Nuovo personaggio - D&amp;D Companion</PageTitle>

<div class="wizard-page">
    <div class="wizard-top">
        <button type="button" class="wiz-cancel" @onclick="ExitAsync">← Esci</button>
    </div>

    @if (loading)
    {
        <LoadingSpinner Text="Caricamento cataloghi..." />
    }
    else if (noCampaign)
    {
        <div class="empty-state">
            <div class="empty-icon">🗡️</div>
            <p class="empty-text">Serve una campagna attiva per creare un personaggio.</p>
            <button type="button" class="primary-btn" @onclick='() => Navigation.NavigateTo("")'>Torna alla Home</button>
        </div>
    }
    else
    {
        <DbErrorBanner Message="@systemError" OnDismiss="@(() => systemError = null)" />

        <h1 class="wizard-title">Nuovo personaggio</h1>
        <p class="wizard-subtitle">Ti guidiamo passo per passo: specie, classe, background, caratteristiche, dettagli — e alla fine il personaggio è pronto.</p>

        <div class="wizard-steps">
            @for (var i = 0; i < TotalSteps; i++)
            {
                var idx = i;
                var reachable = idx <= maxStepReached;
                <button type="button"
                        class="wiz-step-dot @(idx == currentStep ? "active" : "") @(idx < currentStep ? "done" : "") @(!reachable ? "locked" : "")"
                        disabled="@(!reachable)"
                        @onclick="() => GoToStep(idx)"
                        aria-label="@($"Vai al passo {idx + 1}: {StepTitles[idx]}")">
                    @(idx + 1)
                </button>
            }
        </div>
        <p class="wiz-step-caption">Passo @(currentStep + 1) di @TotalSteps — @StepTitles[currentStep]</p>

        <div class="wizard-body">
            @switch (Steps[currentStep])
            {
                case WizardStepKind.Specie:
                    @* ===================== SPECIE ===================== *@
                    <div class="wiz-step">
                        <div class="help-box">
                            La <strong>specie</strong> (elfo, umano, nano...) determina la taglia, la velocità di
                            movimento e alcuni tratti innati (es. la scurovisione). Nelle regole 2024 la specie non dà
                            più bonus alle caratteristiche: quelli arrivano dal background, al passo 3.
                        </div>

                        @if (AllRaceNames.Count == 0)
                        {
                            <div class="empty-catalog-notice">
                                Non ci sono ancora specie nel catalogo di questa campagna, e il manuale precaricato non
                                è (ancora) disponibile. Nessun problema: scrivi il nome a mano, potrai aggiungerla al
                                catalogo più avanti dalla pagina Specie.
                            </div>
                            <div class="field">
                                <label>Nome specie <span class="req">*</span></label>
                                <input type="text" class="input" maxlength="60" placeholder="Es. Elfo, Umano..."
                                       @bind="draft.Race" @bind:event="oninput" />
                            </div>
                        }
                        else
                        {
                            <div class="field">
                                <label>Specie <span class="req">*</span></label>
                                <select class="input" value="@CurrentRaceSelection" @onchange="OnRaceSelectionChanged">
                                    <option value="">-- Seleziona --</option>
                                    @foreach (var name in AllRaceNames)
                                    {
                                        <option value="@name">@name</option>
                                    }
                                    <option value="@CustomOptionValue">Altro (scrivi a mano)</option>
                                </select>
                                @if (isRaceCustom)
                                {
                                    <input type="text" class="input custom-input" maxlength="60"
                                           placeholder="Scrivi la specie" @bind="draft.Race" @bind:event="oninput" />
                                }
                            </div>

                            @if (SelectedRaceDb is not null)
                            {
                                <div class="info-summary">
                                    @if (!string.IsNullOrWhiteSpace(SelectedRaceDb.Description))
                                    {
                                        <p>@SelectedRaceDb.Description</p>
                                    }
                                    <p><strong>Velocità:</strong> @SelectedRaceDb.Speed @(FormValidation.IsMetric(SelectedRaceDb.SpeedUnit) ? "m" : "ft")</p>
                                    @if (!string.IsNullOrWhiteSpace(SelectedRaceDb.Traits))
                                    {
                                        <p><strong>Tratti:</strong> @SelectedRaceDb.Traits</p>
                                    }
                                    @if (CharacterWizardLogic.RaceGrantsAbilityBonuses(SelectedRaceDb))
                                    {
                                        <p class="wiz-legacy-note">
                                            Questa voce porta bonus di caratteristica propri (versione 2014): al passo 3
                                            il background non ne aggiungerà altri, per non sommare due edizioni.
                                        </p>
                                    }
                                </div>
                            }
                            else if (SelectedRacePackage is not null)
                            {
                                <div class="info-summary">
                                    <p><strong>Taglia:</strong> @SelectedRacePackage.Size</p>
                                    @if (SelectedRacePackage.Speed is not null)
                                    {
                                        <p><strong>Velocità:</strong> @SelectedRacePackage.Speed.Value @SelectedRacePackage.Speed.Unit</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(SelectedRacePackage.Description))
                                    {
                                        <p>@SelectedRacePackage.Description</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(SelectedRacePackage.Traits))
                                    {
                                        <p><strong>Tratti:</strong> @SelectedRacePackage.Traits</p>
                                    }
                                </div>
                            }
                        }
                    </div>
                    break;

                case WizardStepKind.Classe:
                    @* ===================== CLASSE ===================== *@
                    <div class="wiz-step">
                        <div class="help-box">
                            La <strong>classe</strong> (guerriero, mago, ladro...) è il mestiere del personaggio: decide
                            il <strong>dado vita</strong> (quanti PF guadagna per livello), la caratteristica principale
                            e i <strong>tiri salvezza</strong> in cui è più bravo a resistere (veleno, incantesimi,
                            esplosioni...).
                        </div>

                        @if (AllClassNames.Count == 0)
                        {
                            <div class="empty-catalog-notice">
                                Non ci sono ancora classi nel catalogo di questa campagna, e il manuale precaricato non
                                è (ancora) disponibile. Scrivi il nome a mano: potrai aggiungerla al catalogo dalla
                                pagina Classi.
                            </div>
                            <div class="field">
                                <label>Nome classe <span class="req">*</span></label>
                                <input type="text" class="input" maxlength="60" placeholder="Es. Guerriero, Mago..."
                                       @bind="draft.Class" @bind:event="oninput" @bind:after="OnClassChanged" />
                            </div>
                        }
                        else
                        {
                            <div class="field">
                                <label>Classe <span class="req">*</span></label>
                                <select class="input" value="@CurrentClassSelection" @onchange="OnClassSelectionChanged">
                                    <option value="">-- Seleziona --</option>
                                    @foreach (var name in AllClassNames)
                                    {
                                        <option value="@name">@name</option>
                                    }
                                    <option value="@CustomOptionValue">Altro (scrivi a mano)</option>
                                </select>
                                @if (isClassCustom)
                                {
                                    @* Anche il testo libero rivaluta la sottoclasse: scrivendo il nome di
                                       una classe del manuale il campo sottoclasse diventa un menu, e senza
                                       questo resterebbe dentro il valore di prima — invisibile e salvabile. *@
                                    <input type="text" class="input custom-input" maxlength="60"
                                           placeholder="Scrivi la classe" @bind="draft.Class" @bind:event="oninput"
                                           @bind:after="OnClassChanged" />
                                }
                            </div>

                            <div class="field">
                                <label>Sottoclasse <span class="wiz-optional">(facoltativa)</span></label>
                                @if (SottoclassiDisponibili.Count > 0)
                                {
                                    <select class="input" value="@CurrentSubclassSelection" @onchange="OnSubclassSelectionChanged">
                                        <option value="">-- Nessuna --</option>
                                        @foreach (var s in SottoclassiDisponibili)
                                        {
                                            <option value="@s.Name">@s.Name</option>
                                        }
                                        <option value="@CustomOptionValue">Altro (scrivi a mano)</option>
                                    </select>
                                    @if (isSubclassCustom)
                                    {
                                        <input type="text" class="input custom-input" maxlength="60"
                                               placeholder="Scrivi la sottoclasse"
                                               @bind="draft.Subclass" @bind:event="oninput" />
                                    }

                                    @if (SottoclasseScelta is not null)
                                    {
                                        var primo = SubclassCatalog.PrimoLivello(SottoclasseScelta);
                                        var acquisiti = SubclassCatalog.PrivilegiFinoAl(SottoclasseScelta, draft.Level);
                                        <div class="info-summary">
                                            @if (acquisiti.Count > 0)
                                            {
                                                <p>
                                                    <strong>Al livello @draft.Level dà:</strong>
                                                    @string.Join(", ", acquisiti.SelectMany(r => r.Privilegi))
                                                </p>
                                            }
                                            else if (primo is not null)
                                            {
                                                <p>Comincia a dare privilegi al <strong>livello @primo</strong>.</p>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    @* Nessuna sottoclasse a catalogo per questa classe: resta il testo libero,
                                       che è anche il modo di usarne una scritta dal proprio tavolo. *@
                                    <input type="text" class="input" maxlength="60"
                                           placeholder="es. Cammino del berserker, Campione..." @bind="draft.Subclass" />
                                }
                            </div>

                            @if (SelectedClassDb is not null)
                            {
                                <div class="info-summary">
                                    <p><strong>Dado vita:</strong> @(string.IsNullOrEmpty(SelectedClassDb.HitDie) ? "—" : SelectedClassDb.HitDie)</p>
                                    @if (!string.IsNullOrWhiteSpace(SelectedClassDb.PrimaryAbility))
                                    {
                                        <p><strong>Caratteristica principale:</strong> @SelectedClassDb.PrimaryAbility</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(SelectedClassDb.SavingThrows))
                                    {
                                        <p><strong>Tiri salvezza competenti:</strong> @SelectedClassDb.SavingThrows</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(SelectedClassDb.ArmorProficiencies))
                                    {
                                        <p><strong>Armature:</strong> @SelectedClassDb.ArmorProficiencies</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(SelectedClassDb.WeaponProficiencies))
                                    {
                                        <p><strong>Armi:</strong> @SelectedClassDb.WeaponProficiencies</p>
                                    }
                                </div>
                            }
                            else if (SelectedClassPackage is not null)
                            {
                                <div class="info-summary">
                                    <p><strong>Dado vita:</strong> @(string.IsNullOrEmpty(SelectedClassPackage.HitDie) ? "—" : SelectedClassPackage.HitDie)</p>
                                    @if (!string.IsNullOrWhiteSpace(SelectedClassPackage.PrimaryAbility))
                                    {
                                        <p><strong>Caratteristica principale:</strong> @SelectedClassPackage.PrimaryAbility</p>
                                    }
                                    @if (SelectedClassPackage.SavingThrows.Count > 0)
                                    {
                                        <p><strong>Tiri salvezza competenti:</strong> @string.Join(", ", SelectedClassPackage.SavingThrows)</p>
                                    }
                                </div>
                            }
                            <p class="field-hint">I tiri salvezza competenti verranno impostati automaticamente in base alla classe: non serve sceglierli qui.</p>
                        }

                        <div class="field">
                            <label>Livello</label>
                            <input type="number" class="input" min="1" max="20" @bind="draft.Level" />
                            <span class="field-hint">
                                Quasi sempre si inizia dal livello 1. Se scrivi un livello più alto — per entrare in una
                                campagna già avviata — compare un passo in più, "Progressione", che guida sottoclasse,
                                talenti e punti ferita dal 2° livello in su fino a qui.
                            </span>
                        </div>

                        <div class="sub-block">
                            <p class="sub-block-title">COMPETENZE ABILITÀ</p>
                            @if (VincoloAbilitaClasse is { } vincolo)
                            {
                                <p class="field-hint">La classe scelta permette di sceglierne @vincolo.Quante fra queste.</p>
                                <p class="skill-picker-count @(EsitoAbilita.Completa ? "" : "incomplete")">
                                    @scelteAbilita.Count di @vincolo.Quante scelte
                                </p>
                                <div class="skill-picker">
                                    @foreach (var s in vincolo.Fra)
                                    {
                                        var scelta = scelteAbilita.Contains(s);
                                        var concessa = ConcesseAttuali.Contains(s);
                                        var bloccata = !scelta && scelteAbilita.Count >= vincolo.Quante;
                                        <label class="skill-pick-row @(scelta ? "checked" : "") @(bloccata ? "disabled" : "")">
                                            <input type="checkbox" checked="@scelta" disabled="@bloccata"
                                                   @onchange="e => ToggleAbilitaScelta(s, e.Value is bool b && b)" />
                                            <span class="skill-pick-name">@SkillCatalog.Nome(s)</span>
                                            @if (concessa)
                                            {
                                                <span class="skill-pick-badge">dal background</span>
                                            }
                                        </label>
                                    }
                                </div>
                                @if (EsitoAbilita.Messaggio is not null)
                                {
                                    <p class="skill-pick-hint @(EsitoAbilita.Completa ? "warn" : "error")">@EsitoAbilita.Messaggio</p>
                                }
                            }
                            else
                            {
                                <p class="field-hint">
                                    @if (!string.IsNullOrWhiteSpace(SuggerimentoAbilitaLibere))
                                    {
                                        <text>Questa classe non ha un elenco vincolato che riconosciamo: scegli
                                        liberamente. La classe suggerisce @SuggerimentoAbilitaLibere.</text>
                                    }
                                    else
                                    {
                                        <text>Scegli liberamente le competenze del personaggio.</text>
                                    }
                                </p>
                                <div class="skill-picker">
                                    @foreach (var s in SkillCatalog.Tutte)
                                    {
                                        var scelta = scelteAbilita.Contains(s);
                                        var concessa = ConcesseAttuali.Contains(s);
                                        @* MINORE 9 del gate del 2026-08-06: qui, senza un vincolo N-su-M da
                                           contare, la casella è l'UNICA rappresentazione della competenza —
                                           una concessa dal background deve apparire spuntata (checked="@scelta"
                                           da solo la mostrava vuota anche se già vera sul draft), a differenza
                                           del ramo vincolato sopra dove scelte e concesse restano
                                           deliberatamente separate per il conteggio.
                                           SERIO del secondo giro dello stesso gate, esteso al terzo giro: una
                                           competenza concessa dal background non è MAI revocabile da questo
                                           picker, che l'utente l'abbia scelta lei stessa o no — ApplicaCompetenze
                                           la lascia comunque dentro via ConcesseAttuali qualunque cosa contenga
                                           scelteAbilita. Vale quindi per due casi, non uno solo: (a) concessa e
                                           mai scelta di suo, e (b) concessa DOPO che l'utente l'aveva già scelta
                                           di suo (spunta Atletica al passo Classe, poi background che la concede
                                           anche lui, poi si torna indietro al passo Classe: qui scelta==true E
                                           concessa==true insieme). In entrambi, togliere la spunta non la rende
                                           mai non competente — quindi checked="@(scelta || concessa)" torna a
                                           valere true al render successivo, un valore IDENTICO a quello di prima
                                           del click: Blazor non vede differenze da propagare al DOM (né qui né
                                           sulla classe della label, stessa espressione) e la casella resta
                                           visivamente vuota mentre il personaggio nasce comunque competente. La
                                           disabilitazione va quindi legata SOLO a concessa, non a "concessa e
                                           basta questa": disabled la rende non toccabile, col badge a spiegare
                                           perché — niente click, niente divergenza DOM/modello da mascherare con
                                           un @key. *@
                                        <label class="skill-pick-row @(scelta || concessa ? "checked" : "") @(concessa ? "disabled" : "")">
                                            <input type="checkbox" checked="@(scelta || concessa)" disabled="@concessa"
                                                   @onchange="e => ToggleAbilitaScelta(s, e.Value is bool b && b)" />
                                            <span class="skill-pick-name">@SkillCatalog.Nome(s)</span>
                                            @if (concessa)
                                            {
                                                <span class="skill-pick-badge">dal background</span>
                                            }
                                        </label>
                                    }
                                </div>
                                @* Valida prevede il messaggio di sovrapposizione anche con vincolo null:
                                   qui non c'era il blocco che lo mostrava (MINORE 9). *@
                                @if (EsitoAbilita.Messaggio is not null)
                                {
                                    <p class="skill-pick-hint warn">@EsitoAbilita.Messaggio</p>
                                }
                            }
                        </div>
                    </div>
                    break;

                case WizardStepKind.Background:
                    @* ===================== BACKGROUND ===================== *@
                    <div class="wiz-step">
                        <div class="help-box">
                            Il <strong>background</strong> racconta cosa faceva il personaggio prima di diventare
                            avventuriero (soldato, criminale, sapiente...). Concede bonus a due o tre caratteristiche,
                            competenze in alcune abilità e, a volte, uno strumento. È facoltativo: puoi anche
                            proseguire senza sceglierne uno.
                        </div>

                        @if (AllBackgroundNames.Count == 0)
                        {
                            <div class="empty-catalog-notice">
                                Non ci sono ancora background nel catalogo di questa campagna, e il manuale precaricato
                                non è (ancora) disponibile. Scrivi il nome a mano (niente bonus automatici) oppure
                                lascia il campo vuoto e prosegui.
                            </div>
                            <div class="field">
                                <label>Nome background <span class="wiz-optional">(facoltativo)</span></label>
                                <input type="text" class="input" maxlength="60" placeholder="Es. Soldato, Criminale..."
                                       @bind="draft.Background" @bind:event="oninput" @bind:after="OnBackgroundChanged" />
                            </div>
                        }
                        else
                        {
                            <div class="field">
                                <label>Background <span class="wiz-optional">(facoltativo)</span></label>
                                <select class="input" value="@CurrentBackgroundSelection" @onchange="OnBackgroundSelectionChanged">
                                    <option value="">-- Nessuno --</option>
                                    @foreach (var name in AllBackgroundNames)
                                    {
                                        <option value="@name">@name</option>
                                    }
                                    <option value="@CustomOptionValue">Altro (scrivi a mano)</option>
                                </select>
                                @if (isBackgroundCustom)
                                {
                                    <input type="text" class="input custom-input" maxlength="60"
                                           placeholder="Scrivi il background" @bind="draft.Background" @bind:event="oninput"
                                           @bind:after="OnBackgroundChanged" />
                                    <p class="field-hint">Un background scritto a mano non concede bonus automatici alle caratteristiche.</p>
                                }
                                @* I quattro dello SRD sono pochi e la reazione naturale è pensare a un
                                   caricamento incompleto: meglio dirlo qui, dove si nota. *@
                                <p class="field-hint">
                                    Il manuale libero (SRD 5.2.1) ne contiene quattro. Gli altri del Manuale del
                                    Giocatore non sono ridistribuibili: aggiungili dalla pagina Background, o scegli
                                    «Altro» e scrivilo a mano.
                                </p>
                            </div>

                            @if (SelectedBackgroundDb is not null)
                            {
                                <div class="info-summary">
                                    @if (!string.IsNullOrWhiteSpace(SelectedBackgroundDb.Description))
                                    {
                                        <p>@SelectedBackgroundDb.Description</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(SelectedBackgroundDb.AbilityScores))
                                    {
                                        <p><strong>Caratteristiche:</strong> @SelectedBackgroundDb.AbilityScores</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(SelectedBackgroundDb.SkillProficiencies))
                                    {
                                        <p><strong>Competenze abilità:</strong> @SelectedBackgroundDb.SkillProficiencies</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(SelectedBackgroundDb.ToolProficiency))
                                    {
                                        <p><strong>Strumento:</strong> @SelectedBackgroundDb.ToolProficiency</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(SelectedBackgroundDb.OriginFeat))
                                    {
                                        <p><strong>Talento d'origine:</strong> @SelectedBackgroundDb.OriginFeat</p>
                                    }
                                </div>
                            }
                            else if (SelectedBackgroundPackage is not null)
                            {
                                <div class="info-summary">
                                    @if (!string.IsNullOrWhiteSpace(SelectedBackgroundPackage.Description))
                                    {
                                        <p>@SelectedBackgroundPackage.Description</p>
                                    }
                                    @if (SelectedBackgroundPackage.AbilityScores.Count > 0)
                                    {
                                        <p><strong>Caratteristiche:</strong> @string.Join(", ", SelectedBackgroundPackage.AbilityScores)</p>
                                    }
                                    @if (SelectedBackgroundPackage.SkillProficiencies.Count > 0)
                                    {
                                        <p><strong>Competenze abilità:</strong> @string.Join(", ", SelectedBackgroundPackage.SkillProficiencies)</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(SelectedBackgroundPackage.ToolProficiency))
                                    {
                                        <p><strong>Strumento:</strong> @SelectedBackgroundPackage.ToolProficiency</p>
                                    }
                                </div>
                            }
                            <p class="field-hint">La ripartizione dei bonus alle caratteristiche si sceglie al passo successivo.</p>
                        }
                    </div>
                    break;

                case WizardStepKind.Caratteristiche:
                    @* ===================== CARATTERISTICHE ===================== *@
                    <div class="wiz-step">
                        <div class="help-box">
                            Le <strong>sei caratteristiche</strong> misurano le capacità innate del personaggio. Ciò
                            che conta davvero nei tiri di dado è il <strong>modificatore</strong> (tra parentesi): più
                            alto il punteggio, più alto il modificatore. La Costituzione, in particolare, incide sui
                            punti ferita.
                        </div>

                        <div class="method-tabs">
                            <button type="button" class="method-tab @(abilityMethod == CharacterWizardLogic.AbilityScoreMethod.StandardArray ? "active" : "")"
                                    @onclick="() => SetMethod(CharacterWizardLogic.AbilityScoreMethod.StandardArray)">
                                Array standard
                            </button>
                            <button type="button" class="method-tab @(abilityMethod == CharacterWizardLogic.AbilityScoreMethod.PointBuy ? "active" : "")"
                                    @onclick="() => SetMethod(CharacterWizardLogic.AbilityScoreMethod.PointBuy)">
                                Acquisto punti
                            </button>
                            <button type="button" class="method-tab @(abilityMethod == CharacterWizardLogic.AbilityScoreMethod.Roll ? "active" : "")"
                                    @onclick="() => SetMethod(CharacterWizardLogic.AbilityScoreMethod.Roll)">
                                Tiro dei dadi
                            </button>
                        </div>

                        @if (abilityMethod == CharacterWizardLogic.AbilityScoreMethod.StandardArray)
                        {
                            <p class="field-hint">
                                Assegna questi sei valori (@string.Join(", ", CharacterWizardLogic.StandardArrayScores)),
                                uno per caratteristica: scegli tu quale numero va dove.
                            </p>
                            <button type="button" class="secondary-btn wiz-array-btn" @onclick="ResetStandardArray">
                                Assegna nell'ordine consigliato
                            </button>
                            @for (var i = 0; i < 6; i++)
                            {
                                var idx = i;
                                <div class="wiz-simple-row">
                                    <span class="wiz-ability-name">@AbilityShort[idx]</span>
                                    <select class="input wiz-simple-select" value="@baseScores[idx]" @onchange="e => SetBaseFromSelect(idx, e)">
                                        @foreach (var v in CharacterWizardLogic.StandardArrayScores.OrderByDescending(x => x))
                                        {
                                            <option value="@v">@v</option>
                                        }
                                    </select>
                                </div>
                            }
                        }
                        else if (abilityMethod == CharacterWizardLogic.AbilityScoreMethod.PointBuy)
                        {
                            <p class="field-hint">Hai @CharacterWizardLogic.PointBuyBudget punti da spendere. Punteggi da 8 a 15: quelli bassi costano poco, quelli alti costano molto di più.</p>
                            <p class="wiz-budget @(RemainingPoints < 0 ? "over" : "")">
                                Punti rimasti: <strong>@RemainingPoints</strong> di @CharacterWizardLogic.PointBuyBudget
                            </p>
                            @for (var i = 0; i < 6; i++)
                            {
                                var idx = i;
                                <div class="wiz-simple-row">
                                    <span class="wiz-ability-name">@AbilityShort[idx]</span>
                                    <div class="wiz-stepper">
                                        <button type="button" class="qty-btn" @onclick="() => DecPointBuy(idx)" aria-label="Diminuisci">−</button>
                                        <span class="wiz-simple-value">@baseScores[idx]</span>
                                        <button type="button" class="qty-btn" @onclick="() => IncPointBuy(idx)" aria-label="Aumenta">+</button>
                                    </div>
                                    <span class="wiz-cost-hint">(costo @CharacterWizardLogic.PointBuyCost(baseScores[idx]))</span>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="field-hint">Se hai tirato i dadi al tavolo (di solito 4d6, tieni i tre migliori), scrivi qui i risultati.</p>
                            @for (var i = 0; i < 6; i++)
                            {
                                var idx = i;
                                <div class="wiz-simple-row">
                                    <span class="wiz-ability-name">@AbilityShort[idx]</span>
                                    @* @key legato al valore: quando il clamp riporta l'input a un
                                       numero che il campo mostrava GIÀ (digito 50 su un 30 clampato),
                                       il valore reso non cambia, Blazor non riscrive l'attributo e a
                                       schermo resterebbe 50 mentre il PG viene salvato con 30. La
                                       chiave forza la ricreazione dell'elemento. *@
                                    @* La chiave dipende SOLO dal contatore, non dal valore: se
                                       cambiasse a ogni modifica, l'input verrebbe ricreato anche
                                       premendo le frecce dello spinner e perderebbe il fuoco dopo
                                       il primo scatto. Il contatore avanza solo quando il valore
                                       accettato differisce da quanto digitato — è lì che il DOM
                                       resterebbe indietro. *@
                                    <input type="number" class="input wiz-simple-input" min="1" max="30"
                                           @key="@($"roll-{idx}-{rollRenderTick}")"
                                           value="@baseScores[idx]" @onchange="e => SetRollScore(idx, e)" />
                                </div>
                            }
                        }

                        <div class="wiz-ability-head"><span>Car.</span><span>Base</span><span>Bonus</span><span>Totale</span></div>
                        @for (var i = 0; i < 6; i++)
                        {
                            var idx = i;
                            <div class="wiz-ability-row">
                                <span class="wiz-ability-name">@AbilityShort[idx]</span>
                                <span>@baseScores[idx]</span>
                                <span class="wiz-ability-bonus">@FormatBonus(BonusForIndex(idx))</span>
                                <span class="wiz-ability-total">@FinalScores[idx] <small>(@FormatBonus(CharacterCalculations.GetModifier(FinalScores[idx])))</small></span>
                            </div>
                        }

                        <div class="sub-block">
                            <p class="sub-block-title">BONUS DAL BACKGROUND</p>
                            @if (!HasSelectedBackground)
                            {
                                <p class="field-hint">Non hai scelto un background: nessun bonus aggiuntivo alle caratteristiche.</p>
                            }
                            else if (BgKeys.Count == 0)
                            {
                                <p class="field-hint">Il background scritto a mano non concede bonus alle caratteristiche.</p>
                            }
                            else if (!BgBonusesApply)
                            {
                                <p class="field-hint">La specie scelta porta già bonus propri (versione 2014): il background non ne aggiunge altri.</p>
                            }
                            else
                            {
                                <div class="split-tabs">
                                    <button type="button" class="method-tab @(EffectiveSplit == CharacterWizardLogic.BackgroundAbilitySplit.TwoAndOne ? "active" : "")"
                                            @onclick="() => bgSplit = CharacterWizardLogic.BackgroundAbilitySplit.TwoAndOne">
                                        Due caratteristiche: +2 e +1
                                    </button>
                                    <button type="button" class="method-tab @(EffectiveSplit == CharacterWizardLogic.BackgroundAbilitySplit.OneEachOfThree ? "active" : "")"
                                            @onclick="() => bgSplit = CharacterWizardLogic.BackgroundAbilitySplit.OneEachOfThree">
                                        Tutte e tre: +1 ciascuna
                                    </button>
                                </div>

                                @if (EffectiveSplit == CharacterWizardLogic.BackgroundAbilitySplit.TwoAndOne)
                                {
                                    <div class="field">
                                        <label>Riceve +2</label>
                                        <select class="input" value="@EffectiveTwoBonusAbility" @onchange="e => twoBonusAbility = e.Value?.ToString()">
                                            @foreach (var k in BgKeys)
                                            {
                                                <option value="@k">@AbilityItalian[k]</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="field">
                                        <label>Riceve +1</label>
                                        <select class="input" value="@EffectiveOneBonusAbility" @onchange="e => oneBonusAbility = e.Value?.ToString()">
                                            @foreach (var k in BgKeys.Where(k => k != EffectiveTwoBonusAbility))
                                            {
                                                <option value="@k">@AbilityItalian[k]</option>
                                            }
                                        </select>
                                    </div>
                                }
                                else
                                {
                                    <p class="field-hint">+1 a @string.Join(", ", BgKeys.Select(k => AbilityItalian[k]))</p>
                                }
                            }
                        </div>
                        <p class="field-hint">Il tetto dei bonus di background è 20; il limite assoluto di ogni caratteristica resta 30.</p>
                    </div>
                    break;

                case WizardStepKind.Progressione:
                    @* ===================== PROGRESSIONE (2026-08-06) =====================
                       Entra in scena solo se il livello richiesto (draft.Level) è oltre il 1°: chi
                       crea un PG nuovo non attraversa questo passo. Lo stato che guida tutto qui è
                       (baseline, risposte per livello, tiri per livello) — mai un personaggio
                       mutato progressivamente: EsitoProgressione rifà il fold da capo a ogni
                       render, leggendo esattamente quello stato (§B della spec). *@
                    <div class="wiz-step">
                        <div class="help-box">
                            Il personaggio nasce già al <strong>livello @draft.Level</strong>: qui sono le tappe dal
                            2° livello in su. Le tappe senza nulla da decidere si confermano da sole con la media del
                            dado (puoi comunque scegliere di tirare); quelle con sottoclasse, talento o incremento di
                            caratteristica si aprono con "Scegli".
                        </div>

                        @if (ClasseSenzaTabella)
                        {
                            <div class="empty-catalog-notice">
                                Questa classe non ha una tabella dei livelli: non possiamo derivare la progressione in
                                automatico. I punti ferita nel passo Dettagli restano una stima, e sottoclasse,
                                talenti e competenze dei livelli successivi vanno compilati a mano dalla scheda dopo
                                la creazione.
                            </div>
                        }
                        else
                        {
                            var esito = EsitoProgressione;
                            <p class="prog-title">Progressione — dal 1° al @draft.Level°</p>

                            <div class="prog-list">
                                @foreach (var tappa in esito.Tappe)
                                {
                                    var stato = CharacterWizardLogic.StatoDiTappa(tappa);
                                    var espansa = livelloEspanso == tappa.Livello;
                                    var confermata = stato == CharacterWizardLogic.StatoTappa.Confermata;
                                    <div class="prog-row @(espansa ? "prog-row-open" : "")">
                                        <div class="prog-row-head">
                                            <span class="prog-row-liv">Liv. @tappa.Livello</span>
                                            @* SERIO 2 del gate del 2026-08-06, MINORE 11: il glifo ripete uno
                                               stato già scritto nel testo adiacente — nessun equivalente
                                               testuale proprio, quindi aria-hidden invece di farlo annunciare
                                               due volte (o come glifo senza senso) da un lettore di schermo. *@
                                            <span class="prog-row-icon prog-stato-@stato.ToString().ToLowerInvariant()" aria-hidden="true">
                                                @(stato switch
                                                {
                                                    CharacterWizardLogic.StatoTappa.Confermata => "✓",
                                                    CharacterWizardLogic.StatoTappa.RichiedeScelte => "⚠",
                                                    _ => "◇"
                                                })
                                            </span>
                                            <span class="prog-row-testo">
                                                @* MINORE 3 del secondo giro del gate del 2026-08-06: la risposta già
                                                   data va passata anche qui, non solo a RiepilogoConfermata — una
                                                   tappa può restare "richiede scelte" perché una decisione FIGLIA è
                                                   ancora aperta mentre quella che l'ha generata (il talento scelto)
                                                   ha già risposta, e senza le risposte di livello la riga la
                                                   riproponeva come "da fare" insieme a quella davvero aperta. *@
                                                @(confermata
                                                    ? RiepilogoConfermata(tappa)
                                                    : CharacterWizardLogic.RiepilogoScelte(tappa, RisposteDiLivello(tappa.Livello)))
                                            </span>

                                            @* SERIO 2 del gate del 2026-08-06: la select del tiro sta SEMPRE
                                               qui, non solo per le tappe confermate — D7 chiede un tiro per
                                               livello indipendente dagli altri, e un livello con una decisione
                                               ancora aperta o facoltativa (il 3°, il 4°, le invocazioni di un
                                               Warlock) merita lo stesso tiro di uno confermato. *@
                                            <select class="prog-dado-select"
                                                    aria-label="@($"Livello {tappa.Livello}: punti ferita, media o tiro manuale")"
                                                    value="@(TiroManuale(tappa.Livello) ? "manuale" : "media")"
                                                    @onchange="e => ImpostaModoTiro(tappa.Livello, tappa.Piano, e)">
                                                <option value="media">media</option>
                                                <option value="manuale">ho tirato</option>
                                            </select>

                                            @* Accanto alla select, non in alternativa: senza questo pulsante
                                               una tappa già risposta (Confermata perché la sua decisione è
                                               risolta, non perché non ce ne fossero) non aveva più alcun modo
                                               di riaprirsi — l'unica via era cambiare classe, che azzera tutto.
                                               Compare ogni volta che la tappa porta almeno una decisione,
                                               risposta o no. *@
                                            @if (tappa.Piano.Decisioni.Count > 0)
                                            {
                                                <button type="button" class="prog-scegli-btn" @onclick="() => ToggleLivello(tappa.Livello)">
                                                    @(espansa ? "Chiudi" : "Scegli")
                                                </button>
                                            }
                                        </div>

                                        @if (TiroManuale(tappa.Livello))
                                        {
                                            var facceMax = CharacterWizardLogic.FacceMax(tappa.Piano.MediaDado);
                                            var tiroCorrente = tiriProgressione.TryGetValue(tappa.Livello, out var t) ? t : tappa.Piano.MediaDado;
                                            var troncato = Math.Clamp(tiroCorrente, 1, facceMax);
                                            <div class="prog-dado-row">
                                                <input type="number" class="prog-dado-input" min="1" max="@facceMax"
                                                       aria-label="@($"Livello {tappa.Livello}: valore del tiro")"
                                                       @key="@($"tiro-{tappa.Livello}-{TiroChiaveVersione(tappa.Livello)}")"
                                                       value="@troncato" @onchange="e => CambiaTiro(tappa.Livello, e, facceMax)" />
                                                <span class="prog-dado-max">/@facceMax</span>
                                            </div>
                                        }

                                        @if (espansa)
                                        {
                                            <div class="prog-row-body">
                                                @foreach (var decisione in tappa.Piano.Decisioni)
                                                {
                                                    @if (decisione is DecisioneFraOpzioni opzioni)
                                                    {
                                                        var scelteCorrenti = RisposteDiLivello(tappa.Livello).TryGetValue(opzioni.Chiave, out var rOpz)
                                                            ? rOpz.Scelte : Array.Empty<string>();
                                                        <div class="prog-decision">
                                                            <p class="prog-decision-title">@opzioni.Titolo</p>
                                                            @if (opzioni.Opzioni.Count == 0)
                                                            {
                                                                <p class="field-hint">Nessuna opzione a catalogo per questa scelta.</p>
                                                            }
                                                            @foreach (var opzione in opzioni.Opzioni)
                                                            {
                                                                var selezionata = scelteCorrenti.Contains(opzione.Nome);
                                                                var bloccata = !selezionata && opzioni.Quante > 1 && scelteCorrenti.Count >= opzioni.Quante;
                                                                var descKey = $"{opzioni.Chiave}|{opzione.Nome}";
                                                                var descEspansa = descrizioniEspanse.Contains(descKey);
                                                                <div class="prog-option @(selezionata ? "prog-option-selected" : "")">
                                                                    <button type="button" class="prog-option-select" disabled="@bloccata"
                                                                            @onclick="() => ScegliOpzione(tappa.Livello, opzioni, opzione.Nome)">
                                                                        <span class="prog-option-check">@(selezionata ? "●" : "○")</span>
                                                                        <span class="prog-option-name">@opzione.Nome</span>
                                                                    </button>
                                                                    @if (!string.IsNullOrWhiteSpace(opzione.Descrizione))
                                                                    {
                                                                        <p class="prog-option-desc">
                                                                            @(descEspansa ? opzione.Descrizione : CharacterWizardLogic.TroncaDescrizione(opzione.Descrizione))
                                                                        </p>
                                                                        @if (opzione.Descrizione.Length > CharacterWizardLogic.DescrizioneTroncamentoSoglia)
                                                                        {
                                                                            <button type="button" class="prog-option-expand" @onclick="() => ToggleDescrizione(descKey)">
                                                                                @(descEspansa ? "Comprimi ▴" : "Espandi ▾")
                                                                            </button>
                                                                        }
                                                                    }
                                                                </div>
                                                            }
                                                            @if (opzioni.Quante > 1)
                                                            {
                                                                <p class="field-hint">Scegli fino a @opzioni.Quante.</p>
                                                            }
                                                        </div>
                                                    }
                                                    else if (decisione is DecisionePunteggi punteggi)
                                                    {
                                                        var correnti = RisposteDiLivello(tappa.Livello).TryGetValue(punteggi.Chiave, out var rPunt)
                                                            ? rPunt.Punteggi : new Dictionary<string, int>();
                                                        var totale = correnti.Values.Sum();
                                                        <div class="prog-decision">
                                                            <p class="prog-decision-title">@punteggi.Titolo</p>
                                                            <p class="field-hint">Somma esattamente 2: +2 a una sola oppure +1 a due.</p>
                                                            @foreach (var (chiaveCar, sigla, nome) in CaratteristichePerPunteggi)
                                                            {
                                                                var valore = correnti.TryGetValue(chiaveCar, out var v) ? v : 0;
                                                                var attuale = punteggi.PunteggiAttuali.TryGetValue(chiaveCar, out var pa) ? pa : 10;
                                                                var proposto = attuale + valore;
                                                                var alTetto = proposto >= 20;
                                                                <div class="prog-score-row">
                                                                    <span class="prog-score-name" title="@nome">@sigla</span>
                                                                    <button type="button" class="qty-btn" disabled="@(valore <= 0)"
                                                                            aria-label="Togli a @nome"
                                                                            @onclick="() => VariaPunteggio(tappa.Livello, punteggi.Chiave, chiaveCar, -1)">−</button>
                                                                    <span class="prog-score-value">
                                                                        @attuale
                                                                        @if (valore > 0)
                                                                        {
                                                                            <text> → </text><strong>@proposto</strong>
                                                                        }
                                                                    </span>
                                                                    <button type="button" class="qty-btn" disabled="@(totale >= 2 || alTetto)"
                                                                            aria-label="Aggiungi a @nome"
                                                                            @onclick="() => VariaPunteggio(tappa.Livello, punteggi.Chiave, chiaveCar, 1)">+</button>
                                                                </div>
                                                            }
                                                            <p class="field-hint">Assegnati: @totale/2</p>
                                                        </div>
                                                    }
                                                    else if (decisione is DecisioneLibera libera)
                                                    {
                                                        var testoAttuale = RisposteDiLivello(tappa.Livello).TryGetValue(libera.Chiave, out var rLib)
                                                            ? rLib.Testo : string.Empty;
                                                        <div class="prog-decision">
                                                            <p class="prog-decision-title">@libera.Titolo</p>
                                                            <p class="field-hint">@libera.Avviso</p>
                                                            <textarea class="input" rows="3" placeholder="Annota qui la tua scelta (facoltativo)"
                                                                      value="@testoAttuale"
                                                                      @onchange="e => ImpostaTestoLibero(tappa.Livello, libera.Chiave, e.Value?.ToString() ?? string.Empty)"></textarea>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="prog-footer">
                                <span>PF totali: <strong>@esito.Personaggio.MaxHitPoints</strong></span>
                                @{ var restanti = CharacterWizardLogic.ScelteRestanti(esito.Tappe); }
                                @if (restanti > 0)
                                {
                                    <span class="prog-footer-warn">@restanti @(restanti == 1 ? "scelta da fare" : "scelte da fare")</span>
                                }
                                else
                                {
                                    <span class="prog-footer-ok">Tutte le scelte fatte</span>
                                }
                            </div>

                            @if (esito.Avvisi.Count > 0)
                            {
                                <div class="prog-avvisi">
                                    @foreach (var avviso in esito.Avvisi)
                                    {
                                        <p class="skill-pick-hint warn">⚠ @avviso</p>
                                    }
                                </div>
                            }
                        }
                    </div>
                    break;

                case WizardStepKind.Dettagli:
                    @* ===================== DETTAGLI ===================== *@
                    <div class="wiz-step">
                        <div class="help-box">
                            Solo il <strong>nome</strong> è davvero obbligatorio: il resto puoi sempre cambiarlo dopo,
                            dalla scheda del personaggio. Qui trovi già dei valori suggeriti in base a classe e
                            caratteristiche.
                        </div>

                        <div class="field">
                            <label>Nome <span class="req">*</span></label>
                            <input type="text" class="input" maxlength="64" @bind="draft.Name" @bind:event="oninput" />
                        </div>

                        <div class="field">
                            <label>Allineamento <span class="wiz-optional">(facoltativo)</span></label>
                            <select class="input" @bind="draft.Alignment">
                                <option value="">-- Nessuno --</option>
                                <option value="Legale Buono">Legale Buono</option>
                                <option value="Neutrale Buono">Neutrale Buono</option>
                                <option value="Caotico Buono">Caotico Buono</option>
                                <option value="Legale Neutrale">Legale Neutrale</option>
                                <option value="Neutrale Puro">Neutrale Puro</option>
                                <option value="Caotico Neutrale">Caotico Neutrale</option>
                                <option value="Legale Malvagio">Legale Malvagio</option>
                                <option value="Neutrale Malvagio">Neutrale Malvagio</option>
                                <option value="Caotico Malvagio">Caotico Malvagio</option>
                            </select>
                        </div>

                        <div class="field">
                            <label>Classe Armatura</label>
                            <div class="wiz-hp-row">
                                <input type="number" class="input" min="0" max="40" @bind="draft.ArmorClass" />
                                <button type="button" class="secondary-btn wiz-suggest-btn" @onclick="UseSuggestedAc">
                                    Usa suggerita (@SuggestedAc)
                                </button>
                            </div>
                            <span class="field-hint">Suggerita = 10 + modificatore Destrezza (nessuna armatura indossata).</span>
                        </div>

                        @{ var anteprima = Anteprima; }
                        <div class="field">
                            <label>PF Massimi</label>
                            @if (CatenaUtile && StimaPfCalcolabile)
                            {
                                <div class="wiz-hp-row">
                                    <input type="number" class="input" min="1" value="@anteprima.MaxHitPoints" disabled />
                                </div>
                                <span class="field-hint">
                                    Calcolati dal passo Progressione per il livello @anteprima.Level: per cambiare un
                                    tiro di dado torna là. I PF correnti partiranno uguali ai massimi.
                                </span>
                            }
                            else if (CatenaUtile)
                            {
                                @* BLOCCANTE del gate del 2026-08-06: qui il dado vita della classe non si
                                   riconosce (campo vuoto, o testo che ParseDieSize non capisce) — il fold ha
                                   già dovuto ripiegare sulla stima generica "d8" (lo stesso avviso visibile al
                                   passo Progressione: "Dado vita non riconosciuto: uso d8 come stima."), quindi
                                   il numero è inventato quanto quello di una classe senza tabella. Un campo
                                   disabilitato che lo mostrasse come "calcolato dalle regole" sarebbe peggio di
                                   un campo libero: qui torna editabile, come per la classe senza tabella (§E
                                   della spec).
                                   Il campo mostra e scrive il SEED di 1° livello (v. PfSeedDettagliMostrato e
                                   pfBaselineManuale), non il totale al livello corrente — prima di questa
                                   correzione mostrava il totale (anteprima.MaxHitPoints) ma scriveva il seed,
                                   quindi il valore digitato non convergeva mai al totale promesso. Sopra il
                                   seed gira infatti il fold di CreationChain, che per ogni livello 2→N somma la
                                   crescita di LevelUpPlanner (guadagno sempre >= 1 PF): il totale al livello N è
                                   perciò SEMPRE strettamente maggiore del seed, e non esiste un calcolo inverso
                                   che tolga quella crescita da un totale digitato per ricavarne il seed. La sola
                                   grandezza che il campo può mostrare e scrivere insieme, senza divergere da un
                                   render all'altro, è quindi il seed — il totale resta visibile, in sola
                                   lettura, nel field-hint sotto. Il valore scritto sostituisce comunque la
                                   stima ovunque il wizard la usa — Progressione, Riepilogo, salvataggio —
                                   perché rientra in AssemblaBaseline come seed di 1° livello (v.
                                   CharacterWizardLogic.AssemblaBaseline). *@
                                <div class="wiz-hp-row">
                                    <input type="number" class="input" min="1"
                                           @key="@($"pf-manuale-{pfManualeRenderTick}")"
                                           value="@PfSeedDettagliMostrato" @onchange="ImpostaPfManuale" />
                                </div>
                                <span class="field-hint">
                                    Il dado vita di questa classe non è riconosciuto: la progressione usa una stima
                                    generica (d8) invece del dado vero. Il numero qui è il valore di <strong>1°
                                    livello</strong>, non il totale: la progressione ci somma sopra la crescita dei
                                    livelli successivi. Al livello attuale (@anteprima.Level) il totale risultante
                                    è <strong>@anteprima.MaxHitPoints</strong> PF. I PF correnti partiranno uguali
                                    ai massimi.
                                </span>
                            }
                            else
                            {
                                <div class="wiz-hp-row">
                                    <input type="number" class="input" min="1" @bind="draft.MaxHitPoints" />
                                    @if (SuggestedHp > 0)
                                    {
                                        <button type="button" class="secondary-btn wiz-suggest-btn" @onclick="UseSuggestedHp">
                                            Usa suggeriti (@SuggestedHp)
                                        </button>
                                    }
                                </div>
                                <span class="field-hint">I PF correnti partiranno uguali ai massimi.</span>
                            }
                        </div>

                        <div class="field">
                            <label>Dadi Vita</label>
                            @if (CatenaUtile)
                            {
                                <div class="wiz-hp-row">
                                    <input type="text" class="input" value="@anteprima.HitDiceMax" disabled />
                                </div>
                                <span class="field-hint">Calcolati dal passo Progressione.</span>
                            }
                            else
                            {
                                <div class="wiz-hp-row">
                                    <input type="text" class="input" maxlength="40" placeholder="es. 1d10" @bind="draft.HitDiceMax" />
                                    @if (!string.IsNullOrEmpty(SuggestedHitDice) && draft.HitDiceMax != SuggestedHitDice)
                                    {
                                        <button type="button" class="secondary-btn wiz-suggest-btn" @onclick="UseSuggestedHitDice">
                                            Usa @SuggestedHitDice
                                        </button>
                                    }
                                </div>
                                <span class="field-hint">Si consumano per recuperare PF durante un riposo breve.</span>
                            }
                        </div>

                        <div class="field">
                            <label>Velocità (m)</label>
                            <input type="number" class="input" min="0" @bind="draft.Speed" />
                            @if (RaceSpeedValue is int rs)
                            {
                                <span class="field-hint">
                                    La specie scelta indica @rs @RaceSpeedUnit.
                                    @* Stessa fonte unica usata da SpeedInMeters: deciderlo qui a
                                       mano farebbe annunciare una conversione che il pulsante non
                                       esegue (o viceversa) su un'unità fuori dalle due canoniche. *@
                                    @if (PackageRowMerge.UnitaValida(RaceSpeedUnit) == "ft")
                                    {
                                        <text> Qui si contano i metri: il pulsante converte (@rs piedi ≈ @CharacterWizardLogic.SpeedInMeters(rs, RaceSpeedUnit) metri).</text>
                                    }
                                </span>
                                <button type="button" class="secondary-btn wiz-suggest-btn" @onclick="CopyRaceSpeed">Usa questa velocità</button>
                            }
                        </div>

                        <div class="field">
                            <label>Taglia</label>
                            <select class="input" @bind="draft.Size">
                                <option value="Minuscola">Minuscola</option>
                                <option value="Piccola">Piccola</option>
                                <option value="Media">Media</option>
                                <option value="Grande">Grande</option>
                                <option value="Enorme">Enorme</option>
                                <option value="Mastodontica">Mastodontica</option>
                            </select>
                        </div>

                        <div class="field">
                            <label>Lingue <span class="wiz-optional">(facoltativo)</span></label>
                            <input type="text" class="input" maxlength="120" placeholder="es. Comune, Elfico..." @bind="draft.Languages" />
                        </div>

                        <div class="derived-info">
                            Iniziativa: <strong>@FormatBonus(CharacterCalculations.GetModifier(FinalScores[1]))</strong>
                            · Bonus competenza: <strong>@FormatBonus(CharacterCalculations.GetProficiencyBonus(draft.Level))</strong>
                        </div>
                    </div>
                    break;

                case WizardStepKind.Riepilogo:
                    @* ===================== RIEPILOGO ===================== *@
                    <div class="wiz-step">
                        <div class="help-box">
                            Ultimo sguardo prima di creare il personaggio: sarà già collegato alla specie, alla classe
                            e al background scelti. Potrai rifinire tutto il resto (aspetto, storia, denari, abilità,
                            inventario, incantesimi) dalla scheda.
                        </div>

                        @* MINORE 12 del gate del 2026-08-06: EsitoProgressione issato una volta sola,
                           come già fanno i passi Progressione e Dettagli — senza questo, il render di
                           questo passo valeva TRE fold completi (Anteprima più due accessi separati a
                           EsitoProgressione qui sotto), fino a 19 livelli × 2 Pianifica ciascuno più un
                           clone da ~90 proprietà, a ogni render. Il ricalcolo a ogni ACCESSO resta
                           deliberato (§B della spec): qui si riduce solo a un accesso per render. *@
                        @{
                            var esitoRiepilogo = EsitoProgressione;
                            var anteprimaRiepilogo = esitoRiepilogo.Personaggio;
                        }
                        @if (MostraProgressione && !ClasseSenzaTabella && !esitoRiepilogo.Completa)
                        {
                            <div class="empty-catalog-notice">
                                @esitoRiepilogo.Motivo Torna al passo Progressione per completarle: "Crea
                                personaggio" resterà bloccato finché non lo fai.
                            </div>
                        }

                        <div class="wiz-summary-card">
                            <h3 class="wiz-summary-name">@(string.IsNullOrWhiteSpace(draft.Name) ? "(senza nome)" : draft.Name)</h3>
                            <p class="wiz-summary-line">
                                Liv @anteprimaRiepilogo.Level
                                · @(string.IsNullOrWhiteSpace(draft.Class) ? "Classe —" : draft.Class)@(string.IsNullOrWhiteSpace(anteprimaRiepilogo.Subclass) ? "" : $" ({anteprimaRiepilogo.Subclass})")
                                · @(string.IsNullOrWhiteSpace(draft.Race) ? "Specie —" : draft.Race)
                            </p>
                            <p class="wiz-summary-line">
                                Background: <strong>@(string.IsNullOrWhiteSpace(draft.Background) ? "nessuno" : draft.Background)</strong>
                            </p>

                            <div class="wiz-summary-grid">
                                @{
                                    var punteggiAnteprima = new[]
                                    {
                                        anteprimaRiepilogo.Strength, anteprimaRiepilogo.Dexterity, anteprimaRiepilogo.Constitution,
                                        anteprimaRiepilogo.Intelligence, anteprimaRiepilogo.Wisdom, anteprimaRiepilogo.Charisma
                                    };
                                }
                                @for (var i = 0; i < 6; i++)
                                {
                                    var idx = i;
                                    <div class="wiz-summary-stat">
                                        <span class="wiz-summary-stat-label">@AbilityShort[idx]</span>
                                        <span class="wiz-summary-stat-val">@punteggiAnteprima[idx]</span>
                                        <span class="wiz-summary-stat-mod">@FormatBonus(CharacterCalculations.GetModifier(punteggiAnteprima[idx]))</span>
                                    </div>
                                }
                            </div>

                            <p class="wiz-summary-line">
                                CA <strong>@anteprimaRiepilogo.ArmorClass</strong>
                                · PF <strong>@anteprimaRiepilogo.MaxHitPoints</strong>
                                · Velocità <strong>@anteprimaRiepilogo.Speed m</strong>
                                @if (!string.IsNullOrWhiteSpace(anteprimaRiepilogo.HitDiceMax))
                                {
                                    <span> · Dadi vita <strong>@anteprimaRiepilogo.HitDiceMax</strong></span>
                                }
                            </p>

                            @if (HasSelectedBackground)
                            {
                                @if (BgBonusesApply)
                                {
                                    <p class="wiz-summary-line">Bonus di background applicati alle caratteristiche qui sopra.</p>
                                }
                                else if (BgKeys.Count > 0)
                                {
                                    <p class="wiz-summary-line">Bonus di background NON applicati: la specie ha già bonus propri.</p>
                                }
                            }
                        </div>

                        <p class="field-hint">Premi "Crea personaggio" per salvare. Potrai modificare qualsiasi cosa in seguito.</p>
                    </div>
                    break;
            }
        </div>

        <div class="wizard-nav">
            @if (currentStep > 0)
            {
                <button type="button" class="secondary-btn" @onclick="Prev" disabled="@isBusy">← Indietro</button>
            }
            @if (currentStep < TotalSteps - 1)
            {
                <button type="button" class="primary-btn" @onclick="Next">Avanti →</button>
            }
            else
            {
                <button type="button" class="primary-btn" @onclick="SaveAsync" disabled="@isBusy">
                    @(isBusy ? "Creazione..." : "Crea personaggio")
                </button>
            }
        </div>
    }
</div>

@code {
    private const string CustomOptionValue = "__custom__";

    /// <summary>I passi possibili del wizard. Progressione è l'unico condizionale (§A della spec):
    /// entra in scena solo quando il livello richiesto è oltre il 1°.</summary>
    private enum WizardStepKind { Specie, Classe, Background, Caratteristiche, Progressione, Dettagli, Riepilogo }

    private static readonly (WizardStepKind Kind, string Titolo)[] TutteLeTappeWizard =
    {
        (WizardStepKind.Specie, "Specie"),
        (WizardStepKind.Classe, "Classe"),
        (WizardStepKind.Background, "Background"),
        (WizardStepKind.Caratteristiche, "Caratteristiche"),
        (WizardStepKind.Progressione, "Progressione"),
        (WizardStepKind.Dettagli, "Dettagli"),
        (WizardStepKind.Riepilogo, "Riepilogo"),
    };

    private static readonly string[] AbilityShort = { "FOR", "DES", "COS", "INT", "SAG", "CAR" };

    private static readonly Dictionary<string, string> AbilityItalian = new()
    {
        ["strength"] = "Forza", ["dexterity"] = "Destrezza", ["constitution"] = "Costituzione",
        ["intelligence"] = "Intelligenza", ["wisdom"] = "Saggezza", ["charisma"] = "Carisma"
    };

    /// <summary>Chiave inglese minuscola, sigla e nome italiano delle sei caratteristiche, per le
    /// righe di <c>DecisionePunteggi</c> nel passo Progressione. SERIO 6 del gate del 2026-08-06:
    /// derivata da <see cref="CharacterWizardLogic.AbilityKeyOrder"/> — l'unica fonte
    /// dell'ordinamento, per sua stessa documentazione — invece di ridichiarare da capo l'ordine
    /// delle sei caratteristiche una terza volta accanto ad <see cref="AbilityShort"/> e
    /// <see cref="AbilityItalian"/>.</summary>
    private static readonly (string Chiave, string Sigla, string Nome)[] CaratteristichePerPunteggi =
        CharacterWizardLogic.AbilityKeyOrder
            .Select((chiave, idx) => (chiave, AbilityShort[idx], AbilityItalian[chiave]))
            .ToArray();

    private bool loading = true;
    private bool noCampaign;
    private bool isBusy;
    private string? systemError;

    private Character draft = new();

    private List<Race> races = new();
    private List<PackageSpecies> racePackages = new();
    private List<CharacterClass> classes = new();
    private List<PackageClass> classPackages = new();

    /// <summary>Le classi del manuale, tutte: sorgente delle sottoclassi. Diversa da
    /// <c>classPackages</c>, che è la vista unita e nasconde ciò che la campagna già copre.</summary>
    private List<PackageClass> classiDiManuale = new();
    private List<Background> backgrounds = new();
    private List<PackageBackground> backgroundPackages = new();

    private int currentStep;
    private int maxStepReached;

    private bool isRaceCustom;
    private bool isClassCustom;
    private bool isSubclassCustom;
    private bool isBackgroundCustom;

    private CharacterWizardLogic.AbilityScoreMethod abilityMethod = CharacterWizardLogic.AbilityScoreMethod.StandardArray;
    private int[] baseScores = (int[])CharacterWizardLogic.StandardArrayScores.Clone();

    private CharacterWizardLogic.BackgroundAbilitySplit bgSplit = CharacterWizardLogic.BackgroundAbilitySplit.TwoAndOne;
    private string? twoBonusAbility;
    private string? oneBonusAbility;

    // Competenze abilità scelte dal vincolo di classe (§C): stato SOLO del wizard, non riletto dai
    // bool del draft — quelli non ricordano se una spunta viene dalla scelta o dal background (§E).
    // Le concesse dal background invece non servono in uno stato proprio: sono interamente derivate
    // da draft.Background via ConcesseAttuali, ricalcolate a ogni render.
    private readonly HashSet<SkillType> scelteAbilita = new();

    // ----- Stato del passo Progressione (§B della spec): SOLO (risposte per livello, tiri per
    // livello) — mai un personaggio mutato progressivamente. Il personaggio al livello richiesto si
    // RIDERIVA da EsitoProgressione a ogni render, rieseguendo il fold da capo. -----

    /// <summary>Le risposte alle decisioni della catena, per livello. <c>Dictionary</c> (non
    /// <c>IReadOnlyDictionary</c>) per la mutazione diretta; <see cref="RispostePerLivelloReadOnly"/>
    /// espone la vista di sola lettura che <c>CreationChain.Deriva</c> richiede.</summary>
    private readonly Dictionary<int, Dictionary<string, Risposta>> risposteProgressione = new();

    /// <summary>I tiri del dado PF, uno per livello (D7 della spec: mai lo stesso tiro riusato per
    /// livelli diversi). Assente = si usa la media.</summary>
    private readonly Dictionary<int, int> tiriProgressione = new();

    /// <summary>Il livello il cui pannello di decisioni è aperto, uno alla volta — come
    /// <c>LevelUpDialog.razor</c>, qui duplicato perché quel file è fuori perimetro.</summary>
    private int? livelloEspanso;

    /// <summary>Chiavi "Chiave|Opzione" per le descrizioni di catalogo espanse a mano (accordion).</summary>
    private readonly HashSet<string> descrizioniEspanse = new(StringComparer.Ordinal);

    /// <summary>Avanza per livello a ogni scarto fra il tiro digitato e quello troncato
    /// nell'intervallo del dado: entra nella @key dell'input del tiro, per forzare Blazor a toccare
    /// davvero il DOM anche quando il valore troncato coincide con quello del render precedente.</summary>
    private readonly Dictionary<int, int> tiroChiaveVersioni = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CurrentUser.EnsureLoadedAsync();

            if (string.IsNullOrEmpty(CurrentUser.UserId) || string.IsNullOrEmpty(CurrentUser.CampaignId))
            {
                noCampaign = true;
                return;
            }

            draft = new Character
            {
                OwnerId = CurrentUser.UserId,
                CampaignId = CurrentUser.CampaignId,
                Level = 1,
                ArmorClass = 10,
                HitPoints = 10,
                MaxHitPoints = 10,
                Size = "Media",
                Speed = 9
            };

            var raceTask = Catalog.GetRacesAsync(CurrentUser.CampaignId);
            var classTask = Catalog.GetClassesAsync(CurrentUser.CampaignId);
            var backgroundTask = Catalog.GetBackgroundsAsync(CurrentUser.CampaignId);
            await Task.WhenAll(raceTask, classTask, backgroundTask);

            races = raceTask.Result.DbRows.ToList();
            racePackages = raceTask.Result.PackageEntries.ToList();
            classes = classTask.Result.DbRows.ToList();
            classPackages = classTask.Result.PackageEntries.ToList();
            backgrounds = backgroundTask.Result.DbRows.ToList();
            backgroundPackages = backgroundTask.Result.PackageEntries.ToList();

            // Le sottoclassi si leggono dal pacchetto INTERO, non da PackageEntries: quella è la
            // vista unita, dove una voce di manuale coperta da una riga di campagna omonima è
            // nascosta. Chi ha importato le classi dalla pagina Dati ha dodici righe omonime,
            // quindi la vista unita non ne offre nessuna e il campo sarebbe tornato testo libero
            // proprio per chi ha fatto tutto per bene. La tabella `classes` non porta le
            // sottoclassi: il manuale è l'unica sorgente che le conosce.
            classiDiManuale = (await Catalog.GetPackageAsync())?.Classes ?? new();

            // Catalogo vuoto (nessuna riga di campagna, nessun pacchetto ancora disponibile):
            // si parte già in modalità testo libero, niente vicolo cieco (§ requisito wizard).
            isRaceCustom = AllRaceNames.Count == 0;
            isClassCustom = AllClassNames.Count == 0;
            isBackgroundCustom = AllBackgroundNames.Count == 0;
        }
        catch (Exception ex)
        {
            systemError = $"Errore caricamento cataloghi: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    // ----- Liste unificate catalogo campagna + pacchetto (già senza doppioni: CatalogService
    // nasconde le voci di pacchetto già coperte da una riga di campagna) -----

    private List<string> AllRaceNames => races.Select(r => r.Name)
        .Concat(racePackages.Select(p => p.Name))
        .Distinct().OrderBy(n => n, StringComparer.OrdinalIgnoreCase).ToList();

    private List<string> AllClassNames => classes.Select(c => c.Name)
        .Concat(classPackages.Select(p => p.Name))
        .Distinct().OrderBy(n => n, StringComparer.OrdinalIgnoreCase).ToList();

    private List<string> AllBackgroundNames => backgrounds.Select(b => b.Name)
        .Concat(backgroundPackages.Select(p => p.Name))
        .Distinct().OrderBy(n => n, StringComparer.OrdinalIgnoreCase).ToList();

    // Stesso difetto del SERIO 1 del gate del 2026-08-06 (v. il commento su SelectedClassDb più
    // sotto), stessa correzione: ricerca normalizzata (maiuscole/accenti), non uguaglianza esatta.
    // Con l'uguaglianza esatta una specie scritta a mano con un casing o un accento diverso dal
    // manuale ("elfo" minuscolo) perdeva descrizione, tratti e velocità. L'Id come spareggio
    // (MINORE 2 del secondo giro del gate del 2026-08-06) rende deterministica la scelta anche con
    // due righe omonime per casing/accenti.
    private Race? SelectedRaceDb =>
        CharacterWizardLogic.TrovaPerNomeNormalizzato(races, r => r.Name, draft.Race, r => r.Id);
    private PackageSpecies? SelectedRacePackage => SelectedRaceDb is null
        ? CharacterWizardLogic.TrovaPerNomeNormalizzato(racePackages, p => p.Name, draft.Race, p => p.Id)
        : null;

    /// <summary>Le sottoclassi disponibili per la classe scelta, da qualunque sorgente: la colonna
    /// della riga di campagna se c'è, altrimenti il manuale (e solo per una riga importata dal
    /// manuale — una classe del tavolo non eredita quelle SRD). Dal 2026-08-01 il menu compare
    /// anche per una classe del tavolo o importata, non più solo per «la classe è ancora quella del
    /// manuale»: prima di allora chi creava un personaggio per una classe fuori catalogo non aveva
    /// mai un menu, nemmeno quando quella classe aveva ormai le proprie sottoclassi.</summary>
    private IReadOnlyList<PackageSubclass> SottoclassiDisponibili
        => SubclassCatalog.Disponibili(classes, classiDiManuale, draft.Class);

    private PackageSubclass? SottoclasseScelta
        => SubclassCatalog.Trova(classes, classiDiManuale, draft.Class, draft.Subclass);

    private string CurrentSubclassSelection
        => isSubclassCustom ? CustomOptionValue : (draft.Subclass ?? string.Empty);

    // SERIO 1 del gate del 2026-08-06: ricerca normalizzata (maiuscole/accenti), non uguaglianza
    // esatta — la STESSA usata da ClassProgression.Risolvi per trovare la tabella dei livelli. Con
    // l'uguaglianza esatta una classe scritta a mano con un casing diverso dal manuale ("mago"
    // minuscolo) trovava la tabella ma non il dado vita, e lo 0 sentinella che ne seguiva bloccava
    // "Crea personaggio" senza via d'uscita. V. CharacterWizardLogic.TrovaPerNomeNormalizzato.
    private CharacterClass? SelectedClassDb =>
        CharacterWizardLogic.TrovaPerNomeNormalizzato(classes, c => c.Name, draft.Class, c => c.Id);
    private PackageClass? SelectedClassPackage => SelectedClassDb is null
        ? CharacterWizardLogic.TrovaPerNomeNormalizzato(classPackages, p => p.Name, draft.Class, p => p.Id)
        : null;

    // Stesso difetto e stessa correzione: un background scritto a mano con un casing o un accento
    // diverso dal manuale perdeva le competenze CONCESSE e le caratteristiche, non solo il testo
    // descrittivo — dati che finiscono davvero sul personaggio salvato.
    private Background? SelectedBackgroundDb =>
        CharacterWizardLogic.TrovaPerNomeNormalizzato(backgrounds, b => b.Name, draft.Background, b => b.Id);
    private PackageBackground? SelectedBackgroundPackage => SelectedBackgroundDb is null
        ? CharacterWizardLogic.TrovaPerNomeNormalizzato(backgroundPackages, p => p.Name, draft.Background, p => p.Id)
        : null;

    // ----- Competenze abilità (§C): vincolo N-su-M dalla classe, concesse dal background -----

    /// <summary>Il vincolo "scegli N fra queste M" della classe scelta, o null se non
    /// rappresentabile (classe a testo libero, o degrado totale D10): in quel caso il picker è
    /// libero a 18 caselle e non blocca mai "Avanti".</summary>
    private VincoloAbilita? VincoloAbilitaClasse =>
        CharacterWizardLogic.RisolviVincoloAbilita(SelectedClassDb, SelectedClassPackage);

    /// <summary>Le competenze che il background concede già, ricalcolate a ogni render da
    /// draft.Background: nessuno stato proprio, per non doverlo tenere sincronizzato a mano.</summary>
    private IReadOnlyList<SkillType> ConcesseAttuali =>
        CharacterWizardLogic.RisolviCompetenzeConcesse(SelectedBackgroundDb, SelectedBackgroundPackage);

    private EsitoScelteAbilita EsitoAbilita =>
        SkillChoiceRules.Valida(VincoloAbilitaClasse, scelteAbilita.ToList(), ConcesseAttuali);

    /// <summary>Suggerimento testuale mostrato quando il vincolo è assente (picker libero, D10):
    /// il testo grezzo della riga di campagna, o "N tra: elenco" ricostruito dal pacchetto.</summary>
    private string? SuggerimentoAbilitaLibere
    {
        get
        {
            if (SelectedClassDb is not null)
                return string.IsNullOrWhiteSpace(SelectedClassDb.SkillChoices) ? null : SelectedClassDb.SkillChoices;

            var scelte = SelectedClassPackage?.SkillChoices;
            return scelte is not null && scelte.From.Count > 0
                ? $"{scelte.Count} tra {string.Join(", ", scelte.From)}"
                : null;
        }
    }

    private void ToggleAbilitaScelta(SkillType abilita, bool selezionata)
    {
        if (selezionata) scelteAbilita.Add(abilita);
        else scelteAbilita.Remove(abilita);
        CharacterWizardLogic.ApplicaCompetenze(draft, scelteAbilita, ConcesseAttuali);
    }

    private string CurrentRaceSelection => isRaceCustom ? CustomOptionValue : (draft.Race ?? string.Empty);
    private string CurrentClassSelection => isClassCustom ? CustomOptionValue : (draft.Class ?? string.Empty);
    private string CurrentBackgroundSelection => isBackgroundCustom ? CustomOptionValue : (draft.Background ?? string.Empty);

    private void OnRaceSelectionChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? string.Empty;
        if (val == CustomOptionValue) { isRaceCustom = true; draft.Race = string.Empty; }
        else { isRaceCustom = false; draft.Race = val; }
    }

    private void OnClassSelectionChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? string.Empty;
        if (val == CustomOptionValue) { isClassCustom = true; draft.Class = string.Empty; }
        else { isClassCustom = false; draft.Class = val; }

        OnClassChanged();
    }

    /// <summary>Cambiata la classe, la sottoclasse dell'altra non ha più senso: il menu non la
    /// contiene più e mostrerebbe «Nessuna» mentre il campo conserva il valore — si salverebbe un
    /// Mago col Cammino del berserker. Una sottoclasse inventata dal tavolo, invece, resta.</summary>
    private void ScollegaSottoclasseNonPiuValida()
    {
        var scelta = SubclassCatalog.RisolviScelta(
            classiDiManuale, draft.Class, draft.Subclass, classes);
        draft.Subclass = scelta.Valore;
        isSubclassCustom = scelta.ScrittaAMano;
    }

    /// <summary>Effetti collaterali del cambio di classe, oltre alla sottoclasse (già gestita da
    /// <see cref="ScollegaSottoclasseNonPiuValida"/>): le competenze SCELTE dal vincolo di classe si
    /// azzerano (§E — le concesse dal background non dipendono dalla classe e restano), la
    /// caratteristica da incantatore e gli slot di 1° livello si ricalcolano dalla classe nuova, e le
    /// decisioni della progressione (sottoclasse, talenti, tiri) si azzerano — una sottoclasse
    /// scelta per il Barbaro non ha senso per il Mago in cui si è appena cambiati (§D13 della spec:
    /// stesso motivo delle competenze). Chiamato sia dalla selezione a tendina sia dal testo libero
    /// (che lo rivaluta a ogni carattere digitato, come già faceva
    /// <see cref="ScollegaSottoclasseNonPiuValida"/> da sola).</summary>
    private void OnClassChanged()
    {
        ScollegaSottoclasseNonPiuValida();

        scelteAbilita.Clear();
        CharacterWizardLogic.ApplicaCompetenze(draft, scelteAbilita, ConcesseAttuali);

        // Caratteristica da incantatore e slot sono interamente derivate dalla classe, e il wizard
        // non offre un campo manuale per sovrascriverle: si azzera prima di applicare, così il
        // "solo se vuota" di ApplySpellcastingAbility trova sempre il campo libero per la classe
        // nuova, invece di conservare la caratteristica della classe abbandonata.
        draft.SpellcastingAbility = null;
        CharacterWizardLogic.ApplySpellcastingAbility(draft, draft.Class);
        CharacterWizardLogic.ApplySpellSlotsLevel1(
            draft, ClassProgression.Risolvi(classes, classiDiManuale, draft.Class));

        risposteProgressione.Clear();
        tiriProgressione.Clear();
        livelloEspanso = null;
        descrizioniEspanse.Clear();
        tiroChiaveVersioni.Clear();

        // MINORE 1 del secondo giro del gate del 2026-08-06: un PF manuale scritto per il dado
        // vita non riconosciuto della classe abbandonata non ha senso per quella nuova — resta
        // comunque inerte se il nuovo dado è riconoscibile (AssemblaBaseline lo ignora in quel
        // caso), ma senza l'azzeramento sopravviverebbe silenzioso se anche la classe nuova avesse
        // il dado vuoto, mostrando un numero pensato per una classe diversa.
        pfBaselineManuale = null;
    }

    private void OnSubclassSelectionChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? string.Empty;
        if (val == CustomOptionValue) { isSubclassCustom = true; draft.Subclass = string.Empty; }
        else { isSubclassCustom = false; draft.Subclass = val; }
    }

    private void OnBackgroundSelectionChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? string.Empty;
        if (val == CustomOptionValue) { isBackgroundCustom = true; draft.Background = string.Empty; }
        else { isBackgroundCustom = false; draft.Background = val; }

        OnBackgroundChanged();
    }

    /// <summary>Cambiato il background, le competenze CONCESSE vanno ricalcolate: via le vecchie,
    /// dentro le nuove (§E). Le scelte di classe non sono toccate — <see cref="ApplicaCompetenze"/>
    /// le rilegge da <see cref="scelteAbilita"/>, non dai bool del draft, quindi una competenza
    /// scelta che il vecchio background dava anche lui resta competente anche quando il nuovo
    /// background non la dà più.</summary>
    private void OnBackgroundChanged()
        => CharacterWizardLogic.ApplicaCompetenze(draft, scelteAbilita, ConcesseAttuali);

    // ----- Bonus di background (§4.7): applicati SOLO se il background ne concede e la specie
    // scelta non ne porta già di suoi (evita di sommare due edizioni) -----

    private bool HasSelectedBackground => !string.IsNullOrWhiteSpace(draft.Background);

    private string? SelectedBackgroundAbilityScoresText =>
        SelectedBackgroundDb?.AbilityScores
        ?? (SelectedBackgroundPackage is not null ? string.Join(", ", SelectedBackgroundPackage.AbilityScores) : null);

    private IReadOnlyList<string> BgKeys => CharacterWizardLogic.BackgroundAbilityKeys(SelectedBackgroundAbilityScoresText);

    private bool BgBonusesApply => CharacterWizardLogic.ShouldApplyBackgroundBonuses(SelectedRaceDb, BgKeys);

    private string? EffectiveTwoBonusAbility =>
        (twoBonusAbility is not null && BgKeys.Contains(twoBonusAbility)) ? twoBonusAbility : BgKeys.ElementAtOrDefault(0);

    private string? EffectiveOneBonusAbility
    {
        get
        {
            var candidates = BgKeys.Where(k => k != EffectiveTwoBonusAbility).ToList();
            if (oneBonusAbility is not null && candidates.Contains(oneBonusAbility)) return oneBonusAbility;
            return candidates.ElementAtOrDefault(0);
        }
    }

    // La ripartizione +2/+1 richiede DUE caratteristiche: un background di campagna scritto a mano
    // può averne una sola, e in quel caso la mappa uscirebbe vuota — nessun bonus applicato, nessun
    // messaggio, con il select "Riceve +1" vuoto come unico indizio. Si ricade allora sul +1 a
    // testa, che con una sola caratteristica significa semplicemente +1 a quella.
    private CharacterWizardLogic.BackgroundAbilitySplit EffectiveSplit =>
        BgKeys.Count < 2 ? CharacterWizardLogic.BackgroundAbilitySplit.OneEachOfThree : bgSplit;

    private IReadOnlyDictionary<string, int> EffectiveBonusMap
    {
        get
        {
            if (!BgBonusesApply) return new Dictionary<string, int>();

            IReadOnlyList<string> chosen = EffectiveSplit == CharacterWizardLogic.BackgroundAbilitySplit.TwoAndOne
                ? new[] { EffectiveTwoBonusAbility, EffectiveOneBonusAbility }
                    .Where(x => x is not null).Select(x => x!).ToList()
                : BgKeys;

            return CharacterWizardLogic.BuildBackgroundBonusMap(EffectiveSplit, chosen);
        }
    }

    private int BonusForIndex(int idx) => BgBonusesApply
        ? (EffectiveBonusMap.TryGetValue(CharacterWizardLogic.AbilityKeyOrder[idx], out var v) ? v : 0)
        : CharacterWizardLogic.RaceBonuses(SelectedRaceDb)[idx];

    private int[] AdjustedBaseScores => BgBonusesApply
        ? CharacterWizardLogic.ApplyBackgroundBonuses(baseScores, EffectiveBonusMap)
        : baseScores;

    private int[] FinalScores => CharacterWizardLogic.FinalAbilityScores(AdjustedBaseScores, SelectedRaceDb);

    // ----- Metodo di generazione punteggi -----

    private void SetMethod(CharacterWizardLogic.AbilityScoreMethod method)
    {
        abilityMethod = method;
        baseScores = CharacterWizardLogic.InitialScoresFor(method);
    }

    private void ResetStandardArray() => baseScores = (int[])CharacterWizardLogic.StandardArrayScores.Clone();

    private void SetBaseFromSelect(int idx, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) baseScores[idx] = v;
    }

    // I limiti arrivano da CharacterWizardLogic, dove sono derivati dalla tabella dei costi:
    // ripeterli qui come letterali li farebbe divergere in silenzio se la tabella cambiasse.
    private void IncPointBuy(int idx) => baseScores[idx] = CharacterWizardLogic.ClampPointBuy(baseScores[idx] + 1);
    private void DecPointBuy(int idx) => baseScores[idx] = CharacterWizardLogic.ClampPointBuy(baseScores[idx] - 1);

    // Cambia a ogni clamp per far ricreare il campo (v. @key nel markup): senza, un valore
    // rifiutato resta scritto a schermo mentre il modello ne contiene un altro.
    private int rollRenderTick;

    private void SetRollScore(int idx, ChangeEventArgs e)
    {
        var grezzo = e.Value?.ToString();
        var v = int.TryParse(grezzo, out var n) ? n : baseScores[idx];
        var clamped = Math.Clamp(v, 1, 30);

        // Il confronto è con il TESTO digitato, non con il numero: così copre insieme il valore
        // clampato (digito 50, resta 30), il testo non numerico e il campo svuotato — in tutti e
        // tre i casi il modello contiene un numero che il campo non sta mostrando.
        if (!string.Equals(grezzo, clamped.ToString(), StringComparison.Ordinal)) rollRenderTick++;
        baseScores[idx] = clamped;
    }

    private int RemainingPoints => CharacterWizardLogic.PointBuyRemaining(baseScores) ?? 0;

    // ----- Dettagli: dado vita/PF/CA/velocità suggeriti -----

    private string? ClassHitDie => SelectedClassDb?.HitDie ?? SelectedClassPackage?.HitDie;

    private int SuggestedHp =>
        CharacterWizardLogic.SuggestMaxHp(ClassHitDie, CharacterCalculations.GetModifier(FinalScores[2]), draft.Level);

    private int SuggestedAc => CharacterWizardLogic.BaseArmorClass(FinalScores[1]);

    private string SuggestedHitDice => CharacterWizardLogic.BuildHitDice(ClassHitDie, draft.Level);

    private void UseSuggestedHp() => draft.MaxHitPoints = SuggestedHp;
    private void UseSuggestedAc() => draft.ArmorClass = SuggestedAc;
    private void UseSuggestedHitDice() => draft.HitDiceMax = SuggestedHitDice;

    // ----- PF quando il dado vita non si calcola (MINORE 1 del secondo giro del gate del
    // 2026-08-06): il campo PF del passo Dettagli torna editabile SOLO in questo stato (v.
    // StimaPfCalcolabile) — assente = si usa la stima generica "d8" di AssemblaBaseline, stesso
    // stile "assente = automatico" già in uso per tiriProgressione. -----

    /// <summary>Vero quando la stima di PF di 1° livello si calcola dalla FORMULA vera (dado vita
    /// di classe riconosciuto), falso quando SuggestMaxHp ripiegherebbe sulla stima generica "d8".
    /// La sentinella 0 di SuggestMaxHp dipende SOLO dal parsing del dado — non da modificatore o
    /// livello — quindi passare 0/1 come argomenti fittizi non cambia l'esito rispetto alla chiamata
    /// vera dentro AssemblaBaseline. Decide se il campo PF del passo Dettagli resta disabilitato
    /// (numero "calcolato dalle regole") o torna editabile: un campo disabilitato che mostra una
    /// stima generica inventata è peggio di un campo libero (§E della spec).</summary>
    private bool StimaPfCalcolabile => CharacterWizardLogic.SuggestMaxHp(ClassHitDie, 0, 1) > 0;

    /// <summary>PF di 1° livello scelti a mano quando il dado vita non si riconosce: null finché
    /// l'utente non tocca il campo, nel qual caso l'automatico ("d8") resta valido. Fluisce dentro
    /// AssemblaBaseline (v. il wrapper più sotto) come seed di 1° livello, così Progressione,
    /// Riepilogo e salvataggio restano tutti sulla stessa fonte: nessun punto separato da tenere
    /// sincronizzato a mano.</summary>
    private int? pfBaselineManuale;

    /// <summary>Valore mostrato (e scritto) dal campo PF del passo Dettagli quando CatenaUtile è
    /// vero ma il dado vita non si riconosce: l'override manuale se già impostato, altrimenti la
    /// stessa stima generica "d8" di 1° livello che AssemblaBaseline userebbe come seed (v.
    /// pfBaselineManuale e CharacterWizardLogic.AssemblaBaseline). BLOCCANTE del gate del
    /// 2026-08-06: deve restare il SEED, mai il totale (anteprima.MaxHitPoints) — il fold di
    /// CreationChain non è invertibile, quindi mostrare il totale mentre si scrive il seed fa
    /// divergere per sempre ciò che il campo mostra da ciò che il campo scrive.</summary>
    private int PfSeedDettagliMostrato =>
        pfBaselineManuale ?? CharacterWizardLogic.SuggestMaxHp("d8", CharacterCalculations.GetModifier(FinalScores[2]), 1);

    /// <summary>Avanza a ogni digitazione che il modello non accetta invariata (testo non numerico,
    /// o clampato a un valore diverso da quanto scritto): stessa ragione di rollRenderTick/
    /// tiroChiaveVersioni più sopra — entra nella @key dell'input e forza Blazor a toccare il DOM
    /// anche quando il valore corretto coincide, per coincidenza, con quello già a schermo.</summary>
    private int pfManualeRenderTick;

    private void ImpostaPfManuale(ChangeEventArgs e)
    {
        var grezzo = e.Value?.ToString();
        if (!int.TryParse(grezzo, out var v))
        {
            pfManualeRenderTick++;
            return;
        }
        var clamped = Math.Max(1, v);
        if (!string.Equals(grezzo, clamped.ToString(), StringComparison.Ordinal)) pfManualeRenderTick++;
        pfBaselineManuale = clamped;
    }

    private int? RaceSpeedValue => SelectedRaceDb?.Speed ?? SelectedRacePackage?.Speed?.Value;

    private string? RaceSpeedUnit => SelectedRaceDb is not null
        ? (FormValidation.IsMetric(SelectedRaceDb.SpeedUnit) ? "m" : "ft")
        : SelectedRacePackage?.Speed?.Unit;

    // Converte, non copia: il campo del PG è in metri, mentre il pacchetto SRD dichiara i piedi
    // per TUTTE le specie. Scrivere il numero grezzo darebbe «30 metri» a ogni personaggio creato
    // dal catalogo di manuale, e l'errore si propagherebbe alla scheda e alla vista Party.
    private void CopyRaceSpeed()
    {
        if (RaceSpeedValue is int v) draft.Speed = CharacterWizardLogic.SpeedInMeters(v, RaceSpeedUnit);
    }

    // ===================================================================
    // Progressione (2026-08-06): collega CreationChain.Deriva al wizard. Il wizard possiede il
    // livello 1, CreationChain possiede il 2→N (v. il principio della spec) — qui sotto sta SOLO
    // l'orchestrazione (assemblare il baseline, scegliere quale dei tre rami della catena vale, e
    // le mutazioni locali di risposte/tiri): nessun calcolo di PF/slot/competenza che duplichi
    // LevelUpPlanner o CreationChain.
    // ===================================================================

    private string? TestoProgressioneClasse => ClassProgression.Risolvi(classes, classiDiManuale, draft.Class);

    /// <summary>Il passo Progressione compare quando si richiede più del 1° livello (§A della
    /// spec) — indipendentemente dal fatto che la classe abbia una tabella: se non l'ha, il passo
    /// resta e SPIEGA il ripiego (§E), non scompare in silenzio.</summary>
    private bool MostraProgressione => draft.Level > 1;

    private bool ClasseSenzaTabella => ClassProgression.Leggi(TestoProgressioneClasse).Count == 0;

    /// <summary>Vero solo quando la catena governa DAVVERO la progressione: livello > 1 e la classe
    /// ha una tabella. Decide se i campi PF/Dadi Vita del passo Dettagli sono calcolati (disabilitati)
    /// o liberi (§D della spec).</summary>
    private bool CatenaUtile => MostraProgressione && !ClasseSenzaTabella;

    private Dictionary<string, Risposta> RisposteDiLivello(int livello)
        => risposteProgressione.TryGetValue(livello, out var r) ? r : new Dictionary<string, Risposta>(StringComparer.Ordinal);

    private IReadOnlyDictionary<int, IReadOnlyDictionary<string, Risposta>> RispostePerLivelloReadOnly
        => risposteProgressione.ToDictionary(kv => kv.Key, kv => (IReadOnlyDictionary<string, Risposta>)kv.Value);

    /// <summary>I tiri salvezza di classe come testo libero ("Forza, Costituzione"), dalle due
    /// sorgenti possibili con la stessa precedenza già in uso per dado vita/caratteristica
    /// principale: la riga di campagna vince quando esiste.</summary>
    private string? SavingThrowsText => SelectedClassDb?.SavingThrows
        ?? (SelectedClassPackage is not null ? string.Join(", ", SelectedClassPackage.SavingThrows) : null);

    /// <summary>Assembla il baseline di 1° livello: clona il draft e sincronizza ciò che il wizard
    /// possiede ma non scrive MAI su <c>draft</c> prima d'ora — punteggi finali, scelta
    /// caratteristiche di background, tiri salvezza di classe — così il resto del wizard continua a
    /// leggere "punteggi non ancora sincronizzati" fino al salvataggio vero. Competenze abilità,
    /// slot incantesimo e caratteristica da incantatore del 1° livello NON si risincronizzano qui:
    /// sono già mantenuti aggiornati sul draft stesso a ogni cambiamento
    /// (<see cref="ToggleAbilitaScelta"/>, <see cref="OnClassChanged"/>, <see cref="OnBackgroundChanged"/>),
    /// e il clone li eredita già corretti.
    ///
    /// SERIO 4 del gate del 2026-08-06: il calcolo vero e proprio vive in
    /// <see cref="CharacterWizardLogic.AssemblaBaseline"/> — funzione pura, testabile — e questo
    /// resta un wrapper sottile che gli passa lo stato del componente. Il livello del clone è SEMPRE
    /// 1, mai <c>draft.Level</c>: quel campo è ora il livello RICHIESTO alla catena (v.
    /// <see cref="DerivaEsito"/>), non lo stato del baseline. Il wizard possiede il 1°, il planner
    /// possiede il 2→N (v. il principio della spec).
    ///
    /// MINORE 1 del secondo giro del gate del 2026-08-06: <see cref="pfBaselineManuale"/> passa
    /// insieme allo stato — vince sulla stima "d8" SOLO quando il dado vita non si riconosce (v.
    /// <see cref="StimaPfCalcolabile"/> e il campo PF del passo Dettagli), altrimenti la funzione
    /// pura lo ignora da sé.</summary>
    private Character AssemblaBaseline() => CharacterWizardLogic.AssemblaBaseline(
        draft, FinalScores, EffectiveBonusMap, SavingThrowsText, CatenaUtile, ClassHitDie, pfBaselineManuale);

    /// <summary>Il branching a tre vie della catena (v. "La catena" della spec): livello 1 (nessuna
    /// catena: il baseline stesso è il personaggio), classe senza tabella (ripiego dichiarato, §E:
    /// niente motore, il livello resta quello scritto a mano) o il fold vero via
    /// <see cref="CreationChain.Deriva"/>. UN'UNICA fonte per l'anteprima (passi Progressione,
    /// Dettagli, Riepilogo) e per il salvataggio (<see cref="SaveAsync"/>): se vivessero in due punti
    /// diversi potrebbero divergere in silenzio, esattamente la classe di difetto che questa fetta
    /// deve evitare.
    ///
    /// SERIO 4 del gate del 2026-08-06: come <see cref="AssemblaBaseline"/>, il calcolo vive in
    /// <see cref="CharacterWizardLogic.DerivaEsito"/> ed è questo il wrapper sottile.</summary>
    private EsitoCatena DerivaEsito(Character baseline) => CharacterWizardLogic.DerivaEsito(
        baseline, MostraProgressione, ClasseSenzaTabella, draft.Level, TestoProgressioneClasse,
        SottoclassiDisponibili, Catalog.Feats, RispostePerLivelloReadOnly, tiriProgressione, ClassHitDie);

    /// <summary>L'esito della catena per l'ANTEPRIMA (passi Progressione, Dettagli, Riepilogo).
    /// Ricalcolato a ogni accesso — mai una cache — per restare sempre in sincrono con
    /// draft/risposte/tiri (§B della spec: lo stato è (baseline, risposte), il personaggio si
    /// deriva, non si mantiene). <see cref="SaveAsync"/> non lo usa: assembla e deriva per conto
    /// proprio, in righe separate, per rendere l'ordine (§C) visibile a chi legge quel metodo.</summary>
    private EsitoCatena EsitoProgressione => DerivaEsito(AssemblaBaseline());

    /// <summary>Il personaggio che i passi Dettagli e Riepilogo mostrano in anteprima: quello che
    /// SaveAsync salverebbe se venisse premuto "Crea personaggio" in questo istante.</summary>
    private Character Anteprima => EsitoProgressione.Personaggio;

    // ----- Interazione col passo Progressione: mutazioni locali di risposte/tiri, mai un calcolo
    // di PF/slot/competenza (quello resta dentro CreationChain/LevelUpPlanner) -----

    private void ImpostaRisposta(int livello, string chiave, Risposta risposta)
    {
        if (!risposteProgressione.TryGetValue(livello, out var perLivello))
        {
            perLivello = new Dictionary<string, Risposta>(StringComparer.Ordinal);
            risposteProgressione[livello] = perLivello;
        }
        perLivello[chiave] = risposta;
    }

    private void ToggleLivello(int livello) => livelloEspanso = livelloEspanso == livello ? null : livello;

    /// <summary>Il testo sintetico di una tappa auto-confermata, PIÙ ciò che è stato scelto (SERIO 2
    /// del gate del 2026-08-06): senza questo una tappa confermata mostrava solo punti ferita e
    /// dado, e non si vedeva quale sottoclasse o quale talento fosse stato preso — bisognava
    /// riaprire il pannello (oggi possibile, dopo la stessa correzione) per scoprirlo. Orchestrazione
    /// del solo componente: legge le risposte già in <see cref="risposteProgressione"/>, non
    /// ricalcola nulla che non sia già in <see cref="TappaCreazione.Piano"/>.</summary>
    private string RiepilogoConfermata(TappaCreazione tappa)
    {
        var risposte = RisposteDiLivello(tappa.Livello);
        var scelte = tappa.Piano.Decisioni
            .Select(d => CharacterWizardLogic.RiepilogoRisposta(d, risposte.TryGetValue(d.Chiave, out var r) ? r : null))
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .Distinct()
            .ToList();

        var automatico = CharacterWizardLogic.RiepilogoAutomatico(tappa);
        return scelte.Count == 0 ? automatico : $"{automatico} · {string.Join(" · ", scelte)}";
    }

    private void ToggleDescrizione(string chiave)
    {
        if (!descrizioniEspanse.Remove(chiave)) descrizioniEspanse.Add(chiave);
    }

    private void ScegliOpzione(int livello, DecisioneFraOpzioni decisione, string nome)
    {
        var attuali = RisposteDiLivello(livello).TryGetValue(decisione.Chiave, out var r) ? r.Scelte : Array.Empty<string>();
        List<string> nuove;
        if (attuali.Contains(nome))
            nuove = attuali.Where(x => x != nome).ToList();
        else if (decisione.Quante == 1)
            nuove = new List<string> { nome };
        else if (attuali.Count < decisione.Quante)
            nuove = attuali.Append(nome).ToList();
        else
            return; // già al massimo: i controlli restano disabilitati, ma niente crash se arriva comunque un tap.

        ImpostaRisposta(livello, decisione.Chiave, new Risposta { Scelte = nuove });
    }

    private void VariaPunteggio(int livello, string chiave, string caratteristica, int delta)
    {
        var correnti = RisposteDiLivello(livello).TryGetValue(chiave, out var r) ? r.Punteggi : new Dictionary<string, int>(StringComparer.Ordinal);
        var totale = correnti.Values.Sum();
        var valore = correnti.TryGetValue(caratteristica, out var v) ? v : 0;

        // Il vincolo "somma esattamente 2, massimo +2 su una sola" si riduce a un solo controllo:
        // con la somma già limitata a 2, nessun singolo valore può comunque superare 2.
        if (delta > 0 && totale >= 2) return;
        if (delta < 0 && valore <= 0) return;

        var nuovi = new Dictionary<string, int>(correnti, StringComparer.Ordinal);
        var nuovoValore = valore + delta;
        if (nuovoValore <= 0) nuovi.Remove(caratteristica);
        else nuovi[caratteristica] = nuovoValore;

        ImpostaRisposta(livello, chiave, new Risposta { Punteggi = nuovi });
    }

    private void ImpostaTestoLibero(int livello, string chiave, string testo)
        => ImpostaRisposta(livello, chiave, new Risposta { Testo = testo });

    private bool TiroManuale(int livello) => tiriProgressione.ContainsKey(livello);

    private void ImpostaModoTiro(int livello, LevelUpPlan piano, ChangeEventArgs e)
    {
        if (e.Value?.ToString() == "manuale") tiriProgressione[livello] = piano.MediaDado;
        else tiriProgressione.Remove(livello);
    }

    private void CambiaTiro(int livello, ChangeEventArgs e, int facceMax)
    {
        if (!int.TryParse(e.Value?.ToString(), out var v))
        {
            // MINORE 7 del gate del 2026-08-06: campo svuotato o testo non numerico. Uscire senza
            // toccare la @key lasciava lo schermo vuoto mentre il fold continuava a usare il vecchio
            // tiro (o la media, se non ce n'era ancora uno) — modello e schermo divergenti, senza che
            // nulla lo segnalasse. Bump comunque: forza Blazor a riscrivere il DOM col valore
            // REALMENTE in uso, invece di lasciare a schermo un campo vuoto che non corrisponde a
            // nessun tiro applicato.
            tiroChiaveVersioni[livello] = tiroChiaveVersioni.GetValueOrDefault(livello) + 1;
            return;
        }
        var troncato = Math.Clamp(v, 1, facceMax);
        // Il digitato eccedeva l'intervallo ed è stato troncato a un valore che magari coincide con
        // quello già in campo: senza questo contatore nella @key dell'input, Blazor non vedrebbe
        // alcuna differenza da propagare al DOM, e il campo continuerebbe a mostrare il numero
        // fuori intervallo digitato dall'utente (stesso schema di LevelUpDialog.razor).
        if (troncato != v) tiroChiaveVersioni[livello] = tiroChiaveVersioni.GetValueOrDefault(livello) + 1;
        tiriProgressione[livello] = troncato;
    }

    private int TiroChiaveVersione(int livello) => tiroChiaveVersioni.GetValueOrDefault(livello);

    // ----- Navigazione fra passi, con validazione (§ requisito wizard) -----

    /// <summary>I passi effettivi di questa sessione: Progressione entra/esce in base al livello
    /// richiesto (§A della spec). Ricalcolata a ogni render, mai salvata a parte: senza questo,
    /// cambiare il campo Livello nel passo Classe richiederebbe risincronizzare a mano una lista
    /// già filtrata in precedenza. Specie/Classe/Background/Caratteristiche restano SEMPRE ai primi
    /// quattro indici (0-3): solo gli indici da 4 in su si spostano, e l'unico punto che tocca
    /// <c>draft.Level</c> (il campo Livello) vive nel passo Classe (indice 1), sempre stabile.</summary>
    private List<WizardStepKind> Steps => TutteLeTappeWizard
        .Where(t => t.Kind != WizardStepKind.Progressione || MostraProgressione)
        .Select(t => t.Kind)
        .ToList();

    private List<string> StepTitles => TutteLeTappeWizard
        .Where(t => t.Kind != WizardStepKind.Progressione || MostraProgressione)
        .Select(t => t.Titolo)
        .ToList();

    private int TotalSteps => Steps.Count;

    /// <summary>Il personaggio che il passo Dettagli mostra e salva: <see cref="Anteprima"/> quando
    /// la catena guida davvero i PF/dadi vita (i campi sono disabilitati e mostrano quel valore),
    /// <c>draft</c> altrimenti (i campi sono editabili). SERIO 3, parte MINORE del gate del
    /// 2026-08-06: <see cref="ValidateStep"/> validava sempre <c>draft</c> anche quando il passo
    /// mostrava <c>Anteprima</c> — svuotare il campo PF al 1° livello (testo non parsabile → 0) e
    /// poi salire di livello lasciava "Avanti" bloccato su un campo disabilitato che mostrava un
    /// valore valido, perché il controllo continuava a leggere lo 0 rimasto su <c>draft</c>.</summary>
    private Character DettagliVisualizzato => CatenaUtile ? Anteprima : draft;

    /// <summary>Valida il passo indicato. <paramref name="datiPersonaggio"/> sostituisce, per il solo
    /// passo Dettagli, la fonte letta di default (<see cref="DettagliVisualizzato"/>): serve a
    /// <see cref="PassoDellErrore"/> (SERIO 3 del gate del 2026-08-06) per rivalidare esattamente il
    /// <c>baseline</c> che <see cref="SaveAsync"/> ha già validato, invece di un secondo controllo
    /// sul draft che potrebbe divergere e non trovare l'errore che ha bloccato il salvataggio.</summary>
    private string? ValidateStep(int step, Character? datiPersonaggio = null)
    {
        switch (Steps[step])
        {
            case WizardStepKind.Specie:
                return CharacterWizardLogic.ValidateSpeciesStep(draft.Race);
            case WizardStepKind.Classe:
                return CharacterWizardLogic.ValidateClassStep(draft.Class)
                    ?? CharacterWizardLogic.ValidateClassSkillChoices(VincoloAbilitaClasse, EsitoAbilita);
            case WizardStepKind.Background:
                return CharacterWizardLogic.ValidateBackgroundStep(draft.Background);
            case WizardStepKind.Caratteristiche:
                return CharacterWizardLogic.ValidateAbilitiesStep(abilityMethod, baseScores);
            case WizardStepKind.Progressione:
                var esito = EsitoProgressione;
                return CharacterWizardLogic.ValidateProgressionStep(CatenaUtile, esito.Completa, esito.Motivo);
            case WizardStepKind.Dettagli:
                return CharacterWizardLogic.ValidateDetailsStep(datiPersonaggio ?? DettagliVisualizzato);
            default:
                return null;
        }
    }

    private void GoToStep(int step)
    {
        if (step > maxStepReached) return; // passo non ancora sbloccato
        currentStep = Math.Clamp(step, 0, TotalSteps - 1);
    }

    private void Next()
    {
        var error = ValidateStep(currentStep);
        if (error is not null)
        {
            Toasts.ShowError(error);
            return;
        }
        currentStep = Math.Min(currentStep + 1, TotalSteps - 1);
        if (currentStep > maxStepReached) maxStepReached = currentStep;
    }

    private void Prev() => GoToStep(currentStep - 1);

    private async Task ExitAsync()
    {
        var confirmed = await Confirm.ShowAsync("Uscire senza salvare? Il personaggio non ancora creato andrà perso.");
        // Percorsi RELATIVI, senza '/' iniziale: in produzione il <base href> è
        // /dnd-companion-app/, e uno slash iniziale uscirebbe dal sottopercorso di GitHub Pages
        // (in locale, con base '/', il difetto resterebbe invisibile).
        if (confirmed) Navigation.NavigateTo("characters");
    }

    // ----- Salvataggio -----

    /// <summary>Il primo passo che non supera la propria validazione, o null se sono tutti a posto.
    /// L'ordine è quello dei passi attuali (<see cref="Steps"/>), così si atterra sul più a monte:
    /// correggerlo può risolvere anche quelli a valle. <see cref="ValidateStep"/> torna sempre null
    /// per Background e Riepilogo, quindi enumerare tutti i passi equivale a controllare solo quelli
    /// che possono davvero bloccare.
    ///
    /// SERIO 3 del gate del 2026-08-06: <paramref name="baseline"/> è lo STESSO oggetto che
    /// <see cref="SaveAsync"/> ha appena validato con <c>ValidateSummaryStep</c> — prima veniva
    /// chiamato senza argomenti e il passo Dettagli finiva per rivalidare <c>draft</c>, che può
    /// divergere dal baseline (v. <see cref="DettagliVisualizzato"/>). Con la divergenza, un
    /// baseline in errore e un draft che invece passa facevano tornare questo metodo <c>null</c>: il
    /// commento di <see cref="SaveAsync"/> promette "riporta al passo che ha prodotto l'errore", ma
    /// con <c>null</c> l'utente restava semplicemente fermo con un toast, senza sapere dove
    /// intervenire.</summary>
    private int? PassoDellErrore(Character baseline)
    {
        var passi = Steps;
        for (var i = 0; i < passi.Count; i++)
            if (ValidateStep(i, baseline) is not null) return i;
        return null;
    }

    private async Task SaveAsync()
    {
        // ORDINE NON NEGOZIABILE (§C della spec): 1) assembla il baseline (le sei caratteristiche
        // finali, la scelta caratteristiche di background, i tiri salvezza — tutto ciò che il
        // wizard possiede ma non scrive MAI su `draft` prima d'ora, per non fargli leggere numeri
        // stantii durante il resto del wizard: v. AssemblaBaseline); 2) valida SUL BASELINE, non
        // sul derivato; 3) deriva con CreationChain.Deriva (dentro DerivaEsito); 4) rifiuta il
        // salvataggio se l'esito non è completo; 5) Normalize sul risultato del fold; 6) salva
        // quello, MAI il draft. Se il sync delle caratteristiche finali girasse DOPO il fold (o se
        // questi passi si interlacciassero), un incremento di caratteristica maturato nel fold —
        // l'ASI del 4°, per esempio — verrebbe sovrascritto in silenzio dal sync tardivo: build
        // verde, test verdi, e il talento del 4° semplicemente non ci sarebbe più nella scheda
        // salvata. È il gemello esatto del bloccante CloneCharacter del 2026-08-06, e altrettanto
        // silenzioso.
        var baseline = AssemblaBaseline(); // 1. assembla

        var errore = CharacterWizardLogic.ValidateSummaryStep(baseline, abilityMethod, baseScores) // 2. valida
            ?? CharacterWizardLogic.ValidateClassSkillChoices(VincoloAbilitaClasse, EsitoAbilita);
        if (errore is not null)
        {
            // Riporta al passo che ha prodotto l'errore, non solo il messaggio: il riepilogo mostra
            // le caratteristiche già sommate ai bonus, quindi «non sembrano» sbagliate, e il toast
            // sparisce da solo. Senza questo salto l'utente resta a guardare una schermata che gli
            // pare corretta, senza sapere dove intervenire.
            var passo = PassoDellErrore(baseline);
            if (passo is int p && p != currentStep) currentStep = p;

            Toasts.ShowError(errore);
            return;
        }

        var esito = DerivaEsito(baseline); // 3. deriva

        if (!esito.Completa) // 4. rifiuta se incompleta
        {
            var idxProgressione = Steps.IndexOf(WizardStepKind.Progressione);
            if (idxProgressione >= 0) currentStep = idxProgressione;

            Toasts.ShowError(esito.Motivo ?? "Completa le scelte di progressione prima di continuare.");
            return;
        }

        var personaggio = esito.Personaggio;
        CharacterNormalizer.Normalize(personaggio); // 5. Normalize sul risultato del fold

        isBusy = true;
        systemError = null;
        try
        {
            personaggio.OwnerId = CurrentUser.UserId ?? string.Empty;
            personaggio.CampaignId = CurrentUser.CampaignId ?? string.Empty;

            var saved = await CharacterRepository.CreateCharacterAsync(personaggio); // 6. salva quello, non il draft
            if (saved is null)
            {
                systemError = "Il server non ha restituito il personaggio salvato.";
                return;
            }

            Toasts.ShowSuccess("Personaggio creato");
            Navigation.NavigateTo($"characters?id={Uri.EscapeDataString(saved.Id)}");
        }
        catch (Exception ex)
        {
            systemError = $"Errore salvataggio: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }
}
