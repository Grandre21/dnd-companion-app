@page "/characters"
@using DndCompanion.Models
@using DndCompanion.Models.Packages
@inject ICharacterRepository CharacterRepository
@inject IRaceRepository RaceRepository
@inject IClassRepository ClassRepository
@inject ICatalogService Catalog
@inject IInventoryRepository InventoryRepository
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ToastService Toasts
@inject ConfirmService Confirm

<PageTitle>Personaggi - D&amp;D Companion</PageTitle>

<div class="characters-container">
    @if (selected == null)
    {
        <header class="page-header">
            <button type="button" class="back-btn" @onclick='() => Navigation.NavigateTo("")'>
                ← Home
            </button>
            <h1 class="page-title">Personaggi</h1>
        </header>
    }

    <DbErrorBanner Message="@errorMessage" OnDismiss="@(() => errorMessage = null)" />

    @switch (mode)
    {
        case ViewMode.Loading:
            <LoadingSpinner />
            break;

        case ViewMode.Empty:
            <div class="empty-state">
                <div class="empty-icon">🗡️</div>
                <p class="empty-text">Non hai ancora un personaggio.</p>
                <button type="button" class="primary-btn" @onclick="OpenCreateForm">
                    Crea Personaggio
                </button>
            </div>
            break;

        case ViewMode.List:
            <div class="list-view">
                @if (characters.Count == 0)
                {
                    <div class="empty-state">
                        <div class="empty-icon">🗡️</div>
                        <p class="empty-text">Nessun personaggio in questa campagna.</p>
                        <button type="button" class="primary-btn" @onclick="OpenCreateForm">
                            Crea Personaggio
                        </button>
                    </div>
                }
                else
                {
                    <div class="char-list">
                        @foreach (var c in characters)
                        {
                            <button type="button" class="list-card" @onclick="() => OpenDetailAsync(c)">
                                <div class="list-name">@c.Name</div>
                                <div class="list-meta">Liv @c.Level · @c.Class · @c.Race</div>
                                <div class="list-hp">PF @c.HitPoints / @c.MaxHitPoints</div>
                            </button>
                        }
                    </div>
                }
            </div>
            break;

        case ViewMode.Detail when selected is not null:
            <div class="char-sheet">
                @* ===== Header unificato ===== *@
                <div class="character-header">
                    <button class="header-btn back-btn" @onclick="GoBack" aria-label="Indietro">←</button>
                    <div class="character-title">
                        <h1 class="character-name">@selected.Name</h1>
                        <p class="character-subtitle">
                            Liv @selected.Level · @selected.Class@(string.IsNullOrWhiteSpace(selected.Subclass) ? "" : $" {selected.Subclass}") · @selected.Race
                        </p>
                    </div>
                    @if (CanEdit)
                    {
                        <button class="header-btn edit-btn" @onclick="StartEdit" aria-label="Modifica">✎</button>
                    }
                </div>

                @* ===== Valori del turno + tab: un solo blocco che resta in cima =====
                   Sticky sul gruppo e non sulle due parti separate: due elementi sticky
                   impilati richiederebbero di sapere l'altezza del primo per calcolare il `top`
                   del secondo, e quell'altezza cambia con la larghezza dello schermo (i PF vanno
                   a capo sotto i 360px). *@
                <div class="sheet-sticky">
                <CharacterVitalsBar Character="@selected" CanEdit="@CanEdit" OnChanged="@SaveCharacterCoreAsync"
                                     OnLevelUp="@ApriLivelloUpAsync" OnOpenHpPanel="@OpenHpPanel"
                                     IsSaving="@isSavingCharacter" OnLocalRevert="@(() => StateHasChanged())" />

                <div class="tab-bar">
                    <button class="tab-item @(activeTab == "rolls" ? "active" : "")" @onclick='() => activeTab = "rolls"'>
                        <span class="tab-icon">⚔</span>
                        <span class="tab-label">Gioco</span>
                    </button>
                    <button class="tab-item @(activeTab == "bio" ? "active" : "")" @onclick='() => activeTab = "bio"'>
                        <span class="tab-icon">📖</span>
                        <span class="tab-label">Scheda</span>
                    </button>
                    <button class="tab-item @(activeTab == "items" ? "active" : "")" @onclick='() => activeTab = "items"'>
                        <span class="tab-icon">🎒</span>
                        <span class="tab-label">Zaino</span>
                    </button>
                    @if (!string.IsNullOrWhiteSpace(selected.SpellcastingAbility))
                    {
                        <button class="tab-item @(activeTab == "magic" ? "active" : "")" @onclick='() => activeTab = "magic"'>
                            <span class="tab-icon">✨</span>
                            <span class="tab-label">Magia</span>
                        </button>
                    }
                </div>
                </div>

                @* Tastierino danni/cura: reso qui dal genitore, FUORI da ".sheet-sticky" — esattamente
                   come LevelUpDialog qui sotto. Quel contenitore è `position: sticky; z-index: 10`
                   (v. Characters.razor.css) e crea uno stacking context: lo z-index 1150 di questo
                   overlay conterebbe solo dentro quel contesto, e l'intero sottoalbero verrebbe dipinto
                   a quota 10 nella radice — sotto BottomNav (100), UpdateBanner (1050) e ToastHost
                   (1100). Alzare lo z-index di .sheet-sticky non risolverebbe: il contesto resterebbe
                   annidato. Stato e markup vivevano in CharacterVitalsBar; il bottone che apre il
                   pannello resta lì e chiede l'apertura via OnOpenHpPanel, come OnLevelUp per il
                   level-up guidato. Due azioni esplicite (danni/cura) invece del segno da indovinare,
                   col calcolo del cuscinetto temporaneo (CharacterView.ApplyDamage/ApplyHealing) che
                   nessuno deve più fare a mente. Click sul fondo o Esc chiudono, click dentro il box
                   non propaga. *@
                @if (showHpPanel)
                {
                    <div class="hp-panel-overlay" @onclick="CloseHpPanel" @onkeydown="HandleHpPanelKeyDown">
                        <div class="hp-panel" role="dialog" aria-modal="true" aria-labelledby="hp-panel-title"
                             @onclick:stopPropagation="true">
                            <button type="button" class="hp-panel-close" @onclick="CloseHpPanel" aria-label="Chiudi">✕</button>
                            <p id="hp-panel-title" class="hp-panel-title">Danni o cura</p>
                            <p class="hp-panel-current">@HpPanelCurrentLabel</p>

                            <label class="hp-panel-label" for="hp-panel-amount">Quantità</label>
                            <input id="hp-panel-amount" @ref="hpAmountInputRef" class="hp-panel-input"
                                   type="number" inputmode="numeric" min="1" placeholder="0"
                                   @bind="hpPanelAmount" @bind:event="oninput" />

                            @if (selected.TempHitPoints > 0)
                            {
                                <p class="hp-panel-hint">Il danno consuma prima i PF temporanei.</p>
                            }

                            <div class="hp-panel-actions">
                                <button type="button" class="hp-panel-btn hp-panel-damage"
                                        disabled="@(!CanEdit || !CanApplyPanelAmount || isSavingCharacter)"
                                        @onclick="ApplyPanelDamageAsync">Danni</button>
                                <button type="button" class="hp-panel-btn hp-panel-heal"
                                        disabled="@(!CanEdit || !CanApplyPanelAmount || isSavingCharacter)"
                                        @onclick="ApplyPanelHealAsync">Cura</button>
                            </div>
                        </div>
                    </div>
                }

                @* Il proseguimento "Sali ancora": D3 vuole un livello alla volta, e per recuperarne
                   più di uno si ripete il dialogo — questo invito evita di dover ritrovare il
                   bottone in cima alla barra dopo ogni conferma. Sparisce da sé alla prossima
                   apertura o alla chiusura manuale. *@
                @if (mostraSaliAncora)
                {
                    <div class="levelup-again">
                        <span class="levelup-again-text">Vuoi salire ancora?</span>
                        <button type="button" class="levelup-again-btn" @onclick="ApriLivelloUpAsync">
                            Sali ancora
                        </button>
                        <button type="button" class="levelup-again-dismiss" aria-label="Chiudi"
                                @onclick="() => mostraSaliAncora = false">✕</button>
                    </div>
                }

                <div class="tab-content">

                @* ===================== TAB TIRI =====================
                   Riordinato per momento del turno (2026-08-06), non per ordine di aggiunta: TS
                   contro morte (quando servono — in testa, perché se il PG sta morendo non conta
                   altro), velocità e ispirazione, armi, risorse di classe, poi le sei
                   caratteristiche con tiri salvezza e abilità — e solo dopo, oltre il divisore
                   «a fine combattimento», dadi vita e riposo. CharacterStatsTab resta un componente
                   separato (le due metà non si fondono): CharacterCombatTab lo rende come
                   ChildContent, in mezzo alle proprie sezioni, invece che come fratello dopo. *@
                @if (activeTab == "rolls")
                {
                    <CharacterCombatTab Character="@selected" CanEdit="@CanEdit" OnChanged="@SaveCharacterCoreAsync"
                                        IsSaving="@isSavingCharacter" OnLocalRevert="@(() => StateHasChanged())"
                                        Weapons="@inventoryItems.Where(i => string.Equals(i.ItemType, "weapon", StringComparison.OrdinalIgnoreCase)).ToList()"
                                        Gruppi="@GruppiPrivilegi"
                                        OnSalvaAnnotazione="@SalvaAnnotazionePrivilegioAsync"
                                        OnEliminaVocePropria="@EliminaVocePropriaPrivilegioAsync">
                        <CharacterStatsTab Character="@selected" CanEdit="@CanEdit" OnChanged="@SaveCharacterAsync" />
                    </CharacterCombatTab>
                }

                @* ===================== TAB SCHEDA ===================== *@
                @if (activeTab == "bio")
                {
                    <CharacterBioTab Character="@selected" CanEdit="@CanEdit" OnSaveNotes="@SaveNotesAsync"
                                     OnSaveTraining="@SaveTrainingAsync"
                                     ClassProgressionText="@ProgressioneClasseSelezionata"
                                     Subclass="@SottoclasseSelezionata"
                                     PackageFeats="@packageFeats"
                                     BackgroundDalManuale="@BackgroundSelezionato"
                                     OnDelete="@DeleteSelectedAsync" IsBusy="@isBusy" />
                }

                @* ===================== TAB ZAINO ===================== *@
                @if (activeTab == "items")
                {
                    <CharacterItemsTab Character="@selected" CanEdit="@CanEdit" Items="@inventoryItems"
                                       IsLoading="@isLoadingInventory" OnChanged="@SaveCharacterAsync"
                                       OnInventoryChanged="@ReloadInventoryAsync" OnError="@SetError" />
                }

                @* ===================== TAB MAGIA ===================== *@
                @if (activeTab == "magic" && !string.IsNullOrWhiteSpace(selected.SpellcastingAbility))
                {
                    <CharacterMagicTab Character="@selected" CanEdit="@CanEdit" OnChanged="@SaveCharacterAsync"
                                       AllSpells="@allSpells" PackageSpells="@packageSpells" OnError="@SetError" />
                }

                </div>

                @* ===================== LEVEL-UP GUIDATO =====================
                   Smontato dal DOM quando non c'è un piano (@if a monte, non solo il @if interno al
                   componente): senza, chiudere e riaprire lo stesso livello lascerebbe vivo lo stato
                   locale del dialogo (tiro manuale, accordion espanso) mentre il piano nuovo qui
                   sotto parte sempre da capo — la giuntura nota fra questo file e LevelUpDialog. *@
                @if (livelloErrore is not null)
                {
                    <div class="levelup-error">
                        <DbErrorBanner Message="@livelloErrore" OnDismiss="@(() => livelloErrore = null)" />
                    </div>
                }
                @if (livelloPiano is not null)
                {
                    <LevelUpDialog Piano="@livelloPiano" Risposte="@livelloRisposte"
                                   OnRisposta="@OnLivelloRisposta" OnTiro="@OnLivelloTiro"
                                   OnConferma="@ConfermaLivelloUpAsync" OnAnnulla="@AnnullaLivelloUp"
                                   InCorso="@livelloInCorso" />
                }
            </div>
            break;

        case ViewMode.Form:
            @* L'eliminazione sta in fondo alla tab «Scheda», non qui: si cerca guardando il
               personaggio, non entrando in modifica. *@
            <CharacterEditForm Draft="@editDraft" Classes="@classes" Races="@races"
                               ClassPackages="@packageClasses"
                               IsBusy="@isBusy" OnSave="@SaveFormAsync" OnCancel="@CancelForm" />
            break;
    }

    @* Creazione personaggio: per OGNI membro (player e master), in ogni vista tranne il form. *@
    @if (mode is ViewMode.List or ViewMode.Empty or ViewMode.Detail)
    {
        <button type="button" class="fab" @onclick="OpenCreateForm" title="Nuovo personaggio" aria-label="Nuovo personaggio">
            +
        </button>
    }
</div>

@code {
    private enum ViewMode { Loading, Empty, List, Detail, Form }

    // Precompilato da CharacterWizard (pagina /characters/nuovo) dopo la creazione: apre subito
    // il dettaglio del PG appena nato invece di lasciare l'utente sulla lista.
    [SupplyParameterFromQuery] public string? Id { get; set; }

    private ViewMode mode = ViewMode.Loading;
    private List<Character> characters = new();
    private Character? selected;
    private Character editDraft = new();
    private List<Race> races = new();
    private List<CharacterClass> classes = new();

    private List<InventoryItem> inventoryItems = new();
    private bool isLoadingInventory;

    // Catalogo globale incantesimi (caricato una sola volta, in cache); passato a CharacterMagicTab.
    // Gli incantesimi del singolo PG li gestisce CharacterMagicTab.
    private List<Spell> allSpells = new();
    private List<PackageSpell> packageSpells = new();
    private bool spellsLoaded;

    // Classi del pacchetto: servono per mostrare i privilegi anche a chi NON ha importato le classi
    // nella campagna, che è il caso normale. Le righe di database restano la fonte prioritaria.
    private List<PackageClass> packageClasses = new();
    private List<PackageFeat> packageFeats = new();
    private List<PackageBackground> packageBackgrounds = new();

    /// <summary>La sottoclasse del PG risolta, da qualunque sorgente: la colonna della riga di
    /// campagna se c'è, altrimenti il manuale (v. <see cref="SubclassCatalog.Disponibili"/>). Null
    /// se il nome è scritto a mano, o se la classe non ne offre nessuna.
    ///
    /// Dal 2026-08-01 non dipende più da <see cref="ClassProgression.ClasseDelManuale"/>: quel
    /// criterio guardava solo il manuale, e una classe del tavolo — o importata e poi arricchita a
    /// mano — con le proprie sottoclassi restava sempre senza privilegi da mostrare qui, anche
    /// quando il menu di modifica li offriva.</summary>
    private PackageSubclass? SottoclasseSelezionata
        => selected is null
            ? null
            : SubclassCatalog.Trova(classes, packageClasses, selected.Class, selected.Subclass);

    /// <summary>Il background del manuale corrispondente al nome sulla scheda, null se scritto a mano
    /// o non a catalogo. Risolto qui, come la sottoclasse: è il genitore ad avere il pacchetto.</summary>
    private PackageBackground? BackgroundSelezionato
        => selected is null ? null : CharacterManualJoin.BackgroundRiconosciuto(selected.Background, packageBackgrounds);

    /// <summary>Tabella dei livelli della classe del PG aperto; la regola di precedenza sta
    /// nell'helper puro, qui restano solo le due collezioni già caricate.</summary>
    private string? ProgressioneClasseSelezionata
        => selected is null ? null : ClassProgression.Risolvi(classes, packageClasses, selected.Class);

    /// <summary>La vista dei privilegi per il tab «Gioco» (v. CharacterFeatureJoin, piano
    /// 2026-08-08): stessi ingressi già in cache passati a CharacterBioTab qui sopra
    /// (ClassProgressionText/Subclass/PackageFeats) — nessuna chiamata di rete nuova.</summary>
    private IReadOnlyList<GruppoPrivilegi> GruppiPrivilegi
        => selected is null
            ? Array.Empty<GruppoPrivilegi>()
            : CharacterFeatureJoin.Raggruppa(CharacterFeatureJoin.Costruisci(
                ProgressioneClasseSelezionata, selected.Level, selected.Class,
                SottoclasseSelezionata, selected.Feats, packageFeats,
                selected.CharacterFeatures, selected.ClassResources));

    // ===== Navigazione a tab della vista detail =====
    // valori: rolls | bio | items | magic
    private string activeTab = "rolls";

    private bool isBusy;
    private string? errorMessage;

    // ===== Salvataggio del personaggio aperto =====
    // Un solo flag, condiviso da CharacterVitalsBar e CharacterCombatTab (v. i loro parametri
    // IsSaving): prima ciascuno teneva il proprio booleano locale (isSavingHp/isResting), e un
    // riposo confermato insieme a un tocco sui PF potevano far partire due scritture in corsa sullo
    // stesso Character — quella che arriva seconda "vince" in database mentre la scheda in memoria
    // resta con l'altra. Impostato/rimosso in SaveCharacterCoreAsync e in SaveTrainingAsync: sono i
    // due punti che scrivono sul personaggio aperto, e la barra dei valori (Danni/Cura) resta
    // renderizzata e attiva mentre l'altro salva, perché vive fuori dal contenuto delle tab.
    private bool isSavingCharacter;

    // ===== Tastierino danni/cura (v. CharacterVitalsBar.OnOpenHpPanel) =====
    // Stato di sola presentazione, spostato qui da CharacterVitalsBar perché il markup dell'overlay
    // deve stare fuori da ".sheet-sticky" (v. il commento sul markup più sopra). Nessuno di questi
    // campi è un dato di dominio; il calcolo vero (cuscinetto temporaneo prima, PF veri poi) vive in
    // CharacterView.ApplyDamage/ApplyHealing.
    private bool showHpPanel;
    private int? hpPanelAmount;
    private ElementReference hpAmountInputRef;
    private bool focusHpAmountPending;

    private bool CanApplyPanelAmount => hpPanelAmount is > 0;

    private string HpPanelCurrentLabel
    {
        get
        {
            if (selected is null) return string.Empty;
            return selected.TempHitPoints > 0
                ? $"Ora {selected.HitPoints}/{selected.MaxHitPoints} (+{selected.TempHitPoints} temp)"
                : $"Ora {selected.HitPoints}/{selected.MaxHitPoints}";
        }
    }

    // ===== Level-up guidato =====
    // Il piano è null a riposo: è la condizione che smonta <LevelUpDialog/> dal DOM (v. il @if nel
    // markup). Le risposte sono mutabili in loco perché LevelUpPlanner.Pianifica le legge, non le
    // possiede: ricalcolare il piano dopo ogni modifica è compito di RicalcolaPianoLivello.
    private LevelUpPlan? livelloPiano;
    private readonly Dictionary<string, Risposta> livelloRisposte = new(StringComparer.Ordinal);
    private int? livelloTiro;
    private bool livelloInCorso;
    private string? livelloErrore;

    // Mostrato dopo una conferma riuscita, se il personaggio non è già al 20°: un tap in meno per
    // recuperare più livelli di fila (D3 del design, "un livello alla volta" con "Sali ancora").
    private bool mostraSaliAncora;

    private bool CanEdit =>
        selected is not null && AccessControl.CanEdit(CurrentUser.IsMaster, selected.OwnerId, CurrentUser.UserId);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CurrentUser.EnsureLoadedAsync();

            if (string.IsNullOrEmpty(CurrentUser.UserId) || string.IsNullOrEmpty(CurrentUser.CampaignId))
            {
                // Non loggato (AuthRedirect interviene) o nessuna campagna attiva.
                mode = ViewMode.Empty;
                return;
            }

            // Tutti i personaggi della campagna; il permesso di modifica è per-personaggio (CanEdit).
            var charsFetch = CharacterRepository.GetCharactersForCampaignAsync(CurrentUser.CampaignId);
            var racesTask = RaceRepository.GetRacesForCampaignAsync(CurrentUser.CampaignId);
            var classesTask = ClassRepository.GetClassesForCampaignAsync(CurrentUser.CampaignId);

            await Task.WhenAll(charsFetch, racesTask, classesTask);

            characters = charsFetch.Result;
            races = racesTask.Result;
            classes = classesTask.Result;

            await UpdateModeFromCharactersAsync();

            // Rientro dal wizard di creazione: apre subito il PG appena creato, sia in lista
            // (master, o giocatore con più PG) sia quando il caso singolo sopra ha già scelto
            // un altro personaggio.
            if (!string.IsNullOrEmpty(Id))
            {
                var justCreated = characters.FirstOrDefault(c => c.Id == Id);

                // Solo se non è GIÀ quello aperto: con un solo personaggio in campagna —
                // il caso del giocatore che rientra dal wizard, cioè il percorso più frequente —
                // UpdateModeFromCharactersAsync lo ha appena aperto, e riaprirlo qui rifarebbe
                // da capo il caricamento dell'inventario.
                if (justCreated is not null && !ReferenceEquals(selected, justCreated))
                    await OpenDetailAsync(justCreated);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore caricamento: {ex.Message}";
            mode = ViewMode.Empty;
        }
    }

    // Il focus del tastierino danni/cura parte solo dopo che l'input è montato nel DOM (v.
    // OpenHpPanel): stesso pattern che viveva in CharacterVitalsBar prima che l'overlay si
    // spostasse qui.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusHpAmountPending) return;
        focusHpAmountPending = false;
        await hpAmountInputRef.FocusAsync();
    }

    private async Task UpdateModeFromCharactersAsync()
    {
        if (CurrentUser.IsMaster)
        {
            mode = ViewMode.List;
        }
        else if (characters.Count == 0)
        {
            mode = ViewMode.Empty;
        }
        else if (characters.Count == 1)
        {
            await OpenDetailAsync(characters[0]);
        }
        else
        {
            mode = ViewMode.List;
        }
    }

    private async Task OpenDetailAsync(Character c)
    {
        selected = c;
        mode = ViewMode.Detail;
        activeTab = "rolls";
        ChiudiLivelloUp();
        showHpPanel = false;
        await LoadInventoryAsync(c.Id);
        await EnsureSpellCatalogAsync();
        await EnsureClassPackageAsync();
    }

    // Le classi del pacchetto, tutte: non la vista unita, che nasconde le voci già coperte da una
    // riga di campagna. Chi ha importato le classi PRIMA che l'import portasse la tabella dei
    // livelli ha righe senza privilegi, e la vista unita lascerebbe quel PG senza nulla da mostrare.
    // Nessun traffico in più: il pacchetto è già stato scaricato qui sopra e resta in cache.
    private async Task EnsureClassPackageAsync()
    {
        if (packageClasses.Count > 0) return;
        try
        {
            var pacchetto = await Catalog.GetPackageAsync();
            if (pacchetto is not null)
            {
                packageClasses = pacchetto.Classes;
                packageFeats = pacchetto.Feats;
                packageBackgrounds = pacchetto.Backgrounds;
            }
        }
        catch (Exception ex)
        {
            // Non blocca la scheda: senza tabella dei livelli il resto del personaggio è intatto.
            errorMessage = $"Errore caricamento privilegi di classe: {ex.Message}";
        }
    }

    // Carica catalogo globale (una sola volta) + incantesimi del PG, solo per gli incantatori.
    // Carica una sola volta il catalogo globale incantesimi (per il SpellPicker di CharacterMagicTab e per il
    // form). Gli incantesimi del singolo PG li carica il componente Magic in OnParametersSet.
    private async Task EnsureSpellCatalogAsync()
    {
        if (spellsLoaded) return;
        try
        {
            var vistaIncantesimi = await Catalog.GetSpellsAsync(CurrentUser.CampaignId ?? string.Empty);
            allSpells = vistaIncantesimi.DbRows.ToList();
            packageSpells = vistaIncantesimi.PackageEntries.ToList();
            spellsLoaded = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore caricamento catalogo incantesimi: {ex.Message}";
        }
    }

    private void GoBack()
    {
        selected = null;
        ChiudiLivelloUp();
        showHpPanel = false;
        BackToListOrEmpty();
    }

    // ===== Tastierino danni/cura =====
    // Richiesto da CharacterVitalsBar via OnOpenHpPanel; il markup vive qui perché deve stare fuori
    // da ".sheet-sticky" (v. il commento sul markup più sopra).
    private void OpenHpPanel()
    {
        if (!CanEdit || isSavingCharacter) return;
        hpPanelAmount = null;
        showHpPanel = true;
        focusHpAmountPending = true; // il focus vero parte in OnAfterRenderAsync, a input montato.
    }

    private void CloseHpPanel() => showHpPanel = false;

    /// <summary>Esc chiude il pannello da qualunque controllo al suo interno: l'evento nativo
    /// risale dal figlio con focus (input o bottone) fino a questo handler sull'overlay.</summary>
    private void HandleHpPanelKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseHpPanel();
    }

    private Task ApplyPanelDamageAsync() => ApplyPanelAsync(ApplyDamage);
    private Task ApplyPanelHealAsync() => ApplyPanelAsync(ApplyHealing);

    private async Task ApplyPanelAsync(Action<Character, int> apply)
    {
        if (selected is null || !CanEdit || isSavingCharacter || hpPanelAmount is not int amount || amount <= 0)
            return;

        // Riferimento catturato ADESSO, non riletto da `selected` dopo l'await: fra l'apply e il
        // salvataggio Blazor smista comunque gli eventi dell'interfaccia, e l'utente può premere
        // "←" (GoBack azzera `selected` → NullReferenceException, non gestita in WebAssembly) o
        // aprire un altro personaggio (OpenDetailAsync sostituisce `selected`) mentre questo
        // metodo è ancora in attesa di rete. Rileggere `selected` al ripristino scriverebbe i PF
        // del PRIMO personaggio dentro il SECONDO, che il salvataggio riuscito di quest'ultimo
        // persisterebbe in silenzio. Lavorando su `pg` — la stessa istanza, non una copia — il
        // ripristino resta ancorato al personaggio giusto qualunque cosa `selected` sia diventato.
        var pg = selected;

        // Presa PRIMA di apply: ApplyDamage/ApplyHealing mutano pg SUBITO, ma il salvataggio
        // è asincrono e può fallire in modo muto (le RLS rifiutano l'update, PostgREST torna [] e
        // SaveCharacterCoreAsync torna false) — stesso rischio già corretto per il riposo
        // (RiposoSnapshot in CharacterCombatTab.razor): senza ripristino, un colpo o una cura mai
        // confermati resterebbero lì fino al primo salvataggio successivo riuscito, che li
        // persisterebbe in silenzio. Uso il metodo con l'esito (non il wrapper SaveCharacterAsync)
        // apposta per poterlo controllare; qui non serve un OnLocalRevert separato — questo metodo
        // è già il "receiver" del proprio @onclick, quindi si ridisegna da sé (e con sé
        // CharacterVitalsBar, che legge lo stesso pg) a fine esecuzione.
        var pf = pg.HitPoints;
        var pfTemp = pg.TempHitPoints;

        apply(pg, amount);
        showHpPanel = false;

        if (!await SaveCharacterCoreAsync())
        {
            pg.HitPoints = pf;
            pg.TempHitPoints = pfTemp;
        }
    }

