@page "/characters"
@using DndCompanion.Models
@using DndCompanion.Models.Packages
@inject ICharacterRepository CharacterRepository
@inject IRaceRepository RaceRepository
@inject IClassRepository ClassRepository
@inject ICatalogService Catalog
@inject IInventoryRepository InventoryRepository
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ToastService Toasts
@inject ConfirmService Confirm

<PageTitle>Personaggi - D&amp;D Companion</PageTitle>

<div class="characters-container">
    @if (selected == null)
    {
        <header class="page-header">
            <button type="button" class="back-btn" @onclick='() => Navigation.NavigateTo("")'>
                ← Home
            </button>
            <h1 class="page-title">Personaggi</h1>
        </header>
    }

    <DbErrorBanner Message="@errorMessage" OnDismiss="@(() => errorMessage = null)" />

    @switch (mode)
    {
        case ViewMode.Loading:
            <LoadingSpinner />
            break;

        case ViewMode.Empty:
            <div class="empty-state">
                <div class="empty-icon">🗡️</div>
                <p class="empty-text">Non hai ancora un personaggio.</p>
                <button type="button" class="primary-btn" @onclick="OpenCreateForm">
                    Crea Personaggio
                </button>
            </div>
            break;

        case ViewMode.List:
            <div class="list-view">
                @if (characters.Count == 0)
                {
                    <div class="empty-state">
                        <div class="empty-icon">🗡️</div>
                        <p class="empty-text">Nessun personaggio in questa campagna.</p>
                        <button type="button" class="primary-btn" @onclick="OpenCreateForm">
                            Crea Personaggio
                        </button>
                    </div>
                }
                else
                {
                    <div class="char-list">
                        @foreach (var c in characters)
                        {
                            <button type="button" class="list-card" @onclick="() => OpenDetailAsync(c)">
                                <div class="list-name">@c.Name</div>
                                <div class="list-meta">Liv @c.Level · @c.Class · @c.Race</div>
                                <div class="list-hp">PF @c.HitPoints / @c.MaxHitPoints</div>
                            </button>
                        }
                    </div>
                }
            </div>
            break;

        case ViewMode.Detail when selected is not null:
            <div class="char-sheet">
                @* ===== Header unificato ===== *@
                <div class="character-header">
                    <button class="header-btn back-btn" @onclick="GoBack" aria-label="Indietro">←</button>
                    <div class="character-title">
                        <h1 class="character-name">@selected.Name</h1>
                        <p class="character-subtitle">
                            Liv @selected.Level · @selected.Class@(string.IsNullOrWhiteSpace(selected.Subclass) ? "" : $" {selected.Subclass}") · @selected.Race
                        </p>
                    </div>
                    @if (CanEdit)
                    {
                        <button class="header-btn edit-btn" @onclick="StartEdit" aria-label="Modifica">✎</button>
                    }
                </div>

                @* ===== Valori del turno + tab: un solo blocco che resta in cima =====
                   Sticky sul gruppo e non sulle due parti separate: due elementi sticky
                   impilati richiederebbero di sapere l'altezza del primo per calcolare il `top`
                   del secondo, e quell'altezza cambia con la larghezza dello schermo (i PF vanno
                   a capo sotto i 360px). *@
                <div class="sheet-sticky">
                <CharacterVitalsBar Character="@selected" CanEdit="@CanEdit" OnChanged="@SaveCharacterAsync" />

                <div class="tab-bar">
                    <button class="tab-item @(activeTab == "rolls" ? "active" : "")" @onclick='() => activeTab = "rolls"'>
                        <span class="tab-icon">⚔</span>
                        <span class="tab-label">Tiri</span>
                    </button>
                    <button class="tab-item @(activeTab == "bio" ? "active" : "")" @onclick='() => activeTab = "bio"'>
                        <span class="tab-icon">📖</span>
                        <span class="tab-label">Scheda</span>
                    </button>
                    <button class="tab-item @(activeTab == "items" ? "active" : "")" @onclick='() => activeTab = "items"'>
                        <span class="tab-icon">🎒</span>
                        <span class="tab-label">Zaino</span>
                    </button>
                    @if (!string.IsNullOrWhiteSpace(selected.SpellcastingAbility))
                    {
                        <button class="tab-item @(activeTab == "magic" ? "active" : "")" @onclick='() => activeTab = "magic"'>
                            <span class="tab-icon">✨</span>
                            <span class="tab-label">Magia</span>
                        </button>
                    }
                </div>
                </div>

                <div class="tab-content">

                @* ===================== TAB TIRI =====================
                   Tutto ciò che si tira o si spende in un turno: la fascia con velocità e
                   ispirazione, i dadi vita, i TS contro morte, le armi, e poi le sei
                   caratteristiche con tiri salvezza e abilità. Le due metà restano due componenti:
                   qui si compongono, non si fondono. *@
                @if (activeTab == "rolls")
                {
                    <CharacterCombatTab Character="@selected" CanEdit="@CanEdit" OnChanged="@SaveCharacterAsync"
                                        Weapons="@inventoryItems.Where(i => string.Equals(i.ItemType, "weapon", StringComparison.OrdinalIgnoreCase)).ToList()" />
                    <CharacterStatsTab Character="@selected" CanEdit="@CanEdit" OnChanged="@SaveCharacterAsync" />
                }

                @* ===================== TAB SCHEDA ===================== *@
                @if (activeTab == "bio")
                {
                    <CharacterBioTab Character="@selected" CanEdit="@CanEdit" OnSaveNotes="@SaveNotesAsync"
                                     ClassProgressionText="@ProgressioneClasseSelezionata"
                                     Subclass="@SottoclasseSelezionata"
                                     OnDelete="@DeleteSelectedAsync" IsBusy="@isBusy" />
                }

                @* ===================== TAB ZAINO ===================== *@
                @if (activeTab == "items")
                {
                    <CharacterItemsTab Character="@selected" CanEdit="@CanEdit" Items="@inventoryItems"
                                       IsLoading="@isLoadingInventory" OnChanged="@SaveCharacterAsync"
                                       OnInventoryChanged="@ReloadInventoryAsync" OnError="@SetError" />
                }

                @* ===================== TAB MAGIA ===================== *@
                @if (activeTab == "magic" && !string.IsNullOrWhiteSpace(selected.SpellcastingAbility))
                {
                    <CharacterMagicTab Character="@selected" CanEdit="@CanEdit" OnChanged="@SaveCharacterAsync"
                                       AllSpells="@allSpells" PackageSpells="@packageSpells" OnError="@SetError" />
                }

                </div>
            </div>
            break;

        case ViewMode.Form:
            @* L'eliminazione sta in fondo alla tab «Scheda», non qui: si cerca guardando il
               personaggio, non entrando in modifica. *@
            <CharacterEditForm Draft="@editDraft" Classes="@classes" Races="@races"
                               ClassPackages="@packageClasses"
                               IsBusy="@isBusy" OnSave="@SaveFormAsync" OnCancel="@CancelForm" />
            break;
    }

    @* Creazione personaggio: per OGNI membro (player e master), in ogni vista tranne il form. *@
    @if (mode is ViewMode.List or ViewMode.Empty or ViewMode.Detail)
    {
        <button type="button" class="fab" @onclick="OpenCreateForm" title="Nuovo personaggio" aria-label="Nuovo personaggio">
            +
        </button>
    }
</div>

@code {
    private enum ViewMode { Loading, Empty, List, Detail, Form }

    // Precompilato da CharacterWizard (pagina /characters/nuovo) dopo la creazione: apre subito
    // il dettaglio del PG appena nato invece di lasciare l'utente sulla lista.
    [SupplyParameterFromQuery] public string? Id { get; set; }

    private ViewMode mode = ViewMode.Loading;
    private List<Character> characters = new();
    private Character? selected;
    private Character editDraft = new();
    private List<Race> races = new();
    private List<CharacterClass> classes = new();

    private List<InventoryItem> inventoryItems = new();
    private bool isLoadingInventory;

    // Catalogo globale incantesimi (caricato una sola volta, in cache); passato a CharacterMagicTab.
    // Gli incantesimi del singolo PG li gestisce CharacterMagicTab.
    private List<Spell> allSpells = new();
    private List<PackageSpell> packageSpells = new();
    private bool spellsLoaded;

    // Classi del pacchetto: servono per mostrare i privilegi anche a chi NON ha importato le classi
    // nella campagna, che è il caso normale. Le righe di database restano la fonte prioritaria.
    private List<PackageClass> packageClasses = new();

    /// <summary>La sottoclasse del PG risolta, da qualunque sorgente: la colonna della riga di
    /// campagna se c'è, altrimenti il manuale (v. <see cref="SubclassCatalog.Disponibili"/>). Null
    /// se il nome è scritto a mano, o se la classe non ne offre nessuna.
    ///
    /// Dal 2026-08-01 non dipende più da <see cref="ClassProgression.ClasseDelManuale"/>: quel
    /// criterio guardava solo il manuale, e una classe del tavolo — o importata e poi arricchita a
    /// mano — con le proprie sottoclassi restava sempre senza privilegi da mostrare qui, anche
    /// quando il menu di modifica li offriva.</summary>
    private PackageSubclass? SottoclasseSelezionata
        => selected is null
            ? null
            : SubclassCatalog.Trova(classes, packageClasses, selected.Class, selected.Subclass);

    /// <summary>Tabella dei livelli della classe del PG aperto; la regola di precedenza sta
    /// nell'helper puro, qui restano solo le due collezioni già caricate.</summary>
    private string? ProgressioneClasseSelezionata
        => selected is null ? null : ClassProgression.Risolvi(classes, packageClasses, selected.Class);

    // ===== Navigazione a tab della vista detail =====
    // valori: rolls | bio | items | magic
    private string activeTab = "rolls";

    private bool isBusy;
    private string? errorMessage;

    private bool CanEdit =>
        selected is not null && AccessControl.CanEdit(CurrentUser.IsMaster, selected.OwnerId, CurrentUser.UserId);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CurrentUser.EnsureLoadedAsync();

            if (string.IsNullOrEmpty(CurrentUser.UserId) || string.IsNullOrEmpty(CurrentUser.CampaignId))
            {
                // Non loggato (AuthRedirect interviene) o nessuna campagna attiva.
                mode = ViewMode.Empty;
                return;
            }

            // Tutti i personaggi della campagna; il permesso di modifica è per-personaggio (CanEdit).
            var charsFetch = CharacterRepository.GetCharactersForCampaignAsync(CurrentUser.CampaignId);
            var racesTask = RaceRepository.GetRacesForCampaignAsync(CurrentUser.CampaignId);
            var classesTask = ClassRepository.GetClassesForCampaignAsync(CurrentUser.CampaignId);

            await Task.WhenAll(charsFetch, racesTask, classesTask);

            characters = charsFetch.Result;
            races = racesTask.Result;
            classes = classesTask.Result;

            await UpdateModeFromCharactersAsync();

            // Rientro dal wizard di creazione: apre subito il PG appena creato, sia in lista
            // (master, o giocatore con più PG) sia quando il caso singolo sopra ha già scelto
            // un altro personaggio.
            if (!string.IsNullOrEmpty(Id))
            {
                var justCreated = characters.FirstOrDefault(c => c.Id == Id);

                // Solo se non è GIÀ quello aperto: con un solo personaggio in campagna —
                // il caso del giocatore che rientra dal wizard, cioè il percorso più frequente —
                // UpdateModeFromCharactersAsync lo ha appena aperto, e riaprirlo qui rifarebbe
                // da capo il caricamento dell'inventario.
                if (justCreated is not null && !ReferenceEquals(selected, justCreated))
                    await OpenDetailAsync(justCreated);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore caricamento: {ex.Message}";
            mode = ViewMode.Empty;
        }
    }

    private async Task UpdateModeFromCharactersAsync()
    {
        if (CurrentUser.IsMaster)
        {
            mode = ViewMode.List;
        }
        else if (characters.Count == 0)
        {
            mode = ViewMode.Empty;
        }
        else if (characters.Count == 1)
        {
            await OpenDetailAsync(characters[0]);
        }
        else
        {
            mode = ViewMode.List;
        }
    }

    private async Task OpenDetailAsync(Character c)
    {
        selected = c;
        mode = ViewMode.Detail;
        activeTab = "rolls";
        await LoadInventoryAsync(c.Id);
        await EnsureSpellCatalogAsync();
        await EnsureClassPackageAsync();
    }

    // Le classi del pacchetto, tutte: non la vista unita, che nasconde le voci già coperte da una
    // riga di campagna. Chi ha importato le classi PRIMA che l'import portasse la tabella dei
    // livelli ha righe senza privilegi, e la vista unita lascerebbe quel PG senza nulla da mostrare.
    // Nessun traffico in più: il pacchetto è già stato scaricato qui sopra e resta in cache.
    private async Task EnsureClassPackageAsync()
    {
        if (packageClasses.Count > 0) return;
        try
        {
            var pacchetto = await Catalog.GetPackageAsync();
            if (pacchetto is not null) packageClasses = pacchetto.Classes;
        }
        catch (Exception ex)
        {
            // Non blocca la scheda: senza tabella dei livelli il resto del personaggio è intatto.
            errorMessage = $"Errore caricamento privilegi di classe: {ex.Message}";
        }
    }

    // Carica catalogo globale (una sola volta) + incantesimi del PG, solo per gli incantatori.
    // Carica una sola volta il catalogo globale incantesimi (per il SpellPicker di CharacterMagicTab e per il
    // form). Gli incantesimi del singolo PG li carica il componente Magic in OnParametersSet.
    private async Task EnsureSpellCatalogAsync()
    {
        if (spellsLoaded) return;
        try
        {
            var vistaIncantesimi = await Catalog.GetSpellsAsync(CurrentUser.CampaignId ?? string.Empty);
            allSpells = vistaIncantesimi.DbRows.ToList();
            packageSpells = vistaIncantesimi.PackageEntries.ToList();
            spellsLoaded = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore caricamento catalogo incantesimi: {ex.Message}";
        }
    }

    private void GoBack()
    {
        selected = null;
        BackToListOrEmpty();
    }

    private void StartEdit() => OpenEditForm();

    private async Task LoadInventoryAsync(string characterId)
    {
        isLoadingInventory = true;
        try
        {
            inventoryItems = await InventoryRepository.GetInventoryForCharacterAsync(characterId);
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore caricamento inventario: {ex.Message}";
            inventoryItems = new();
        }
        finally
        {
            isLoadingInventory = false;
        }
    }

    // Ricarica l'inventario dopo una modifica strutturale di CharacterItemsTab (add/delete),
    // così anche le armi mostrate nel tab Combat restano allineate.
    private async Task ReloadInventoryAsync()
    {
        if (selected is not null) await LoadInventoryAsync(selected.Id);
    }

    private void SetError(string? message) => errorMessage = message;

    private void BackToListOrEmpty()
    {
        if (CurrentUser.IsMaster || characters.Count > 1)
        {
            mode = ViewMode.List;
        }
        else if (characters.Count == 0)
        {
            mode = ViewMode.Empty;
        }
        else
        {
            Navigation.NavigateTo("");
        }
    }

    // La creazione guidata vive nella sua pagina dedicata (§ wizard principiante): un passo alla
    // volta, con spiegazioni e collegamento a specie/classe/background del catalogo. Qui restava
    // solo la modifica di un PG esistente (ViewMode.Form/CharacterEditForm), invariata.
    // Percorso RELATIVO, senza '/' iniziale: in produzione il <base href> è /dnd-companion-app/,
    // e uno slash iniziale porterebbe fuori dal sottopercorso di GitHub Pages (in locale, dove la
    // base è '/', il difetto non si vedrebbe). Stessa convenzione degli href di BottomNav.
    private void OpenCreateForm() => Navigation.NavigateTo("characters/nuovo");

    private void OpenEditForm()
    {
        if (selected is null) return;
        editDraft = CloneCharacter(selected);
        mode = ViewMode.Form;
    }

    private void CancelForm()
    {
        if (selected is not null)
        {
            mode = ViewMode.Detail;
        }
        else if (CurrentUser.IsMaster || characters.Count > 0)
        {
            mode = ViewMode.List;
        }
        else
        {
            mode = ViewMode.Empty;
        }
    }

    private async Task DeleteSelectedAsync()
    {
        // Speculare a characters_delete: proprietario o master. Senza il permesso il server non
        // cancella e non protesta, quindi la finta riuscita si eviterebbe solo qui.
        if (selected is null || !CanEdit || isBusy) return;

        var nome = string.IsNullOrWhiteSpace(selected.Name) ? "questo personaggio" : $"\"{selected.Name}\"";
        var confermato = await Confirm.ShowAsync(
            $"Eliminare {nome}? Spariscono anche il suo inventario e i suoi incantesimi.");
        if (!confermato) return;

        // Ricontrollato dopo la conferma: la finestra di dialogo è asincrona, e nel frattempo una
        // prima eliminazione può essere arrivata in fondo e aver azzerato `selected`.
        if (selected is null || isBusy) return;

        var id = selected.Id;
        isBusy = true;
        errorMessage = null;
        var cancellato = false;
        try
        {
            await CharacterRepository.DeleteCharacterAsync(id);
            cancellato = true;

            // Riletto dal server invece che rimosso dalla lista in memoria: se la RLS ha rifiutato
            // la cancellazione PostgREST non protesta — elimina zero righe e risponde bene — e senza
            // la rilettura l'utente vedrebbe sparire un personaggio ancora vivo.
            characters = await CharacterRepository.GetCharactersForCampaignAsync(
                CurrentUser.CampaignId ?? string.Empty);

            var sopravvissuto = characters.FirstOrDefault(c => c.Id == id);
            if (sopravvissuto is not null)
            {
                errorMessage = "Il personaggio non è stato eliminato: non hai i permessi per farlo.";
                await OpenDetailAsync(sopravvissuto);
                return;
            }

            selected = null;
            editDraft = new Character();
            Toasts.ShowSuccess("Personaggio eliminato");
            await UpdateModeFromCharactersAsync();
        }
        catch (Exception ex)
        {
            // Due punti di fallimento distinti. Se la cancellazione è già passata e a cadere è la
            // rilettura, dire "errore eliminazione" manderebbe l'utente a ritentare su un
            // personaggio che non esiste più.
            errorMessage = cancellato
                ? $"Personaggio eliminato, ma l'elenco non si è aggiornato: {ex.Message}"
                : $"Errore eliminazione: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SaveFormAsync()
    {
        if (string.IsNullOrWhiteSpace(editDraft.Name))
        {
            Toasts.ShowError("Il nome è obbligatorio");
            return;
        }
        if (editDraft.MaxHitPoints < 1)
        {
            Toasts.ShowError("Gli HP massimi devono essere almeno 1");
            return;
        }
        if (editDraft.HitPoints > editDraft.MaxHitPoints)
        {
            editDraft.HitPoints = editDraft.MaxHitPoints;
        }

        CharacterNormalizer.Normalize(editDraft);

        isBusy = true;
        errorMessage = null;
        try
        {
            Character? saved;
            if (string.IsNullOrEmpty(editDraft.Id))
            {
                editDraft.OwnerId = CurrentUser.UserId ?? string.Empty;
                editDraft.CampaignId = CurrentUser.CampaignId ?? string.Empty;
                saved = await CharacterRepository.CreateCharacterAsync(editDraft);
            }
            else
            {
                saved = await CharacterRepository.UpdateCharacterAsync(editDraft);
            }

            if (saved is null)
            {
                errorMessage = "Il server non ha restituito il personaggio salvato.";
                return;
            }

            var idx = characters.FindIndex(c => c.Id == saved.Id);
            if (idx >= 0) characters[idx] = saved;
            else characters.Add(saved);

            Toasts.ShowSuccess("Personaggio salvato");
            await OpenDetailAsync(saved);
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore salvataggio: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    // Persistenza delle note (invocata da CharacterBioTab via OnSaveNotes); il draft e il flag di
    // salvataggio vivono nel componente.
    private async Task SaveNotesAsync(string text)
    {
        if (selected is null || !CanEdit) return;

        var previous = selected.Notes;
        selected.Notes = text;
        errorMessage = null;
        try
        {
            var saved = await CharacterRepository.UpdateCharacterAsync(selected);
            if (saved is not null)
            {
                selected.Notes = saved.Notes;
                SyncListFromSelected();
            }
        }
        catch (Exception ex)
        {
            selected.Notes = previous;
            errorMessage = $"Errore salvataggio note: {ex.Message}";
        }
    }

    private async Task SaveCharacterAsync()
    {
        if (selected is null) return;

        errorMessage = null;
        try
        {
            var saved = await CharacterRepository.UpdateCharacterAsync(selected);
            if (saved is not null)
            {
                SyncListFromSelected();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore salvataggio caratteristiche: {ex.Message}";
        }
    }

    private void SyncListFromSelected()
    {
        if (selected is null) return;
        var idx = characters.FindIndex(c => c.Id == selected.Id);
        if (idx >= 0) characters[idx] = selected;
    }


    // Copia profonda di TUTTI i campi: il form di modifica deve fare round-trip
    // completo, altrimenti salvando si azzerano i campi non clonati.
    private static Character CloneCharacter(Character c) => new()
    {
        Id = c.Id,
        OwnerId = c.OwnerId,
        CampaignId = c.CampaignId,
        Name = c.Name,
        Class = c.Class,
        Race = c.Race,
        Level = c.Level,
        HitPoints = c.HitPoints,
        MaxHitPoints = c.MaxHitPoints,
        ArmorClass = c.ArmorClass,
        Strength = c.Strength,
        Dexterity = c.Dexterity,
        Constitution = c.Constitution,
        Intelligence = c.Intelligence,
        Wisdom = c.Wisdom,
        Charisma = c.Charisma,
        Notes = c.Notes,
        CreatedAt = c.CreatedAt,

        // Identità estesa
        Background = c.Background,
        BackgroundAbilityChoice = c.BackgroundAbilityChoice,
        Subclass = c.Subclass,
        Alignment = c.Alignment,
        ExperiencePoints = c.ExperiencePoints,
        Size = c.Size,
        Speed = c.Speed,
        Appearance = c.Appearance,
        Backstory = c.Backstory,
        Languages = c.Languages,

        // HP avanzati e stato in combattimento
        TempHitPoints = c.TempHitPoints,
        HitDiceMax = c.HitDiceMax,
        HitDiceSpent = c.HitDiceSpent,
        DeathSaveSuccesses = c.DeathSaveSuccesses,
        DeathSaveFailures = c.DeathSaveFailures,
        HeroicInspiration = c.HeroicInspiration,

        // Competenze tiri salvezza
        ProfSaveStrength = c.ProfSaveStrength,
        ProfSaveDexterity = c.ProfSaveDexterity,
        ProfSaveConstitution = c.ProfSaveConstitution,
        ProfSaveIntelligence = c.ProfSaveIntelligence,
        ProfSaveWisdom = c.ProfSaveWisdom,
        ProfSaveCharisma = c.ProfSaveCharisma,

        // Skill: competenza
        ProfAthletics = c.ProfAthletics,
        ProfAcrobatics = c.ProfAcrobatics,
        ProfSleightOfHand = c.ProfSleightOfHand,
        ProfStealth = c.ProfStealth,
        ProfArcana = c.ProfArcana,
        ProfHistory = c.ProfHistory,
        ProfInvestigation = c.ProfInvestigation,
        ProfNature = c.ProfNature,
        ProfReligion = c.ProfReligion,
        ProfAnimalHandling = c.ProfAnimalHandling,
        ProfInsight = c.ProfInsight,
        ProfMedicine = c.ProfMedicine,
        ProfPerception = c.ProfPerception,
        ProfSurvival = c.ProfSurvival,
        ProfDeception = c.ProfDeception,
        ProfIntimidation = c.ProfIntimidation,
        ProfPerformance = c.ProfPerformance,
        ProfPersuasion = c.ProfPersuasion,

        // Skill: expertise
        ExpAthletics = c.ExpAthletics,
        ExpAcrobatics = c.ExpAcrobatics,
        ExpSleightOfHand = c.ExpSleightOfHand,
        ExpStealth = c.ExpStealth,
        ExpArcana = c.ExpArcana,
        ExpHistory = c.ExpHistory,
        ExpInvestigation = c.ExpInvestigation,
        ExpNature = c.ExpNature,
        ExpReligion = c.ExpReligion,
        ExpAnimalHandling = c.ExpAnimalHandling,
        ExpInsight = c.ExpInsight,
        ExpMedicine = c.ExpMedicine,
        ExpPerception = c.ExpPerception,
        ExpSurvival = c.ExpSurvival,
        ExpDeception = c.ExpDeception,
        ExpIntimidation = c.ExpIntimidation,
        ExpPerformance = c.ExpPerformance,
        ExpPersuasion = c.ExpPersuasion,

        // Tratti, talenti, privilegi
        SpeciesTraits = c.SpeciesTraits,
        ClassFeatures = c.ClassFeatures,
        Feats = c.Feats,

        // Denari
        CopperPieces = c.CopperPieces,
        SilverPieces = c.SilverPieces,
        ElectrumPieces = c.ElectrumPieces,
        GoldPieces = c.GoldPieces,
        PlatinumPieces = c.PlatinumPieces,

        // Sintonia oggetti magici
        AttunedItem1 = c.AttunedItem1,
