    private async Task DeleteSelectedAsync()
    {
        // Speculare a characters_delete: proprietario o master. Senza il permesso il server non
        // cancella e non protesta, quindi la finta riuscita si eviterebbe solo qui.
        if (selected is null || !CanEdit || isBusy || isSavingCharacter) return;

        var nome = string.IsNullOrWhiteSpace(selected.Name) ? "questo personaggio" : $"\"{selected.Name}\"";
        var confermato = await Confirm.ShowAsync(
            $"Eliminare {nome}? Spariscono anche il suo inventario e i suoi incantesimi.");
        if (!confermato) return;

        // Ricontrollato dopo la conferma: la finestra di dialogo è asincrona, e nel frattempo una
        // prima eliminazione può essere arrivata in fondo e aver azzerato `selected`.
        if (selected is null || isBusy) return;

        var id = selected.Id;
        isBusy = true;
        errorMessage = null;
        var cancellato = false;
        try
        {
            await CharacterRepository.DeleteCharacterAsync(id);
            cancellato = true;

            // Riletto dal server invece che rimosso dalla lista in memoria: se la RLS ha rifiutato
            // la cancellazione PostgREST non protesta — elimina zero righe e risponde bene — e senza
            // la rilettura l'utente vedrebbe sparire un personaggio ancora vivo.
            characters = await CharacterRepository.GetCharactersForCampaignAsync(
                CurrentUser.CampaignId ?? string.Empty);

            var sopravvissuto = characters.FirstOrDefault(c => c.Id == id);
            if (sopravvissuto is not null)
            {
                errorMessage = "Il personaggio non è stato eliminato: non hai i permessi per farlo.";
                await OpenDetailAsync(sopravvissuto);
                return;
            }

            selected = null;
            showHpPanel = false;
            editDraft = new Character();
            Toasts.ShowSuccess("Personaggio eliminato");
            await UpdateModeFromCharactersAsync();
        }
        catch (Exception ex)
        {
            // Due punti di fallimento distinti. Se la cancellazione è già passata e a cadere è la
            // rilettura, dire "errore eliminazione" manderebbe l'utente a ritentare su un
            // personaggio che non esiste più.
            errorMessage = cancellato
                ? $"Personaggio eliminato, ma l'elenco non si è aggiornato: {ex.Message}"
                : $"Errore eliminazione: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SaveFormAsync()
    {
        if (string.IsNullOrWhiteSpace(editDraft.Name))
        {
            Toasts.ShowError("Il nome è obbligatorio");
            return;
        }
        if (editDraft.MaxHitPoints < 1)
        {
            Toasts.ShowError("Gli HP massimi devono essere almeno 1");
            return;
        }
        if (editDraft.HitPoints > editDraft.MaxHitPoints)
        {
            editDraft.HitPoints = editDraft.MaxHitPoints;
        }

        CharacterNormalizer.Normalize(editDraft);

        isBusy = true;
        errorMessage = null;
        try
        {
            Character? saved;
            if (string.IsNullOrEmpty(editDraft.Id))
            {
                editDraft.OwnerId = CurrentUser.UserId ?? string.Empty;
                editDraft.CampaignId = CurrentUser.CampaignId ?? string.Empty;
                saved = await CharacterRepository.CreateCharacterAsync(editDraft);
            }
            else
            {
                saved = await CharacterRepository.UpdateCharacterAsync(editDraft);
            }

            if (saved is null)
            {
                errorMessage = "Il server non ha restituito il personaggio salvato.";
                return;
            }

            var idx = characters.FindIndex(c => c.Id == saved.Id);
            if (idx >= 0) characters[idx] = saved;
            else characters.Add(saved);

            Toasts.ShowSuccess("Personaggio salvato");
            await OpenDetailAsync(saved);
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore salvataggio: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    // Persistenza delle note (invocata da CharacterBioTab via OnSaveNotes); il draft e il flag di
    // salvataggio vivono nel componente.
    private async Task SaveNotesAsync(string text)
    {
        if (selected is null || !CanEdit) return;

        var previous = selected.Notes;
        selected.Notes = text;
        errorMessage = null;
        try
        {
            var saved = await CharacterRepository.UpdateCharacterAsync(selected);
            if (saved is not null)
            {
                selected.Notes = saved.Notes;
                SyncListFromSelected();
            }
        }
        catch (Exception ex)
        {
            selected.Notes = previous;
            errorMessage = $"Errore salvataggio note: {ex.Message}";
        }
    }

    // Persistenza dell'addestramento (invocata da CharacterBioTab via OnSaveTraining), stesso schema
    // di SaveNotesAsync qui sopra ma su tre campi invece di uno, e con `pg` catturato prima
    // dell'await: fra il tap su "Salva addestramento" e la risposta di rete l'utente può aprire un
    // altro personaggio (OpenDetailAsync sostituisce `selected`), e un ripristino letto da `selected`
    // scriverebbe questi tre campi dentro la scheda sbagliata — stesso motivo per cui la
    // sincronizzazione in lista, sotto, passa `pg` all'overload di SyncListFromSelected e non si
    // affida al `selected` corrente. isSavingCharacter si legge in guardia E si imposta, con la
    // stessa disciplina di SaveCharacterCoreAsync (v. il commento sul campo): un salvataggio dei PF
    // o un riposo in corso — o viceversa un addestramento in corso — non deve incrociarsi con
    // l'altro sulla stessa riga.
    private async Task SaveTrainingAsync(
        (string ArmorTraining, string WeaponProficiencies, string ToolProficiencies) training)
    {
        if (selected is null || !CanEdit || isSavingCharacter) return;

        var pg = selected;
        var previousArmor = pg.ArmorTraining;
        var previousWeapons = pg.WeaponProficiencies;
        var previousTools = pg.ToolProficiencies;

        pg.ArmorTraining = training.ArmorTraining;
        pg.WeaponProficiencies = training.WeaponProficiencies;
        pg.ToolProficiencies = training.ToolProficiencies;
        errorMessage = null;
        isSavingCharacter = true;
        StateHasChanged();
        try
        {
            var saved = await CharacterRepository.UpdateCharacterAsync(pg);
            if (saved is null)
            {
                pg.ArmorTraining = previousArmor;
                pg.WeaponProficiencies = previousWeapons;
                pg.ToolProficiencies = previousTools;
                errorMessage = "Il server non ha restituito il personaggio salvato.";
                return;
            }

            pg.ArmorTraining = saved.ArmorTraining;
            pg.WeaponProficiencies = saved.WeaponProficiencies;
            pg.ToolProficiencies = saved.ToolProficiencies;
            SyncListFromSelected(pg);
        }
        catch (Exception ex)
        {
            pg.ArmorTraining = previousArmor;
            pg.WeaponProficiencies = previousWeapons;
            pg.ToolProficiencies = previousTools;
            errorMessage = $"Errore salvataggio addestramento: {ex.Message}";
        }
        finally
        {
            isSavingCharacter = false;
            StateHasChanged();
        }
    }

    /// <summary>Il vero salvataggio, con l'ESITO: le RLS nuove legano l'update all'appartenenza
    /// corrente alla campagna, e quando la condizione non combacia (utente rimosso da
    /// campaign_members) PostgREST non solleva un errore — aggiorna zero righe e risponde [], e
    /// UpdateCharacterAsync torna null. Senza controllare `saved`, come faceva la versione
    /// precedente di questo metodo, il chiamante non ha modo di sapere che il database non si è
    /// mosso: da qui l'allineamento a SaveFormAsync, che questo caso lo gestisce già.
    ///
    /// isSavingCharacter lo impostano due punti — questo metodo e SaveTrainingAsync (v. il
    /// commento lì): CharacterVitalsBar e CharacterCombatTab lo leggono via il parametro IsSaving
    /// invece di un booleano locale a testa, cosicché un riposo e un tocco sui PF confermati nello
    /// stesso istante — o in corsa con un salvataggio dell'addestramento — non facciano partire due
    /// scritture in corsa sullo stesso Character (v. il commento sul campo). StateHasChanged è
    /// esplicito perché sia
    /// CharacterVitalsBar sia CharacterCombatTab invocano questo metodo (o il wrapper
    /// SaveCharacterAsync) come Func&lt;Task&lt;bool&gt;&gt;/Task diretto e non come EventCallback:
    /// senza il wrapping di EventCallback, che dopo l'invocazione rirenderizza da sé il "receiver",
    /// il cambio di isSavingCharacter non arriverebbe altrimenti alla UI durante l'attesa di rete.
    /// (CharacterStatsTab/CharacterItemsTab/CharacterMagicTab restano su EventCallback puro tramite
    /// il wrapper: quella magia di re-render la offre comunque il framework, per loro.)</summary>
    private async Task<bool> SaveCharacterCoreAsync()
    {
        if (selected is null) return false;

        isSavingCharacter = true;
        StateHasChanged();
        errorMessage = null;
        try
        {
            var saved = await CharacterRepository.UpdateCharacterAsync(selected);
            if (saved is null)
            {
                errorMessage = "Il server non ha restituito il personaggio salvato.";
                return false;
            }

            SyncListFromSelected();
            return true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore salvataggio caratteristiche: {ex.Message}";
            return false;
        }
        finally
        {
            isSavingCharacter = false;
            StateHasChanged();
        }
    }

    // Wrapper senza esito, per i tab (CharacterStatsTab, CharacterItemsTab, CharacterMagicTab) che
    // si limitano a chiedere il salvataggio via il solito EventCallback e non hanno bisogno di
    // condizionare un proprio messaggio all'esito, a differenza di CharacterVitalsBar (i PF) e
    // CharacterCombatTab (i riposi), che leggono l'esito da SaveCharacterCoreAsync direttamente.
    private Task SaveCharacterAsync() => SaveCharacterCoreAsync();

    /// <summary>Salva/aggiorna un'annotazione su un privilegio (invocato da CharacterCombatTab via
    /// OnSalvaAnnotazione, bollato fino da CharacterFeaturesSection): la voce si fonde in
    /// CharacterFeatures per nome NORMALIZZATO — se esiste già si sostituisce, altrimenti si
    /// aggiunge (v. brief Task 8). Salvataggio con SaveCharacterCoreAsync (lo stesso di
    /// SaveCharacterAsync, che ne è solo l'alias senza esito — v. il commento lì) perché qui, come in
    /// SaveTrainingAsync, "pg" va saputo riportare indietro: CharacterFeaturesSection lascia
    /// esplicitamente "banner/rollback" al genitore (v. il suo SalvaAsync), e senza il controllo
    /// dell'esito un update rifiutato dalle RLS (PostgREST torna [], nessuna eccezione) lascerebbe
    /// l'annotazione mutata solo in locale, pronta a essere persistita dal primo salvataggio
    /// successivo riuscito su QUALUNQUE altro campo.</summary>
    private async Task SalvaAnnotazionePrivilegioAsync(CharacterFeature feature)
    {
        if (selected is null || !CanEdit || isSavingCharacter) return;

        var pg = selected;
        var precedente = new List<CharacterFeature>(pg.CharacterFeatures);
        var chiave = CatalogKey.NormalizeName(feature.Nome);
        var idx = pg.CharacterFeatures.FindIndex(f => CatalogKey.NormalizeName(f.Nome) == chiave);
        if (idx >= 0) pg.CharacterFeatures[idx] = feature;
        else pg.CharacterFeatures.Add(feature);

        if (!await SaveCharacterCoreAsync())
        {
            pg.CharacterFeatures = precedente;
        }
    }

    /// <summary>Elimina una voce propria per nome normalizzato. Le voci DERIVATE (classe,
    /// sottoclasse, talento) non passano da qui: CharacterFeaturesSection esclude già il pulsante
    /// Elimina per loro (v. la sua guardia "voce.Origine != propria"). V. il commento su
    /// SalvaAnnotazionePrivilegioAsync per il motivo di SaveCharacterCoreAsync invece del wrapper.</summary>
    private async Task EliminaVocePropriaPrivilegioAsync(VistaPrivilegio voce)
    {
        if (selected is null || !CanEdit || isSavingCharacter) return;

        var pg = selected;
        var precedente = new List<CharacterFeature>(pg.CharacterFeatures);
        var chiave = CatalogKey.NormalizeName(voce.Nome);
        pg.CharacterFeatures.RemoveAll(f => CatalogKey.NormalizeName(f.Nome) == chiave);

        if (!await SaveCharacterCoreAsync())
        {
            pg.CharacterFeatures = precedente;
        }
    }

    private void SyncListFromSelected()
    {
        if (selected is null) return;
        SyncListFromSelected(selected);
    }

    // Overload esplicito per chi cattura `pg` prima di un await (v. SaveTrainingAsync): se nel
    // frattempo l'utente ha aperto un altro personaggio, `selected` non è più `pg`, e sincronizzare
    // sul primo scriverebbe la riga sbagliata nella lista invece di quella appena salvata.
    private void SyncListFromSelected(Character character)
    {
        var idx = characters.FindIndex(c => c.Id == character.Id);
        if (idx >= 0) characters[idx] = character;
    }

    // ===== Level-up guidato =====
    // Orchestrazione soltanto: il calcolo vive in LevelUpPlanner (helper puro), la presentazione in
    // LevelUpDialog. Qui si prendono i cataloghi già in memoria, si passa tutto al planner e si fa
    // UN salvataggio alla conferma — mai un ricalcolo o una scrittura dentro il dialogo stesso.

    private async Task ApriLivelloUpAsync()
    {
        if (selected is null || !CanEdit || isSavingCharacter || selected.Level >= 20) return;

        mostraSaliAncora = false;
        livelloErrore = null;
        livelloRisposte.Clear();
        livelloTiro = null;

        // Di norma già in cache da OpenDetailAsync: il controllo interno la rende gratuita nel
        // caso comune, e necessaria solo se il caricamento iniziale del pacchetto era fallito.
        await EnsureClassPackageAsync();

        RicalcolaPianoLivello();

        if (livelloPiano is null)
        {
            Toasts.ShowError("Questa classe non ha una tabella dei livelli: modifica la scheda a mano.");
        }
    }

    // Richiamato dal genitore a ogni risposta: il piano NON si aggiorna da solo, perché
    // l'incremento di Costituzione ha effetto retroattivo sui punti ferita già maturati.
    private void RicalcolaPianoLivello()
    {
        if (selected is null)
        {
            livelloPiano = null;
            return;
        }

        var sottoclassi = SubclassCatalog.Disponibili(classes, packageClasses, selected.Class);
        livelloPiano = LevelUpPlanner.Pianifica(
            selected,
            ProgressioneClasseSelezionata,
            sottoclassi,
            Catalog.Feats,
            livelloRisposte,
            livelloTiro,
            DadoVitaClasseSelezionata());
    }

    private void OnLivelloRisposta((string Chiave, Risposta Risposta) e)
    {
        livelloRisposte[e.Chiave] = e.Risposta;
        RicalcolaPianoLivello();
    }

    private void OnLivelloTiro(int? tiro)
    {
        livelloTiro = tiro;
        RicalcolaPianoLivello();
    }

    private void AnnullaLivelloUp() => ChiudiLivelloUp();

    private void ChiudiLivelloUp()
    {
        livelloPiano = null;
        livelloRisposte.Clear();
        livelloTiro = null;
        livelloErrore = null;
        mostraSaliAncora = false;
    }

    /// <summary>Fotografia dei campi che <see cref="LevelUpPlanner.Applica"/> può toccare — la
    /// whitelist del planner, non un elenco indipendente — presa PRIMA di mutare il personaggio.
    /// Serve a <see cref="ConfermaLivelloUpAsync"/> per riportare `selected` esattamente com'era
    /// se il salvataggio fallisce: `selected` è l'istanza viva condivisa con la scheda aperta e con
    /// la riga in `characters`, non una copia, quindi senza questo ripristino un "Annulla" dopo un
    /// errore di rete lascerebbe il livello nuovo scritto lì mentre il database ha ancora quello
    /// vecchio — e il primo salvataggio successivo da un altro tab (il "−" dei PF, "Salva note",
    /// qualunque OnChanged) persisterebbe in silenzio un level-up che l'utente non ha mai
    /// confermato. Non toglierlo perché "sembra ridondante" col commento sull'idempotenza di
    /// Applica: quella guardia protegge da un SECONDO livello applicato allo stesso Character,
    /// non da un livello mai confermato lasciato lì dopo un errore.
    ///
    /// Non copre gli effetti di <see cref="CharacterNormalizer.Normalize"/> (chiamata in coda ad
    /// Applica) su campi fuori da questa whitelist — trim di testo e clamp numerici. Accettato: su
    /// un personaggio già salvato in precedenza quei campi arrivano già normalizzati, quindi
    /// Normalize non ha nulla da cambiare; il residuo teorico (uno spazio finale tolto da un campo
    /// mai stato salvato prima) non vale il costo di allargare la whitelist.</summary>
    private sealed record LivelloUpSnapshot(
        int Level, int MaxHitPoints, int HitPoints, string? HitDiceMax,
        int SpellSlots1Max, int SpellSlots2Max, int SpellSlots3Max, int SpellSlots4Max, int SpellSlots5Max,
        int SpellSlots6Max, int SpellSlots7Max, int SpellSlots8Max, int SpellSlots9Max,
        string? Subclass, string? SpellcastingAbility, string? ClassFeatures, string? Feats,
        int Strength, int Dexterity, int Constitution, int Intelligence, int Wisdom, int Charisma)
    {
        public static LivelloUpSnapshot Cattura(Character pg) => new(
            pg.Level, pg.MaxHitPoints, pg.HitPoints, pg.HitDiceMax,
            pg.SpellSlots1Max, pg.SpellSlots2Max, pg.SpellSlots3Max, pg.SpellSlots4Max, pg.SpellSlots5Max,
            pg.SpellSlots6Max, pg.SpellSlots7Max, pg.SpellSlots8Max, pg.SpellSlots9Max,
            pg.Subclass, pg.SpellcastingAbility, pg.ClassFeatures, pg.Feats,
            pg.Strength, pg.Dexterity, pg.Constitution, pg.Intelligence, pg.Wisdom, pg.Charisma);

        public void Ripristina(Character pg)
        {
            pg.Level = Level;
            pg.MaxHitPoints = MaxHitPoints;
            pg.HitPoints = HitPoints;
            pg.HitDiceMax = HitDiceMax;
            pg.SpellSlots1Max = SpellSlots1Max;
            pg.SpellSlots2Max = SpellSlots2Max;
            pg.SpellSlots3Max = SpellSlots3Max;
            pg.SpellSlots4Max = SpellSlots4Max;
            pg.SpellSlots5Max = SpellSlots5Max;
            pg.SpellSlots6Max = SpellSlots6Max;
            pg.SpellSlots7Max = SpellSlots7Max;
            pg.SpellSlots8Max = SpellSlots8Max;
            pg.SpellSlots9Max = SpellSlots9Max;
            pg.Subclass = Subclass;
            pg.SpellcastingAbility = SpellcastingAbility;
            pg.ClassFeatures = ClassFeatures;
            pg.Feats = Feats;
            pg.Strength = Strength;
            pg.Dexterity = Dexterity;
            pg.Constitution = Constitution;
            pg.Intelligence = Intelligence;
            pg.Wisdom = Wisdom;
            pg.Charisma = Charisma;
        }
    }

    private async Task ConfermaLivelloUpAsync()
    {
        if (selected is null || livelloPiano is null || livelloInCorso || isSavingCharacter) return;
        if (!livelloPiano.Completo(livelloRisposte)) return;

        var piano = livelloPiano;
        var pg = selected;

        // Presa PRIMA di Applica: è lo stato a cui tornare se il salvataggio fallisce (v. il
        // commento sul record qui sopra). Ripristinarlo qui sana anche il ricalcolo del piano dopo
        // un ritentativo: con `pg` tornato al livello vecchio, RicalcolaPianoLivello (richiamata da
        // OnLivelloTiro/OnLivelloRisposta) riparte da lì invece di proporre un secondo salto sopra
        // un livello mai confermato.
        var snapshot = LivelloUpSnapshot.Cattura(pg);

        livelloInCorso = true;
        livelloErrore = null;
        try
        {
            // Muta l'istanza corrente, non una copia: i tab già aperti la tengono viva. Se questo
            // stesso salvataggio viene ritentato dopo un errore di rete, Applica trova pg.Level già
            // uguale a piano.LivelloA e non rimuta nulla — la guardia di idempotenza che la rende
            // sicura da richiamare due volte sullo stesso Character.
            LevelUpPlanner.Applica(pg, piano, livelloRisposte);

            var saved = await CharacterRepository.UpdateCharacterAsync(pg);
            if (saved is null)
            {
                snapshot.Ripristina(pg);
                livelloErrore = "Il server non ha restituito il personaggio salvato.";
                return;
            }

            SyncListFromSelected();
            ChiudiLivelloUp();

            var messaggio = $"Ora sei livello {saved.Level}.";
            if (piano.CerchioSbloccato is int cerchio)
            {
                messaggio += $" Hai sbloccato il {cerchio}° cerchio di incantesimi.";
                // Rimando concreto al tab Magia, non solo nominato nel testo del toast — ma non se
                // l'utente è sul tab Scheda: CharacterBioTab tiene le note non salvate solo in
                // locale, e smontarlo per lo switch le butterebbe via senza preavviso. Il messaggio
                // nel toast resta comunque, switch di tab o no.
                if (!string.IsNullOrWhiteSpace(saved.SpellcastingAbility) && activeTab != "bio")
                    activeTab = "magic";
            }
            Toasts.ShowSuccess(messaggio);

            mostraSaliAncora = saved.Level < 20;
        }
        catch (Exception ex)
        {
            // Il dialogo resta aperto (livelloPiano non viene toccato) e le risposte restano
            // intatte: un nuovo tap su "Diventa livello N" ritenta lo stesso salvataggio. `pg` è
            // già stato riportato allo stato precedente (v. lo snapshot sopra), quindi il
            // ritentativo riparte dallo stesso punto di prima, non da un livello già mutato.
            snapshot.Ripristina(pg);
            livelloErrore = $"Errore salvataggio livello: {ex.Message}";
        }
        finally
        {
            livelloInCorso = false;
        }
    }

    /// <summary>Il dado vita della classe, per il calcolo dei punti ferita: dalla riga di campagna
    /// omonima se la dichiara, altrimenti dal manuale. Vince sul dado dedotto da
    /// <see cref="Character.HitDiceMax"/> dentro il planner — un Barbaro con HitDiceMax vuoto o
    /// scritto storto non deve vedersi proporre punti ferita calcolati su d8.</summary>
    private string? DadoVitaClasseSelezionata()
    {
        if (selected is null) return null;
        var chiave = CatalogKey.NormalizeName(selected.Class);

        var dallaCampagna = classes.FirstOrDefault(c =>
            CatalogKey.NormalizeName(c.Name) == chiave && !string.IsNullOrWhiteSpace(c.HitDie));
        if (dallaCampagna is not null) return dallaCampagna.HitDie;

        var dalManuale = packageClasses.FirstOrDefault(c =>
            CatalogKey.NormalizeName(c.Name) == chiave && !string.IsNullOrWhiteSpace(c.HitDie));
        return dalManuale?.HitDie;
    }

    // Copia profonda di TUTTI i campi: il form di modifica deve fare round-trip
    // completo, altrimenti salvando si azzerano i campi non clonati. Il corpo vive ora in
    // Services/CharacterClone.cs (anche CreationChain ne ha bisogno per non mutare il baseline
    // che riceve): questa resta una delega, `internal` (non `private`) per il test di round-trip
    // in Tests/CharacterCloneTests.cs (InternalsVisibleTo già configurato nel .csproj), che
    // confronta per riflessione tutte le proprietà pubbliche così il prossimo campo dimenticato
    // fa fallire il test invece di azzerare dati in produzione al primo salvataggio dal form di
    // modifica.
    internal static Character CloneCharacter(Character c) => CharacterClone.Clona(c);

}
