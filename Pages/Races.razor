@page "/races"
@using DndCompanion.Models
@using DndCompanion.Models.Packages
@implements IDisposable
@inject IRaceRepository RaceRepository
@inject IProfileRepository ProfileRepository
@inject ICatalogService Catalog
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ToastService Toasts
@inject ConfirmService Confirm

<PageTitle>Razze - D&amp;D Companion</PageTitle>

<div class="races-container">
    <header class="page-header">
        <button type="button" class="back-btn" @onclick='() => Navigation.NavigateTo("")'>
            ← Home
        </button>
        <h1 class="page-title">Razze</h1>
    </header>

    <DbErrorBanner Message="@errorMessage" OnDismiss="@(() => errorMessage = null)" />

    @if (mode == ViewMode.Form)
    {
        <div class="form-view">
            <div class="form-top">
                <button type="button" class="back-link" @onclick="CancelForm">← Annulla</button>
            </div>

            <h2 class="form-title">
                @(string.IsNullOrEmpty(editDraft.Id) ? "Nuova Razza" : "Modifica Razza")
            </h2>

            <div class="form-grid">
                <div class="field field-full">
                    <label>Nome</label>
                    <input type="text" class="input" maxlength="80" @bind="editDraft.Name" />
                </div>

                <div class="field field-full">
                    <label>Descrizione</label>
                    <textarea class="input" rows="4" @bind="editDraft.Description"></textarea>
                </div>

                <div class="field">
                    <label>Velocità</label>
                    <input type="number" class="input" min="0" max="@(FormValidation.IsMetric(editDraft.SpeedUnit) ? 36 : 120)" @bind="editDraft.Speed" />
                </div>

                <div class="field">
                    <label>Unità</label>
                    <select class="input" aria-label="Unità di velocità" @bind="editDraft.SpeedUnit">
                        <option value="m">metri</option>
                        <option value="ft">piedi</option>
                    </select>
                </div>

                <div class="field-group field-full">
                    <label class="group-label">Bonus Caratteristiche</label>
                    <div class="stats-inputs">
                        <div class="field stat-field">
                            <label title="Forza">FOR</label>
                            <input type="number" class="input" @bind="editDraft.StrBonus" />
                        </div>
                        <div class="field stat-field">
                            <label title="Destrezza">DES</label>
                            <input type="number" class="input" @bind="editDraft.DexBonus" />
                        </div>
                        <div class="field stat-field">
                            <label title="Costituzione">COS</label>
                            <input type="number" class="input" @bind="editDraft.ConBonus" />
                        </div>
                        <div class="field stat-field">
                            <label title="Intelligenza">INT</label>
                            <input type="number" class="input" @bind="editDraft.IntBonus" />
                        </div>
                        <div class="field stat-field">
                            <label title="Saggezza">SAG</label>
                            <input type="number" class="input" @bind="editDraft.WisBonus" />
                        </div>
                        <div class="field stat-field">
                            <label title="Carisma">CAR</label>
                            <input type="number" class="input" @bind="editDraft.ChaBonus" />
                        </div>
                    </div>
                </div>

                <div class="field field-full">
                    <label>Tratti</label>
                    <textarea class="input" rows="5" @bind="editDraft.Traits"
                              placeholder="Visione notturna, resistenza al veleno, ecc."></textarea>
                </div>

                <div class="field field-full">
                    <label>Lingue</label>
                    <input type="text" class="input" maxlength="200" @bind="editDraft.Languages"
                           placeholder="Comune, Elfico, ..." />
                </div>
            </div>

            <div class="form-actions">
                <button type="button" class="primary-btn" @onclick="SaveFormAsync" disabled="@isBusy">
                    @(isBusy ? "Salvataggio..." : "Salva")
                </button>
                <button type="button" class="secondary-btn" @onclick="CancelForm" disabled="@isBusy">
                    Annulla
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="search-section">
            <input type="text" class="search-input" placeholder="Cerca razza..."
                   @bind="searchInput" @bind:event="oninput" @bind:after="OnSearchInputChangedAsync" />

            <div class="results-info">
                @if (isLoading)
                {
                    <LoadingSpinner Text="Caricamento razze..." />
                }
                else
                {
                    var count = FilteredEntries.Count();
                    <span>@count @(count == 1 ? "razza trovata" : "razze trovate")</span>
                }
            </div>
        </div>

        <div class="races-list">
            @if (!isLoading)
            {
                @foreach (var entry in FilteredEntries)
                {
                    var isExpanded = expandedKey == entry.Key;
                    <div class="race-card @(isExpanded ? "expanded" : "") @(entry.FromAppPackage ? "package-card" : "")">
                        <button type="button" class="card-summary" @onclick="() => ToggleExpand(entry.Key)">
                            <div class="card-main">
                                <div class="card-name">@entry.Name</div>
                                <div class="card-meta">
                                    <span class="speed-badge">Velocità @entry.Speed @(FormValidation.IsMetric(entry.SpeedUnit) ? "m" : "ft")</span>
                                    @{ var author = GetAuthorName(entry.Db?.AddedBy); }
                                    @if (!string.IsNullOrEmpty(author))
                                    {
                                        <span class="author-badge" title="Aggiunta da @author">✎ @author</span>
                                    }
                                    @if (entry.FromAppPackage)
                                    {
                                        <span class="package-badge">Dal manuale</span>
                                    }
                                </div>
                            </div>
                            <span class="expand-icon">@(isExpanded ? "▾" : "▸")</span>
                        </button>

                        <div class="card-details">
                            <div class="details-inner">
                                @if (!string.IsNullOrWhiteSpace(entry.Description))
                                {
                                    <div class="section-block">
                                        <div class="section-title">Descrizione</div>
                                        <div class="section-body">@entry.Description</div>
                                    </div>
                                }

                                @if (entry.Db is not null)
                                {
                                    <div class="section-block">
                                        <div class="section-title">Bonus caratteristiche</div>
                                        <div class="section-body">@FormatRaceBonuses(entry.Db)</div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(entry.Traits))
                                {
                                    <div class="section-block">
                                        <div class="section-title">Tratti</div>
                                        <div class="section-body">@entry.Traits</div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(entry.Languages))
                                {
                                    <div class="section-block">
                                        <div class="section-title">Lingue</div>
                                        <div class="section-body">@entry.Languages</div>
                                    </div>
                                }

                                @if (entry.IsPackage)
                                {
                                    <div class="card-actions">
                                        <button type="button" class="action-btn duplicate-action"
                                                @onclick="() => OpenDuplicateForm(entry.Package!)" @onclick:stopPropagation
                                                aria-label="Duplica e modifica @entry.Name">
                                            ⧉ Duplica e modifica
                                        </button>
                                    </div>
                                }
                                else if (CatalogKey.IsFromAppPackage(entry.Db!.SourceId))
                                {
                                    <div class="card-actions">
                                        <button type="button" class="action-btn duplicate-action"
                                                @onclick="() => OpenDuplicateForm(entry.Db!)" @onclick:stopPropagation
                                                aria-label="Duplica e modifica @entry.Name">
                                            ⧉ Duplica e modifica
                                        </button>
                                    </div>
                                }
                                else if (PuoModificare(entry.Db!))
                                {
                                    <div class="card-actions">
                                        <button type="button" class="action-btn edit-action" @onclick="() => OpenEditForm(entry.Db!)" @onclick:stopPropagation>
                                            ✎ Modifica
                                        </button>
                                        <button type="button" class="action-btn delete-action" @onclick="() => DeleteRaceAsync(entry.Db!)" @onclick:stopPropagation>
                                            🗑 Elimina
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (!FilteredEntries.Any())
                {
                    <div class="empty-state">
                        @if (dbRows.Count == 0 && packageRows.Count == 0)
                        {
                            <div class="empty-icon">🧝</div>
                            <p class="empty-title">Nessuna razza nel database</p>
                            <p class="empty-text">
                                Ogni giocatore può aggiungere le razze usando il bottone
                                <strong>+</strong> in basso a destra.
                            </p>
                        }
                        else
                        {
                            <p class="empty-text">Nessuna razza corrisponde alla ricerca.</p>
                        }
                    </div>
                }
            }
        </div>

        @* Creazione razza: ogni membro della campagna può aggiungere. *@
        <button type="button" class="fab" @onclick="OpenCreateForm" title="Nuova razza" aria-label="Nuova razza">
            +
        </button>
    }
</div>

@code {
    private enum ViewMode { List, Form }

    private ViewMode mode = ViewMode.List;

    private List<Race> dbRows = new();
    private List<PackageSpecies> packageRows = new();
    private Dictionary<string, string> playerNicknames = new();
    private bool isLoading = true;
    private bool isBusy;
    private string? errorMessage;

    private string searchInput = string.Empty;
    private string searchQuery = string.Empty;
    private CancellationTokenSource? debounceCts;

    private string? expandedKey;
    private Race editDraft = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CurrentUser.EnsureLoadedAsync();

            if (string.IsNullOrEmpty(CurrentUser.CampaignId)) return;

            var profilesTask = ProfileRepository.GetProfilesAsync();
            var reloadTask = ReloadAsync();
            await Task.WhenAll(profilesTask, reloadTask);

            playerNicknames = profilesTask.Result.ToDictionary(p => p.Id, p => p.DisplayName ?? "Utente");
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore caricamento razze: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Ricarica SEMPRE dal servizio invece di ritoccare dbRows/packageRows in memoria: la vista non
    // è solo righe di database, contiene anche le voci di pacchetto, e quali siano visibili dipende
    // da cosa c'è nel database (vedi "Duplica e modifica" più sotto).
    private async Task ReloadAsync()
    {
        if (string.IsNullOrEmpty(CurrentUser.CampaignId)) return;

        var vista = await Catalog.GetRacesAsync(CurrentUser.CampaignId);
        dbRows = vista.DbRows.ToList();
        packageRows = vista.PackageEntries.ToList();
    }

    private string? GetAuthorName(string? authorId)
    {
        if (string.IsNullOrEmpty(authorId)) return null;
        return playerNicknames.TryGetValue(authorId, out var nick) ? nick : null;
    }

    // Una riga di database è modificabile se chi guarda ne ha il diritto E non viene dal
    // pacchetto dell'app: quelle restano voci di manuale anche se vivono nel database (§6).
    private bool PuoModificare(Race r)
        => !CatalogKey.IsFromAppPackage(r.SourceId)
           && AccessControl.CanEdit(CurrentUser.IsMaster, r.AddedBy, CurrentUser.UserId);

    // Copia modificabile di una voce di pacchetto: nasce SENZA SourceId, così è una voce
    // propria dell'utente e ha la precedenza nel merge (§4.3).
    private Race DuplicaDaPacchetto(PackageSpecies p) => new()
    {
        Name = p.Name,
        Description = p.Description,
        Speed = p.Speed?.Value ?? 9,
        // Senza questa riga la copia nasce con il default 'ft' del Model e il numero resta 9:
        // una specie che correva 9 metri si ritrova a 9 piedi (§4.5). E l'unità passa dall'helper,
        // non da un `?? "m"` scritto qui: il valore finisce dritto in una colonna con CHECK, e una
        // copia con "metri" o "FT" farebbe fallire il salvataggio con un 400 opaco.
        SpeedUnit = PackageRowMerge.UnitaValida(p.Speed?.Unit),
        Traits = p.Traits,
        SourceId = null,
        CampaignId = CurrentUser.CampaignId ?? string.Empty,
        AddedBy = CurrentUser.UserId,
    };

    // Stessa regola di DuplicaDaPacchetto, ma per una riga di DATABASE che porta comunque la
    // provenienza del pacchetto dell'app (import diretto, non ancora possibile in questa fase ma
    // già previsto dal modello dati): anche qui la copia nasce SENZA SourceId.
    // AddedBy è l'utente CORRENTE, non l'autore originale della riga (che potrebbe non essere lui):
    // la RLS "races_insert" richiede added_by = auth.uid(), quindi copiare r.AddedBy avrebbe
    // fatto fallire l'INSERT per chiunque diverso dall'autore originale, master incluso.
    private Race DuplicaDaRigaImportata(Race r) => new()
    {
        Name = r.Name,
        Description = r.Description,
        Speed = r.Speed,
        SpeedUnit = r.SpeedUnit,
        StrBonus = r.StrBonus,
        DexBonus = r.DexBonus,
        ConBonus = r.ConBonus,
        IntBonus = r.IntBonus,
        WisBonus = r.WisBonus,
        ChaBonus = r.ChaBonus,
        Traits = r.Traits,
        Languages = r.Languages,
        SourceId = null,
        CampaignId = r.CampaignId,
        AddedBy = CurrentUser.UserId,
    };

    // Vista unificata di riga-database e voce-pacchetto: la lista mostrata è un'unione delle due
    // sorgenti (ricerca/ordinamento/rendering condivisi), ma le operazioni CRUD restano ancorate a
    // dbRows/packageRows separati.
    // FromAppPackage è la stessa condizione che, più sotto, sopprime i comandi di modifica/cancellazione
    // (voce di pacchetto, oppure riga di database con provenienza dal pacchetto dell'app): la marcatura
    // visiva (badge "Dal manuale" + bordo della card) deve dipendere da questa, non da IsPackage da sola,
    // altrimenti una riga di database non modificabile risulterebbe indistinguibile da una qualsiasi.
    private sealed record Entry(
        string Key,
        string Name,
        string Description,
        int Speed,
        string SpeedUnit,
        string Traits,
        string Languages,
        bool IsPackage,
        bool FromAppPackage,
        Race? Db,
        PackageSpecies? Package);

    private static Entry ToEntry(Race r) => new(
        "db:" + r.Id, r.Name, r.Description, r.Speed, r.SpeedUnit, r.Traits, r.Languages,
        false, CatalogKey.IsFromAppPackage(r.SourceId), r, null);

    // La velocità del pacchetto porta con sé la propria unità: è il motivo per cui speed_unit
    // esiste come colonna e non si deduce dalla sorgente (§4.5). L'unità passa SEMPRE da
    // PackageRowMerge.UnitaValida: races_speed_unit_check accetta solo 'm' e 'ft', e un file
    // scritto a mano può contenere "metri" o "feet".
    private static Entry ToEntry(PackageSpecies p) => new(
        "pkg:" + p.Id, p.Name, p.Description, p.Speed?.Value ?? 0,
        PackageRowMerge.UnitaValida(p.Speed?.Unit),
        p.Traits, string.Empty, true, true, null, p);

    private IEnumerable<Entry> FilteredEntries
    {
        get
        {
            IEnumerable<Entry> result = dbRows.Select(ToEntry).Concat(packageRows.Select(ToEntry));
            if (!string.IsNullOrEmpty(searchQuery))
            {
                // CatalogKey.NormalizeName su entrambi i lati: cercare "elfo" deve trovare "Elfo",
                // non solo la stessa combinazione esatta di maiuscole e accenti.
                var chiaveRicerca = CatalogKey.NormalizeName(searchQuery);
                result = result.Where(e => CatalogKey.NormalizeName(e.Name).Contains(chiaveRicerca, StringComparison.Ordinal));
            }
            return result.OrderBy(e => e.Name, StringComparer.OrdinalIgnoreCase);
        }
    }

    private async Task OnSearchInputChangedAsync()
    {
        debounceCts?.Cancel();
        debounceCts?.Dispose();
        debounceCts = new CancellationTokenSource();
        var token = debounceCts.Token;
        try
        {
            await Task.Delay(300, token);
            if (token.IsCancellationRequested) return;
            searchQuery = searchInput.Trim();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private void ToggleExpand(string key) => expandedKey = expandedKey == key ? null : key;

    private void OpenCreateForm()
    {
        editDraft = new Race
        {
            Speed = 30,
            AddedBy = CurrentUser.UserId,
            CampaignId = CurrentUser.CampaignId ?? string.Empty
        };
        mode = ViewMode.Form;
    }

    private void OpenEditForm(Race race)
    {
        editDraft = CloneRace(race);
        mode = ViewMode.Form;
    }

    private void OpenDuplicateForm(PackageSpecies package)
    {
        editDraft = DuplicaDaPacchetto(package);
        mode = ViewMode.Form;
    }

    private void OpenDuplicateForm(Race race)
    {
        editDraft = DuplicaDaRigaImportata(race);
        mode = ViewMode.Form;
    }

    private void CancelForm() => mode = ViewMode.List;

    private async Task SaveFormAsync()
    {
        var validationError = FormValidation.ValidateRace(editDraft);
        if (validationError is not null)
        {
            Toasts.ShowError(validationError);
            return;
        }

        isBusy = true;
        errorMessage = null;
        try
        {
            var saved = string.IsNullOrEmpty(editDraft.Id)
                ? await RaceRepository.CreateRaceAsync(editDraft)
                : await RaceRepository.UpdateRaceAsync(editDraft);

            if (saved is null)
            {
                errorMessage = "Il server non ha restituito la razza salvata.";
                return;
            }

            // Richiama il servizio invece di ritoccare dbRows: la copia di "Duplica e modifica"
            // deve far sparire la voce di pacchetto da cui deriva nella STESSA operazione, non al
            // prossimo cambio pagina.
            await ReloadAsync();
            expandedKey = "db:" + saved.Id;
            mode = ViewMode.List;
            Toasts.ShowSuccess("Salvato");
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore salvataggio: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteRaceAsync(Race race)
    {
        var confirmed = await Confirm.ShowAsync($"Eliminare la razza \"{race.Name}\"?");
        if (!confirmed) return;

        isBusy = true;
        errorMessage = null;
        try
        {
            await RaceRepository.DeleteRaceAsync(race.Id);
            if (expandedKey == "db:" + race.Id) expandedKey = null;
            await ReloadAsync();
            Toasts.ShowSuccess("Eliminato");
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore eliminazione: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private static Race CloneRace(Race r) => new()
    {
        Id = r.Id,
        Name = r.Name,
        Description = r.Description,
        Speed = r.Speed,
        StrBonus = r.StrBonus,
        DexBonus = r.DexBonus,
        ConBonus = r.ConBonus,
        IntBonus = r.IntBonus,
        WisBonus = r.WisBonus,
        ChaBonus = r.ChaBonus,
        Traits = r.Traits,
        Languages = r.Languages,
        SourceId = r.SourceId,
        SpeedUnit = r.SpeedUnit,
        AddedBy = r.AddedBy,
        CampaignId = r.CampaignId,
        CreatedAt = r.CreatedAt
    };

    private static string FormatRaceBonuses(Race race)
    {
        var parts = new List<string>();
        void Add(int val, string label)
        {
            if (val != 0) parts.Add($"{(val > 0 ? "+" : "")}{val} {label}");
        }
        Add(race.StrBonus, "FOR");
        Add(race.DexBonus, "DES");
        Add(race.ConBonus, "COS");
        Add(race.IntBonus, "INT");
        Add(race.WisBonus, "SAG");
        Add(race.ChaBonus, "CAR");
        return parts.Count > 0 ? string.Join(", ", parts) : "Nessuno";
    }

    public void Dispose()
    {
        debounceCts?.Cancel();
        debounceCts?.Dispose();
    }
}
