@page "/dati"
@using DndCompanion.Models
@using DndCompanion.Models.Packages
@inject ICatalogService Catalog
@inject IRaceRepository RaceRepository
@inject IClassRepository ClassRepository
@inject ISpellRepository SpellRepository
@inject IMonsterRepository MonsterRepository
@inject IBackgroundRepository BackgroundRepository
@inject ICharacterSpellRepository CharacterSpellRepository
@inject ICampaignRepository CampaignRepository
@inject CurrentUserService CurrentUser
@inject ToastService Toasts
@inject ConfirmService Confirm
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Dati - D&amp;D Companion</PageTitle>

<div class="dati-container">
    <header class="page-header">
        <button type="button" class="back-btn" @onclick='() => Navigation.NavigateTo("")'>
            ← Home
        </button>
        <h1 class="page-title">Dati</h1>
    </header>

    <DbErrorBanner Message="@systemError" OnDismiss="@(() => systemError = null)" />

    @if (loading)
    {
        <LoadingSpinner Text="Caricamento..." />
    }
    else if (string.IsNullOrEmpty(CurrentUser.CampaignId))
    {
        @* Guardia sulla campagna attiva: senza, un file scelto qui finirebbe su
           GetCampaignCatalogsAsync(null!) e su query "campaign_id=eq." malformate. *@
        <div class="empty-state">
            <p class="empty-text">Seleziona una campagna per importare o esportare i dati.</p>
        </div>
    }
    else
    {
        <p class="campaign-name">Campagna attiva: <strong>@campaignName</strong></p>

        @* La guida sta qui, in cima e richiudibile: senza, il formato del file si può solo
           indovinare, e chi vuole scrivere le proprie voci non sa da dove cominciare. *@
        <section class="data-section">
            <button type="button" class="guide-toggle" @onclick="() => showGuide = !showGuide"
                    aria-expanded="@(showGuide ? "true" : "false")">
                <span class="guide-chevron">@(showGuide ? "▾" : "▸")</span>
                Come si scrive un file di dati
            </button>

            @if (showGuide)
            {
                <div class="guide-body">
                    <p>
                        Il modo più rapido è <strong>non partire da zero</strong>: usa
                        «Esporta tutto, manuale incluso» qui sotto e modifica quel file. Contiene già
                        una voce compilata per ogni sezione, ed è la stessa forma che l'import si
                        aspetta.
                    </p>

                    <p class="guide-code-label">La struttura è questa:</p>
<pre class="guide-code">{
  "schemaVersion": 1,
  "id": "mio-pacchetto",
  "name": "Il mio materiale",
  "edition": "2024",
  "language": "it",
  "species": [ ... ],
  "classes": [ ... ],
  "backgrounds": [ ... ],
  "spells": [ ... ],
  "monsters": [ ... ]
}</pre>

                    <p>
                        Ogni voce, in ogni sezione, ha bisogno di <strong>due soli campi</strong>:
                        <code>id</code> e <code>name</code>. Tutto il resto è facoltativo, e un campo
                        assente significa «non lo so», non «cancellalo»: un reimport lascia intatto
                        ciò che il file non nomina.
                    </p>

                    <p>
                        Un'eccezione da conoscere: le <strong>sottoclassi</strong> annidate dentro le
                        classi (e i <strong>talenti</strong>) l'app le legge solo dal manuale
                        precaricato, e all'import <strong>non le scrive</strong> — non c'è un catalogo
                        dove salvarle. L'anteprima lo dice, così non le cerchi dopo.
                    </p>

                    <p>
                        L'<code>id</code> è la memoria del file: se reimporti un pacchetto con gli
                        stessi id, le voci vengono <strong>aggiornate</strong> invece che duplicate.
                        Conviene costruirli come <code>tuo-pacchetto/soldato</code>, perché è da quel
                        prefisso che «Rimuovi un import» riconosce le voci da togliere.
                    </p>

                    <p class="guide-code-label">Un mostro completo, per esempio:</p>
<pre class="guide-code">{
  "id": "mio-pacchetto/mostro/lupo-invernale",
  "name": "Lupo invernale",
  "challengeRating": "3",
  "armorClass": 13,
  "hitPoints": "75 (10d10 + 20)",
  "description": "Bestia Grande, neutrale malvagio. Tratti e azioni vanno tutti qui, con \n dove serve andare a capo."
}</pre>
                    <p>
                        Nel <code>description</code> il testo sta su <strong>una riga sola</strong>: un
                        ritorno a capo vero dentro le virgolette non è JSON valido e farebbe respingere
                        il file: per andare a capo si scrive <code>\n</code>.
                    </p>

                    <p>
                        Le velocità vogliono un numero <strong>intero</strong> e l'unità
                        (<code>"m"</code> o <code>"ft"</code>): un decimale fa rifiutare l'intero
                        file, non la singola voce. Lo stesso vale per un <code>id</code> mancante o
                        ripetuto — l'anteprima dell'import lo dice prima di scrivere qualsiasi cosa.
                    </p>
                </div>
            }
        </section>

        <section class="data-section">
            <h2 class="section-heading">Importa</h2>
            <p class="section-hint">
                Scegli un file di pacchetto (.json). L'anteprima mostrerà esattamente cosa verrà
                creato, aggiornato o saltato — è ciò che accadrà davvero, non una stima.
            </p>

            <div class="field">
                <label for="package-file">File di pacchetto</label>
                @* @key legato a un contatore: "Annulla" lo incrementa e Blazor ricrea l'elemento,
                   così l'input torna vuoto. Senza, il DOM continuerebbe a mostrare il file scelto e
                   riselezionare LO STESSO file non farebbe scattare l'evento change — chi annulla
                   resterebbe senza modo di ricalcolare l'anteprima. *@
                <InputFile @key="fileInputKey" id="package-file" class="input" accept=".json"
                           OnChange="OnFileSelectedAsync"
                           disabled="@isBusy" aria-label="Scegli un file di pacchetto" />
            </div>

            @if (isBusy && !removalBusy)
            {
                @* Non durante una rimozione: quella ha il suo spinner, nella sua sezione. *@
                <LoadingSpinner Text="Elaborazione in corso..." />
            }

            @if (warnings.Count > 0)
            {
                @* Avvisi del parser (es. pacchetto non in italiano, §5): non bloccano l'import,
                   quindi restano in un blocco distinto dagli errori di validazione (toast). *@
                <div class="plan-section plan-warnings">
                    <h3 class="plan-section-title">⚠ Avvisi</h3>
                    <ul>
                        @foreach (var avviso in warnings)
                        {
                            <li>@avviso</li>
                        }
                    </ul>
                </div>
            }

            @if (plan is not null)
            {
                <div class="plan-summary">
                    <p>
                        <strong>@plan.TotalWrites</strong> @(plan.TotalWrites == 1 ? "voce" : "voci") da scrivere,
                        <strong>@plan.TotalSkipped</strong> @(plan.TotalSkipped == 1 ? "saltata" : "saltate").
                    </p>
                </div>

                @foreach (var sezione in plan.Sections)
                {
                    <div class="plan-section">
                        <h3 class="plan-section-title">@sezione.Title</h3>

                        <table class="plan-counts">
                            <tbody>
                                <tr><td>Da creare</td><td>@sezione.CreateCount</td></tr>
                                <tr><td>Da aggiornare</td><td>@sezione.UpdateCount</td></tr>
                                <tr><td>Saltate</td><td>@sezione.SkippedCount</td></tr>
                            </tbody>
                        </table>

                        @if (!string.IsNullOrEmpty(sezione.Note))
                        {
                            <p class="plan-note">@sezione.Note</p>
                        }

                        @{
                            // Solo le voci che contribuiscono a SkippedCount: i talenti NotImportable
                            // hanno già la loro spiegazione nella Note della sezione (§9), elencarli
                            // uno per uno qui sarebbe ridondante e potenzialmente lunghissimo.
                            var saltate = sezione.Items
                                .Where(i => i.Outcome is ImportOutcome.SkippedNoPermission or ImportOutcome.SkippedLocalWins)
                                .ToList();
                        }
                        @if (saltate.Count > 0)
                        {
                            <ul class="plan-skipped">
                                @foreach (var voce in saltate)
                                {
                                    <li>@voce.Name — @MotivoScarto(voce.Outcome)</li>
                                }
                            </ul>
                        }
                    </div>
                }

                <div class="plan-actions">
                    @if (plan.IsEmpty)
                    {
                        <p class="empty-text">
                            Nessuna voce da importare: sono già tutte presenti o non modificabili.
                        </p>
                    }
                    else
                    {
                        <button type="button" class="primary-btn" @onclick="ConfirmImportAsync" disabled="@isBusy"
                                aria-label="Conferma l'import del pacchetto">
                            Conferma import
                        </button>
                    }
                    <button type="button" class="secondary-btn" @onclick="ClearSelection" disabled="@isBusy"
                            aria-label="Annulla la selezione del file">
                        Annulla
                    </button>
                </div>
            }

            @if (importNotice is not null)
            {
                @* Perché l'anteprima non c'è più: distinto dal resoconto, che dice cosa è stato
                   scritto davvero e non va sovrascritto. *@
                <div class="plan-section">
                    <p class="plan-note">@importNotice</p>
                </div>

                @* Il pulsante "Annulla" sta dentro il blocco dell'anteprima, che qui non c'è più:
                   senza questo, chi vuole ripartire deve scegliere un file DIVERSO — riscegliere lo
                   stesso non rilancia l'evento change dell'input. *@
                <div class="plan-actions">
                    <button type="button" class="secondary-btn" @onclick="ClearSelection" disabled="@isBusy"
                            aria-label="Annulla la selezione del file">
                        Annulla
                    </button>
                </div>
            }

            @if (importReport is not null)
            {
                @* Resoconto di cosa è passato e cosa no (§9): non c'è atomicità fra le richieste
                   distinte di import, quindi un fallimento a metà lascia un risultato parziale che
                   va reso esplicito invece di essere taciuto. *@
                <div class="plan-section plan-report">
                    <h3 class="plan-section-title">Resoconto import</h3>
                    <p>@importReport</p>
                </div>
            }
        </section>

        <section class="data-section">
            <h2 class="section-heading">Esporta</h2>
            <p class="section-hint">
                Scarica un file con i cataloghi di questa campagna: specie, classi, background,
                incantesimi e mostri. Utile per un backup o per portare i dati a un altro tavolo.
                <strong>Manuale incluso</strong> aggiunge anche le voci del manuale precaricato:
                serve se vuoi portarti via tutto, e serve soprattutto se vuoi scrivere voci tue —
                il file diventa un modello già compilato da cui copiare la forma di ogni sezione.
            </p>
            <div class="export-actions">
                <button type="button" class="primary-btn" @onclick="() => EsportaAsync(false)" disabled="@isBusy"
                        aria-label="Esporta i cataloghi della campagna">
                    ⬇ Esporta la campagna
                </button>
                <button type="button" class="secondary-btn" @onclick="() => EsportaAsync(true)" disabled="@isBusy"
                        aria-label="Esporta la campagna insieme al manuale">
                    ⬇ Esporta tutto, manuale incluso
                </button>
            </div>
        </section>

        <section class="data-section">
            <h2 class="section-heading">Rimuovi un import</h2>
            <p class="section-hint" id="removal-hint">
                Toglie dalla campagna le voci arrivate da un pacchetto. La provenienza è
                l'identificatore scritto in cima al file, lo stesso che apre gli identificatori delle
                sue voci: da «mio-pacchetto/soldato» la provenienza è «mio-pacchetto». Le voci del
                manuale distribuito con l'app non si rimuovono.
            </p>

            <div class="field">
                <label for="removal-prefix">Provenienza</label>
                <input id="removal-prefix" class="input" type="text" value="@removalPrefix"
                       @oninput="OnRemovalPrefixInput" disabled="@isBusy"
                       placeholder="mio-pacchetto"
                       aria-label="Provenienza da rimuovere" aria-describedby="removal-hint" />
            </div>

            <div class="plan-actions">
                <button type="button" class="secondary-btn" @onclick="CalcolaAnteprimaRimozioneAsync"
                        disabled="@isBusy" aria-label="Calcola l'impatto della rimozione">
                    Calcola l'impatto
                </button>
            </div>

            @if (removalBusy)
            {
                @* Spinner proprio: quello della sezione Importa è in cima alla pagina e da qui non
                   si vedrebbe. *@
                <LoadingSpinner Text="Elaborazione in corso..." />
            }

            @if (removalPreview is not null)
            {
                <div class="plan-section">
                    <h3 class="plan-section-title">
                        Provenienza «@removalPreview.Prefix»
                    </h3>

                    <table class="plan-counts">
                        <tbody>
                            <tr><td>Specie</td><td>@removalPreview.RaceIds.Count</td></tr>
                            <tr><td>Classi</td><td>@removalPreview.ClassIds.Count</td></tr>
                            <tr><td>Background</td><td>@removalPreview.BackgroundIds.Count</td></tr>
                            <tr><td>Incantesimi</td><td>@removalPreview.SpellIds.Count</td></tr>
                            <tr><td>Mostri</td><td>@removalPreview.MonsterIds.Count</td></tr>
                        </tbody>
                    </table>

                    @if (removalAffectedCharacters > 0)
                    {
                        @* Evidenziato perché è la conseguenza che l'utente non si aspetta: il
                           CASCADE toglie l'incantesimo anche dalle schede, non solo dal catalogo. *@
                        <p class="removal-impact">
                            ⚠ @removalAffectedCharacters
                            @(removalAffectedCharacters == 1
                                ? "personaggio perderà un incantesimo dalla propria scheda."
                                : "personaggi perderanno un incantesimo dalla propria scheda.")
                        </p>
                    }

                    @if (removalPreview.BlockedByPermission > 0)
                    {
                        <p class="plan-note">
                            @removalPreview.BlockedByPermission
                            @(removalPreview.BlockedByPermission == 1
                                ? "voce non è tua e resterà."
                                : "voci non sono tue e resteranno.")
                        </p>
                    }

                    @if (removalPreview.Total == 0)
                    {
                        <p class="plan-note">Nessuna voce da rimuovere per questa provenienza.</p>
                    }
                </div>

                @if (removalPreview.Total > 0)
                {
                    <div class="plan-actions">
                        <button type="button" class="secondary-btn danger-btn" @onclick="RimuoviAsync"
                                disabled="@isBusy" aria-label="Rimuovi le voci di questa provenienza">
                            🗑 Rimuovi
                        </button>
                    </div>
                }
            }

            @if (removalNotice is not null)
            {
                @* Perché l'anteprima non c'è più: distinto dal resoconto, che dice quali voci sono
                   state tolte davvero e non va sovrascritto. *@
                <div class="plan-section">
                    <p class="plan-note">@removalNotice</p>
                </div>
            }

            @if (removalReport is not null)
            {
                <div class="plan-section plan-report">
                    <h3 class="plan-section-title">Resoconto rimozione</h3>
                    <p>@removalReport</p>
                </div>
            }
        </section>
    }
</div>

@code {
    private bool loading = true;
    private bool isBusy;
    private string? systemError;

    private string campaignName = string.Empty;

    // Il file scelto, letto e validato: pacchetto, anteprima e avvisi restano insieme finché
    // l'utente non conferma o cambia file.
    private CatalogPackage? loadedPackage;
    private ImportPlanResult? plan;
    private IReadOnlyList<string> warnings = Array.Empty<string>();
    /// <summary>La guida al formato è chiusa all'apertura: serve la prima volta, poi è rumore.</summary>
    private bool showGuide;

    private string? importReport;

    // Avviso sullo stato dell'anteprima, distinto dal resoconto di ciò che è stato scritto:
    // scriverlo dentro importReport cancellerebbe l'unica traccia di un import parziale (§9).
    private string? importNotice;

    // Le righe della campagna come stanno nel database: servono all'anteprima e poi, riga per riga,
    // all'esecuzione degli aggiornamenti, che partono dall'esistente invece di sostituirlo.
    private CampaignCatalogs existing = new();

    private string removalPrefix = string.Empty;
    private CatalogRemoval? removalPreview;
    private int removalAffectedCharacters;
    private string? removalReport;

    // Speculare a importNotice, e per la stessa ragione: il resoconto di una rimozione parziale è
    // l'unica traccia delle voci che il server non ha tolto, e un avviso sullo stato dell'anteprima
    // non deve cancellarla.
    private string? removalNotice;

    // Distinto da isBusy — che disabilita i comandi di tutta la pagina, e va bene così: due
    // operazioni sui cataloghi in parallelo non devono partire. Serve solo a decidere DOVE si
    // accende lo spinner: quello della rimozione, acceso durante un import, farebbe credere che sia
    // partita l'operazione distruttiva.
    private bool removalBusy;

    // Identità dell'<InputFile> nel render tree: cambiarla lo fa ricreare vuoto (vedi il markup).
    private int fileInputKey;

    /// <summary>Limite di dimensione del file. Il pacchetto SRD completo starà ben sotto; oltre,
    /// è quasi certamente il file sbagliato, e leggerlo in memoria in WebAssembly costa.</summary>
    private const long MaxFileSize = 8 * 1024 * 1024;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CurrentUser.EnsureLoadedAsync();
            if (string.IsNullOrEmpty(CurrentUser.CampaignId)) return;

            var campagne = await CampaignRepository.GetUserCampaignsAsync(CurrentUser.UserId ?? string.Empty);
            campaignName = campagne.FirstOrDefault(c => c.Id == CurrentUser.CampaignId)?.Name ?? "Campagna";
        }
        catch (Exception ex)
        {
            systemError = $"Errore caricamento: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        loadedPackage = null;
        plan = null;
        warnings = Array.Empty<string>();
        importReport = null;
        importNotice = null;
        // Un errore di sistema del tentativo precedente (lettura file o import interrotto) non deve
        // restare a schermo sopra un'anteprima nuova e valida: gli altri due punti d'ingresso
        // (ConfirmImportAsync, EsportaAsync) lo azzerano già all'avvio, per simmetria lo fa anche questo.
        systemError = null;

        var file = e.File;
        if (file.Size > MaxFileSize)
        {
            Toasts.ShowError($"Il file supera {MaxFileSize / (1024 * 1024)} MB: controlla di aver scelto un pacchetto di dati.");
            return;
        }

        isBusy = true;
        try
        {
            using var stream = file.OpenReadStream(MaxFileSize);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            var esito = CatalogPackageParser.Parse(json);
            warnings = esito.Warnings;

            if (esito.Package is null)
            {
                // Errori di validazione: toast, non banner. Il banner è per gli errori di sistema.
                foreach (var errore in esito.Errors.Take(3))
                    Toasts.ShowError(errore);
                if (esito.Errors.Count > 3)
                    Toasts.ShowError($"…e altri {esito.Errors.Count - 3} problemi nel file.");
                return;
            }

            loadedPackage = esito.Package;

            // L'anteprima si calcola sullo stato REALE del database, non sull'unione mostrata
            // dalle pagine: è ciò che l'import andrà a toccare.
            existing = await Catalog.GetCampaignCatalogsAsync(CurrentUser.CampaignId!);
            plan = PackageImportPlan.Build(
                loadedPackage, existing, CurrentUser.IsMaster, CurrentUser.UserId);
        }
        catch (Exception ex)
        {
            systemError = $"Errore lettura del file: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ConfirmImportAsync()
    {
        if (loadedPackage is null || plan is null || string.IsNullOrEmpty(CurrentUser.CampaignId)) return;

        var conferma = await Confirm.ShowAsync(
            $"Importare {plan.TotalWrites} voci nella campagna \"{campaignName}\"? " +
            $"{plan.TotalSkipped} verranno saltate.");
        if (!conferma) return;

        isBusy = true;
        systemError = null;
        var resoconto = new List<string>();
        try
        {
            // Una sezione per tipo, e dentro ciascuna due percorsi distinti: le creazioni in un
            // blocco solo (una richiesta, quindi una transazione), gli aggiornamenti riga per riga
            // partendo dalla riga esistente. PostgREST è transazionale sulla singola richiesta ma
            // non offre atomicità FRA richieste distinte (§9): se qualcosa si ferma a metà, i
            // passaggi già compiuti restano e il resoconto lo dice.
            var campagna = CurrentUser.CampaignId;
            var autore = CurrentUser.UserId;

            await EseguiSezioneAsync(
                "Specie", resoconto, loadedPackage.Species, existing.Races,
                p => p.Id, r => r.Id,
                p => PackageRowMerge.NuovaSpecie(p, campagna, autore), PackageRowMerge.ApplicaSpecie,
                RaceRepository.CreateManyAsync, RaceRepository.UpdateRaceAsync);

            await EseguiSezioneAsync(
                "Classi", resoconto, loadedPackage.Classes, existing.Classes,
                p => p.Id, c => c.Id,
                p => PackageRowMerge.NuovaClasse(p, campagna, autore), PackageRowMerge.ApplicaClasse,
                ClassRepository.CreateManyAsync, ClassRepository.UpdateClassAsync);

            await EseguiSezioneAsync(
                "Background", resoconto, loadedPackage.Backgrounds, existing.Backgrounds,
                p => p.Id, b => b.Id,
                p => PackageRowMerge.NuovoBackground(p, campagna, autore), PackageRowMerge.ApplicaBackground,
                BackgroundRepository.CreateManyAsync, BackgroundRepository.UpdateBackgroundAsync);

            await EseguiSezioneAsync(
                "Incantesimi", resoconto, loadedPackage.Spells, existing.Spells,
                p => p.Id, s => s.Id,
                p => PackageRowMerge.NuovoIncantesimo(p, campagna, autore), PackageRowMerge.ApplicaIncantesimo,
                SpellRepository.CreateManyAsync, SpellRepository.UpdateSpellAsync);

            await EseguiSezioneAsync(
                "Mostri", resoconto, loadedPackage.Monsters, existing.Monsters,
                p => p.Id, m => m.Id,
                p => PackageRowMerge.NuovoMostro(p, campagna, autore), PackageRowMerge.ApplicaMostro,
                MonsterRepository.CreateManyAsync, MonsterRepository.UpdateMonsterAsync);

            importReport = string.Join(" · ", resoconto);
            Toasts.ShowSuccess("Import completato");

            // L'anteprima ora è vecchia: rifarla su dati freschi evita che un secondo clic
            // riproponga di creare ciò che è appena stato creato. Vale anche per l'altra sezione,
            // i cui id congelati non coprono le righe appena scritte.
            RiallineaImport(await Catalog.GetCampaignCatalogsAsync(CurrentUser.CampaignId));
            InvalidaAnteprimaRimozione();
        }
        catch (Exception ex)
        {
            importReport = string.Join(" · ", resoconto);
            systemError = $"Import interrotto: {ex.Message}";

            // Il piano usato finora è ormai disallineato con quanto è già stato scritto prima
            // dell'interruzione: senza ricalcolarlo, un secondo clic su "Conferma import"
            // rilancerebbe la CREAZIONE delle righe delle sezioni già passate — che ora hanno un
            // source_id già presente in campagna — violando UNIQUE(campaign_id, source_id) invece
            // di riprendere da dove l'esecuzione si è fermata. Nested try/catch: se anche questa
            // lettura fallisce (stessa interruzione di rete), non deve mascherare l'errore originale.
            try
            {
                RiallineaImport(await Catalog.GetCampaignCatalogsAsync(CurrentUser.CampaignId));
            }
            catch
            {
                // Il piano resta quello vecchio: peggio di niente, ma non oscura systemError.
            }

            // Parte delle scritture può essere passata prima dell'interruzione: l'anteprima di
            // rimozione, se c'è, è comunque da rifare.
            InvalidaAnteprimaRimozione();
        }
        finally
        {
            isBusy = false;
        }
    }

    // Esegue una sezione del piano e ne registra l'esito.
    //
    // Generico su (voce di pacchetto, riga di database) perché i cinque cataloghi non condividono
    // un'interfaccia comune: sono Model Postgrest indipendenti, e introdurne una per questo solo
    // scopo significherebbe toccarli tutti.
    //
    // L'esito si conta sulle righe RESTITUITE dal server, non si assume: le RLS bloccano gli UPDATE
    // senza sollevare eccezioni — la richiesta riesce e tocca zero righe, e i repository lo
    // rivelano restituendo null (§7).
    private async Task EseguiSezioneAsync<TPkg, TRow>(
        string titoloSezione,
        List<string> resoconto,
        List<TPkg> vociDelPacchetto,
        List<TRow> righeEsistenti,
        Func<TPkg, string> idVoce,
        Func<TRow, string> idRiga,
        Func<TPkg, TRow> nuovaRigaDa,
        Action<TPkg, TRow> applicaSu,
        Func<List<TRow>, Task<List<TRow>>> creaInBlocco,
        Func<TRow, Task<TRow?>> aggiornaUna)
        where TRow : class
    {
        var sezione = plan!.Sections.FirstOrDefault(s => s.Title == titoloSezione);
        if (sezione is null) return;

        var perId = vociDelPacchetto.ToDictionary(idVoce, StringComparer.Ordinal);
        var scritte = 0;
        var attese = 0;

        // 1. Creazioni: un blocco solo.
        var daCreare = sezione.Items
            .Where(i => i.Outcome == ImportOutcome.Create && perId.ContainsKey(i.SourceId))
            .Select(i => nuovaRigaDa(perId[i.SourceId]))
            .ToList();

        attese += daCreare.Count;
        if (daCreare.Count > 0)
            scritte += (await creaInBlocco(daCreare)).Count;

        // 2. Aggiornamenti: uno per riga, PARTENDO dalla riga esistente. Il formato non copre tutte
        // le colonne — un file senza `languages`, senza i bonus di specie, senza le caratteristiche
        // di un mostro le azzererebbe — e non deve toccare né `added_by` né `created_at`, altrimenti
        // un reimport del master si approprierebbe delle voci caricate dai giocatori.
        foreach (var item in sezione.Items.Where(i => i.Outcome == ImportOutcome.Update))
        {
            if (!perId.TryGetValue(item.SourceId, out var voce)) continue;

            var esistente = righeEsistenti.FirstOrDefault(r => idRiga(r) == item.ExistingRowId);
            if (esistente is null) continue;

            attese++;
            applicaSu(voce, esistente);
            if (await aggiornaUna(esistente) is not null) scritte++;
        }

        if (attese == 0) return;

        resoconto.Add(scritte == attese
            ? $"{titoloSezione}: {scritte}"
            : $"{titoloSezione}: {scritte} di {attese} (il server ne ha rifiutate {attese - scritte})");
    }

    /// <param name="conIlManuale">Include anche le voci del manuale dell'app. Serve a due cose che
    /// l'export della sola campagna non copre: portarsi via davvero tutto, e avere un file già
    /// popolato da cui capire come si scrive una voce — chi non ha mai importato nulla, altrimenti,
    /// scarica un file con le sezioni vuote.</param>
    private async Task EsportaAsync(bool conIlManuale)
    {
        if (string.IsNullOrEmpty(CurrentUser.CampaignId)) return;

        isBusy = true;
        systemError = null;
        try
        {
            var cataloghi = await Catalog.GetCampaignCatalogsAsync(CurrentUser.CampaignId);
            // Il manuale si carica SEMPRE, anche per l'export della sola campagna: se fra le righe
            // ce n'è qualcuna di provenienza SRD — le crea SpellMaterialization — il file deve
            // portarne l'attribuzione, e la licenza sta lì.
            var manuale = await Catalog.GetPackageAsync();
            var pacchetto = CampaignExport.Build(cataloghi, campaignName, manuale, conIlManuale);

            // Il manuale può mancare (assente o illeggibile: GetPackageAsync torna null). Senza
            // dirlo, il file scaricato sarebbe quello della sola campagna e il toast direbbe
            // «Esportato» — l'utente crederebbe di avere tutto. Due casi distinti, e il secondo
            // riguarda anche l'export della sola campagna: se fra le righe c'è materiale SRD
            // (SpellMaterialization) la licenza sta nel manuale, quindi senza manuale il file esce
            // con testo SRD e senza attribuzione. Va detto, non taciuto.
            // I due avvisi sono cumulabili, non alternativi: con «manuale incluso» e una campagna che
            // contiene già righe materializzate valgono entrambi, e tenerli in `else if` avrebbe
            // taciuto proprio quello sull'attribuzione — il motivo per cui il controllo esiste.
            if (manuale is null)
            {
                var avvisi = new List<string>();
                if (conIlManuale)
                    avvisi.Add("Il manuale non era disponibile: il file contiene le sole voci di "
                        + "questa campagna.");
                if (CampaignExport.ContieneMaterialeDiManuale(cataloghi))
                    avvisi.Add("Il file contiene voci di provenienza SRD ma esce senza "
                        + "l'attribuzione della licenza, che sta nel manuale: non condividerlo così.");

                if (avvisi.Count > 0)
                    systemError = string.Join(" ", avvisi)
                        + " Riesporta quando l'app è di nuovo in linea.";
            }

            var json = CampaignExport.ToJson(pacchetto);

            await JS.InvokeVoidAsync("downloadTextFile", pacchetto.Id + ".json", json);
            // Il toast dice cosa è uscito davvero: con il banner sopra, un «Esportato» secco
            // sarebbe la conferma che si voleva evitare.
            Toasts.ShowSuccess(systemError is null ? "Esportato" : "Esportato, ma incompleto");
        }
        catch (Exception ex)
        {
            systemError = $"Errore esportazione: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    // Cambiare provenienza invalida sia l'anteprima sia il resoconto: entrambi parlano di un'altra
    // provenienza, e lasciarli a schermo accanto a un campo che ora dice altro li farebbe leggere
    // come riferiti a quella nuova.
    private void OnRemovalPrefixInput(ChangeEventArgs e)
    {
        removalPrefix = e.Value?.ToString() ?? string.Empty;
        removalPreview = null;
        removalAffectedCharacters = 0;
        removalReport = null;
        removalNotice = null;
    }

    private async Task CalcolaAnteprimaRimozioneAsync()
    {
        removalPreview = null;
        removalAffectedCharacters = 0;
        removalReport = null;
        removalNotice = null;

        var prefisso = CatalogRemovalPlan.NormalizePrefix(removalPrefix);
        if (prefisso.Length == 0)
        {
            Toasts.ShowError("Indica la provenienza da rimuovere (es. mio-pacchetto).");
            return;
        }

        // §8: la provenienza del pacchetto dell'app NON è rimovibile. Sarebbe il danno della
        // materializzazione moltiplicato per N righe in un colpo solo, e AccessControl.CanEdit non
        // farebbe da freno — quelle righe nascono con l'added_by del giocatore che le ha usate.
        if (!CatalogRemovalPlan.IsRemovablePrefix(prefisso))
        {
            Toasts.ShowError("Le voci del manuale distribuito con l'app non si rimuovono in blocco.");
            return;
        }

        isBusy = true;
        removalBusy = true;
        systemError = null;
        try
        {
            (removalPreview, removalAffectedCharacters, _) = await LeggiImpattoAsync(prefisso);
        }
        catch (Exception ex)
        {
            systemError = $"Errore nel calcolo dell'anteprima: {ex.Message}";
        }
        finally
        {
            isBusy = false;
            removalBusy = false;
        }
    }

    // Il calcolo vero, senza toccare isBusy né systemError: lo richiama anche RimuoviAsync per
    // ricontare dopo l'operazione, e un finally annidato che spegne isBusy riabiliterebbe i
    // pulsanti a metà di un'operazione ancora in corso.
    //
    // Restituisce anche i cataloghi appena letti: dopo una rimozione servono a riallineare la
    // sezione Importa senza un secondo giro di rete.
    private async Task<(CatalogRemoval Piano, int PgColpiti, CampaignCatalogs Cataloghi)> LeggiImpattoAsync(
        string prefisso)
    {
        var cataloghi = await Catalog.GetCampaignCatalogsAsync(CurrentUser.CampaignId!);
        var piano = CatalogRemovalPlan.Build(
            cataloghi, prefisso, CurrentUser.IsMaster, CurrentUser.UserId);

        // Quanti PG perderanno un incantesimo: character_spells_spell_id_fkey è ON DELETE CASCADE,
        // quindi togliere la riga dal catalogo la toglie dalle schede (§8).
        var legami = await CharacterSpellRepository.GetBySpellIdsAsync(piano.SpellIds);
        var pgColpiti = legami.Select(l => l.CharacterId).Distinct().Count();

        return (piano, pgColpiti, cataloghi);
    }

    private async Task RimuoviAsync()
    {
        if (removalPreview is null || string.IsNullOrEmpty(CurrentUser.CampaignId)) return;

        // L'insieme su cui si opera si congela QUI: il campo di testo e l'anteprima a schermo
        // possono cambiare, ciò che viene cancellato no.
        var daRimuovere = removalPreview;

        // Il testo del ConfirmDialog riporta i numeri invece di limitarsi a "sei sicuro?" (§8), e
        // nomina la provenienza congelata, non quella scritta nel campo adesso: chi ricalcola,
        // cambia idea e poi conferma, deve leggere ciò che verrà davvero cancellato.
        var messaggio = daRimuovere.Total == 1
            ? $"Rimuovere 1 voce di provenienza \"{daRimuovere.Prefix}\"?"
            : $"Rimuovere {daRimuovere.Total} voci di provenienza \"{daRimuovere.Prefix}\"?";
        if (removalAffectedCharacters > 0)
            messaggio += removalAffectedCharacters == 1
                ? " 1 personaggio perderà un incantesimo dalla propria scheda."
                : $" {removalAffectedCharacters} personaggi perderanno un incantesimo dalla propria scheda.";
        if (daRimuovere.BlockedByPermission > 0)
            messaggio += daRimuovere.BlockedByPermission == 1
                ? " 1 voce non è tua e resterà."
                : $" {daRimuovere.BlockedByPermission} voci non sono tue e resteranno.";

        if (!await Confirm.ShowAsync(messaggio)) return;

        isBusy = true;
        removalBusy = true;
        systemError = null;
        removalReport = null;
        removalNotice = null;
        try
        {
            // Si cancellano gli id esatti che l'anteprima ha mostrato — non un criterio rivalutato
            // adesso, che potrebbe raccogliere righe diverse da quelle contate.
            await RaceRepository.DeleteByIdsAsync(daRimuovere.RaceIds);
            await ClassRepository.DeleteByIdsAsync(daRimuovere.ClassIds);
            await BackgroundRepository.DeleteByIdsAsync(daRimuovere.BackgroundIds);
            await SpellRepository.DeleteByIdsAsync(daRimuovere.SpellIds);
            await MonsterRepository.DeleteByIdsAsync(daRimuovere.MonsterIds);

            // Il Delete di questa libreria non dice quante righe ha tolto, e un Delete bloccato
            // dalla RLS "riesce" a vuoto (§3 di DA-FARE): l'unico resoconto onesto è ricontare.
            // Per questo il toast arriva DOPO il riconteggio: un "completata" verde emesso qui
            // sarebbe il segnale più visibile della pagina, e proprio quello che il riconteggio
            // potrebbe smentire.
            // Try/catch annidato perché a questo punto la cancellazione è già avvenuta: se cade la
            // rilettura, presentarla come "errore durante la rimozione" con i conteggi vecchi
            // ancora a schermo farebbe concludere che non è stato cancellato nulla.
            try
            {
                var (piano, pgColpiti, cataloghi) = await LeggiImpattoAsync(daRimuovere.Prefix);
                removalPreview = piano;
                removalAffectedCharacters = pgColpiti;

                // Si contano gli id CONGELATI ancora presenti, non le righe che il criterio
                // raccoglie adesso: fra l'anteprima e il riconteggio possono esserne comparse di
                // nuove — un import rifatto, un altro giocatore che scrive — e scambiarle per
                // sopravvissute darebbe un resoconto falso, fino al conteggio negativo.
                var rimaste = CatalogRemovalPlan.StillPresent(daRimuovere, piano);
                var tolte = daRimuovere.Total - rimaste;
                var quante = tolte == 1 ? "Rimossa 1 voce" : $"Rimosse {tolte} voci";

                if (rimaste == 0)
                {
                    removalReport = $"{quante}.";
                    Toasts.ShowSuccess("Rimozione completata");
                }
                else
                {
                    // Non "non tue": chi opera come giocatore congela solo righe proprie, quindi una
                    // sopravvissuta significa che il server l'ha rifiutata, non che appartenga ad altri.
                    removalReport = $"{quante} su {daRimuovere.Total}; " +
                                    (rimaste == 1
                                        ? "1 non è stata rimossa dal server."
                                        : $"{rimaste} non sono state rimosse dal server.");
                    Toasts.ShowError("Rimozione parziale: il server non ha rimosso tutte le voci.");
                }

                RiallineaImport(cataloghi);
            }
            catch (Exception ex)
            {
                removalPreview = null;
                removalAffectedCharacters = 0;
                removalReport = "Le voci sono state cancellate, ma la verifica dell'esito non è " +
                                "riuscita. Ricalcola l'impatto per vedere cosa resta.";
                // È un errore di sistema (rete/DB) come gli altri due della pagina: va nel banner
                // persistente, che porta con sé "Ripara e ricarica". Il toast e il resoconto
                // dicono cosa fare, il banner dice cosa è andato storto.
                systemError = $"Errore nella verifica dopo la rimozione: {ex.Message}";
                Toasts.ShowError("Voci cancellate, ma l'esito non è stato verificato.");
                InvalidaAnteprimaImport();
            }
        }
        catch (Exception ex)
        {
            // Le cinque cancellazioni sono richieste distinte e PostgREST non offre atomicità fra
            // richieste: se una si ferma, quelle già passate restano. L'anteprima mostrata finora
            // non descrive più il database, e lasciarla a schermo la farebbe leggere come "non è
            // stato cancellato nulla" — sull'operazione più distruttiva dell'app.
            removalPreview = null;
            removalAffectedCharacters = 0;
            removalReport = "La rimozione si è interrotta: una parte delle voci può essere già " +
                            "stata cancellata. Ricalcola l'impatto per vedere cosa resta.";
            systemError = $"Errore durante la rimozione: {ex.Message}";
            InvalidaAnteprimaImport();
        }
        finally
        {
            isBusy = false;
            removalBusy = false;
        }
    }

    // La rimozione ha scritto sulle stesse cinque tabelle da cui la sezione Importa aveva letto:
    // senza riallineare, un "Conferma import" successivo ripercorrerebbe il ramo Update su righe
    // ormai cancellate — PostgREST accetta l'UPDATE toccando zero righe e il resoconto ne darebbe
    // la colpa al server. Vanno aggiornati insieme: aggiornare `existing` senza rifare `plan`
    // farebbe saltare in silenzio gli item il cui ExistingRowId non esiste più.
    private void RiallineaImport(CampaignCatalogs cataloghi)
    {
        existing = cataloghi;
        plan = loadedPackage is null
            ? null
            : PackageImportPlan.Build(loadedPackage, existing, CurrentUser.IsMaster, CurrentUser.UserId);

        // Il piano ora è di nuovo valido: l'avviso di un'invalidazione precedente resterebbe a
        // schermo a dire di riscegliere il file proprio mentre l'anteprima è tornata.
        importNotice = null;
    }

    // Stesso problema, ma senza dati freschi con cui ricostruire il piano: l'unica mossa sicura è
    // toglierlo. Sparire in silenzio non basta — chi aveva un'anteprima a schermo deve sapere
    // perché non c'è più.
    private void InvalidaAnteprimaImport()
    {
        if (plan is null) return;

        plan = null;
        // Al condizionale: si arriva qui anche quando la prima cancellazione è fallita e nulla è
        // stato scritto. Il piano va comunque rifatto — non si sa quali richieste siano passate —
        // ma dichiarare una modifica che può non esserci sarebbe un'informazione falsa.
        importNotice = "Anteprima annullata: la rimozione può aver cambiato i cataloghi, e il piano " +
                       "calcolato prima potrebbe non descrivere più il database. Riscegli il file per rifarla.";
    }

    // Il verso opposto: l'import ha scritto sulle stesse cinque tabelle, quindi gli id congelati
    // nell'anteprima di rimozione non coprono più le righe appena create — un "Rimuovi" eseguito
    // ora dichiarerebbe di aver tolto tutta la provenienza lasciandone in campagna una parte.
    // Si azzera invece di ricalcolare: sarebbe un giro di rete in più in coda a un'operazione già
    // lunga, e l'anteprima si rifà con un clic.
    private void InvalidaAnteprimaRimozione()
    {
        if (removalPreview is null) return;

        removalPreview = null;
        removalAffectedCharacters = 0;
        // Al condizionale per la stessa ragione di InvalidaAnteprimaImport: il ramo interrotto passa
        // di qui anche quando la prima scrittura è fallita e nulla è cambiato.
        removalNotice = "Anteprima annullata: l'import può aver cambiato i cataloghi. Ricalcola l'impatto.";
    }

    // Testo mostrato accanto a ogni voce saltata: le uniche due ragioni che finiscono nella lista
    // (i talenti NotImportable hanno la loro spiegazione nella Note della sezione, non qui).
    private static string MotivoScarto(ImportOutcome outcome) => outcome switch
    {
        ImportOutcome.SkippedNoPermission => "non modificabile",
        ImportOutcome.SkippedLocalWins => "esiste già una voce locale con lo stesso nome",
        _ => "saltata",
    };

    // Annulla la scelta corrente senza toccare il database: l'utente può ripartire da un altro
    // file — o dallo stesso, grazie al @key che svuota l'input — senza ricaricare la pagina.
    private void ClearSelection()
    {
        fileInputKey++;
        loadedPackage = null;
        plan = null;
        warnings = Array.Empty<string>();
        importReport = null;
        importNotice = null;
    }
}
