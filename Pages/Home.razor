@page "/"
@using DndCompanion.Models
@inject AuthStateService AuthState
@inject SupabaseService SupabaseService
@inject IProfileRepository ProfileRepository
@inject ICampaignRepository CampaignRepository
@inject ICharacterRepository CharacterRepository
@inject CampaignStateService CampaignState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ConfirmService Confirm
@inject ToastService Toasts

<PageTitle>D&amp;D Companion</PageTitle>

<div class="home-container">
    <header class="home-header">
        <div class="welcome">
            <h1>D&amp;D Companion</h1>
            @if (!string.IsNullOrEmpty(displayName))
            {
                <p class="welcome-line">
                    Benvenuto, <strong>@displayName</strong>
                    @if (!string.IsNullOrEmpty(CampaignState.ActiveCampaignRole))
                    {
                        <span class="role-tag">@(isMaster ? "Master" : "Giocatore")</span>
                    }
                </p>
            }
        </div>
        <button type="button" class="logout-btn" @onclick="OnLogoutAsync" title="Esci">
            Esci
        </button>
    </header>

    <DbErrorBanner Message="@errorMessage" OnDismiss="@(() => errorMessage = null)" />

    @if (isLoading)
    {
        <LoadingSpinner />
    }
    else
    {
        <section class="campaign-bar">
            @if (campaigns.Count == 0)
            {
                <div class="empty-campaigns">
                    <h2>Nessuna campagna</h2>
                    <p>Crea una nuova campagna o unisciti a una esistente con un codice invito.</p>
                </div>
            }
            else
            {
                <div class="campaign-selector">
                    <label for="campaign-select">Campagna attiva</label>
                    <select id="campaign-select" class="input" value="@CampaignState.ActiveCampaignId"
                            @onchange="OnCampaignSelectedAsync">
                        <option value="">— Seleziona —</option>
                        @foreach (var c in campaigns)
                        {
                            <option value="@c.Id" selected="@(c.Id == CampaignState.ActiveCampaignId)">@c.Name</option>
                        }
                    </select>
                </div>

                @if (ActiveCampaign is not null && isMaster)
                {
                    <div class="invite-box">
                        <span class="invite-label">Codice invito</span>
                        <code class="invite-code">@ActiveCampaign.InviteCode</code>
                        <span class="invite-hint">Condividilo con i tuoi giocatori</span>
                    </div>
                }

                @if (ActiveCampaign is not null)
                {
                    <div class="campaign-manage">
                        @if (isMaster)
                        {
                            <button type="button" class="secondary-btn danger-btn" @onclick="DeleteActiveCampaignAsync" disabled="@isBusy">
                                Elimina campagna
                            </button>
                        }
                        else
                        {
                            <button type="button" class="secondary-btn" @onclick="LeaveActiveCampaignAsync" disabled="@isBusy">
                                Esci dalla campagna
                            </button>
                        }
                    </div>
                }
            }

            <div class="campaign-actions">
                <button type="button" class="primary-btn" @onclick="() => ShowForm(FormKind.Create)">+ Crea campagna</button>
                <button type="button" class="secondary-btn" @onclick="() => ShowForm(FormKind.Join)">Unisciti</button>
            </div>

            @if (formKind == FormKind.Create)
            {
                <div class="campaign-form">
                    <input type="text" class="input" maxlength="60" placeholder="Nome della campagna"
                           @bind="newCampaignName" disabled="@isBusy" />
                    <div class="form-actions">
                        <button type="button" class="primary-btn" @onclick="CreateCampaignAsync" disabled="@isBusy">
                            @(isBusy ? "Creazione..." : "Crea")
                        </button>
                        <button type="button" class="secondary-btn" @onclick="HideForm" disabled="@isBusy">Annulla</button>
                    </div>
                </div>
            }
            else if (formKind == FormKind.Join)
            {
                <div class="campaign-form">
                    <input type="text" class="input" maxlength="32" placeholder="Codice invito (es. DND-AB12)"
                           @bind="joinCode" disabled="@isBusy" />
                    <div class="form-actions">
                        <button type="button" class="primary-btn" @onclick="JoinCampaignAsync" disabled="@isBusy">
                            @(isBusy ? "Verifica..." : "Unisciti")
                        </button>
                        <button type="button" class="secondary-btn" @onclick="HideForm" disabled="@isBusy">Annulla</button>
                    </div>
                </div>
            }
        </section>

        @if (!string.IsNullOrEmpty(CampaignState.ActiveCampaignId))
        {
            @if (showOnboarding)
            {
                <section class="onboarding" aria-label="Primi passi">
                    <h2>Primi passi</h2>
                    <ol class="onboarding-list">
                        @foreach (var step in onboardingSteps)
                        {
                            <li class="onboarding-step @(step.IsDone ? "done" : null)">
                                @* Lo stato "fatto" non passa solo dalla spunta e dal testo barrato:
                                   a uno screen reader i passi completati suonerebbero identici a
                                   quelli da fare, e per i primi manca pure il pulsante "Vai" che
                                   altrimenti li distingue. *@
                                <span class="step-check"
                                      role="@(step.IsDone ? "img" : null)"
                                      aria-label="@(step.IsDone ? "Completato" : null)"
                                      aria-hidden="@(step.IsDone ? null : "true")">@(step.IsDone ? "✓" : "")</span>
                                <div class="step-body">
                                    <span class="step-title">@step.Title</span>
                                    <span class="step-desc">@step.Description</span>
                                </div>
                                @if (!step.IsDone)
                                {
                                    @* StepAction.None non ha pulsante: quel passo si compie nel
                                       selettore di campagna qui sopra, non altrove. *@
                                    @if (step.Action == HomeOnboardingLogic.StepAction.Navigate && step.Route is not null)
                                    {
                                        <button type="button" class="step-action" @onclick="@(() => Navigation.NavigateTo(step.Route))">
                                            Vai
                                        </button>
                                    }
                                    else if (step.Action == HomeOnboardingLogic.StepAction.CopyInviteCode)
                                    {
                                        <button type="button" class="step-action" @onclick="CopyInviteCodeAsync">
                                            Copia codice
                                        </button>
                                    }
                                }
                            </li>
                        }
                    </ol>
                </section>
            }

            <section class="catalog-section" aria-label="Cataloghi di consultazione">
                <h2>Cataloghi</h2>
                <p class="catalog-hint">
                    Materiale di consultazione — mostri, classi, razze, background, dati di campagna.
                    Non serve per iniziare a giocare: torna qui quando prepari qualcosa.
                </p>
                <div class="catalog-list">
                    @foreach (var item in catalogItems)
                    {
                        <button type="button" class="catalog-item" @onclick="@(() => Navigation.NavigateTo(item.Route))">
                            <span class="catalog-icon" aria-hidden="true">@item.Icon</span>
                            <span class="catalog-title">@item.Title</span>
                        </button>
                    }
                </div>
            </section>
        }
        else
        {
            <div class="state-message">Seleziona o crea una campagna per iniziare.</div>
        }
    }
</div>

@code {
    private enum FormKind { None, Create, Join }

    private record CatalogItem(string Icon, string Title, string Route);

    // Le altre quattro voci della vecchia griglia (Personaggi, Incantesimi, Appunti, Combattimento)
    // sono ora raggiungibili dalla barra di navigazione inferiore (Shared/BottomNav.razor) e non
    // hanno più bisogno di una card qui: restano solo i cataloghi di sola consultazione, che la
    // barra non ospita. Il pacchetto SRD è arrivato il 2026-07-31, ma NON aggiunge una voce
    // "Manuale": le sue voci compaiono già dentro i cataloghi qui sotto (CatalogService unisce
    // pacchetto e righe di campagna), quindi una card a parte mostrerebbe le stesse cose due volte.
    private static readonly CatalogItem[] catalogItems =
    {
        new("🐉", "Mostri",      "monsters"),
        new("⚔️", "Classi",      "classes"),
        new("🧝", "Razze",       "races"),
        new("🎭", "Background",  "backgrounds"),
        new("📦", "Dati",        "dati"),
    };

    private string? userId;
    private string? displayName;
    private List<Campaign> campaigns = new();
    private List<Character> campaignCharacters = new();
    private List<CampaignMember> campaignMembers = new();
    private bool isLoading = true;
    private bool isBusy;
    private string? errorMessage;

    private FormKind formKind = FormKind.None;
    private string newCampaignName = string.Empty;
    private string joinCode = string.Empty;

    private bool isMaster => CampaignState.IsMaster;

    private Campaign? ActiveCampaign =>
        campaigns.FirstOrDefault(c => c.Id == CampaignState.ActiveCampaignId);

    private bool hasOwnCharacter =>
        !string.IsNullOrEmpty(userId) && campaignCharacters.Any(c => c.OwnerId == userId);

    private bool hasOtherMembers => campaignMembers.Count > 1;

    private IReadOnlyList<HomeOnboardingLogic.Step> onboardingSteps => HomeOnboardingLogic.BuildSteps(
        hasActiveCampaign: !string.IsNullOrEmpty(CampaignState.ActiveCampaignId),
        isMaster: isMaster,
        hasOwnCharacter: hasOwnCharacter,
        hasOtherMembers: hasOtherMembers);

    private bool showOnboarding => !HomeOnboardingLogic.IsSetupComplete(onboardingSteps);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Garantisce che il bootstrap della sessione (init + LoadSession + eventuale ritorno
            // OAuth) sia COMPLETO prima di leggere l'identità: niente più race con AuthRedirect.
            await SupabaseService.GetClientAsync();

            userId = await AuthState.GetUserIdAsync();
            if (string.IsNullOrEmpty(userId))
            {
                // Sessione risolta ma nessun utente → non loggato: AuthRedirect porterà al login.
                // Il finally azzera comunque isLoading (niente loading infinito).
                return;
            }

            displayName = await AuthState.GetDisplayNameAsync();
            await ProfileRepository.EnsureProfileAsync(userId, displayName);

            await CampaignState.InitializeAsync();
            campaigns = await CampaignRepository.GetUserCampaignsAsync(userId);

            // Se la campagna attiva memorizzata non è più valida, azzerala.
            var activeId = CampaignState.ActiveCampaignId;
            if (!string.IsNullOrEmpty(activeId) && campaigns.All(c => c.Id != activeId))
            {
                await CampaignState.ClearActiveCampaign();
            }

            // Auto-seleziona se non c'è una campagna attiva ma l'utente ne ha almeno una.
            if (string.IsNullOrEmpty(CampaignState.ActiveCampaignId) && campaigns.Count > 0)
            {
                await CampaignState.SetActiveCampaignAsync(campaigns[0].Id);
            }

            await LoadOnboardingDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore caricamento campagne: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Dati SOLO per decidere quali passi del percorso guidato sono già completati (personaggio
    // proprio, altri membri): non sono dati di dominio mostrati altrove in questa pagina, quindi un
    // fallimento qui non merita il DbErrorBanner. Si tace e si riprova al prossimo cambio campagna,
    // stesso criterio di Shared/BottomNav.razor per gli aiuti di sola guida.
    //
    // Le due chiamate hanno try/catch separati: se una fallisce e l'altra riesce, il risultato buono
    // non va perso (altrimenti un errore transitorio sui membri farebbe ricomparire "Crea il tuo
    // personaggio" come da fare anche se il personaggio c'è già).
    //
    // Il selettore campagna (riga sopra) non è disabilitato durante il caricamento: un cambio rapido
    // può quindi avviare una seconda LoadOnboardingDataAsync mentre la prima è ancora in attesa di
    // rete, e l'ordine di arrivo delle risposte non è garantito. Senza il controllo finale, la
    // risposta più lenta per la campagna PRECEDENTE potrebbe sovrascrivere quella già corretta della
    // campagna attuale. Si scarta quindi il risultato se, nel frattempo, la campagna attiva è
    // cambiata rispetto a quella richiesta.
    private async Task LoadOnboardingDataAsync()
    {
        var campaignId = CampaignState.ActiveCampaignId;
        if (string.IsNullOrEmpty(campaignId))
        {
            campaignCharacters = new();
            campaignMembers = new();
            return;
        }

        List<Character> characters;
        try
        {
            characters = await CharacterRepository.GetCharactersForCampaignAsync(campaignId);
        }
        catch
        {
            characters = new();
        }

        List<CampaignMember> members;
        try
        {
            members = await CampaignRepository.GetCampaignMembersAsync(campaignId);
        }
        catch
        {
            members = new();
        }

        if (CampaignState.ActiveCampaignId != campaignId) return; // superato da un cambio nel frattempo

        campaignCharacters = characters;
        campaignMembers = members;
    }

    private async Task OnCampaignSelectedAsync(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (string.IsNullOrEmpty(id))
        {
            await CampaignState.ClearActiveCampaign();
        }
        else
        {
            await CampaignState.SetActiveCampaignAsync(id);
        }
        await LoadOnboardingDataAsync();
        StateHasChanged();
    }

    private void ShowForm(FormKind kind)
    {
        formKind = kind;
        errorMessage = null;
        newCampaignName = string.Empty;
        joinCode = string.Empty;
    }

    private void HideForm() => formKind = FormKind.None;

    private async Task CreateCampaignAsync()
    {
        if (string.IsNullOrWhiteSpace(newCampaignName))
        {
            Toasts.ShowError("Inserisci un nome per la campagna");
            return;
        }
        if (string.IsNullOrEmpty(userId)) return;

        isBusy = true;
        errorMessage = null;
        try
        {
            var created = await CampaignRepository.CreateCampaignAsync(newCampaignName.Trim(), userId);
            campaigns.Add(created);
            await CampaignState.SetActiveCampaignAsync(created.Id);
            await LoadOnboardingDataAsync();
            formKind = FormKind.None;
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore creazione campagna: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task JoinCampaignAsync()
    {
        if (string.IsNullOrWhiteSpace(joinCode))
        {
            Toasts.ShowError("Inserisci un codice invito");
            return;
        }
        if (string.IsNullOrEmpty(userId)) return;

        isBusy = true;
        errorMessage = null;
        try
        {
            var joined = await CampaignRepository.JoinCampaignAsync(joinCode.Trim(), userId);
            if (joined is null)
            {
                Toasts.ShowError("Codice invito non valido");
                return;
            }

            if (campaigns.All(c => c.Id != joined.Id))
                campaigns.Add(joined);

            await CampaignState.SetActiveCampaignAsync(joined.Id);
            await LoadOnboardingDataAsync();
            formKind = FormKind.None;
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteActiveCampaignAsync()
    {
        var campaign = ActiveCampaign;
        if (campaign is null || !isMaster || isBusy) return;

        var confirmed = await Confirm.ShowAsync(
            $"Eliminare la campagna \"{campaign.Name}\"?\n\n" +
            "Questa azione è IRREVERSIBILE: cancella i personaggi di TUTTI i giocatori, le note, " +
            "gli incantesimi, i mostri, le razze e le classi di questa campagna.");
        if (!confirmed) return;

        isBusy = true;
        errorMessage = null;
        try
        {
            await CampaignRepository.DeleteCampaignAsync(campaign.Id);
            campaigns.RemoveAll(c => c.Id == campaign.Id);
            if (CampaignState.ActiveCampaignId == campaign.Id)
                await CampaignState.ClearActiveCampaign();
            await SelectFirstOrNoneAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore eliminazione campagna: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task LeaveActiveCampaignAsync()
    {
        var campaign = ActiveCampaign;
        if (campaign is null || isMaster || isBusy || string.IsNullOrEmpty(userId)) return;

        var confirmed = await Confirm.ShowAsync(
            $"Uscire dalla campagna \"{campaign.Name}\"?\n\n" +
            "Non farai più parte della campagna. Il tuo personaggio resta nella campagna e " +
            "il Master potrà ancora vederlo.");
        if (!confirmed) return;

        isBusy = true;
        errorMessage = null;
        try
        {
            await CampaignRepository.LeaveCampaignAsync(campaign.Id, userId);
            campaigns.RemoveAll(c => c.Id == campaign.Id);
            if (CampaignState.ActiveCampaignId == campaign.Id)
                await CampaignState.ClearActiveCampaign();
            await SelectFirstOrNoneAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore uscita campagna: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    // Dopo eliminazione/uscita: se restano campagne ne seleziona una; altrimenti resta
    // nessuna campagna attiva e la UI mostra l'onboarding (campaigns.Count == 0). In entrambi i
    // casi i dati del percorso guidato vanno ricaricati: o per la campagna appena selezionata, o
    // azzerati perché non ce n'è più una attiva.
    private async Task SelectFirstOrNoneAsync()
    {
        if (string.IsNullOrEmpty(CampaignState.ActiveCampaignId) && campaigns.Count > 0)
            await CampaignState.SetActiveCampaignAsync(campaigns[0].Id);
        await LoadOnboardingDataAsync();
    }

    private async Task CopyInviteCodeAsync()
    {
        var code = ActiveCampaign?.InviteCode;
        if (string.IsNullOrEmpty(code)) return;

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            Toasts.ShowSuccess("Codice invito copiato");
        }
        catch
        {
            // Clipboard non disponibile (permessi negati, contesto non sicuro): il codice resta
            // comunque visibile e selezionabile a mano nel box qui sopra.
            Toasts.ShowError("Impossibile copiare: seleziona il codice qui sopra a mano");
        }
    }

    private async Task OnLogoutAsync()
    {
        await CampaignState.ClearActiveCampaign();
        await AuthState.LogoutAsync();
    }
}
