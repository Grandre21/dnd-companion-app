@page "/classes"
@using DndCompanion.Models
@using DndCompanion.Models.Packages
@implements IDisposable
@inject IClassRepository ClassRepository
@inject IProfileRepository ProfileRepository
@inject ICatalogService Catalog
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ToastService Toasts
@inject ConfirmService Confirm

<PageTitle>Classi - D&amp;D Companion</PageTitle>

<div class="classes-container">
    <header class="page-header">
        <button type="button" class="back-btn" @onclick='() => Navigation.NavigateTo("")'>
            ← Home
        </button>
        <h1 class="page-title">Classi</h1>
    </header>

    <DbErrorBanner Message="@errorMessage" OnDismiss="@(() => errorMessage = null)" />

    @if (mode == ViewMode.Form)
    {
        <div class="form-view">
            <div class="form-top">
                <button type="button" class="back-link" @onclick="CancelForm">← Annulla</button>
            </div>

            <h2 class="form-title">
                @(string.IsNullOrEmpty(editDraft.Id) ? "Nuova Classe" : "Modifica Classe")
            </h2>

            <div class="form-grid">
                <div class="field field-full">
                    <label>Nome</label>
                    <input type="text" class="input" maxlength="80" @bind="editDraft.Name" />
                </div>

                <div class="field field-full">
                    <label>Descrizione</label>
                    <textarea class="input" rows="4" @bind="editDraft.Description"></textarea>
                </div>

                <div class="field">
                    <label>Dado Vita</label>
                    <input type="text" class="input" maxlength="10" placeholder="es. d10" @bind="editDraft.HitDie" />
                </div>

                <div class="field">
                    <label>Abilità Primaria</label>
                    <input type="text" class="input" maxlength="40" placeholder="es. Forza" @bind="editDraft.PrimaryAbility" />
                </div>

                <div class="field field-full">
                    <label>Tiri Salvezza</label>
                    <input type="text" class="input" maxlength="120" placeholder="es. Forza, Costituzione" @bind="editDraft.SavingThrows" />
                </div>

                <div class="field field-full">
                    <label>Competenze Armature</label>
                    <input type="text" class="input" maxlength="200" @bind="editDraft.ArmorProficiencies" />
                </div>

                <div class="field field-full">
                    <label>Competenze Armi</label>
                    <input type="text" class="input" maxlength="200" @bind="editDraft.WeaponProficiencies" />
                </div>

                <div class="field field-full">
                    <label>Scelta Abilità</label>
                    <textarea class="input" rows="3" placeholder="Es. Scegli 2 tra Acrobazia, Atletica..." @bind="editDraft.SkillChoices"></textarea>
                </div>

                <div class="field field-full">
                    <label>Capacità di Classe</label>
                    <textarea class="input" rows="8" @bind="editDraft.Features"></textarea>
                </div>

                @* Le sottoclassi vivono in editDraft.Subclasses (colonna "subclasses"), nel formato
                   testuale di SubclassText: qui restano solo il markup e il richiamo a
                   SubclassEditor, che tiene la manipolazione dell'elenco. *@
                <div class="field field-full">
                    <label>Sottoclassi</label>
                    @if (!SubclassEditor.PuoModificare(editDraft.Subclasses))
                    {
                        @* Il campo contiene testo che SubclassText non saprebbe restituire intatto
                           (una nota scritta a mano, magari sopra un elenco): la modifica guidata
                           resta disattivata per non buttarlo via in silenzio al primo salvataggio.
                           Il testo però si mostra e si corregge a mano, come per «Capacità di
                           Classe» qui sopra: senza la textarea questo ramo era un vicolo cieco —
                           contenuto né visibile né modificabile, recuperabile solo via database. *@
                        <p class="subclass-hint">
                            Il campo contiene del testo che non riconosciamo come elenco di sottoclassi:
                            per non perderlo, qui la modifica guidata è disattivata. Puoi correggerlo a
                            mano — un elenco comincia con <code>## Nome della sottoclasse</code>.
                        </p>
                        <textarea class="input" rows="6" @bind="editDraft.Subclasses"></textarea>
                    }
                    else
                    {
                        var sottoclassi = SubclassText.Leggi(editDraft.Subclasses);
                        @if (sottoclassi.Count > 0)
                        {
                            <ul class="subclass-list">
                                @foreach (var s in sottoclassi)
                                {
                                    <li class="subclass-list-item">
                                        <span class="subclass-list-name">@s.Name</span>
                                        <div class="subclass-list-actions">
                                            <button type="button" class="action-btn edit-action"
                                                    @onclick="() => OpenSubclassForm(s)"
                                                    aria-label="Modifica sottoclasse @s.Name">
                                                ✎
                                            </button>
                                            <button type="button" class="action-btn delete-action"
                                                    @onclick="() => RemoveSubclassAsync(s.Name)"
                                                    aria-label="Rimuovi sottoclasse @s.Name">
                                                🗑
                                            </button>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="subclass-hint">
                                Nessuna sottoclasse propria: il personaggio può comunque scriverne una a mano.
                            </p>
                        }

                        @if (showSubclassForm)
                        {
                            <div class="subclass-form">
                                <div class="field">
                                    <label>Nome sottoclasse</label>
                                    <input type="text" class="input" maxlength="60" @bind="subclassName" />
                                </div>
                                <div class="field">
                                    <label>Descrizione</label>
                                    <textarea class="input" rows="3" @bind="subclassDescription"></textarea>
                                </div>
                                <div class="field">
                                    <label>Privilegi per livello</label>
                                    <textarea class="input" rows="3" placeholder="es. L3 — Frenesia"
                                              @bind="subclassLevels"></textarea>
                                    <p class="subclass-hint">Un privilegio per riga, formato «L&lt;livello&gt; — Nome».</p>
                                </div>
                                <div class="form-actions">
                                    <button type="button" class="primary-btn" @onclick="SaveSubclass">
                                        Salva sottoclasse
                                    </button>
                                    <button type="button" class="secondary-btn" @onclick="CancelSubclassForm">
                                        Annulla
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="action-btn subclass-add-btn"
                                    @onclick="() => OpenSubclassForm(null)">
                                + Aggiungi sottoclasse
                            </button>
                        }
                    }
                </div>
            </div>

            <div class="form-actions">
                <button type="button" class="primary-btn" @onclick="SaveFormAsync" disabled="@isBusy">
                    @(isBusy ? "Salvataggio..." : "Salva")
                </button>
                <button type="button" class="secondary-btn" @onclick="CancelForm" disabled="@isBusy">
                    Annulla
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="search-section">
            <input type="text" class="search-input" placeholder="Cerca classe..."
                   @bind="searchInput" @bind:event="oninput" @bind:after="OnSearchInputChangedAsync" />

            <div class="results-info">
                @if (isLoading)
                {
                    <LoadingSpinner Text="Caricamento classi..." />
                }
                else
                {
                    var count = FilteredEntries.Count();
                    <span>@count @(count == 1 ? "classe trovata" : "classi trovate")</span>
                }
            </div>
        </div>

        <div class="classes-list">
            @if (!isLoading)
            {
                @foreach (var entry in FilteredEntries)
                {
                    var isExpanded = expandedKey == entry.Key;
                    <div class="class-card @(isExpanded ? "expanded" : "") @(entry.FromAppPackage ? "package-card" : "")">
                        <button type="button" class="card-summary" @onclick="() => ToggleExpand(entry.Key)">
                            <div class="card-main">
                                <div class="card-name">@entry.Name</div>
                                <div class="card-meta">
                                    <span class="hitdie-badge">Dado Vita @(string.IsNullOrEmpty(entry.HitDie) ? "—" : entry.HitDie)</span>
                                    @{ var author = GetAuthorName(entry.Db?.AddedBy); }
                                    @if (!string.IsNullOrEmpty(author))
                                    {
                                        <span class="author-badge" title="Aggiunta da @author">✎ @author</span>
                                    }
                                    @if (entry.FromAppPackage)
                                    {
                                        <span class="package-badge">Dal manuale</span>
                                    }
                                </div>
                            </div>
                            <span class="expand-icon">@(isExpanded ? "▾" : "▸")</span>
                        </button>

                        <div class="card-details">
                            <div class="details-inner">
                                @if (!string.IsNullOrWhiteSpace(entry.Description))
                                {
                                    <div class="section-block">
                                        <div class="section-title">Descrizione</div>
                                        <div class="section-body">@entry.Description</div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(entry.PrimaryAbility))
                                {
                                    <div class="section-block">
                                        <div class="section-title">Abilità primaria</div>
                                        <div class="section-body">@entry.PrimaryAbility</div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(entry.SavingThrows))
                                {
                                    <div class="section-block">
                                        <div class="section-title">Tiri salvezza</div>
                                        <div class="section-body">@entry.SavingThrows</div>
                                    </div>
                                }

                                @if (entry.Db is not null && !string.IsNullOrWhiteSpace(entry.Db.ArmorProficiencies))
                                {
                                    <div class="section-block">
                                        <div class="section-title">Competenze armature</div>
                                        <div class="section-body">@entry.Db.ArmorProficiencies</div>
                                    </div>
                                }

                                @if (entry.Db is not null && !string.IsNullOrWhiteSpace(entry.Db.WeaponProficiencies))
                                {
                                    <div class="section-block">
                                        <div class="section-title">Competenze armi</div>
                                        <div class="section-body">@entry.Db.WeaponProficiencies</div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(entry.SkillChoices))
                                {
                                    <div class="section-block">
                                        <div class="section-title">Scelta abilità</div>
                                        <div class="section-body">@entry.SkillChoices</div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(entry.Features))
                                {
                                    <div class="section-block">
                                        <div class="section-title">Capacità di classe</div>
                                        <div class="section-body">@entry.Features</div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(entry.SubclassNames))
                                {
                                    <div class="section-block">
                                        <div class="section-title">Sottoclassi</div>
                                        <div class="section-body">@entry.SubclassNames</div>
                                    </div>
                                }

                                @if (entry.IsPackage)
                                {
                                    <div class="card-actions">
                                        <button type="button" class="action-btn duplicate-action"
                                                @onclick="() => OpenDuplicateForm(entry.Package!)" @onclick:stopPropagation
                                                aria-label="Duplica e modifica @entry.Name">
                                            ⧉ Duplica e modifica
                                        </button>
                                    </div>
                                }
                                else if (CatalogKey.IsFromAppPackage(entry.Db!.SourceId))
                                {
                                    <div class="card-actions">
                                        <button type="button" class="action-btn duplicate-action"
                                                @onclick="() => OpenDuplicateForm(entry.Db!)" @onclick:stopPropagation
                                                aria-label="Duplica e modifica @entry.Name">
                                            ⧉ Duplica e modifica
                                        </button>
                                    </div>
                                }
                                else if (PuoModificare(entry.Db!))
                                {
                                    <div class="card-actions">
                                        <button type="button" class="action-btn edit-action" @onclick="() => OpenEditForm(entry.Db!)" @onclick:stopPropagation>
                                            ✎ Modifica
                                        </button>
                                        <button type="button" class="action-btn delete-action" @onclick="() => DeleteClassAsync(entry.Db!)" @onclick:stopPropagation>
                                            🗑 Elimina
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (!FilteredEntries.Any())
                {
                    <div class="empty-state">
                        @if (dbRows.Count == 0 && packageRows.Count == 0)
                        {
                            <div class="empty-icon">⚔️</div>
                            <p class="empty-title">Nessuna classe nel database</p>
                            <p class="empty-text">
                                Ogni giocatore può aggiungere le classi usando il bottone
                                <strong>+</strong> in basso a destra.
                            </p>
                        }
                        else
                        {
                            <p class="empty-text">Nessuna classe corrisponde alla ricerca.</p>
                        }
                    </div>
                }
            }
        </div>

        @* Creazione classe: ogni membro della campagna può aggiungere. *@
        <button type="button" class="fab" @onclick="OpenCreateForm" title="Nuova classe" aria-label="Nuova classe">
            +
        </button>
    }
</div>

@code {
    private enum ViewMode { List, Form }

    private ViewMode mode = ViewMode.List;

    private List<CharacterClass> dbRows = new();
    private List<PackageClass> packageRows = new();
    private Dictionary<string, string> playerNicknames = new();
    private bool isLoading = true;
    private bool isBusy;
    private string? errorMessage;

    private string searchInput = string.Empty;
    private string searchQuery = string.Empty;
    private CancellationTokenSource? debounceCts;

    private string? expandedKey;
    private CharacterClass editDraft = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CurrentUser.EnsureLoadedAsync();

            if (string.IsNullOrEmpty(CurrentUser.CampaignId)) return;

            var profilesTask = ProfileRepository.GetProfilesAsync();
            var reloadTask = ReloadAsync();
            await Task.WhenAll(profilesTask, reloadTask);

            playerNicknames = profilesTask.Result.ToDictionary(p => p.Id, p => p.DisplayName ?? "Utente");
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore caricamento classi: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Ricarica SEMPRE dal servizio invece di ritoccare dbRows/packageRows in memoria: la vista non
    // è solo righe di database, contiene anche le voci di pacchetto, e quali siano visibili dipende
    // da cosa c'è nel database (vedi "Duplica e modifica" più sotto).
    private async Task ReloadAsync()
    {
        if (string.IsNullOrEmpty(CurrentUser.CampaignId)) return;

        var vista = await Catalog.GetClassesAsync(CurrentUser.CampaignId);
        dbRows = vista.DbRows.ToList();
        packageRows = vista.PackageEntries.ToList();
    }

    private string? GetAuthorName(string? authorId)
    {
        if (string.IsNullOrEmpty(authorId)) return null;
        return playerNicknames.TryGetValue(authorId, out var nick) ? nick : null;
    }

    // Una riga di database è modificabile se chi guarda ne ha il diritto E non viene dal
    // pacchetto dell'app: quelle restano voci di manuale anche se vivono nel database (§6).
    private bool PuoModificare(CharacterClass c)
        => !CatalogKey.IsFromAppPackage(c.SourceId)
           && AccessControl.CanEdit(CurrentUser.IsMaster, c.AddedBy, CurrentUser.UserId);

    // Copia modificabile di una voce di pacchetto: nasce SENZA SourceId, così è una voce
    // propria dell'utente e ha la precedenza nel merge (§4.3).
    private CharacterClass DuplicaDaPacchetto(PackageClass p) => new()
    {
        Name = p.Name,
        HitDie = p.HitDie,
        PrimaryAbility = p.PrimaryAbility,
        SavingThrows = string.Join(", ", p.SavingThrows),
        SkillChoices = PackageRowMerge.DescriviScelte(p.SkillChoices) ?? string.Empty,
        // La tabella dei livelli va copiata come tutto il resto: la card mostra i venti livelli, e
        // senza questa riga «Duplica e modifica» aprirebbe una textarea vuota. La copia, non avendo
        // SourceId, oscura per nome la voce di pacchetto (CatalogMerge): la tabella sparirebbe
        // dalla pagina e la scheda del PG mostrerebbe i privilegi SRD di una classe sostituita.
        Features = ClassProgression.Serializza(p.Levels),
        // Stessa ragione dei livelli: senza le sottoclassi, «Duplica e modifica» da una classe SRD
        // perderebbe proprio ciò che si voleva modificare — la classe copiata oscura la voce di
        // pacchetto (nessun SourceId), e con lei sparirebbero anche le sue sottoclassi.
        Subclasses = SubclassText.Serializza(p.Subclasses),
        SourceId = null,
        CampaignId = CurrentUser.CampaignId ?? string.Empty,
        AddedBy = CurrentUser.UserId,
    };

    // Stessa regola di DuplicaDaPacchetto, ma per una riga di DATABASE che porta comunque la
    // provenienza del pacchetto dell'app (import diretto, non ancora possibile in questa fase ma
    // già previsto dal modello dati): anche qui la copia nasce SENZA SourceId.
    // AddedBy è l'utente CORRENTE, non l'autore originale della riga (che potrebbe non essere lui):
    // la RLS "classes_insert" richiede added_by = auth.uid(), quindi copiare c.AddedBy avrebbe
    // fatto fallire l'INSERT per chiunque diverso dall'autore originale, master incluso.
    private CharacterClass DuplicaDaRigaImportata(CharacterClass c) => new()
    {
        Name = c.Name,
        Description = c.Description,
        HitDie = c.HitDie,
        PrimaryAbility = c.PrimaryAbility,
        SavingThrows = c.SavingThrows,
        ArmorProficiencies = c.ArmorProficiencies,
        WeaponProficiencies = c.WeaponProficiencies,
        SkillChoices = c.SkillChoices,
        Features = c.Features,
        Subclasses = c.Subclasses,
        SourceId = null,
        CampaignId = c.CampaignId,
        AddedBy = CurrentUser.UserId,
    };

    // Vista unificata di riga-database e voce-pacchetto: la lista mostrata è un'unione delle due
    // sorgenti (ricerca/ordinamento/rendering condivisi), ma le operazioni CRUD restano ancorate a
    // dbRows/packageRows separati.
    // FromAppPackage è la stessa condizione che, più sotto, sopprime i comandi di modifica/cancellazione
    // (voce di pacchetto, oppure riga di database con provenienza dal pacchetto dell'app): la marcatura
    // visiva (badge "Dal manuale" + bordo della card) deve dipendere da questa, non da IsPackage da sola,
    // altrimenti una riga di database non modificabile risulterebbe indistinguibile da una qualsiasi.
    private sealed record Entry(
        string Key,
        string Name,
        string Description,
        string HitDie,
        string PrimaryAbility,
        string SavingThrows,
        string SkillChoices,
        string Features,
        string SubclassNames,
        bool IsPackage,
        bool FromAppPackage,
        CharacterClass? Db,
        PackageClass? Package);

    private static Entry ToEntry(CharacterClass c) => new(
        "db:" + c.Id, c.Name, c.Description, c.HitDie, c.PrimaryAbility, c.SavingThrows,
        c.SkillChoices, c.Features, NomiSottoclassi(SubclassText.Leggi(c.Subclasses)),
        false, CatalogKey.IsFromAppPackage(c.SourceId), c, null);

    // Le liste del pacchetto diventano testo, come le colonne del Model. `levels` passa da
    // ClassProgression.Serializza, la stessa conversione che usa l'import (2026-07-31): prima
    // veniva scartata, e la voce «Dal manuale» mostrava la sezione privilegi vuota mentre la riga
    // importata della stessa classe mostrava i venti livelli — due schede diverse per la stessa
    // classe. Il formato resta a righe e `.section-body` ha `white-space: pre-wrap`.
    //
    // La descrizione delle scelte di abilità passa da PackageRowMerge.DescriviScelte, non da una
    // formula riscritta qui: è la stessa che usano import e aggiornamento, e tre copie
    // divergerebbero al primo cambio di formato.
    private static Entry ToEntry(PackageClass p) => new(
        "pkg:" + p.Id, p.Name, string.Empty, p.HitDie, p.PrimaryAbility,
        string.Join(", ", p.SavingThrows),
        PackageRowMerge.DescriviScelte(p.SkillChoices) ?? string.Empty,
        ClassProgression.Serializza(p.Levels), NomiSottoclassi(p.Subclasses),
        true, true, null, p);

    // Solo i nomi, non l'elenco intero: la card è un riepilogo, e i privilegi di ogni sottoclasse
    // si vedono già nella scheda del personaggio (SubclassCatalog.PrivilegiFinoAl) o, per chi la
    // sta scrivendo, nel mini-form della modifica.
    private static string NomiSottoclassi(IEnumerable<PackageSubclass>? sottoclassi)
        => string.Join(", ", (sottoclassi ?? Enumerable.Empty<PackageSubclass>())
            .Where(s => s is not null && !string.IsNullOrWhiteSpace(s.Name))
            .Select(s => s.Name));

    private IEnumerable<Entry> FilteredEntries
    {
        get
        {
            IEnumerable<Entry> result = dbRows.Select(ToEntry).Concat(packageRows.Select(ToEntry));
            if (!string.IsNullOrEmpty(searchQuery))
            {
                // CatalogKey.NormalizeName su entrambi i lati: cercare "paladino" deve trovare
                // "Paladino", non solo la stessa combinazione esatta di maiuscole e accenti.
                var chiaveRicerca = CatalogKey.NormalizeName(searchQuery);
                result = result.Where(e => CatalogKey.NormalizeName(e.Name).Contains(chiaveRicerca, StringComparison.Ordinal));
            }
            return result.OrderBy(e => e.Name, StringComparer.OrdinalIgnoreCase);
        }
    }

    private async Task OnSearchInputChangedAsync()
    {
        debounceCts?.Cancel();
        debounceCts?.Dispose();
        debounceCts = new CancellationTokenSource();
        var token = debounceCts.Token;
        try
        {
            await Task.Delay(300, token);
            if (token.IsCancellationRequested) return;
            searchQuery = searchInput.Trim();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private void ToggleExpand(string key) => expandedKey = expandedKey == key ? null : key;

    private void OpenCreateForm()
    {
        editDraft = new CharacterClass
        {
            HitDie = "d8",
            AddedBy = CurrentUser.UserId,
            CampaignId = CurrentUser.CampaignId ?? string.Empty
        };
        ResetSubclassForm();
        mode = ViewMode.Form;
    }

    private void OpenEditForm(CharacterClass cls)
    {
        editDraft = CloneClass(cls);
        ResetSubclassForm();
        mode = ViewMode.Form;
    }

    private void OpenDuplicateForm(PackageClass package)
    {
        editDraft = DuplicaDaPacchetto(package);
        ResetSubclassForm();
        mode = ViewMode.Form;
    }

    private void OpenDuplicateForm(CharacterClass cls)
    {
        editDraft = DuplicaDaRigaImportata(cls);
        ResetSubclassForm();
        mode = ViewMode.Form;
    }

    private void CancelForm() => mode = ViewMode.List;

    // ===== Mini-form "aggiungi/modifica sottoclasse", dentro il form della classe =====
    // Stato di sola UI: la sottoclasse aggiunta/tolta vive già in editDraft.Subclasses (SubclassEditor
    // lavora sul testo), qui restano solo i campi del piccolo form e quale voce si sta modificando.
    private bool showSubclassForm;
    private string? editingSubclassName;
    private string subclassName = string.Empty;
    private string subclassDescription = string.Empty;
    private string subclassLevels = string.Empty;
    private string? subclassId;

    // Va richiamato ogni volta che si apre il form della classe (nuova/modifica/duplica): senza,
    // il mini-form di una sottoclasse lasciato aperto sulla classe precedente sopravviverebbe al
    // cambio di editDraft.
    private void ResetSubclassForm()
    {
        showSubclassForm = false;
        editingSubclassName = null;
        subclassName = string.Empty;
        subclassDescription = string.Empty;
        subclassLevels = string.Empty;
        subclassId = null;
    }

    private void OpenSubclassForm(PackageSubclass? esistente)
    {
        editingSubclassName = esistente?.Name;
        subclassName = esistente?.Name ?? string.Empty;
        subclassDescription = esistente?.Description ?? string.Empty;
        subclassLevels = esistente is null ? string.Empty : ClassProgression.Serializza(esistente.Levels);
        subclassId = esistente?.Id;
        showSubclassForm = true;
    }

    private void CancelSubclassForm() => ResetSubclassForm();

    private void SaveSubclass()
    {
        if (string.IsNullOrWhiteSpace(subclassName))
        {
            Toasts.ShowError("Il nome della sottoclasse è obbligatorio");
            return;
        }

        // Rinominare una sottoclasse col nome di un'altra la sovrascriverebbe: `Aggiungi` sostituisce
        // per nome normalizzato, e con due voci in corrispondenza ne resta una sola — descrizione e
        // privilegi dell'altra persi senza un avviso. Meglio dirlo prima che chiederne conferma dopo:
        // il nome è l'unica chiave che questo elenco ha.
        if (SubclassEditor.CollideConUnAltra(editDraft.Subclasses, subclassName, editingSubclassName))
        {
            Toasts.ShowError($"C'è già una sottoclasse che si chiama \"{subclassName.Trim()}\"");
            return;
        }

        var nuova = SubclassEditor.Costruisci(subclassName, subclassDescription, subclassLevels, subclassId);
        editDraft.Subclasses = SubclassEditor.Aggiungi(editDraft.Subclasses, nuova, editingSubclassName);
        ResetSubclassForm();
    }

    private async Task RemoveSubclassAsync(string nome)
    {
        var confermato = await Confirm.ShowAsync($"Rimuovere la sottoclasse \"{nome}\"?");
        if (!confermato) return;

        editDraft.Subclasses = SubclassEditor.Rimuovi(editDraft.Subclasses, nome);
        // Se si stava modificando proprio questa voce, il mini-form non ha più senso aperto su un
        // nome che non esiste più.
        if (CatalogKey.NormalizeName(editingSubclassName) == CatalogKey.NormalizeName(nome))
            ResetSubclassForm();
    }

    private async Task SaveFormAsync()
    {
        if (string.IsNullOrWhiteSpace(editDraft.Name))
        {
            Toasts.ShowError("Il nome è obbligatorio");
            return;
        }

        isBusy = true;
        errorMessage = null;
        try
        {
            var saved = string.IsNullOrEmpty(editDraft.Id)
                ? await ClassRepository.CreateClassAsync(editDraft)
                : await ClassRepository.UpdateClassAsync(editDraft);

            if (saved is null)
            {
                errorMessage = "Il server non ha restituito la classe salvata.";
                return;
            }

            // Richiama il servizio invece di ritoccare dbRows: la copia di "Duplica e modifica"
            // deve far sparire la voce di pacchetto da cui deriva nella STESSA operazione, non al
            // prossimo cambio pagina.
            await ReloadAsync();
            expandedKey = "db:" + saved.Id;
            mode = ViewMode.List;
            Toasts.ShowSuccess("Salvato");
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore salvataggio: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteClassAsync(CharacterClass cls)
    {
        var confirmed = await Confirm.ShowAsync($"Eliminare la classe \"{cls.Name}\"?");
        if (!confirmed) return;

        isBusy = true;
        errorMessage = null;
        try
        {
            await ClassRepository.DeleteClassAsync(cls.Id);
            if (expandedKey == "db:" + cls.Id) expandedKey = null;
            await ReloadAsync();
            Toasts.ShowSuccess("Eliminato");
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore eliminazione: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private static CharacterClass CloneClass(CharacterClass c) => new()
    {
        Id = c.Id,
        Name = c.Name,
        Description = c.Description,
        HitDie = c.HitDie,
        PrimaryAbility = c.PrimaryAbility,
        SavingThrows = c.SavingThrows,
        ArmorProficiencies = c.ArmorProficiencies,
        WeaponProficiencies = c.WeaponProficiencies,
        SkillChoices = c.SkillChoices,
        Features = c.Features,
        // Senza questa riga, aprire "Modifica" su una classe che ha già sottoclasse proprie le
        // azzererebbe al primo salvataggio: editDraft partirebbe da un clone senza Subclasses e lo
        // riscriverebbe vuoto, perdendo ciò che SaveSubclass aveva scritto in una sessione precedente.
        Subclasses = c.Subclasses,
        SourceId = c.SourceId,
        AddedBy = c.AddedBy,
        CampaignId = c.CampaignId,
        CreatedAt = c.CreatedAt
    };

    public void Dispose()
    {
        debounceCts?.Cancel();
        debounceCts?.Dispose();
    }
}
