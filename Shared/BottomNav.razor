@implements IDisposable
@inject NavigationManager Navigation
@inject CurrentUserService CurrentUser

@*
    Barra di navigazione inferiore (2026-07-30) — chiude la voce §8-bis del backlog:
    prima di questa barra ogni spostamento passava dalla Home, cioè due tap e un
    ricaricamento dati per ogni cambio di sezione. Sul telefono era l'attrito n.1.

    Sei voci, non tutte: le destinazioni dell'app sono dieci e su 390px darebbero celle da 39px,
    sotto la soglia del dito. Qui stanno le cinque sezioni di uso continuo al tavolo più la Home,
    che resta l'accesso a tutto il resto — i cinque cataloghi di consultazione (Mostri, Classi,
    Razze, Background, Dati) e il cambio campagna.

    Il tetto è proprio sei: a 390px — lo schermo più stretto che consideriamo — sei celle
    danno 65px l'una, ancora sopra i 44px di target tap; una settima scenderebbe a 55px con
    etichette che troncano quasi tutte. Se servirà una destinazione in più, ne va tolta una,
    non aggiunta e basta.

    Compare solo con una campagna attiva: senza, le sezioni non avrebbero dati da mostrare
    e la Home è comunque l'unica destinazione sensata. Il cambio campagna avviene in una
    pagina, non nel layout, quindi la barra si aggiorna via CurrentUser.ActiveCampaignChanged.
*@

@if (visible)
{
    <nav class="bottom-nav" aria-label="Navigazione principale">
        @foreach (var item in Items)
        {
            var isActive = BottomNavRoutes.IsActive(Navigation.ToBaseRelativePath(Navigation.Uri), item.Route);
            <a class="bnav-item @(isActive ? "active" : null)"
               href="@item.Href"
               aria-current="@(isActive ? "page" : null)">
                <span class="bnav-icon" aria-hidden="true">@item.Icon</span>
                <span class="bnav-label">@item.Label</span>
            </a>
        }
    </nav>
}

@code {
    private record NavItem(string Icon, string Label, string Route)
    {
        /// <summary>
        /// href relativo al &lt;base href&gt; (in produzione /dnd-companion-app/). Per la Home
        /// serve "./": un href vuoto significherebbe "documento corrente", non la radice.
        /// </summary>
        public string Href => Route.Length == 0 ? "./" : Route;
    }

    // Etichette prese dal lessico che l'app già usa altrove (le card della Home e i titoli di
    // pagina): "Personaggi", "Incantesimi", "Appunti" e "Iniziativa" — che è il nome dato al
    // tracker dal titolo di Combat.razor, oltre a essere l'unico abbastanza corto per la cella.
    // Le icone portano il selettore di variante (U+FE0F) come nelle card: senza, "⚔" viene reso
    // in monocromatico e stona accanto alle altre, a colori.
    private static readonly NavItem[] Items =
    {
        new("🏠", "Home",        ""),
        new("🗡️", "Personaggi",  "characters"),
        // Party sta accanto a Personaggi perché è la sua controparte: da quando un giocatore
        // vede in Personaggi solo i PROPRI PG (RLS ristretta, migrazione party_visibility), è
        // qui che si guardano le stat dei compagni. Senza questa voce la pagina non sarebbe
        // raggiungibile da nessun punto dell'app.
        new("🛡️", "Party",       "party"),
        new("⚔️", "Iniziativa",  "combat"),
        new("📜", "Incantesimi", "spells"),
        new("📝", "Appunti",     "notes"),
    };

    private bool visible;

    protected override async Task OnInitializedAsync()
    {
        // Sottoscrizioni PRIMA dell'await: se il componente venisse disposto mentre il
        // caricamento è ancora sospeso, Dispose annullerebbe iscrizioni non ancora fatte e la
        // continuation le lascerebbe appese a un componente morto (l'evento vive su un servizio
        // Singleton, quindi la perdita sarebbe permanente).
        CurrentUser.ActiveCampaignChanged += OnCampaignChanged;
        Navigation.LocationChanged += OnLocationChanged;

        try
        {
            // Idempotente: se una pagina l'ha già fatto, qui non costa nulla. Serve al caso in
            // cui la PWA venga riaperta direttamente su una rotta interna, dove il layout
            // renderizza prima che la pagina abbia caricato il proprio stato.
            await CurrentUser.EnsureLoadedAsync();
        }
        catch
        {
            // Il caricamento tocca la rete (identità e ruolo nella campagna): all'avvio offline,
            // o su un errore momentaneo, fallirebbe. Qui sta nel layout, FUORI dall'ErrorBoundary
            // che protegge le pagine: senza questa rete di sicurezza l'eccezione arriverebbe alla
            // barra d'errore di Blazor e la navigazione resterebbe assente per tutta la sessione.
            // La barra è un aiuto, non un dato: si tace e si riprova al primo cambio campagna.
        }

        visible = !string.IsNullOrEmpty(CurrentUser.CampaignId);
    }

    private void OnCampaignChanged()
    {
        visible = !string.IsNullOrEmpty(CurrentUser.CampaignId);
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        CurrentUser.ActiveCampaignChanged -= OnCampaignChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
