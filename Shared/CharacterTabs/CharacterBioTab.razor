@using DndCompanion.Models
@using DndCompanion.Models.Packages
@using DndCompanion.Services

<div class="bio-blocks">
    <div class="bio-row">
        <span class="bio-label">Allineamento</span>
        <span class="bio-value">@(string.IsNullOrWhiteSpace(Character.Alignment) ? "—" : Character.Alignment)</span>
    </div>
    <div class="bio-row">
        <span class="bio-label">Background</span>
        <span class="bio-value">@(string.IsNullOrWhiteSpace(Character.Background) ? "—" : Character.Background)</span>
    </div>
    <div class="bio-row">
        <span class="bio-label">Lingue</span>
        <span class="bio-value">@(string.IsNullOrWhiteSpace(Character.Languages) ? "—" : Character.Languages)</span>
    </div>
    <div class="bio-row">
        <span class="bio-label">Esperienza</span>
        <span class="bio-value">@Character.ExperiencePoints PE</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Character.Appearance))
    {
        <div class="bio-block">
            <p class="bio-block-title">ASPETTO</p>
            <p class="bio-block-text">@Character.Appearance</p>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Character.Backstory))
    {
        <div class="bio-block">
            <p class="bio-block-title">STORIA</p>
            <p class="bio-block-text">@Character.Backstory</p>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Character.SpeciesTraits))
    {
        <div class="bio-block">
            <p class="bio-block-title">TRATTI DELLA SPECIE</p>
            <p class="bio-block-text">@Character.SpeciesTraits</p>
        </div>
    }
    @* Resistenze, immunità e vulnerabilità stavano nella tab del combattimento, ma non sono
       un'azione: sono tratti del personaggio, e si consultano come i tratti di specie. *@
    @if (HasDefenses)
    {
        <p class="section-header">DIFESE</p>
        <div class="defenses-badges">
            @if (!string.IsNullOrWhiteSpace(Character.DamageResistances))
            {
                @foreach (var item in SplitDefenses(Character.DamageResistances))
                {
                    <span class="defense-badge resistance">RES @item</span>
                }
            }
            @if (!string.IsNullOrWhiteSpace(Character.DamageImmunities))
            {
                @foreach (var item in SplitDefenses(Character.DamageImmunities))
                {
                    <span class="defense-badge immunity">IMM @item</span>
                }
            }
            @if (!string.IsNullOrWhiteSpace(Character.DamageVulnerabilities))
            {
                @foreach (var item in SplitDefenses(Character.DamageVulnerabilities))
                {
                    <span class="defense-badge vulnerability">VUL @item</span>
                }
            }
            @if (!string.IsNullOrWhiteSpace(Character.ConditionImmunities))
            {
                @foreach (var item in SplitDefenses(Character.ConditionImmunities))
                {
                    <span class="defense-badge condition-immunity">IMM @item</span>
                }
            }
        </div>
    }

    @{
        var raggiunti = ClassProgression.PrivilegiFinoAl(ClassProgressionText, Character.Level);
        var slot = ClassProgression.SlotFinoAl(ClassProgressionText, Character.Level);
        var prossimo = ClassProgression.ProssimoDopo(ClassProgressionText, Character.Level);
    }
    @if (raggiunti.Count > 0)
    {
        <div class="bio-block">
            <p class="bio-block-title">
                DAL MANUALE — @(string.IsNullOrWhiteSpace(Character.Class) ? "CLASSE" : Character.Class.ToUpperInvariant()) FINO AL LIVELLO @Character.Level
            </p>

            @if (slot.Count > 0)
            {
                <p class="slot-line">
                    <span class="slot-label">Slot incantesimo</span>
                    @for (var i = 0; i < slot.Count; i++)
                    {
                        <span class="slot-chip" title="@(i + 1)° livello">@slot[i]</span>
                    }
                </p>
            }

            <ul class="feature-list">
                @foreach (var riga in raggiunti)
                {
                    <li class="feature-row">
                        <span class="feature-level">L@(riga.Livello)</span>
                        <span class="feature-names">
                            @foreach (var privilegio in riga.Privilegi)
                            {
                                var sottoclasse = ClassProgression.RiguardaSottoclasse(privilegio);
                                <span class="feature-name @(sottoclasse ? "is-subclass" : "")">
                                    @if (sottoclasse && !string.IsNullOrWhiteSpace(Character.Subclass))
                                    {
                                        @($"{privilegio}: {Character.Subclass}")
                                    }
                                    else
                                    {
                                        @privilegio
                                    }
                                </span>
                            }
                        </span>
                    </li>
                }
            </ul>

            @if (prossimo is not null)
            {
                <p class="next-level">
                    Al livello @prossimo.Livello: @string.Join(", ", prossimo.Privilegi)
                </p>
            }

            @* La sottoclasse si sceglie al 3° livello: finché il PG non ci arriva il campo resta
               vuoto di proposito, e senza dirlo sembra una cosa dimenticata. *@
            @if (string.IsNullOrWhiteSpace(Character.Subclass)
                 && raggiunti.Any(r => r.Privilegi.Any(ClassProgression.RiguardaSottoclasse)))
            {
                <p class="next-level">Sottoclasse non ancora indicata: si compila dalla modifica della scheda.</p>
            }
        </div>
    }

    @* La sottoclasse, quando il manuale la conosce, porta privilegi propri: senza mostrarli il
       campo resta un nome e basta — che era esattamente il difetto segnalato. *@
    @if (Subclass is not null)
    {
        var daSottoclasse = SubclassCatalog.PrivilegiFinoAl(Subclass, Character.Level);
        var primoLivello = SubclassCatalog.PrimoLivello(Subclass);
        <div class="bio-block">
            <p class="bio-block-title">@Subclass.Name.ToUpperInvariant()</p>

            @if (daSottoclasse.Count > 0)
            {
                <ul class="feature-list">
                    @foreach (var riga in daSottoclasse)
                    {
                        <li class="feature-row">
                            <span class="feature-level">L@(riga.Livello)</span>
                            <span class="feature-names">
                                @foreach (var privilegio in riga.Privilegi)
                                {
                                    <span class="feature-name is-subclass">@privilegio</span>
                                }
                            </span>
                        </li>
                    }
                </ul>
            }
            else if (primoLivello is not null)
            {
                <p class="next-level">I suoi privilegi si sbloccano dal livello @primoLivello.</p>
            }

            @if (!string.IsNullOrWhiteSpace(Subclass.Description))
            {
                <p class="bio-block-text subclass-text">@Subclass.Description</p>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Character.ClassFeatures))
    {
        <div class="bio-block">
            @* Il titolo dice "a mano" solo quando c'è anche la tabella del manuale, altrimenti
               distinguerebbe da nulla. *@
            <p class="bio-block-title">@(raggiunti.Count > 0 ? "PRIVILEGI ANNOTATI A MANO" : "PRIVILEGI DI CLASSE")</p>
            <p class="bio-block-text">@Character.ClassFeatures</p>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Character.Feats))
    {
        <div class="bio-block">
            <p class="bio-block-title">TALENTI</p>
            <p class="bio-block-text">@Character.Feats</p>
        </div>
    }

    @* Addestramento: la stessa voce del riquadro "EQUIPMENT TRAINING & PROFICIENCIES" della
       carta, testo libero (v. spec 2026-08-06, D4) perché non alimenta calcoli e si consulta
       poche volte a campagna — non durante il gioco, come le altre voci sopra, quindi in fondo
       a quel gruppo e non insieme alle NOTE LIBERE, che sono la parte a cambio frequente. *@
    <div class="bio-block">
        <p class="bio-block-title">ADDESTRAMENTO</p>

        <div class="training-field">
            <label class="training-label" for="training-armor">Armature</label>
            <textarea id="training-armor" class="training-textarea" rows="2" @bind="armorTrainingDraft"
                      disabled="@(!CanEdit)" placeholder="Es. leggera, media, pesante, scudi"></textarea>
        </div>
        <div class="training-field">
            <label class="training-label" for="training-weapons">Armi</label>
            <textarea id="training-weapons" class="training-textarea" rows="2" @bind="weaponProficienciesDraft"
                      disabled="@(!CanEdit)" placeholder="Es. spade corte, asce, armi da tiro"></textarea>
        </div>
        <div class="training-field">
            <label class="training-label" for="training-tools">Strumenti</label>
            <textarea id="training-tools" class="training-textarea" rows="2" @bind="toolProficienciesDraft"
                      disabled="@(!CanEdit)" placeholder="Es. strumenti da fabbro, kit del ladro"></textarea>
        </div>

        @if (CanEdit)
        {
            <button type="button" class="small-btn"
                    @onclick="SaveTraining"
                    disabled="@(isSavingTraining || !TrainingDraftsChanged)">
                @(isSavingTraining ? "Salvataggio..." : "Salva addestramento")
            </button>
        }
    </div>

    <div class="bio-block">
        <p class="bio-block-title">NOTE LIBERE</p>
        <textarea class="notes-textarea" rows="5" @bind="notesDraft" disabled="@(!CanEdit)"
                  placeholder="Equipaggiamento, background, obiettivi..."></textarea>
        @if (CanEdit)
        {
            <button type="button" class="small-btn"
                    @onclick="SaveNotes"
                    disabled="@(isSavingNotes || notesDraft == (Character.Notes ?? string.Empty))">
                @(isSavingNotes ? "Salvataggio..." : "Salva note")
            </button>
        }
    </div>

    @* In fondo alla scheda e non dentro la modifica: chi cerca «come cancello il mio personaggio»
       non pensa di entrare in modifica per trovarlo. Compare solo a chi può davvero farlo —
       proprietario o master, come la policy characters_delete. *@
    @if (CanEdit && OnDelete.HasDelegate)
    {
        <div class="danger-zone">
            <p class="danger-title">Eliminare il personaggio</p>
            <p class="danger-text">
                Se ne vanno anche il suo inventario e i suoi incantesimi. L'operazione non si annulla.
            </p>
            <button type="button" class="danger-btn" @onclick="@(() => OnDelete.InvokeAsync())"
                    disabled="@IsBusy">
                🗑 Elimina il personaggio
            </button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Character Character { get; set; } = default!;

    /// <summary>Abilita la modifica delle note (master o proprietario del PG); speculare alle RLS.</summary>
    [Parameter] public bool CanEdit { get; set; }

    /// <summary>Tabella dei livelli della classe del personaggio, nel formato di
    /// <see cref="ClassProgression"/>; null se la classe non è a catalogo o non ne ha una. Il
    /// genitore la risolve perché è lui ad avere i cataloghi già caricati.</summary>
    [Parameter] public string? ClassProgressionText { get; set; }

    /// <summary>Il genitore persiste le note (UpdateCharacter + sync della lista) e gestisce gli errori.</summary>
    [Parameter] public EventCallback<string> OnSaveNotes { get; set; }

    /// <summary>Il genitore persiste l'addestramento (UpdateCharacter + sync della lista), stesso
    /// schema di <see cref="OnSaveNotes"/>: qui il draft, là la scrittura e la gestione errori. La
    /// tupla segue il precedente già in uso nel progetto (<c>LevelUpDialog.OnRisposta</c>) invece
    /// di aprire tre canali separati per tre campi che si salvano sempre insieme.</summary>
    [Parameter] public EventCallback<(string ArmorTraining, string WeaponProficiencies, string ToolProficiencies)> OnSaveTraining { get; set; }

    /// <summary>La sottoclasse risolta, da qualunque sorgente (v.
    /// <see cref="SubclassCatalog.Disponibili"/>): null se il nome è scritto a mano o se la classe
    /// non ne offre nessuna. Il genitore la risolve, perché è lui ad avere sia le righe di classe
    /// della campagna sia il pacchetto già caricati.</summary>
    [Parameter] public PackageSubclass? Subclass { get; set; }

    /// <summary>Eliminazione del personaggio. La conferma e la chiamata al database restano al
    /// genitore, come per il salvataggio delle note.</summary>
    [Parameter] public EventCallback OnDelete { get; set; }

    /// <summary>Un'operazione del genitore è in corso: disabilita l'eliminazione. Da solo non
    /// basta — fra la conferma e la fine della chiamata il genitore non ri-renderizza, quindi il
    /// `disabled` non arriva al DOM in tempo: la guardia vera è il rientro in DeleteSelectedAsync.</summary>
    [Parameter] public bool IsBusy { get; set; }

    private bool HasDefenses =>
        !string.IsNullOrWhiteSpace(Character.DamageResistances) ||
        !string.IsNullOrWhiteSpace(Character.DamageImmunities) ||
        !string.IsNullOrWhiteSpace(Character.DamageVulnerabilities) ||
        !string.IsNullOrWhiteSpace(Character.ConditionImmunities);

    private static IEnumerable<string> SplitDefenses(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) yield break;
        foreach (var p in s.Split(new[] { ',', ';', '\n' },
                     StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            yield return p;
        }
    }

    private string notesDraft = string.Empty;
    private bool isSavingNotes;
    private string armorTrainingDraft = string.Empty;
    private string weaponProficienciesDraft = string.Empty;
    private string toolProficienciesDraft = string.Empty;
    private bool isSavingTraining;
    private string? _lastId;

    // Re-inizializza il draft quando cambia il PG mostrato (prima lo faceva il genitore alla selezione).
    protected override void OnParametersSet()
    {
        if (Character.Id != _lastId)
        {
            _lastId = Character.Id;
            notesDraft = Character.Notes ?? string.Empty;
            armorTrainingDraft = Character.ArmorTraining ?? string.Empty;
            weaponProficienciesDraft = Character.WeaponProficiencies ?? string.Empty;
            toolProficienciesDraft = Character.ToolProficiencies ?? string.Empty;
        }
    }

    private async Task SaveNotes()
    {
        if (!CanEdit) return;
        isSavingNotes = true;
        await OnSaveNotes.InvokeAsync(notesDraft);
        isSavingNotes = false;
    }

    private bool TrainingDraftsChanged =>
        armorTrainingDraft != (Character.ArmorTraining ?? string.Empty) ||
        weaponProficienciesDraft != (Character.WeaponProficiencies ?? string.Empty) ||
        toolProficienciesDraft != (Character.ToolProficiencies ?? string.Empty);

    private async Task SaveTraining()
    {
        if (!CanEdit) return;
        isSavingTraining = true;
        await OnSaveTraining.InvokeAsync((armorTrainingDraft, weaponProficienciesDraft, toolProficienciesDraft));
        isSavingTraining = false;
    }
}
