    /// <summary>Le caratteristiche/abilità (CharacterStatsTab): questo componente resta grande di
    /// suo, e spezzarlo in due solo per intercalare CharacterStatsTab fra risorse e dadi vita
    /// creerebbe due componenti che condividono lo stesso Character/CanEdit/OnChanged senza un
    /// motivo migliore di questo. Characters.razor lo passa come figlio (v. il markup lì) invece
    /// che renderlo come fratello dopo questo tab: così l'ordine di gioco (armi, risorse,
    /// caratteristiche, poi — a fine combattimento — dadi vita e riposo) è un fatto della
    /// composizione, non serve una seconda istanza né stato duplicato.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool ShowDeathSaves =>
        Character.HitPoints == 0 || Character.DeathSaveSuccesses > 0 || Character.DeathSaveFailures > 0;

    private int HitDiceTotal() => CharacterCalculations.GetHitDiceTotal(Character.HitDiceMax);

    // Clampato a 0: GetHitDiceRemaining non lo fa (CharacterCalculations.cs), e HitDiceSpent
    // salvato a mano oltre il totale (nessun vincolo max in CharacterEditForm) lo renderebbe
    // negativo — lo stepper del riposo breve mostrerebbe "-N / -N" invece di "0 / N". Riusata anche
    // dal mini-riquadro DV in cima al tab (piano 2026-08-08, B3): stessa espressione in entrambi i
    // punti, o divergerebbero al primo HitDiceSpent fuori range.
    private int HitDiceRemaining() => Math.Max(0, CharacterCalculations.GetHitDiceRemaining(Character));

    // ===== Riposo lungo / riposo breve =====
    private bool showShortRestPanel;
    private int dadiSpesi;
    private int totaleTirato;
    private bool totaleTiratoModificatoAMano;
    private string? _lastRestCharacterId;

    // ===== Risorse di classe =====
    private bool isAddingResource;
    private ClassResource resourceDraft = new();
    private ClassResource? editingResource;
    private ClassResource editDraft = new();
    private bool isSavingResources;

    // Reset dello stato UI locale al cambio di PG (stesso pattern di CharacterItemsTab): senza,
    // un pannello di riposo breve — o un form risorse — lasciato aperto seguirebbe il PG
    // selezionato dopo.
    protected override void OnParametersSet()
    {
        if (Character.Id != _lastRestCharacterId)
        {
            _lastRestCharacterId = Character.Id;
            showShortRestPanel = false;
            isAddingResource = false;
            resourceDraft = new ClassResource();
            isSavingResources = false;
            editingResource = null;
        }
    }

    private void ToggleShortRestPanel()
    {
        if (!CanEdit) return;
        showShortRestPanel = !showShortRestPanel;
        if (showShortRestPanel) ResetShortRestDraft();
    }

    private void CloseShortRestPanel() => showShortRestPanel = false;

    private void ResetShortRestDraft()
    {
        dadiSpesi = Math.Min(1, HitDiceRemaining());
        totaleTiratoModificatoAMano = false;
        RicalcolaTotalePrecompilato();
    }

    private void RicalcolaTotalePrecompilato()
    {
        if (totaleTiratoModificatoAMano) return;
        totaleTirato = RestCalculations.MediaDadoVita(Character.HitDiceMax) * dadiSpesi;
    }

    private void AdjustDadiSpesi(int delta)
    {
        if (!CanEdit) return;
        var max = HitDiceRemaining();
        var v = Math.Clamp(dadiSpesi + delta, 0, max);
        if (v == dadiSpesi) return;
        dadiSpesi = v;
        RicalcolaTotalePrecompilato();
    }

    private void OnTotaleTiratoInput(ChangeEventArgs e)
    {
        if (!CanEdit) return;
        totaleTiratoModificatoAMano = true;
        totaleTirato = int.TryParse(e.Value?.ToString(), out var v) ? Math.Max(0, v) : 0;
    }

    /// <summary>Fotografia dei campi che <see cref="RestCalculations.Applica"/> può toccare —
    /// stesso schema di LivelloUpSnapshot in Characters.razor, e per lo stesso motivo:
    /// RestCalculations muta Character SUBITO (per poter mostrare il riepilogo prima/insieme al
    /// salvataggio), ma il salvataggio vero è asincrono e può fallire in modo muto (le RLS legate
    /// all'appartenenza corrente alla campagna rifiutano l'update, PostgREST torna [] senza un
    /// errore). Senza ripristinare questi campi a un fallimento, un ritentativo — reazione naturale
    /// ora che il fallimento è visibile e non più muto — applicherebbe l'esito una seconda volta su
    /// uno stato già mutato: es. un riposo lungo ripetuto due volte di seguito dopo due fallimenti
    /// recupererebbe il doppio dei dadi vita a cui il personaggio ha diritto per un riposo, e alla
    /// prima scrittura riuscita (anche innocua, come un tocco sui PF da un altro tab) quel valore
    /// gonfiato finirebbe in database.
    ///
    /// Include anche <c>ClassResources</c> (v. sezione «Risorse di classe» più sotto): da quando
    /// <see cref="RestCalculations.Applica"/> ripristina anche le risorse (Ricarica compatibile),
    /// un riposo tocca quella lista tanto quanto PF/dadi vita/slot — senza fotografarla qui, un
    /// riposo salvato a vuoto azzererebbe "Spesi" solo in locale (mai confermato) ma un ritentativo
    /// o un qualunque salvataggio successivo persisterebbe quell'azzeramento fantasma.</summary>
    private sealed record RiposoSnapshot(
        int HitPoints, int TempHitPoints, int HitDiceSpent, int DeathSaveSuccesses, int DeathSaveFailures,
        int SpellSlots1Used, int SpellSlots2Used, int SpellSlots3Used, int SpellSlots4Used, int SpellSlots5Used,
        int SpellSlots6Used, int SpellSlots7Used, int SpellSlots8Used, int SpellSlots9Used,
        List<ClassResource> ClassResources)
    {
        public static RiposoSnapshot Cattura(Character c) => new(
            c.HitPoints, c.TempHitPoints, c.HitDiceSpent, c.DeathSaveSuccesses, c.DeathSaveFailures,
            c.SpellSlots1Used, c.SpellSlots2Used, c.SpellSlots3Used, c.SpellSlots4Used, c.SpellSlots5Used,
            c.SpellSlots6Used, c.SpellSlots7Used, c.SpellSlots8Used, c.SpellSlots9Used,
            // Copia per VALORE (nuove istanze ClassResource), non per riferimento: anche se
            // RestCalculations oggi sostituisce sempre la lista con istanze nuove senza mutare
            // quelle vecchie, questa fotografia non deve dipendere da quel dettaglio implementativo
            // per restare valida.
            (c.ClassResources ?? new List<ClassResource>())
                .Select(r => new ClassResource { Nome = r.Nome, Max = r.Max, Spesi = r.Spesi, Ricarica = r.Ricarica })
                .ToList());

        public void Ripristina(Character c)
        {
            c.HitPoints = HitPoints;
            c.TempHitPoints = TempHitPoints;
            c.HitDiceSpent = HitDiceSpent;
            c.DeathSaveSuccesses = DeathSaveSuccesses;
            c.DeathSaveFailures = DeathSaveFailures;
            c.SpellSlots1Used = SpellSlots1Used;
            c.SpellSlots2Used = SpellSlots2Used;
            c.SpellSlots3Used = SpellSlots3Used;
            c.SpellSlots4Used = SpellSlots4Used;
            c.SpellSlots5Used = SpellSlots5Used;
            c.SpellSlots6Used = SpellSlots6Used;
            c.SpellSlots7Used = SpellSlots7Used;
            c.SpellSlots8Used = SpellSlots8Used;
            c.SpellSlots9Used = SpellSlots9Used;
            c.ClassResources = ClassResources;
        }
    }

    private async Task ConfermaRiposoBreveAsync()
    {
        if (!CanEdit || IsSaving || dadiSpesi <= 0) return;

        // Riferimento catturato ADESSO, non riletto dal parametro Character dopo l'await: mentre
        // questo metodo aspetta OnChanged, Blazor smista comunque gli eventi dell'interfaccia, e il
        // genitore può cambiare il parametro sotto di noi (un altro personaggio aperto, o "←" che
        // torna alla lista). Rileggere Character al ripristino scriverebbe i valori del PG di PRIMA
        // dentro quello NUOVO.
        var pg = Character;

        // Presa PRIMA di Applica: RestCalculations muta pg subito (per poter mostrare il
        // riepilogo nel toast), ma il salvataggio è asincrono e può fallire in modo muto (le RLS
        // rifiutano l'update, PostgREST torna [] e OnChanged qui restituisce false). Ora che il
        // fallimento è visibile (v. il commento su OnChanged più sotto), ritentare è la reazione
        // naturale — e senza questo ripristino il secondo tentativo applicherebbe l'esito una
        // seconda volta su uno stato già mutato (es. il doppio dei dadi vita spesi). Stesso schema
        // di LivelloUpSnapshot in Characters.razor.
        var snapshot = RiposoSnapshot.Cattura(pg);

        var esito = RestCalculations.RiposoBreve(pg, dadiSpesi, totaleTirato);
        RestCalculations.Applica(pg, esito);
        showShortRestPanel = false;
        // Applica sostituisce SEMPRE ClassResources con istanze nuove (anche le risorse non
        // toccate da questo riposo — v. RestCalculations.RipristinaRisorse) — un pannello di
        // modifica risorsa aperto punterebbe a un'istanza ormai fuori lista: ReferenceEquals col
        // nuovo array fallirebbe e si chiuderebbe di scatto scartando in silenzio l'editDraft.
        // Meglio chiuderlo esplicitamente qui, come si fa già per showShortRestPanel.
        editingResource = null;

        // Il toast si annuncia solo se il salvataggio è confermato: con le RLS legate
        // all'appartenenza corrente alla campagna, un update rifiutato torna [] (non un errore) e
        // OnChanged qui restituisce false — senza controllarlo il riposo direbbe "fatto" anche a
        // scrittura andata a vuoto (v. il commento su OnChanged qui sopra).
        var salvato = await OnChanged();
        if (salvato)
        {
            Toasts.ShowSuccess(string.Join(" · ", esito.Riepilogo));
        }
        else
        {
            snapshot.Ripristina(pg);
            // V. il commento su OnLocalRevert: senza, CharacterVitalsBar (i PF/PF-temp che il
            // riposo tocca) resterebbe a mostrare i valori mutati-e-mai-salvati.
            await OnLocalRevert.InvokeAsync();
        }
    }

    private async Task RiposoLungoAsync()
    {
        if (!CanEdit || IsSaving) return;

        // Distruttivo (azzera i TS contro morte): conferma obbligatoria, come da regola di
        // progetto per le azioni che non si possono annullare.
        var confermato = await Confirm.ShowAsync(
            "Fare un riposo lungo? Ripristina PF, dadi vita e slot incantesimo, e azzera i tiri " +
            "salvezza contro la morte.");
        if (!confermato) return;

        // Ricontrollato dopo la conferma: la finestra di dialogo è asincrona, e nel frattempo un
        // altro salvataggio sullo stesso personaggio (dai PF, o da un secondo tap qui) può essere
        // partito nel mentre.
        if (!CanEdit || IsSaving) return;

        // Riferimento catturato ADESSO, non riletto dal parametro Character dopo l'await: fra la
        // conferma e il salvataggio Blazor smista comunque gli eventi dell'interfaccia, e il
        // genitore può cambiare il parametro sotto di noi (un altro personaggio aperto, o "←" che
        // torna alla lista). Rileggere Character al ripristino scriverebbe i valori del PG di PRIMA
        // dentro quello NUOVO.
        var pg = Character;

        // V. il commento in ConfermaRiposoBreveAsync: senza questo ripristino un ritentativo dopo
        // un salvataggio rifiutato applicherebbe l'esito una seconda volta su uno stato già
        // mutato — qui il rischio è peggiore (PF, dadi vita E slot incantesimo, non solo i dadi).
        var snapshot = RiposoSnapshot.Cattura(pg);

        var esito = RestCalculations.RiposoLungo(pg);
        RestCalculations.Applica(pg, esito);
        showShortRestPanel = false;
        // V. il commento in ConfermaRiposoBreveAsync: stesso motivo, stesso rischio.
        editingResource = null;

        var salvato = await OnChanged();
        if (salvato)
        {
            Toasts.ShowSuccess(string.Join(" · ", esito.Riepilogo));
        }
        else
        {
            snapshot.Ripristina(pg);
            await OnLocalRevert.InvokeAsync();
        }
    }

    // Le quattro mutazioni dirette che seguono (TS morte, ispirazione, dado vita) valgono un solo
    // campo, non l'insieme che RiposoSnapshot fotografa — ma soffrono lo stesso difetto: mutano
    // Character PRIMA di sapere se OnChanged() lo salverà davvero. Senza il ripristino sul
    // fallimento, il valore mai confermato resterebbe lì fino al primo salvataggio successivo
    // riuscito (da QUALUNQUE tab), che lo persisterebbe in silenzio insieme al resto.

    private async Task SetDeathSaveSuccesses(int value)
    {
        if (!CanEdit || IsSaving) return;

        // Riferimento catturato ADESSO, non riletto dal parametro Character dopo l'await: mentre
        // questo metodo aspetta OnChanged, Blazor smista comunque gli eventi dell'interfaccia, e il
        // genitore può cambiare il parametro sotto di noi (un altro personaggio aperto, o "←" che
        // torna alla lista). Rileggere Character al ripristino scriverebbe il valore del PG di PRIMA
        // dentro quello NUOVO.
        var pg = Character;
        value = Math.Clamp(value, 0, 3);
        if (value == pg.DeathSaveSuccesses) return;
        var precedente = pg.DeathSaveSuccesses;
        pg.DeathSaveSuccesses = value;
        if (!await OnChanged())
        {
            pg.DeathSaveSuccesses = precedente;
            await OnLocalRevert.InvokeAsync();
        }
    }

    private async Task SetDeathSaveFailures(int value)
    {
        if (!CanEdit || IsSaving) return;

        // V. il commento in SetDeathSaveSuccesses: stesso motivo, stesso rischio.
        var pg = Character;
        value = Math.Clamp(value, 0, 3);
        if (value == pg.DeathSaveFailures) return;
        var precedente = pg.DeathSaveFailures;
        pg.DeathSaveFailures = value;
        if (!await OnChanged())
        {
            pg.DeathSaveFailures = precedente;
            await OnLocalRevert.InvokeAsync();
        }
    }

    private async Task ToggleHeroicInspiration()
    {
        if (!CanEdit || IsSaving) return;

        // V. il commento in SetDeathSaveSuccesses: stesso motivo, stesso rischio.
        var pg = Character;
        var precedente = pg.HeroicInspiration;
        pg.HeroicInspiration = !precedente;
        if (!await OnChanged())
        {
            pg.HeroicInspiration = precedente;
            await OnLocalRevert.InvokeAsync();
        }
    }

    private Task DecrementHitDice() => AdjustHitDiceSpentAsync(-1);
    private Task IncrementHitDice() => AdjustHitDiceSpentAsync(1);

    private async Task AdjustHitDiceSpentAsync(int delta)
    {
        if (!CanEdit || IsSaving) return;

        // V. il commento in SetDeathSaveSuccesses: stesso motivo, stesso rischio.
        var pg = Character;
        var total = HitDiceTotal();
        var v = Math.Clamp(pg.HitDiceSpent + delta, 0, total);
        if (v == pg.HitDiceSpent) return;
        var precedente = pg.HitDiceSpent;
        pg.HitDiceSpent = v;
        if (!await OnChanged())
        {
            pg.HitDiceSpent = precedente;
            await OnLocalRevert.InvokeAsync();
        }
    }

    // ===== Risorse di classe =====
    // Nessuna regola di dominio qui: ClassResourceRules decide cosa vuol dire "spendere" o
    // "recuperare" un uso e come si ripulisce un nome/ricarica; questo componente chiama e mostra.
    // Stessa disciplina snapshot-e-ripristina delle mutazioni sopra (dadi vita, TS morte,
    // ispirazione): "pg" catturato ORA perché Character può cambiare sotto un await, e il
    // ripristino usa una COPIA SHALLOW della lista presa prima di mutare — copia shallow perché
    // ClassResourceRules.Spendi/Recupera sono pure (restituiscono una nuova istanza, non mutano
    // quella vecchia): la vecchia lista continua a contenere gli oggetti "di prima" intatti.

    /// <summary>Le risorse suggerite per la classe del personaggio, escluse quelle già presenti
    /// (confronto normalizzato, v. CatalogKey): senza il filtro, uno scorciatoia già aggiunta
    /// porterebbe solo a un tentativo di salvataggio rifiutato per nome duplicato.</summary>
    private IReadOnlyList<ClassResource> SuggestedResources =>
        ClassResourceRules.Suggerite(Character.Class)
            .Where(s => !Character.ClassResources.Any(r =>
                CatalogKey.NormalizeName(r.Nome) == CatalogKey.NormalizeName(s.Nome)))
            .ToList();

    /// <summary>Contatori NON collegati a nessuna scheda-privilegio (v. Gruppi/CharacterFeatureJoin,
    /// Task 8): l'Ira, se ha una VistaPrivilegio con Contatore agganciato, non compare più qui sotto
    /// — un dato, una sola superficie primaria, o i suoi pallini sarebbero spendibili da due punti
    /// diversi. Confronto per nome normalizzato (v. CatalogKey), mai crudo.</summary>
    private IReadOnlyList<ClassResource> RisorseSenzaScheda =>
        Character.ClassResources
            .Where(r => !Gruppi.SelectMany(g => g.Voci).Any(v =>
                v.Contatore is not null &&
                CatalogKey.NormalizeName(v.Contatore.Nome) == CatalogKey.NormalizeName(r.Nome)))
            .ToList();

    private static string EtichettaRicarica(string? ricarica) => ricarica?.Trim().ToLowerInvariant() switch
    {
        "breve" => "riposo breve",
        "nessuna" => "altro",
        _ => "riposo lungo",
    };

    private void OpenAddResourceForm()
    {
        if (!CanEdit) return;
        resourceDraft = new ClassResource { Ricarica = "lungo" };
        isAddingResource = true;
    }

    private void CancelAddResource()
    {
        isAddingResource = false;
        resourceDraft = new ClassResource();
    }

    private void ApplySuggestion(ClassResource suggerita)
    {
        resourceDraft.Nome = suggerita.Nome;
        resourceDraft.Ricarica = suggerita.Ricarica;
    }

    private async Task SaveNewResourceAsync()
    {
        // IsSaving (condiviso col genitore/CharacterVitalsBar) copre le corse con salvataggi
        // partiti da ALTRI controlli di questo tab (riposo, dadi vita, ...); isSavingResources
        // resta per il feedback immediato ("Salvataggio...") e la ri-entranza sulla stessa azione.
        if (!CanEdit || IsSaving || isSavingResources) return;

        var nome = resourceDraft.Nome?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(nome))
        {
            Toasts.ShowError("Il nome della risorsa è obbligatorio");
            return;
        }
        if (resourceDraft.Max < 1)
        {
            Toasts.ShowError("Il massimo deve essere almeno 1");
            return;
        }

        var pg = Character;
        var chiave = CatalogKey.NormalizeName(nome);
        if (pg.ClassResources.Any(r => CatalogKey.NormalizeName(r.Nome) == chiave))
        {
            Toasts.ShowError("Esiste già una risorsa con questo nome");
            return;
        }

        // Copia PRIMA di aggiungere: v. commento d'apertura della sezione.
        var precedente = new List<ClassResource>(pg.ClassResources);
        pg.ClassResources.Add(new ClassResource
        {
            Nome = nome,
            Max = resourceDraft.Max,
            Spesi = 0,
            Ricarica = resourceDraft.Ricarica,
        });

        isSavingResources = true;
        var salvato = await OnChanged();
        isSavingResources = false;

        if (salvato)
        {
            isAddingResource = false;
            resourceDraft = new ClassResource();
        }
        else
        {
            pg.ClassResources = precedente;
            await OnLocalRevert.InvokeAsync();
        }
    }

    /// <summary>Applica un delta a un contatore (positivo = spende, negativo = recupera): nucleo
    /// comune a OnResourceDotClickAsync (delta calcolato dal pallino toccato nella sezione RISORSE)
    /// e a OnSpendiContatoreDaSchedaAsync (delta ricevuto già pronto da CharacterFeaturesSection,
    /// stessa identica semantica — v. brief Task 8: "Nome" è il nome della ClassResource, "Usi" è il
    /// delta). Due punti d'accesso allo stesso pallino non devono divergere su come lo spendono.</summary>
    private async Task SpendiRisorsaAsync(ClassResource risorsa, int delta)
    {
        if (!CanEdit || IsSaving || delta == 0) return;

        var pg = Character;
        var idx = pg.ClassResources.IndexOf(risorsa);
        if (idx < 0) return;

        var precedente = new List<ClassResource>(pg.ClassResources);
        var aggiornata = ClassResourceRules.Spendi(risorsa, delta);
        pg.ClassResources[idx] = aggiornata;

        // Spendi/Recupera sono pure: "risorsa" nella lista è ora un'istanza NUOVA. Se il pannello
        // di modifica era aperto proprio su questa risorsa, il riferimento in editingResource
        // punterebbe ancora alla vecchia istanza — al render successivo ReferenceEquals(...) col
        // nuovo oggetto del @foreach fallirebbe e il pannello si chiuderebbe di scatto, scartando
        // in silenzio il testo che l'utente stava scrivendo. Si riallinea invece che azzerare: qui
        // la risorsa non viene rimossa, solo aggiornata (a differenza di DeleteResourceAsync). E se
        // il salvataggio fallisce, il riallineamento si annulla insieme al resto: la lista torna a
        // "precedente" (le vecchie istanze) e editingResource deve tornare a puntare lì.
        var editavaQuestaRisorsa = ReferenceEquals(editingResource, risorsa);
        if (editavaQuestaRisorsa) editingResource = aggiornata;

        if (!await OnChanged())
        {
            pg.ClassResources = precedente;
            if (editavaQuestaRisorsa) editingResource = risorsa;
            await OnLocalRevert.InvokeAsync();
        }
    }

    /// <summary>Un tocco su un pallino: se è quello che segna la disponibilità corrente lo
    /// "spegne" (un uso in meno), altrimenti porta la disponibilità esattamente a quel pallino —
    /// stesso schema di SetDeathSaveSuccesses/Failures più sopra, letto sui pallini "disponibili"
    /// invece che "raggiunti". Toccare un pallino già vuoto quindi RECUPERA usi fino a lì.</summary>
    private Task OnResourceDotClickAsync(ClassResource risorsa, int posizione)
    {
        var delta = ClassResourceRules.DeltaDaPallino(risorsa.Max, risorsa.Spesi, posizione);
        return SpendiRisorsaAsync(risorsa, delta);
    }

    /// <summary>Ponte fra CharacterFeaturesSection (il suo OnContatoreDotClickAsync calcola già il
    /// delta) e il nucleo comune sopra: qui arriva solo il NOME della risorsa (v. la semantica di
    /// OnSpendiContatore nel brief Task 8), quindi si cerca prima l'istanza viva in
    /// Character.ClassResources — per nome normalizzato, mai crudo (v. CatalogKey).</summary>
    private Task OnSpendiContatoreDaSchedaAsync((string Nome, int Usi) spesa)
    {
        var chiave = CatalogKey.NormalizeName(spesa.Nome);
        var risorsa = Character.ClassResources
            .FirstOrDefault(r => CatalogKey.NormalizeName(r.Nome) == chiave);
        return risorsa is null ? Task.CompletedTask : SpendiRisorsaAsync(risorsa, spesa.Usi);
    }

    private void ToggleEditResource(ClassResource risorsa)
    {
        if (!CanEdit || IsSaving) return;
        if (ReferenceEquals(editingResource, risorsa))
        {
            editingResource = null;
            return;
        }
        editingResource = risorsa;
        editDraft = new ClassResource
        {
            Nome = risorsa.Nome,
            Max = risorsa.Max,
            Spesi = risorsa.Spesi,
            Ricarica = risorsa.Ricarica,
        };
    }

    private void CancelEditResource() => editingResource = null;

    private async Task SaveEditResourceAsync(ClassResource risorsa)
    {
        if (!CanEdit || IsSaving || isSavingResources) return;

        var nome = editDraft.Nome?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(nome))
        {
            Toasts.ShowError("Il nome della risorsa è obbligatorio");
            return;
        }
        if (editDraft.Max < 1)
        {
            Toasts.ShowError("Il massimo deve essere almeno 1");
            return;
        }

        var pg = Character;
        var idx = pg.ClassResources.IndexOf(risorsa);
        if (idx < 0) return;

        var chiaveNuova = CatalogKey.NormalizeName(nome);
        var duplicato = pg.ClassResources
            .Where((r, i) => i != idx)
            .Any(r => CatalogKey.NormalizeName(r.Nome) == chiaveNuova);
        if (duplicato)
        {
            Toasts.ShowError("Esiste già una risorsa con questo nome");
            return;
        }

        // Il massimo può scendere sotto gli usi già spesi (es. da 4 a 2 con 3 spesi): Spesi si
        // clampa al nuovo massimo, mai il contrario — coerente con ClassResourceRules.Normalizza.
        var nuovoMax = editDraft.Max;
        var nuovoSpesi = Math.Clamp(risorsa.Spesi, 0, nuovoMax);
        var aggiornata = new ClassResource
        {
            Nome = nome,
            Max = nuovoMax,
            Spesi = nuovoSpesi,
            Ricarica = editDraft.Ricarica,
        };

        var precedente = new List<ClassResource>(pg.ClassResources);
        pg.ClassResources[idx] = aggiornata;

        isSavingResources = true;
        var salvato = await OnChanged();
        isSavingResources = false;

        if (salvato)
        {
            // Solo se il pannello aperto è ancora quello di QUESTA risorsa: se nel frattempo
            // l'utente ne ha aperto un altro (o questa stessa chiamata arriva in ritardo dopo che
            // altro ha già cambiato editingResource), chiuderlo qui chiuderebbe il pannello
            // sbagliato — stesso guardia già usata in DeleteResourceAsync.
            if (ReferenceEquals(editingResource, risorsa)) editingResource = null;
        }
        else
        {
            pg.ClassResources = precedente;
            await OnLocalRevert.InvokeAsync();
        }
    }

    private async Task DeleteResourceAsync(ClassResource risorsa)
    {
        if (!CanEdit || IsSaving || isSavingResources) return;

        var confermato = await Confirm.ShowAsync($"Eliminare la risorsa \"{risorsa.Nome}\"?");
        if (!confermato) return;

        // Ricontrollato dopo la conferma: la finestra è asincrona, e nel frattempo un altro
        // salvataggio sullo stesso personaggio può essere già partito.
        if (!CanEdit || IsSaving || isSavingResources) return;

        var pg = Character;
        var idx = pg.ClassResources.IndexOf(risorsa);
        if (idx < 0) return;

        var precedente = new List<ClassResource>(pg.ClassResources);
        pg.ClassResources.RemoveAt(idx);
        // Tenuto a parte per poterlo riallineare anche sul fallimento (v. sotto) — stesso schema
        // di "editavaQuestaRisorsa" in OnResourceDotClickAsync.
        var editavaQuestaRisorsa = ReferenceEquals(editingResource, risorsa);
        if (editavaQuestaRisorsa) editingResource = null;

        isSavingResources = true;
        var salvato = await OnChanged();
        isSavingResources = false;

        if (!salvato)
        {
            pg.ClassResources = precedente;
            // Se il salvataggio fallisce la risorsa non è mai stata eliminata: il pannello di
            // modifica torna a puntarci, invece di restare chiuso su un dato che in realtà c'è
            // ancora (stesso schema del ripristino in OnResourceDotClickAsync).
            if (editavaQuestaRisorsa) editingResource = risorsa;
            await OnLocalRevert.InvokeAsync();
        }
    }
}
