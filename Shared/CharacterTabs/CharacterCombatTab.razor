@using DndCompanion.Models
@using DndCompanion.Services
@inject ConfirmService Confirm
@inject ToastService Toasts

@* PF, CA, INI e PERC sono saliti in CharacterVitalsBar, sopra le tab: servono a ogni turno e
   stavano dietro un tocco. Qui resta ciò che si consulta quando serve davvero. *@

@* ===== Ordine del tab «Tiri» (riordino 2026-08-06): per momento del turno, non per data di
   aggiunta. Prima ciò che si tira/spende in combattimento (TS morte quando servono, velocità e
   ispirazione, armi, risorse di classe, poi le caratteristiche/abilità di CharacterStatsTab), poi
   — dopo il divisore «a fine combattimento» — ciò che si recupera (dadi vita, riposo). I TS contro
   morte restano condizionali (ShowDeathSaves) ma, quando compaiono, vanno in testa: se il
   personaggio sta morendo non c'è arma o risorsa che conti prima di quel tiro.

   Dal 2026-08-08 (piano "board di gioco") cambia la RESA — riquadri in griglia (vocabolario
   .board/.w-*, globale in app.css) al posto delle card impilate — ma la SEQUENZA resta la stessa
   di sopra: questo componente ridisegna, non riordina. *@

@if (ShowDeathSaves)
{
    <div class="board">
        <div class="w w-12 death-saves-card">
            <p class="card-label">TIRI SALVEZZA CONTRO MORTE</p>
            <div class="death-saves-row">
                <div class="death-saves-group">
                    <span class="ds-label success">Successi</span>
                    <div class="ds-dots">
                        @for (int i = 1; i <= 3; i++)
                        {
                            var n = i;
                            <span class="ds-dot @(Character.DeathSaveSuccesses >= n ? "filled success" : "")"
                                  role="button" tabindex="0"
                                  aria-pressed="@AriaBool(Character.DeathSaveSuccesses >= n)" aria-label="Successo tiro salvezza @n"
                                  @onclick="() => SetDeathSaveSuccesses(n == Character.DeathSaveSuccesses ? n - 1 : n)"
                                  @onkeydown="@(e => OnKey(e, () => SetDeathSaveSuccesses(n == Character.DeathSaveSuccesses ? n - 1 : n)))"></span>
                        }
                    </div>
                </div>
                <div class="death-saves-group">
                    <span class="ds-label failure">Fallimenti</span>
                    <div class="ds-dots">
                        @for (int i = 1; i <= 3; i++)
                        {
                            var n = i;
                            <span class="ds-dot @(Character.DeathSaveFailures >= n ? "filled failure" : "")"
                                  role="button" tabindex="0"
                                  aria-pressed="@AriaBool(Character.DeathSaveFailures >= n)" aria-label="Fallimento tiro salvezza @n"
                                  @onclick="() => SetDeathSaveFailures(n == Character.DeathSaveFailures ? n - 1 : n)"
                                  @onkeydown="@(e => OnKey(e, () => SetDeathSaveFailures(n == Character.DeathSaveFailures ? n - 1 : n)))"></span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* Strip ATTIVO: sezione 3 dell'ordine verticale (v. piano 2026-08-08, Task 8), subito dopo i TS
   contro morte. Componente a parte (CSS isolation: le sue regole vanno nel proprio .razor.css, non
   qui — v. memoria "blazor-css-isolation-extraction"). *@
<CharacterActiveStrip Gruppi="@Gruppi" CharacterId="@Character.Id" />

@* Riga di quattro mini-valori (piano 2026-08-08, B3): VEL e ISPIRAZIONE (ex .secondary-stats) più
   DV — dadi vita rimasti, HitDiceRemaining() già clampato a 0: STESSA espressione usata dal
   riquadro fuso di fine combattimento più sotto, apposta, per non farli divergere — e COMP, che
   lascia CharacterStatsTab (D1a: qui prende posizione fissa). L'unità "m" di VEL non passa da
   .w-sub (una riga SOTTO il valore, dettaglio secondario come il danno di un'arma): è parte dello
   stesso valore, sulla stessa riga del numero, quindi resta in .w-unit, scoped qui sotto. *@
<div class="board">
    <div class="w w-3">
        <p class="w-label">VEL</p>
        <p class="w-value">@Character.Speed<span class="w-unit">m</span></p>
    </div>
    <div class="w w-3 w-toggle @(Character.HeroicInspiration ? "active" : "")"
         role="button" tabindex="0"
         aria-pressed="@AriaBool(Character.HeroicInspiration)" aria-label="Ispirazione eroica"
         @onclick="ToggleHeroicInspiration"
         @onkeydown="@(e => OnKey(e, ToggleHeroicInspiration))">
        <p class="w-label">ISPIRAZIONE</p>
        <p class="w-value">@(Character.HeroicInspiration ? "Sì" : "No")</p>
    </div>
    <div class="w w-3">
        <p class="w-label">DV</p>
        <p class="w-value">@HitDiceRemaining()/@HitDiceTotal()</p>
    </div>
    <div class="w w-3">
        <p class="w-label">COMP</p>
        <p class="w-value">@FormatBonus(CharacterCalculations.GetProficiencyBonus(Character.Level))</p>
    </div>
</div>

@* Armi: riquadri w-6, due per riga — oltre la seconda la griglia va a capo da sé (repeat(12,...)
   più span 6, nessuna logica in più). L'etichetta "ARMI" non c'è più: il nome dell'arma è già
   .w-label (piano 2026-08-08, B3). *@
@if (Weapons.Any())
{
    <div class="board">
        @foreach (var w in Weapons)
        {
            var haFlagArma = w.IsFinesse || w.IsRanged || w.IsNotProficient;
            var bonusCalcolato = WeaponCalculations.BonusAttacco(w, Character);
            <div class="w w-6">
                <p class="w-label">@w.Name</p>
                <p class="w-value">
                    @* Il valore scritto a mano vince (invariato dal comportamento precedente): se
                       AttackBonus è valorizzato si mostra quello. Se è vuoto E l'arma non ha ALCUN
                       flag impostato (accurata/a distanza/non competente), ModificatoreArma ricade
                       per costruzione sul ramo Forza — quasi certamente sbagliato per un'arma a
                       distanza o accurata mai configurata: il numero si mostra allora come STIMA
                       esplicita, non come "il" bonus (v. CLAUDE.md — l'app non presenta come certo
                       un valore che dipende da dati che l'utente non ha ancora fornito). *@
                    @if (!string.IsNullOrWhiteSpace(w.AttackBonus))
                    {
                        @w.AttackBonus
                    }
                    else if (haFlagArma)
                    {
                        @FormatBonus(bonusCalcolato)
                    }
                    else
                    {
                        <span class="weapon-calc-hint"
                              title="Nessun bonus scritto a mano e nessuna proprietà (accurata/a distanza/non competente) impostata su quest'arma: il calcolo assume un'arma da mischia con Forza. Se l'arma è a distanza o accurata, modificala per un valore corretto.">
                            stima @FormatBonus(bonusCalcolato)
                        </span>
                    }
                </p>
                @if (!string.IsNullOrWhiteSpace(w.Damage))
                {
                    <p class="w-sub">@w.Damage @w.DamageType?.ToLower()</p>
                }
            </div>
        }
    </div>
}
else
{
    <p class="empty-note">Nessuna arma equipaggiata</p>
}

@* Privilegi raggruppati per economia d'azione: sezione 6 dell'ordine verticale. Il raggruppamento e
   l'ordinamento li fa già CharacterFeatureJoin (Gruppi arriva pronto da Characters.razor, con gli
   stessi cataloghi già in cache passati a CharacterBioTab); questo componente rende e smista, non
   possiede l'annotazione — il salvataggio vero passa dal genitore (OnSalvaAnnotazione), lo spendere
   un contatore resta invece qui (v. OnSpendiContatoreDaSchedaAsync più sotto): riusa lo stesso
   nucleo di OnResourceDotClickAsync perché sono due strade per spendere lo stesso pallino e non
   devono divergere. OnApriDettaglioPrivilegio bolla fino a Characters.razor (il foglio dal basso,
   D3/D4 del piano 2026-08-08): questo componente la propaga soltanto, non la consuma.
   CharacterFeaturesSection esclude ANCORA il gruppo "passivo" (v. il suo commento in testa): quella
   resa resta qui sotto, diversa da quella delle altre schede — v. il blocco PASSIVI subito dopo. *@
<CharacterFeaturesSection Gruppi="@Gruppi" CharacterId="@Character.Id" LivelloAttuale="@Character.Level"
                           CanEdit="@CanEdit" IsSaving="@IsSaving"
                           OnSalvaAnnotazione="@OnSalvaAnnotazione"
                           OnSpendiContatore="@OnSpendiContatoreDaSchedaAsync"
                           OnApriDettaglio="@OnApriDettaglioPrivilegio" />

@* Passivi: sezione 7 dell'ordine verticale, resa DIVERSA dalle schede di CharacterFeaturesSection —
   un SOLO riquadro-tasto per l'intero gruppo, non una card per voce: sono promemoria, non azioni
   (v. spec 2026-08-08, D5), e la board non è il posto per leggerli per intero (D2 — "prosa" è un
   elenco, non un widget). Un tocco apre il foglio in modalità elenco (OnApriDettaglioGruppo, v.
   Pages/Characters.razor): prima di questo cambio (2026-08-08, board-di-gioco "Il difetto") questa
   era l'unica sezione senza aggancio al foglio, e i suoi privilegi (Difesa senza armatura, Maestria
   nelle armi, ...) non avevano alcun modo di essere annotati dall'interfaccia. *@
@{ var gruppoPassivi = Gruppi.FirstOrDefault(g => g.Tag == "passivo"); }
@if (gruppoPassivi is not null && gruppoPassivi.Voci.Count > 0)
{
    var etichettaVoci = gruppoPassivi.Voci.Count == 1 ? "1 voce" : $"{gruppoPassivi.Voci.Count} voci";
    <div class="board">
        <div class="w w-6" role="button" tabindex="0"
             aria-label="@($"{gruppoPassivi.Etichetta}, {etichettaVoci}")"
             @onclick="() => OnApriDettaglioGruppo.InvokeAsync(gruppoPassivi)"
             @onkeydown="@(e => OnKey(e, () => OnApriDettaglioGruppo.InvokeAsync(gruppoPassivi)))">
            <p class="w-label">@gruppoPassivi.Etichetta</p>
            <p class="w-value">@gruppoPassivi.Voci.Count</p>
        </div>
    </div>
}

@* Risorse di classe (Ira, Ispirazione bardica, ...) SENZA scheda-privilegio collegata (v.
   RisorseSenzaScheda più sotto): un contatore con una VistaPrivilegio agganciata è già reso dentro
   CharacterFeaturesSection, e non deve comparire due volte — un dato, una sola superficie primaria
   (D6). D6 vuole anche che un contatore SENZA privilegio a cui agganciarsi prenda un riquadro
   proprio, non una card d'altra epoca in mezzo ai riquadri: stesso vocabolario .w/.w-6 già usato
   per armi e mini-valori qui sopra. I pallini restano gli STESSI (.resource-dot/.resource-dots),
   gap 2rem INVARIATO — v. il commento sulla classe nel CSS: sotto i 44px i tap target si
   sovrappongono, lo stesso difetto già misurato su StatCard.razor.css. L'aggiunta di una risorsa
   nuova è in fondo al tab, sotto il divisore «Modifica» (piano 2026-08-08, B1/D7): è il controllo
   più raro, va nel posto meno prezioso. *@
@if (RisorseSenzaScheda.Any())
{
    <div class="board">
        @foreach (var risorsa in RisorseSenzaScheda)
        {
            var r = risorsa;
            var disponibili = r.Max - r.Spesi;
            <div class="w w-6">
                <div class="resource-header">
                    <p class="w-label">@r.Nome</p>
                    @if (CanEdit)
                    {
                        <button type="button" class="resource-edit-btn" aria-label="Modifica @r.Nome"
                                @onclick="() => ToggleEditResource(r)" disabled="@IsSaving">✎</button>
                    }
                </div>
                <div class="resource-dots">
                    @for (int i = 1; i <= r.Max; i++)
                    {
                        var n = i;
                        <span class="resource-dot @(n <= disponibili ? "filled" : "")"
                              role="button" tabindex="0"
                              aria-pressed="@AriaBool(n <= disponibili)" aria-label="Uso @n di @r.Nome"
                              @onclick="() => OnResourceDotClickAsync(r, n)"
                              @onkeydown="@(e => OnKey(e, () => OnResourceDotClickAsync(r, n)))"></span>
                    }
                </div>
                <p class="w-sub">Ricarica: @EtichettaRicarica(r.Ricarica)</p>

                @if (ReferenceEquals(editingResource, r))
                {
                    <div class="resource-edit-panel">
                        <div class="resource-field">
                            <label for="@($"risorsa-edit-nome-{r.GetHashCode()}")">Nome</label>
                            <input id="@($"risorsa-edit-nome-{r.GetHashCode()}")" type="text" class="resource-input"
                                   maxlength="60" @bind="editDraft.Nome" />
                        </div>
                        <div class="resource-field">
                            <label for="@($"risorsa-edit-max-{r.GetHashCode()}")">Massimo</label>
                            <input id="@($"risorsa-edit-max-{r.GetHashCode()}")" type="number" class="resource-input"
                                   min="1" @bind="editDraft.Max" />
                        </div>
                        <div class="resource-field">
                            <label for="@($"risorsa-edit-ricarica-{r.GetHashCode()}")">Ricarica</label>
                            <select id="@($"risorsa-edit-ricarica-{r.GetHashCode()}")" class="resource-input"
                                    @bind="editDraft.Ricarica">
                                <option value="lungo">Riposo lungo</option>
                                <option value="breve">Riposo breve</option>
                                <option value="nessuna">Nessuna (altro)</option>
                            </select>
                        </div>
                        <div class="resource-form-actions">
                            <button type="button" class="primary-btn" @onclick="() => SaveEditResourceAsync(r)"
                                    disabled="@(IsSaving || isSavingResources)">
                                @(isSavingResources ? "Salvataggio..." : "Salva")
                            </button>
                            <button type="button" class="secondary-btn" @onclick="CancelEditResource"
                                    disabled="@isSavingResources">
                                Annulla
                            </button>
                            <button type="button" class="resource-delete-btn" @onclick="() => DeleteResourceAsync(r)"
                                    disabled="@(IsSaving || isSavingResources)">
                                Elimina
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@* Caratteristiche, tiri salvezza e abilità (CharacterStatsTab): resta un componente separato — non
   fuso qui dentro, non duplicato come istanza a parte — che Characters.razor passa come figlio (v.
   il commento lì). Si compone qui, in mezzo, invece che dopo: è l'ultima cosa che si tira prima del
   divisore di fase più sotto. *@
@ChildContent

@* Divisore di fase: separa ciò che si tira o si spende in combattimento (sopra) da ciò che si
   recupera quando è finito (sotto). Solo token esistenti, nessun colore nuovo — v. CLAUDE.md. *@
<div class="turn-divider" role="separator" aria-hidden="true">
    <span class="turn-divider-label">A fine combattimento</span>
</div>

@* Dadi vita e riposo: un solo riquadro (piano 2026-08-08, B2) — un bordo e un padding invece di
   due, contenuto invariato. Il valore mostrato è HitDiceRemaining() (già clampato a 0, v. sotto), la
   STESSA espressione usata dal mini-riquadro DV più sopra: due letture indipendenti dello stesso
   calcolo divergerebbero al primo HitDiceSpent fuori range (v. il commento su HitDiceRemaining()
   nel @code). *@
<div class="recovery-card">
    <p class="card-label hit-dice-label">DADI VITA</p>
    <div class="hit-dice-row">
        <button class="hd-btn" @onclick="DecrementHitDice" aria-label="Un dado vita in meno"
                disabled="@(!CanEdit || IsSaving || Character.HitDiceSpent <= 0)">−</button>
        <div class="hit-dice-display">
            <span class="hit-dice-value">@HitDiceRemaining() / @HitDiceTotal()</span>
            <span class="hit-dice-type">@(string.IsNullOrWhiteSpace(Character.HitDiceMax) ? "—" : Character.HitDiceMax)</span>
        </div>
        <button class="hd-btn" @onclick="IncrementHitDice" aria-label="Un dado vita in più"
                disabled="@(!CanEdit || IsSaving || Character.HitDiceSpent >= HitDiceTotal())">+</button>
    </div>

    @* Riposo lungo/breve (RestCalculations, helper puro): il lungo passa da ConfirmDialog perché
       azzera i TS contro morte; il breve apre un pannello che chiede dadi spesi + totale tirato
       (l'app non tira il dado, offre solo la media come valore precompilato). *@
    <div class="recovery-divider">
        <p class="card-label">RIPOSO</p>
        <div class="rest-actions">
            <button type="button" class="secondary-btn rest-btn" @onclick="ToggleShortRestPanel"
                    disabled="@(!CanEdit || IsSaving)">
                Riposo breve
            </button>
            <button type="button" class="primary-btn rest-btn" @onclick="RiposoLungoAsync"
                    disabled="@(!CanEdit || IsSaving)">
                Riposo lungo
            </button>
        </div>

        @if (showShortRestPanel)
        {
            <div class="short-rest-panel">
                <div class="short-rest-field">
                    <span class="short-rest-label">Dadi vita spesi</span>
                    <div class="short-rest-stepper">
                        <button type="button" class="hd-btn" @onclick="() => AdjustDadiSpesi(-1)"
                                aria-label="Un dado vita speso in meno"
                                disabled="@(!CanEdit || dadiSpesi <= 0)">−</button>
                        <span class="short-rest-value">@dadiSpesi / @HitDiceRemaining()</span>
                        <button type="button" class="hd-btn" @onclick="() => AdjustDadiSpesi(1)"
                                aria-label="Un dado vita speso in più"
                                disabled="@(!CanEdit || dadiSpesi >= HitDiceRemaining())">+</button>
                    </div>
                </div>
                <div class="short-rest-field">
                    <label class="short-rest-label" for="riposo-breve-totale">Totale tirato</label>
                    <input id="riposo-breve-totale" type="number" class="short-rest-input" min="0"
                           value="@totaleTirato" @oninput="OnTotaleTiratoInput" disabled="@(!CanEdit)" />
                </div>
                <div class="short-rest-actions">
                    <button type="button" class="secondary-btn rest-btn" @onclick="CloseShortRestPanel">
                        Annulla
                    </button>
                    <button type="button" class="primary-btn rest-btn" @onclick="ConfermaRiposoBreveAsync"
                            disabled="@(!CanEdit || IsSaving || dadiSpesi <= 0)">
                        Conferma
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@* Divisore «Modifica» (piano 2026-08-08, B1/D7): il chrome di amministrazione — qui, l'unico
   rimasto in questo componente è "+ Aggiungi risorsa" — esce dal percorso del pollice e va in fondo
   al tab, sotto ciò che si consulta durante il turno. Stessa classe di .turn-divider più sopra: due
   dividers, stesso stile, solo l'etichetta cambia. *@
<div class="turn-divider" role="separator" aria-hidden="true">
    <span class="turn-divider-label">Modifica</span>
</div>

@if (CanEdit)
{
    @if (!isAddingResource)
    {
        <button type="button" class="resource-add-btn" @onclick="OpenAddResourceForm" disabled="@IsSaving">
            + Aggiungi risorsa
        </button>
    }
    else
    {
        <div class="resource-form">
            @if (SuggestedResources.Any())
            {
                <div class="resource-suggestions">
                    @foreach (var s in SuggestedResources)
                    {
                        var suggerita = s;
                        <button type="button" class="resource-chip" @onclick="() => ApplySuggestion(suggerita)">
                            @suggerita.Nome
                        </button>
                    }
                </div>
            }
            <div class="resource-field">
                <label for="risorsa-nome">Nome</label>
                <input id="risorsa-nome" type="text" class="resource-input" maxlength="60"
                       placeholder="Nome della risorsa" @bind="resourceDraft.Nome" />
            </div>
            <div class="resource-field">
                <label for="risorsa-max">Massimo</label>
                <input id="risorsa-max" type="number" class="resource-input" min="1"
                       @bind="resourceDraft.Max" />
            </div>
            <div class="resource-field">
                <label for="risorsa-ricarica">Ricarica</label>
                <select id="risorsa-ricarica" class="resource-input" @bind="resourceDraft.Ricarica">
                    <option value="lungo">Riposo lungo</option>
                    <option value="breve">Riposo breve</option>
                    <option value="nessuna">Nessuna (altro)</option>
                </select>
            </div>
            <div class="resource-form-actions">
                <button type="button" class="primary-btn" @onclick="SaveNewResourceAsync"
                        disabled="@(IsSaving || isSavingResources)">
                    @(isSavingResources ? "Salvataggio..." : "Salva")
                </button>
                <button type="button" class="secondary-btn" @onclick="CancelAddResource"
                        disabled="@isSavingResources">
                    Annulla
                </button>
            </div>
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public Character Character { get; set; } = default!;
    [Parameter] public bool CanEdit { get; set; }

    /// <summary>A differenza delle altre tab, qui il salvataggio deve riportare l'ESITO: il riposo
    /// mostra un toast di successo solo se il server ha davvero accettato la scrittura (le RLS
    /// legano l'update all'appartenenza corrente alla campagna — se non combacia, PostgREST
    /// aggiorna zero righe e risponde [], e senza l'esito qui il riposo si annuncerebbe riuscito
    /// comunque). Un EventCallback non può restituire un valore da InvokeAsync: da qui il delegato
    /// semplice invece del solito EventCallback usato dalle altre tab.</summary>
    [Parameter, EditorRequired] public Func<Task<bool>> OnChanged { get; set; } = default!;

    /// <summary>Salvataggio in corso per QUESTO personaggio, tenuto dal genitore e condiviso con
    /// CharacterVitalsBar: senza un solo flag comune, un riposo confermato e un tocco sui PF nello
    /// stesso istante potrebbero far partire due scritture in corsa sullo stesso Character.</summary>
    [Parameter] public bool IsSaving { get; set; }

    /// <summary>Da invocare dopo aver riportato Character allo stato pre-tentativo, quando
    /// OnChanged() torna false: questo componente si ridisegna da sé a fine dei propri metodi (è il
    /// "receiver" del proprio click), ma CharacterVitalsBar — fratello, non figlio, e che mostra gli
    /// stessi PF/PF-temp toccati dal riposo — non si accorgerebbe del ripristino finché qualcos'altro
    /// non forzasse un render del genitore. SaveCharacterCoreAsync (in Characters.razor) chiama già
    /// StateHasChanged sul genitore, ma PRIMA che questo componente rientri dall'await e ripristini
    /// Character: quella StateHasChanged non vede ancora il valore corretto. Bound dal genitore a un
    /// semplice StateHasChanged su di sé — stesso schema "il figlio chiede, il genitore fa" di
    /// OnOpenHpPanel/OnLevelUp in CharacterVitalsBar.razor.</summary>
    [Parameter] public EventCallback OnLocalRevert { get; set; }

    [Parameter] public IReadOnlyList<InventoryItem> Weapons { get; set; } = Array.Empty<InventoryItem>();

    /// <summary>I privilegi già raggruppati (v. CharacterFeatureJoin, piano 2026-08-08): Characters.razor
    /// li costruisce con i cataloghi già in cache (nessuna chiamata di rete nuova qui) e li passa
    /// pronti. Include ANCHE il gruppo "passivo": CharacterFeaturesSection lo esclude da sé, la
    /// sezione PASSIVI qui sotto lo estrae per la propria resa diversa.</summary>
    [Parameter] public IReadOnlyList<GruppoPrivilegi> Gruppi { get; set; } = Array.Empty<GruppoPrivilegi>();

    /// <summary>Bolle fino a Characters.razor: la voce si fonde in Character.CharacterFeatures per
    /// nome normalizzato e il salvataggio passa direttamente da SaveCharacterCoreAsync, come negli
    /// altri tab, che ne riporta l'esito — questo componente non possiede l'annotazione, la smista
    /// soltanto (v. commento sul markup della sezione privilegi).</summary>
    [Parameter] public EventCallback<CharacterFeature> OnSalvaAnnotazione { get; set; }

    /// <summary>Apre il foglio di dettaglio del privilegio (piano 2026-08-08, D3/D4): risale da
    /// CharacterFeaturesSection fino a Characters.razor, che possiede lo stato del foglio. Questo
    /// componente si limita a propagarla come parametro — non la consuma, non la intercetta.</summary>
    [Parameter] public EventCallback<VistaPrivilegio> OnApriDettaglioPrivilegio { get; set; }

