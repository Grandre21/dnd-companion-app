@using DndCompanion.Models
@using DndCompanion.Services
@inject IInventoryRepository InventoryRepository
@inject ConfirmService Confirm

<div class="inventory-header">
    <p class="section-header" style="margin: 0;">INVENTARIO</p>
    <p class="inventory-summary">@Items.Count oggetti · Peso @FormatWeight(TotalInventoryWeight) kg</p>
</div>
<div class="inventory-section">

    @if (CanEditInventory)
    {
        @if (!isAddingItem)
        {
            <button type="button" class="inv-add-btn" @onclick="OpenAddItemForm">
                + Aggiungi oggetto
            </button>
        }
        else
        {
            <div class="inv-form">
                <div class="inv-form-grid">
                    <div class="field field-full">
                        <label>Nome</label>
                        <input type="text" class="input" maxlength="80"
                               placeholder="Nome dell'oggetto"
                               @bind="newItemDraft.Name" />
                    </div>

                    <div class="field">
                        <label>Quantità</label>
                        <input type="number" class="input" min="1" @bind="newItemDraft.Quantity" />
                    </div>

                    <div class="field">
                        <label>Peso</label>
                        <input type="number" class="input" step="0.1" min="0"
                               @bind="newItemDraft.Weight" />
                    </div>

                    <div class="field field-full">
                        <label>Tipo</label>
                        <select class="input" @bind="newItemDraft.ItemType">
                            @foreach (var o in ItemTypeOptions)
                            {
                                <option value="@o.Value">@o.Label</option>
                            }
                        </select>
                    </div>

                    @if (IsWeaponType(newItemDraft.ItemType))
                    {
                        <p class="weapon-fields-title field-full">Dettagli dell'arma</p>

                        <div class="field field-full">
                            <label>Bonus d'attacco (facoltativo)</label>
                            <input type="text" class="input" maxlength="20"
                                   placeholder="es. +5 — lascia vuoto per il calcolo automatico"
                                   @bind="newItemDraft.AttackBonus" />
                        </div>

                        <div class="field">
                            <label>Danno</label>
                            <input type="text" class="input" maxlength="20"
                                   placeholder="es. 2d6"
                                   @bind="newItemDraft.Damage" />
                        </div>

                        <div class="field">
                            <label>Tipo di danno</label>
                            <input type="text" class="input" maxlength="30"
                                   placeholder="es. Taglio"
                                   @bind="newItemDraft.DamageType" />
                        </div>

                        <div class="field field-full">
                            <label>Note (opzionale)</label>
                            <textarea class="input" rows="2"
                                      @bind="newItemDraft.AttackNotes"></textarea>
                        </div>

                        <div class="weapon-flags field-full">
                            <label class="weapon-flag">
                                <input type="checkbox" @bind="newItemDraft.IsFinesse" />
                                <span class="weapon-flag-text">
                                    <span class="weapon-flag-name">Accurata</span>
                                    <span class="weapon-flag-hint">Può usare Destrezza al posto di Forza, se conviene.</span>
                                </span>
                            </label>
                            <label class="weapon-flag">
                                <input type="checkbox" @bind="newItemDraft.IsRanged" />
                                <span class="weapon-flag-text">
                                    <span class="weapon-flag-name">A distanza</span>
                                    <span class="weapon-flag-hint">Usa Destrezza per il bonus d'attacco.</span>
                                </span>
                            </label>
                            <label class="weapon-flag">
                                <input type="checkbox" @bind="newItemDraft.IsNotProficient" />
                                <span class="weapon-flag-text">
                                    <span class="weapon-flag-name">Non competente</span>
                                    <span class="weapon-flag-hint">Niente bonus di competenza per questa arma.</span>
                                </span>
                            </label>
                        </div>
                    }

                    <div class="field field-full">
                        <label>Descrizione (opzionale)</label>
                        <textarea class="input" rows="3"
                                  @bind="newItemDraft.Description"></textarea>
                    </div>
                </div>

                <div class="inv-form-actions">
                    <button type="button" class="primary-btn"
                            @onclick="SaveNewItemAsync"
                            disabled="@isSavingInventory">
                        @(isSavingInventory ? "Salvataggio..." : "Salva")
                    </button>
                    <button type="button" class="secondary-btn"
                            @onclick="CancelAddItem"
                            disabled="@isSavingInventory">
                        Annulla
                    </button>
                </div>
            </div>
        }
    }

    @if (IsLoading)
    {
        <LoadingSpinner Text="Caricamento inventario..." />
    }
    else if (Items.Count == 0)
    {
        <div class="inv-empty">Nessun oggetto nell'inventario.</div>
    }
    else
    {
        <div class="inv-list">
            @foreach (var item in Items)
            {
                var isItemExpanded = expandedItemId == item.Id;
                var isEditingThisItem = editingItemId == item.Id;
                var isWeapon = IsWeaponType(item.ItemType);
                var hasWeaponStats = isWeapon &&
                    (!string.IsNullOrWhiteSpace(item.AttackBonus) ||
                     !string.IsNullOrWhiteSpace(item.Damage) ||
                     !string.IsNullOrWhiteSpace(item.DamageType));
                <div class="inv-item @(item.IsEquipped ? "equipped" : "")">
                    <div class="inv-row">
                        <button type="button" class="inv-name-btn"
                                @onclick="() => ToggleItemExpand(item.Id)">
                            @if (isWeapon)
                            {
                                <span class="weapon-badge" title="Arma">⚔</span>
                            }
                            else if (item.IsEquipped)
                            {
                                <span class="eq-icon" title="Equipaggiato">⚔️</span>
                            }
                            <span class="inv-name-text">@item.Name</span>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <span class="inv-exp-icon">@(isItemExpanded ? "▾" : "▸")</span>
                            }
                        </button>

                        @if (CanEditInventory)
                        {
                            <div class="qty-controls">
                                @* Disabilitati anche mentre il pannello di modifica di QUESTO oggetto è
                                   aperto: lo stepper scrive item.Quantity subito sul server, ma il pannello
                                   lavora su una copia scollegata (editItemDraft) — le due scritture
                                   convergerebbero su "item" e l'ultima a salvare vincerebbe, perdendo in
                                   silenzio l'incremento/decremento fatto nel frattempo. *@
                                <button type="button" class="qty-btn qty-minus"
                                        @onclick="() => AdjustQuantityAsync(item, -1)"
                                        disabled="@(isSavingInventory || isEditingThisItem)">
                                    −
                                </button>
                                <span class="qty-value">@item.Quantity</span>
                                <button type="button" class="qty-btn qty-plus"
                                        @onclick="() => AdjustQuantityAsync(item, 1)"
                                        disabled="@(isSavingInventory || isEditingThisItem)">
                                    +
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="qty-readonly">×@item.Quantity</div>
                        }
                    </div>

                    @if (hasWeaponStats)
                    {
                        <p class="inv-weapon-stats">
                            @if (!string.IsNullOrWhiteSpace(item.AttackBonus)) { <span>@item.AttackBonus</span> }
                            @if (!string.IsNullOrWhiteSpace(item.Damage)) { <span>· @item.Damage @item.DamageType?.ToLower()</span> }
                        </p>
                    }

                    <div class="inv-meta">
                        @if (!string.IsNullOrWhiteSpace(item.ItemType))
                        {
                            <span class="inv-type-badge">@(isWeapon ? "Arma" : item.ItemType)</span>
                        }
                        @if (item.Weight.HasValue)
                        {
                            <span class="inv-weight">@FormatWeight(item.Weight.Value * item.Quantity)</span>
                        }

                        @if (CanEditInventory)
                        {
                            <label class="inv-eq-toggle">
                                <input type="checkbox" checked="@item.IsEquipped"
                                       @onchange="@(e => ToggleEquippedAsync(item, (bool)(e.Value ?? false)))"
                                       disabled="@isSavingInventory" />
                                <span>Equipaggiato</span>
                            </label>

                            <button type="button" class="inv-edit-btn"
                                    title="Modifica oggetto"
                                    aria-label="Modifica @item.Name"
                                    @onclick="() => OpenEditItemForm(item)"
                                    disabled="@isSavingInventory">
                                ✎
                            </button>

                            <button type="button" class="inv-delete-btn"
                                    title="Elimina oggetto"
                                    @onclick="() => DeleteItemAsync(item)"
                                    disabled="@isSavingInventory">
                                🗑️
                            </button>
                        }
                    </div>

                    @if (isItemExpanded && !string.IsNullOrWhiteSpace(item.Description))
                    {
                        <div class="inv-description">@item.Description</div>
                    }

                    @if (isEditingThisItem)
                    {
                        <div class="inv-edit-form">
                            <div class="inv-form-grid">
                                <div class="field field-full">
                                    <label>Nome</label>
                                    <input type="text" class="input" maxlength="80"
                                           placeholder="Nome dell'oggetto"
                                           @bind="editItemDraft.Name" />
                                </div>

                                <div class="field">
                                    <label>Quantità</label>
                                    <input type="number" class="input" min="1" @bind="editItemDraft.Quantity" />
                                </div>

                                <div class="field">
                                    <label>Peso</label>
                                    <input type="number" class="input" step="0.1" min="0"
                                           @bind="editItemDraft.Weight" />
                                </div>

                                <div class="field field-full">
                                    <label>Tipo</label>
                                    <select class="input" @bind="editItemDraft.ItemType">
                                        @foreach (var o in ItemTypeOptions)
                                        {
                                            <option value="@o.Value">@o.Label</option>
                                        }
                                    </select>
                                </div>

                                @if (IsWeaponType(editItemDraft.ItemType))
                                {
                                    <p class="weapon-fields-title field-full">Dettagli dell'arma</p>

                                    <div class="field field-full">
                                        <label>Bonus d'attacco (facoltativo)</label>
                                        <input type="text" class="input" maxlength="20"
                                               placeholder="es. +5 — lascia vuoto per il calcolo automatico"
                                               @bind="editItemDraft.AttackBonus" />
                                    </div>

                                    <div class="field">
                                        <label>Danno</label>
                                        <input type="text" class="input" maxlength="20"
                                               placeholder="es. 2d6"
                                               @bind="editItemDraft.Damage" />
                                    </div>

                                    <div class="field">
                                        <label>Tipo di danno</label>
                                        <input type="text" class="input" maxlength="30"
                                               placeholder="es. Taglio"
                                               @bind="editItemDraft.DamageType" />
                                    </div>

                                    <div class="field field-full">
                                        <label>Note (opzionale)</label>
                                        <textarea class="input" rows="2"
                                                  @bind="editItemDraft.AttackNotes"></textarea>
                                    </div>

                                    <div class="weapon-flags field-full">
                                        <label class="weapon-flag">
                                            <input type="checkbox" @bind="editItemDraft.IsFinesse" />
                                            <span class="weapon-flag-text">
                                                <span class="weapon-flag-name">Accurata</span>
                                                <span class="weapon-flag-hint">Può usare Destrezza al posto di Forza, se conviene.</span>
                                            </span>
                                        </label>
                                        <label class="weapon-flag">
                                            <input type="checkbox" @bind="editItemDraft.IsRanged" />
                                            <span class="weapon-flag-text">
                                                <span class="weapon-flag-name">A distanza</span>
                                                <span class="weapon-flag-hint">Usa Destrezza per il bonus d'attacco.</span>
                                            </span>
                                        </label>
                                        <label class="weapon-flag">
                                            <input type="checkbox" @bind="editItemDraft.IsNotProficient" />
                                            <span class="weapon-flag-text">
                                                <span class="weapon-flag-name">Non competente</span>
                                                <span class="weapon-flag-hint">Niente bonus di competenza per questa arma.</span>
                                            </span>
                                        </label>
                                    </div>
                                }

                                <div class="field field-full">
                                    <label>Descrizione (opzionale)</label>
                                    <textarea class="input" rows="3"
                                              @bind="editItemDraft.Description"></textarea>
                                </div>
                            </div>

                            <div class="inv-form-actions">
                                <button type="button" class="primary-btn"
                                        @onclick="() => SaveEditItemAsync(item)"
                                        disabled="@isSavingInventory">
                                    @(isSavingInventory ? "Salvataggio..." : "Salva")
                                </button>
                                <button type="button" class="secondary-btn"
                                        @onclick="CancelEditItem"
                                        disabled="@isSavingInventory">
                                    Annulla
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<p class="section-header">DENARO</p>
@if (isEditingMoney)
{
    <div class="money-editor">
        <div class="money-field">
            <label>MP</label>
            <input type="number" min="0" @bind="draftPlatinum" />
        </div>
        <div class="money-field">
            <label>MO</label>
            <input type="number" min="0" @bind="draftGold" />
        </div>
        <div class="money-field">
            <label>ME</label>
            <input type="number" min="0" @bind="draftElectrum" />
        </div>
        <div class="money-field">
            <label>MA</label>
            <input type="number" min="0" @bind="draftSilver" />
        </div>
        <div class="money-field">
            <label>MR</label>
            <input type="number" min="0" @bind="draftCopper" />
        </div>
        <div class="money-editor-actions">
            <span class="money-total">= @CoinConversion.FormattaTotaleInOro(CoinConversion.TotaleInRame(draftPlatinum, draftGold, draftElectrum, draftSilver, draftCopper)) mo</span>
            @if (CoinConversion.Compatta(draftPlatinum, draftGold, draftElectrum, draftSilver, draftCopper).Cambia)
            {
                <button type="button" class="money-compact-btn" @onclick="CompattaMonete"
                        title="Riordina le monete verso i tagli alti senza cambiarne il valore">Compatta</button>
            }
            <button type="button" class="money-cancel-btn" @onclick="AnnullaMonete">Annulla</button>
            <button class="money-save-btn" @onclick="SaveMoney">Salva</button>
        </div>
    </div>
}
else
{
    @* role/tabindex/aria-label qui sono condizionali su CanEdit, a differenza di altri controlli
       del progetto (SpellListItem.razor:4-7, CharacterCombatTab.razor:28-31) che li tengono sempre
       presenti e delegano il permesso alla guardia dentro il metodo: a CanEdit false il riquadro
       non è azionabile, e metterlo comunque nel tab order porterebbe la tastiera su un elemento che
       non fa nulla (il testo resta leggibile). Stessa forma già in StatCard.razor:68-69 (DotRole/DotTabIndex su IsEditMode). *@
    <div class="money-compact @(CanEdit ? "editable" : "")"
         role="@(CanEdit ? "button" : null)"
         tabindex="@(CanEdit ? "0" : null)"
         aria-label="@(CanEdit ? "Modifica il denaro" : null)"
         @onclick="ApriEditorMonete"
         @onkeydown="@(e => OnKey(e, () => { ApriEditorMonete(); return Task.CompletedTask; }))">
        <span class="money-icon">🪙</span>
        <span class="money-summary">@FormatMoney()</span>
        <span class="money-total">= @CoinConversion.FormattaTotaleInOro(Character) mo</span>
        @if (CanEdit)
        {
            <span class="money-edit-hint">✎</span>
        }
    </div>
}

<p class="section-header">SINTONIE OGGETTI MAGICI</p>
<div class="attunements-compact">
    @for (int slot = 1; slot <= 3; slot++)
    {
        var n = slot;
        var current = AttunementValue(n);
        <div class="attunement-row">
            <span class="attunement-icon">✦</span>
            @if (CanEdit)
            {
                <input type="text" class="attunement-input" maxlength="80"
                       placeholder="(slot libero)"
                       value="@current"
                       @onchange="@(e => SetAttunementAsync(n, e.Value?.ToString()))" />
            }
            else
            {
                <span class="attunement-text @(string.IsNullOrWhiteSpace(current) ? "empty" : "")">
                    @(string.IsNullOrWhiteSpace(current) ? "(slot libero)" : current)
                </span>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Character Character { get; set; } = default!;
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public IReadOnlyList<InventoryItem> Items { get; set; } = Array.Empty<InventoryItem>();
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>Persistenza di campi Character (denaro/sintonie): il genitore fa SaveCharacterAsync.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Modifica strutturale dell'inventario (add/delete): il genitore ricarica la lista.</summary>
    [Parameter] public EventCallback OnInventoryChanged { get; set; }
    /// <summary>Messaggio d'errore da mostrare nel banner del genitore (null = pulisci).</summary>
    [Parameter] public EventCallback<string?> OnError { get; set; }

    private bool isAddingItem;
    private InventoryItem newItemDraft = new();
    private bool isSavingInventory;
    private string? expandedItemId;
    private bool isEditingMoney;
    private string? _lastId;

    // Bozza del denaro: stesso schema di newItemDraft/editItemDraft qui sopra. I cinque input
    // scrivevano dritti su Character, e poiché il salvataggio del PG manda l'intera riga, una
    // modifica mai confermata partiva col primo salvataggio di un altro campo qualsiasi.
    private int draftPlatinum, draftGold, draftElectrum, draftSilver, draftCopper;

    // Modifica di un oggetto già in elenco: stesso schema di isAddingItem/newItemDraft sopra, ma
    // tenuto a parte perché più oggetti nell'elenco condividono lo stesso form — solo uno alla
    // volta può essere in modifica (editingItemId ne indica l'Id, null = nessuno).
    private string? editingItemId;
    private InventoryItem editItemDraft = new();

    // Le armi (Value "weapon") vengono mostrate nella sezione Combattimento. Le altre voci usano Value == Label.
    private static readonly (string Value, string Label)[] ItemTypeOptions =
    {
        ("Altro", "Altro"),
        ("weapon", "Arma"),
        ("Armatura", "Armatura"),
        ("Pozione", "Pozione"),
        ("Pergamena", "Pergamena"),
        ("Strumento", "Strumento"),
        ("Tesoro", "Tesoro")
    };

    private bool CanEditInventory => CanEdit;

    private double TotalInventoryWeight => Items.Sum(i => (i.Weight ?? 0) * i.Quantity);

    // Confronto centralizzato: decide sia il badge "Arma" nell'elenco sia se i form di
    // creazione/modifica mostrano i campi arma (bonus, danno, note, le tre spunte).
    private static bool IsWeaponType(string? itemType) =>
        string.Equals(itemType, "weapon", StringComparison.OrdinalIgnoreCase);

    // Se il tipo scelto non è "arma" i campi arma restano nascosti in UI, ma senza questo
    // azzeramento un valore scritto mentre il tipo era ancora "weapon" (poi cambiato prima di
    // salvare) sopravvivrebbe invisibile sul record: se l'oggetto tornasse "arma" in futuro,
    // ricomparirebbero bonus/danno/flag mai intenzionalmente confermati per quella configurazione.
    private static void ClearWeaponFieldsIfNotWeapon(InventoryItem item)
    {
        if (IsWeaponType(item.ItemType)) return;
        item.AttackBonus = null;
        item.Damage = null;
        item.DamageType = null;
        item.AttackNotes = null;
        item.IsFinesse = false;
        item.IsRanged = false;
        item.IsNotProficient = false;
    }

    // Reset dello stato UI locale al cambio di PG (prima lo faceva il genitore alla selezione).
    protected override void OnParametersSet()
    {
        if (Character.Id != _lastId)
        {
            _lastId = Character.Id;
            expandedItemId = null;
            isAddingItem = false;
            isEditingMoney = false;
            newItemDraft = new InventoryItem();
            editingItemId = null;
            editItemDraft = new InventoryItem();
            // Difensivo come gli altri reset qui sopra: la bozza viene comunque ripopolata
            // all'apertura da ApriEditorMonete.
            draftPlatinum = draftGold = draftElectrum = draftSilver = draftCopper = 0;
        }
    }

    private void ToggleItemExpand(string id) => expandedItemId = expandedItemId == id ? null : id;

    private async Task OpenAddItemForm()
    {
        if (!CanEditInventory) return;
        newItemDraft = new InventoryItem
        {
            CharacterId = Character.Id,
            Quantity = 1,
            ItemType = ItemTypeOptions[0].Value
        };
        isAddingItem = true;
        await OnError.InvokeAsync(null);
    }

    private void CancelAddItem()
    {
        isAddingItem = false;
        newItemDraft = new InventoryItem();
    }

    private async Task SaveNewItemAsync()
    {
        if (!CanEditInventory) return;

        if (string.IsNullOrWhiteSpace(newItemDraft.Name))
        {
            await OnError.InvokeAsync("Il nome dell'oggetto è obbligatorio");
            return;
        }
        if (newItemDraft.Quantity < 1) newItemDraft.Quantity = 1;
        ClearWeaponFieldsIfNotWeapon(newItemDraft);

        isSavingInventory = true;
        await OnError.InvokeAsync(null);
        try
        {
            newItemDraft.CharacterId = Character.Id;
            var saved = await InventoryRepository.CreateInventoryItemAsync(newItemDraft);
            if (saved is null)
            {
                await OnError.InvokeAsync("Il server non ha restituito l'oggetto salvato.");
                return;
            }
            isAddingItem = false;
            newItemDraft = new InventoryItem();
            await OnInventoryChanged.InvokeAsync(); // il genitore ricarica (lista ordinata + Combat aggiornato)
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync($"Errore creazione oggetto: {ex.Message}");
        }
        finally
        {
            isSavingInventory = false;
        }
    }

    // ===== Modifica di un oggetto già in elenco =====
    // Un'arma creata prima dell'introduzione di IsFinesse/IsRanged/IsNotProficient (e più in
    // generale qualunque oggetto) resterebbe senza questi campi per sempre senza un modo per
    // aggiornarla: questo form segue lo stesso schema di quello di creazione più sopra, bindato
    // a editItemDraft invece che a newItemDraft.

    private void OpenEditItemForm(InventoryItem item)
    {
        if (!CanEditInventory) return;
        if (editingItemId == item.Id)
        {
            CancelEditItem();
            return;
        }
        editingItemId = item.Id;
        editItemDraft = CloneItem(item);
    }

    private void CancelEditItem()
    {
        editingItemId = null;
        editItemDraft = new InventoryItem();
    }

    private static InventoryItem CloneItem(InventoryItem source) => new()
    {
        Id = source.Id,
        CharacterId = source.CharacterId,
        Name = source.Name,
        Quantity = source.Quantity,
        Weight = source.Weight,
        Description = source.Description,
        ItemType = source.ItemType,
        IsEquipped = source.IsEquipped,
        AttackBonus = source.AttackBonus,
        Damage = source.Damage,
        DamageType = source.DamageType,
        AttackNotes = source.AttackNotes,
        IsFinesse = source.IsFinesse,
        IsRanged = source.IsRanged,
        IsNotProficient = source.IsNotProficient,
    };

    private static void CopyItemFields(InventoryItem target, InventoryItem source)
    {
        target.Name = source.Name;
        target.Quantity = source.Quantity;
        target.Weight = source.Weight;
        target.Description = source.Description;
        target.ItemType = source.ItemType;
        target.AttackBonus = source.AttackBonus;
        target.Damage = source.Damage;
        target.DamageType = source.DamageType;
        target.AttackNotes = source.AttackNotes;
        target.IsFinesse = source.IsFinesse;
        target.IsRanged = source.IsRanged;
        target.IsNotProficient = source.IsNotProficient;
    }

    private async Task SaveEditItemAsync(InventoryItem item)
    {
        if (!CanEditInventory) return;

        if (string.IsNullOrWhiteSpace(editItemDraft.Name))
        {
            await OnError.InvokeAsync("Il nome dell'oggetto è obbligatorio");
            return;
        }
        if (editItemDraft.Quantity < 1) editItemDraft.Quantity = 1;
        ClearWeaponFieldsIfNotWeapon(editItemDraft);

        // Snapshot per il ripristino se il salvataggio non è confermato: "item" è l'istanza VIVA
        // nella lista del genitore (stessa disciplina di AdjustQuantityAsync/ToggleEquippedAsync
        // più sotto), non una copia — la si muta subito per il feedback immediato, prima di sapere
        // se il server accetta davvero la scrittura.
        var precedente = CloneItem(item);
        CopyItemFields(item, editItemDraft);

        isSavingInventory = true;
        await OnError.InvokeAsync(null);
        try
        {
            var saved = await InventoryRepository.UpdateInventoryItemAsync(item);
            if (saved is null)
            {
                CopyItemFields(item, precedente);
                await OnError.InvokeAsync("Il server non ha restituito l'oggetto salvato.");
                return;
            }
            editingItemId = null;
            editItemDraft = new InventoryItem();
            await OnInventoryChanged.InvokeAsync(); // il genitore ricarica (ordine tipo poi nome + Combat aggiornato)
        }
        catch (Exception ex)
        {
            CopyItemFields(item, precedente);
            await OnError.InvokeAsync($"Errore salvataggio oggetto: {ex.Message}");
        }
        finally
        {
            isSavingInventory = false;
        }
    }

    private async Task AdjustQuantityAsync(InventoryItem item, int delta)
    {
        if (!CanEditInventory) return;

        var newQty = item.Quantity + delta;

        if (newQty <= 0)
        {
            var confirmed = await Confirm.ShowAsync(
                $"Eliminare \"{item.Name}\" dall'inventario?");
            if (!confirmed) return;
            await DeleteItemInternalAsync(item);
            return;
        }

        var previous = item.Quantity;
        item.Quantity = newQty;
        isSavingInventory = true;
        await OnError.InvokeAsync(null);
        try
        {
            var saved = await InventoryRepository.UpdateInventoryItemAsync(item);
            if (saved is not null)
            {
                item.Quantity = saved.Quantity;
            }
        }
        catch (Exception ex)
        {
            item.Quantity = previous;
            await OnError.InvokeAsync($"Errore salvataggio quantità: {ex.Message}");
        }
        finally
        {
            isSavingInventory = false;
        }
    }

    private async Task ToggleEquippedAsync(InventoryItem item, bool newValue)
    {
        if (!CanEditInventory) return;
        if (item.IsEquipped == newValue) return;

        var previous = item.IsEquipped;
        item.IsEquipped = newValue;
        isSavingInventory = true;
        await OnError.InvokeAsync(null);
        try
        {
            var saved = await InventoryRepository.UpdateInventoryItemAsync(item);
            if (saved is not null)
            {
                item.IsEquipped = saved.IsEquipped;
            }
        }
        catch (Exception ex)
        {
            item.IsEquipped = previous;
            await OnError.InvokeAsync($"Errore salvataggio equipaggiamento: {ex.Message}");
        }
        finally
        {
            isSavingInventory = false;
        }
    }

    private async Task DeleteItemAsync(InventoryItem item)
    {
        if (!CanEditInventory) return;

        var confirmed = await Confirm.ShowAsync(
            $"Eliminare \"{item.Name}\" dall'inventario?");
        if (!confirmed) return;

        await DeleteItemInternalAsync(item);
    }

    private async Task DeleteItemInternalAsync(InventoryItem item)
    {
        isSavingInventory = true;
        await OnError.InvokeAsync(null);
        try
        {
            await InventoryRepository.DeleteInventoryItemAsync(item.Id);
            if (expandedItemId == item.Id) expandedItemId = null;
            await OnInventoryChanged.InvokeAsync(); // il genitore ricarica (rimuove l'item + Combat aggiornato)
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync($"Errore eliminazione oggetto: {ex.Message}");
        }
        finally
        {
            isSavingInventory = false;
        }
    }

    private static string FormatWeight(double weight)
    {
        if (weight <= 0) return "0";
        return weight.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    }

    // Stringa compatta delle sole valute > 0, in ordine di valore decrescente (MP>MO>ME>MA>MR).
    private string FormatMoney()
    {
        var parts = new List<string>();
        if (Character.PlatinumPieces > 0) parts.Add($"{Character.PlatinumPieces} MP");
        if (Character.GoldPieces > 0) parts.Add($"{Character.GoldPieces} MO");
        if (Character.ElectrumPieces > 0) parts.Add($"{Character.ElectrumPieces} ME");
        if (Character.SilverPieces > 0) parts.Add($"{Character.SilverPieces} MA");
        if (Character.CopperPieces > 0) parts.Add($"{Character.CopperPieces} MR");
        return parts.Count > 0 ? string.Join(" · ", parts) : "Nessuna moneta";
    }

    private void ApriEditorMonete()
    {
        if (!CanEdit) return;
        draftPlatinum = Character.PlatinumPieces;
        draftGold = Character.GoldPieces;
        draftElectrum = Character.ElectrumPieces;
        draftSilver = Character.SilverPieces;
        draftCopper = Character.CopperPieces;
        isEditingMoney = true;
    }

    private async Task SaveMoney()
    {
        if (!CanEdit) return;
        // Il clamp si applica alla bozza al momento del travaso: è l'unico punto in cui i valori
        // entrano nel personaggio.
        Character.PlatinumPieces = Math.Max(0, draftPlatinum);
        Character.GoldPieces = Math.Max(0, draftGold);
        Character.ElectrumPieces = Math.Max(0, draftElectrum);
        Character.SilverPieces = Math.Max(0, draftSilver);
        Character.CopperPieces = Math.Max(0, draftCopper);
        await OnChanged.InvokeAsync();
        isEditingMoney = false;
    }

    // Riordina i tagli della bozza senza cambiarne il valore totale. Non tocca il personaggio:
    // finché non si preme Salva, la compattazione si può abbandonare con Annulla.
    private void CompattaMonete()
    {
        if (!CanEdit) return;
        var esito = CoinConversion.Compatta(draftPlatinum, draftGold, draftElectrum, draftSilver, draftCopper);
        draftPlatinum = esito.PlatinumPieces;
        draftGold = esito.GoldPieces;
        draftElectrum = esito.ElectrumPieces;
        draftSilver = esito.SilverPieces;
        draftCopper = esito.CopperPieces;
    }

    private void AnnullaMonete() => isEditingMoney = false;

    private string? AttunementValue(int slot) => slot switch
    {
        1 => Character.AttunedItem1,
        2 => Character.AttunedItem2,
        3 => Character.AttunedItem3,
        _ => null
    };

    private async Task SetAttunementAsync(int slot, string? raw)
    {
        if (!CanEdit) return;
        var val = string.IsNullOrWhiteSpace(raw) ? null : raw.Trim();
        switch (slot)
        {
            case 1: Character.AttunedItem1 = val; break;
            case 2: Character.AttunedItem2 = val; break;
            case 3: Character.AttunedItem3 = val; break;
            default: return;
        }
        await OnChanged.InvokeAsync();
    }
}
