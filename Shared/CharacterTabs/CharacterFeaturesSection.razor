@using DndCompanion.Models
@using DndCompanion.Services
@implements IDisposable
@inject ActiveEffectsService ActiveEffects
@inject ToastService Toasts

@* La board dei privilegi del tab «Gioco» (v. piano 2026-08-08 board-di-gioco, Fetta C). Rende TUTTI
   i gruppi tranne "passivo": quel gruppo lo rende CharacterCombatTab con una resa diversa (riga
   singola, nessun contatore, nessun interruttore — v. spec 2026-08-08, sezione «L'ordine
   verticale»).

   Ogni gruppo è un riquadro w-6 in POSIZIONE FISSA per tag (v. .w[data-tag=...] nel CSS, D1a): se un
   gruppo è vuoto la sua posizione resta vuota, gli altri non scorrono a riempirla — un personaggio di
   1° livello senza privilegi "azione" è il caso comune, non l'eccezione.

   La nota NON si rende più qui: sta nel foglio aperto da OnApriDettaglio (fetta A, Pages/Characters.razor).
   Nessuna logica di dominio qui: il raggruppamento e l'ordinamento li fa già CharacterFeatureJoin
   (Services/), la densità la fa CharacterFeatureDensity — questo componente rende soltanto e delega
   ogni scrittura al genitore tramite EventCallback — non possiede Character, non salva nulla di suo.
   L'unica eccezione è lo stato "attivo", che non è mai una scrittura sul personaggio (v.
   ActiveEffectsService): vive in localStorage e si tocca direttamente dal servizio iniettato, senza
   passare dal genitore. *@

@if (!GruppiVisibili.Any())
{
    <p class="empty-note">Nessun privilegio da mostrare per ora.</p>
}
else
{
    <div class="board">
        @foreach (var gruppo in GruppiVisibili)
        {
            <div class="w w-6" data-tag="@gruppo.Tag">
                <p class="w-label">@gruppo.Etichetta</p>
                <ul class="w-list">
                    @foreach (var voce in gruppo.Voci)
                    {
                        var attiva = ActiveEffects.IsActive(CharacterId, voce.Nome);
                        var densita = CharacterFeatureDensity.Classifica(voce, attiva);
                        var rigaClass = densita == DensitaPrivilegio.Spenta
                            ? "feature-tile-row-dim"
                            : (attiva ? "feature-tile-row-active" : string.Empty);

                        <li class="feature-tile-row @rigaClass"
                            role="button" tabindex="0"
                            aria-label="@voce.Nome"
                            @onclick="() => OnApriDettaglio.InvokeAsync(voce)"
                            @onkeydown="@(e => OnKey(e, () => OnApriDettaglio.InvokeAsync(voce)))">
                            <span class="feature-tile-name">
                                @voce.Nome
                                @if (voce.SbloccatoAlLivello == LivelloAttuale)
                                {
                                    <span class="feature-badge-new">Nuovo</span>
                                }
                            </span>

                            <div class="feature-tile-actions">
                                @if (voce.Attivabile)
                                {
                                    <span class="feature-toggle @(attiva ? "active" : "")"
                                          role="button" tabindex="0"
                                          aria-pressed="@AriaBool(attiva)" aria-label="@voce.Nome"
                                          @onclick="() => ToggleAttivoAsync(voce.Nome)" @onclick:stopPropagation="true"
                                          @onkeydown="@(e => OnKey(e, () => ToggleAttivoAsync(voce.Nome)))" @onkeydown:stopPropagation="true"></span>
                                }

                                @* I pallini restano visibili in TUTTE le densità, anche Spenta dove la
                                   riga smorzata dice già la stessa cosa: non sono una resa, sono il
                                   controllo — l'unico modo di ripristinare il contatore dopo un riposo
                                   lungo (OnContatoreDotClickAsync). Nasconderli lascerebbe un'Ira esaurita
                                   per sempre: la ridondanza col colore smorzato è accettata di proposito,
                                   non va "corretta" rimuovendoli. Lo stopPropagation è nuovo rispetto alla
                                   card di prima: ora l'intera riga apre il foglio (OnApriDettaglio), quindi
                                   un tocco sul pallino non deve propagarsi e aprirlo anche lui. *@
                                @if (voce.Contatore is not null)
                                {
                                    var contatore = voce.Contatore;
                                    var disponibili = contatore.Max - contatore.Spesi;
                                    <div class="feature-dots">
                                        @for (int i = 1; i <= contatore.Max; i++)
                                        {
                                            var n = i;
                                            <span class="feature-dot @(n <= disponibili ? "filled" : "")"
                                                  role="button" tabindex="0"
                                                  aria-pressed="@AriaBool(n <= disponibili)" aria-label="Uso @n di @contatore.Nome"
                                                  @onclick="() => OnContatoreDotClickAsync(contatore, n)" @onclick:stopPropagation="true"
                                                  @onkeydown="@(e => OnKey(e, () => OnContatoreDotClickAsync(contatore, n)))" @onkeydown:stopPropagation="true"></span>
                                        }
                                    </div>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
}

@* «+ Aggiungi voce» in fondo alla sezione, non in cima (D7): il chrome di modifica esce dal
   percorso del pollice. *@
@if (CanEdit)
{
    @if (!isAddingNew)
    {
        <button type="button" class="feature-add-btn" @onclick="ApriAggiunta" disabled="@IsSaving">
            + Aggiungi voce
        </button>
    }
    else
    {
        <div class="feature-form">
            <div class="feature-field">
                <label for="feature-add-nome">Nome</label>
                <input id="feature-add-nome" type="text" class="feature-input" maxlength="120"
                       placeholder="Nome del privilegio o del tratto" @bind="draft.Nome" />
            </div>
            @* Nota/Azione/Risorsa/interruttore/azioni: pannello condiviso con la modifica dal foglio
               (Pages/Characters.razor), v. Shared/CharacterTabs/CharacterFeatureEditPanel.razor. Il
               Nome resta qui perché il pannello lo esclude di proposito (nella modifica non è
               modificabile, è la chiave della voce) — v. brief giuntura fetta A/fetta C 2026-08-08.
               Nessun wrapper con sfondo/bordo nel pannello: quello lo dà .feature-form qui sopra. *@
            <CharacterFeatureEditPanel Draft="draft" IsSaving="IsSaving" PuoEliminare="false"
                                        OnSalva="SalvaAsync" OnAnnulla="AnnullaModifica" />
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<GruppoPrivilegi> Gruppi { get; set; } = Array.Empty<GruppoPrivilegi>();
    [Parameter, EditorRequired] public string CharacterId { get; set; } = string.Empty;
    [Parameter] public int LivelloAttuale { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool IsSaving { get; set; }

    /// <summary>Copre SIA la modifica di una voce esistente SIA l'aggiunta di una voce propria: sono
    /// la stessa operazione — si scrive un CharacterFeature nel jsonb, e se il suo nome non
    /// corrisponde a nessun derivato il join lo renderà come voce propria (v. brief Task 7).</summary>
    [Parameter] public EventCallback<CharacterFeature> OnSalvaAnnotazione { get; set; }

    [Parameter] public EventCallback<(string Nome, int Usi)> OnSpendiContatore { get; set; }

    /// <summary>Apre il foglio della fetta A (Pages/Characters.razor) con il dettaglio del privilegio
    /// toccato: nome, tag, nota per intero e il ✎ che apre la modifica (v. piano, "Contratti fra le
    /// fette"). Un tocco sulla riga lo invoca; questo componente non possiede lo stato del foglio.</summary>
    [Parameter] public EventCallback<VistaPrivilegio> OnApriDettaglio { get; set; }

    private IEnumerable<GruppoPrivilegi> GruppiVisibili => Gruppi.Where(g => g.Tag != "passivo");

    // ===== Editing su bozza: MAI @bind diretto sul dato (v. brief). CharacterFeature riusato come
    // tipo della bozza: la sua forma coincide esattamente coi campi da modificare, stesso schema di
    // "resourceDraft = new ClassResource()" in CharacterCombatTab.razor. =====
    private CharacterFeature draft = new();
    private bool isAddingNew;
    private string? _lastCharacterId;

    protected override void OnParametersSet()
    {
        if (CharacterId != _lastCharacterId)
        {
            _lastCharacterId = CharacterId;
            isAddingNew = false;
            draft = new CharacterFeature();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ActiveEffects.Changed += HandleActiveEffectsChanged;
        await ActiveEffects.EnsureLoadedAsync();
    }

    private void HandleActiveEffectsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => ActiveEffects.Changed -= HandleActiveEffectsChanged;

    private void ApriAggiunta()
    {
        if (!CanEdit) return;
        if (isAddingNew) { AnnullaModifica(); return; }
        isAddingNew = true;
        draft = new CharacterFeature();
    }

    private void AnnullaModifica()
    {
        isAddingNew = false;
        draft = new CharacterFeature();
    }

    private async Task SalvaAsync()
    {
        if (!CanEdit || IsSaving) return;

        if (string.IsNullOrWhiteSpace(draft.Nome))
        {
            Toasts.ShowError("Il nome è obbligatorio");
            return;
        }

        var feature = CharacterFeatureRules.NormalizzaBozza(draft);

        // OnSalvaAnnotazione è un EventCallback<T>: non può restituire un esito (stesso limite
        // documentato per OnChanged in CharacterCombatTab.razor). Il pannello si chiude comunque; è
        // il genitore, che possiede Character e il salvataggio vero, a gestire un eventuale
        // fallimento (banner/rollback), non questo componente.
        await OnSalvaAnnotazione.InvokeAsync(feature);
        AnnullaModifica();
    }

    private Task ToggleAttivoAsync(string nome) => ActiveEffects.ToggleAsync(CharacterId, nome);

    /// <summary>Un tocco su un pallino: stesso schema di OnResourceDotClickAsync in
    /// CharacterCombatTab.razor, letto sui pallini "disponibili" invece che "raggiunti". Qui non si
    /// muta nulla in locale — questo componente non possiede Character.ClassResources — si emette
    /// solo il delta (positivo = spende, negativo = recupera) al genitore.</summary>
    private async Task OnContatoreDotClickAsync(ClassResource contatore, int posizione)
    {
        if (!CanEdit || IsSaving) return;

        var delta = ClassResourceRules.DeltaDaPallino(contatore.Max, contatore.Spesi, posizione);
        if (delta == 0) return;

        await OnSpendiContatore.InvokeAsync((contatore.Nome, delta));
    }
}
