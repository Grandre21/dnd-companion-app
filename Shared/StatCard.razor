@using DndCompanion.Models
@using DndCompanion.Services

<div class="statcard">
    <div class="sc-header">
        <div class="sc-abbr">@Abbr(Ability)</div>
        <div class="sc-mod">@FormatBonus(CharacterCalculations.GetModifier(AbilityScore(Character, Ability)))</div>
        <div class="sc-score">@AbilityScore(Character, Ability)</div>
    </div>

    <div class="sc-divider"></div>

    <div class="sc-row">
        <span class="@DotClass(GetSaveProf(Character, Ability), false)"
              role="@DotRole" tabindex="@DotTabIndex"
              aria-pressed="@AriaBool(GetSaveProf(Character, Ability))" aria-label="TS @Abbr(Ability)"
              @onclick="() => CycleSave()" @onclick:stopPropagation="true"
              @onkeydown="@(e => OnKey(e, CycleSave))" @onkeydown:stopPropagation="true"></span>
        <span class="sc-name @(GetSaveProf(Character, Ability) ? "on" : "off")">TS</span>
        <span class="sc-val @(GetSaveProf(Character, Ability) ? "on" : "off")">@FormatBonus(CharacterCalculations.GetSaveBonus(Character, Ability))</span>
    </div>

    @foreach (var skill in SkillsFor(Ability))
    {
        var prof = GetSkillProf(Character, skill);
        var exp = GetSkillExp(Character, skill);
        <div class="sc-row">
            <span class="@DotClass(prof, exp)"
                  role="@DotRole" tabindex="@DotTabIndex"
                  aria-pressed="@AriaBool(prof || exp)" aria-label="@SkillLabel(skill)"
                  @onclick="() => CycleSkill(skill)" @onclick:stopPropagation="true"
                  @onkeydown="@(e => OnKey(e, () => CycleSkill(skill)))" @onkeydown:stopPropagation="true"></span>
            <span class="sc-name @(prof || exp ? "on" : "off")">@SkillLabel(skill)</span>
            <span class="sc-val @(prof || exp ? "on" : "off")">@FormatBonus(CharacterCalculations.GetSkillBonus(Character, skill))</span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public AbilityType Ability { get; set; }
    [Parameter, EditorRequired] public Character Character { get; set; } = default!;
    [Parameter] public bool IsEditMode { get; set; } = false;

    /// <summary>Deve riportare l'ESITO (non un EventCallback): un update rifiutato dalle RLS non
    /// solleva eccezioni — PostgREST aggiorna zero righe e risponde [] — quindi senza l'esito una
    /// competenza mai confermata resterebbe a schermo e verrebbe poi persistita in silenzio dal
    /// primo salvataggio riuscito da qualunque altro punto della scheda. Stesso contratto di
    /// CharacterVitalsBar.OnChanged (v. il commento lì).</summary>
    [Parameter, EditorRequired] public Func<Task<bool>> OnChanged { get; set; } = default!;

    /// <summary>Da invocare dopo aver riportato Character allo stato pre-tentativo: questo
    /// componente si ridisegna da sé (è il receiver del proprio click), ma il foglio che lo ospita
    /// no. Bound dal genitore a StateHasChanged su di sé.</summary>
    [Parameter] public EventCallback OnLocalRevert { get; set; }

    // ---- Toggle pallini (solo in edit mode) ----

    private async Task CycleSave()
    {
        if (!IsEditMode) return;
        // Il valore va catturato PRIMA dell'await: fra un await e l'altro Blazor smista gli eventi,
        // e ripristinare rileggendo la proprietà scriverebbe il valore sbagliato.
        var precedente = GetSaveProf(Character, Ability);
        SetSaveProf(Character, Ability, !precedente);
        if (!await OnChanged())
        {
            SetSaveProf(Character, Ability, precedente);
            await OnLocalRevert.InvokeAsync();
        }
    }

    private async Task CycleSkill(SkillType skill)
    {
        if (!IsEditMode) return;
        var prof = GetSkillProf(Character, skill);
        var exp = GetSkillExp(Character, skill);
        // Ciclo: non competente -> competente -> expertise -> non competente
        if (!prof && !exp) { SetSkillProf(Character, skill, true); }
        else if (prof && !exp) { SetSkillExp(Character, skill, true); }
        else { SetSkillProf(Character, skill, false); SetSkillExp(Character, skill, false); }

        if (!await OnChanged())
        {
            // Ripristino di ENTRAMBI i flag: il ciclo ne tocca uno o due a seconda del ramo, e
            // rimetterne solo uno lascerebbe uno stato che nessun ramo del ciclo produce.
            SetSkillProf(Character, skill, prof);
            SetSkillExp(Character, skill, exp);
            await OnLocalRevert.InvokeAsync();
        }
    }

    // ---- Accessibilità tastiera (Enter/Space attivano il pallino, solo in edit mode) ----

    private string? DotRole => IsEditMode ? "button" : null;
    private int DotTabIndex => IsEditMode ? 0 : -1;

    // ---- Formattazione (FormatBonus/AriaBool/OnKey vengono da CharacterView, @using static globale) ----

    private static string DotClass(bool prof, bool exp)
        => prof && exp ? "sc-dot expertise" : prof ? "sc-dot prof" : "sc-dot";

    // ---- Mapping nomi ----

    private static string Abbr(AbilityType a) => a switch
    {
        AbilityType.Strength => "FOR",
        AbilityType.Dexterity => "DES",
        AbilityType.Constitution => "COS",
        AbilityType.Intelligence => "INT",
        AbilityType.Wisdom => "SAG",
        AbilityType.Charisma => "CAR",
        _ => "?"
    };

    // Enum -> nome italiano: centralizzato in SkillCatalog (usato anche dal vincolo di scelta
    // abilità e dai suoi test contro il pacchetto SRD).
    private static string SkillLabel(SkillType s) => SkillCatalog.Nome(s);

    // Skill associate alla caratteristica: DERIVATA da CharacterCalculations.GetSkillAbility invece
    // di ricopiarne l'inverso a mano (era lo stesso difetto di SkillLabel, promosso solo a metà —
    // MINORE 6 del gate del 2026-08-06). Così una skill nuova entra qui da sola.
    private static IEnumerable<SkillType> SkillsFor(AbilityType a) =>
        SkillCatalog.Tutte.Where(s => CharacterCalculations.GetSkillAbility(s) == a);

    // ---- Accessor stato: punteggio e tiri salvezza (CharacterCalculations non li espone
    // pubblici). Le skill, sotto, non ripetono più questo schema: delegano a SkillCatalog. ----

    private static int AbilityScore(Character c, AbilityType a) => a switch
    {
        AbilityType.Strength => c.Strength,
        AbilityType.Dexterity => c.Dexterity,
        AbilityType.Constitution => c.Constitution,
        AbilityType.Intelligence => c.Intelligence,
        AbilityType.Wisdom => c.Wisdom,
        AbilityType.Charisma => c.Charisma,
        _ => 10
    };

    private static bool GetSaveProf(Character c, AbilityType a) => a switch
    {
        AbilityType.Strength => c.ProfSaveStrength,
        AbilityType.Dexterity => c.ProfSaveDexterity,
        AbilityType.Constitution => c.ProfSaveConstitution,
        AbilityType.Intelligence => c.ProfSaveIntelligence,
        AbilityType.Wisdom => c.ProfSaveWisdom,
        AbilityType.Charisma => c.ProfSaveCharisma,
        _ => false
    };

    private static void SetSaveProf(Character c, AbilityType a, bool v)
    {
        switch (a)
        {
            case AbilityType.Strength: c.ProfSaveStrength = v; break;
            case AbilityType.Dexterity: c.ProfSaveDexterity = v; break;
            case AbilityType.Constitution: c.ProfSaveConstitution = v; break;
            case AbilityType.Intelligence: c.ProfSaveIntelligence = v; break;
            case AbilityType.Wisdom: c.ProfSaveWisdom = v; break;
            case AbilityType.Charisma: c.ProfSaveCharisma = v; break;
        }
    }

    // Lettura/scrittura delle 18 coppie di bool: centralizzate in SkillCatalog, che le condivide
    // col vincolo di scelta abilità (SkillChoiceRules) e con la creazione guidata.
    private static bool GetSkillProf(Character c, SkillType s) => SkillCatalog.Competente(c, s);

    private static void SetSkillProf(Character c, SkillType s, bool v) => SkillCatalog.ImpostaCompetenza(c, s, v);

    private static bool GetSkillExp(Character c, SkillType s) => SkillCatalog.Esperto(c, s);

    private static void SetSkillExp(Character c, SkillType s, bool v) => SkillCatalog.ImpostaEsperienza(c, s, v);
}
